{
  "schema": "plan42.integration/0.1",
  "component": "alchemy.plan42",
  "version": "0.1-dev5",
  "owner": "Plan42",
  "entrypoints": {
    "oorexx_class": "plan42/AlchemyPlan42Service.cls::AlchemyPlan42Service",
    "python_bridge": "tools/plan42_bridge.py",
    "canonical_compiler": "tools/plan42c.py",
    "native_runner": "run_plan42.rex",
    "rx2cpp_build_planner": "tools/plan42_rx2cpp_plan.py",
    "rx2cpp_object_model_importer": "tools/plan42_rx2cpp_inventory.py",
    "rx2cpp_upstream_audit": "tools/plan42_rx2cpp_upstream_audit.py"
  },
  "service_key": "plan42",
  "estate_candidate": "estate/plan42.estate.candidate.json",
  "estate_published": false,
  "intentions": [
    {
      "id": "plan42.discover",
      "effect": "read-only",
      "dynamic": true
    },
    {
      "id": "plan42.inspect",
      "effect": "read-only",
      "requires": [
        "source-read"
      ]
    },
    {
      "id": "plan42.compile",
      "effect": "file-write",
      "requires": [
        "source-read",
        "output-write-authorisation"
      ],
      "execution": false
    },
    {
      "id": "plan42.native.plan",
      "effect": "read-only",
      "execution": false,
      "publication": false,
      "requires": [
        "generated-oorexx-source"
      ]
    },
    {
      "id": "plan42.native.inventory",
      "effect": "read-only",
      "execution": false,
      "publication": false,
      "requires": [
        "generated-oorexx-source",
        "RX2CPP_OBJECT_MODEL/0.1 evidence"
      ]
    }
  ],
  "dependencies": {
    "required": [
      "python3",
      "plan42c.py"
    ],
    "optional": [
      "oorexx",
      "ExternalCall",
      "transport.isolated",
      "ConnectSelector",
      "QueueFabric",
      "rx2cpp 0.30.18 (pinned checkout; separately qualified)"
    ]
  },
  "target_routing": {
    "oorexx_native_candidates": [
      "python3",
      "python",
      "py",
      "oorexx",
      "oo-rexx",
      "oo_rexx",
      "orx",
      "regina",
      "rexx",
      "classicrexx",
      "classic-rexx",
      "classic_rexx",
      "bash",
      "sh"
    ],
    "python_canonical": [
      "c",
      "c11",
      "rust"
    ],
    "canonical_refusals": [
      "cpp",
      "c++",
      "java"
    ],
    "two_stage_native": {
      "from": "oorexx source generated by Plan42",
      "through": "animatedads/oorexx/oorexx2cpp",
      "to": "native C++17 binary or interpreter-loadable .so",
      "qualified": false,
      "generic_cpp_backend": false,
      "publication": false
    }
  },
  "security_contract": {
    "automatic_codelet_activation": false,
    "generated_code_execution": false,
    "runtime_class_replacement": false,
    "outbound_rpc": false,
    "output_boundary": "generated/plan42/",
    "input_boundary": "Alchemy workspace",
    "no_silent_native_fallback": true,
    "provenance": [
      "source_sha256",
      "output_sha256",
      "compatibility",
      "diagnostics",
      "engine"
    ],
    "native_cpp_compilation_automatic": false,
    "native_inspector_import": "unattested read-only source model; no interpreter execution"
  },
  "acceptance": {
    "python_bridge_tests": "local passed in isolated cases",
    "native_oorexx_runtime": "not executed in current environment",
    "rust_compiler": "not executed in current environment",
    "framework65_full_boot": "not established",
    "current_new_alchemy_host": "adapter contract ready; production runtime publication not asserted",
    "rx2cpp_github_main_2026_10_15": "inspected VERSION 0.30.18, revision 9047f0e; no interpreter/native runtime execution in this workspace",
    "native_build_plan": "read-only verification and CLI tests only",
    "rx2cpp_object_inspection": "import only; genuine interpreter run unqualified"
  }
}
