+    sqlite3_bind_text(right,1,table.data(),(int)table.size(),SQLITE_TRANSIENT);
+    int a=sqlite3_step(left),b=sqlite3_step(right);
+    bool equal=a==SQLITE_ROW && b==SQLITE_ROW && compareSQLiteCell(left,right,0);
