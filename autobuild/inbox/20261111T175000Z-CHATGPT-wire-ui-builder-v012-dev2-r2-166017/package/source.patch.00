diff --git a/wire_ui_builder_v0.12-dev2-readiness/examples/WireUIBuilderLiveWorkspaceFixture.cls b/wire_ui_builder_v0.12-dev2-readiness/examples/WireUIBuilderLiveWorkspaceFixture.cls
