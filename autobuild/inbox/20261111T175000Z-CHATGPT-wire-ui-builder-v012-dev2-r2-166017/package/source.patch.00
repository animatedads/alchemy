+++ b/wire_ui_builder_v0.12-dev2-readiness/integration/WireUIBuilderApplication.cls
@@ -0,0 +1,935 @@
+/*
+  Standalone Builder Studio Wire UI application.
+  Studio design and target design are intentionally different projects.
+*/
+::class WireUIBuilderApplication subclass WireUIApplication public
+::attribute targetProject get
+::attribute sourceCatalogue get
+::method init
+  expose targetProject sourceCatalogue lastPublished studioState sourceWorkspaceRef sourceWindowRevision sourceWindowOffset sourceWindowLimit sourceFilter sourceSortRef sourceSortDirection
+  use arg applicationId, sessionId, accessPointId, view, projection, targetProject, sourceCatalogue=.nil
+  self~init:super(applicationId,sessionId,accessPointId,view,projection)
+  if targetProject==.nil | \targetProject~isA(.WireUIBuilderProject) then raise syntax 88.900 array("BUILDER_TARGET_PROJECT_REQUIRED")
+  lastPublished=.nil
+  studioState="DESIGN"
+  sourceWorkspaceRef="BUILDER_SOURCE"; sourceWindowRevision=0; sourceWindowOffset=0; sourceWindowLimit=25
+  sourceFilter=""; sourceSortRef="PATH"; sourceSortDirection="ASC"
+
+::method installInitialView
+  expose targetProject sourceCatalogue sourceWorkspaceRef sourceWindowOffset sourceWindowLimit sourceFilter sourceSortRef sourceSortDirection
+  v=self~view
+  shell=.table~new; shell["visible"]=.true
+  call must v~createInstance("root","WUIB_SHELL@1",shell)
+
+  project=.table~new; project["projectId"]=targetProject~projectId; project["title"]=targetProject~title; project["revision"]=targetProject~revision; project["draftCount"]=targetProject~drafts~items; project["visible"]=.true
+  call must v~createInstance("project","WUIB_PROJECT@1",project,"root")
+
+  toolNav=.table~new; toolNav["items"]=.array~of("DESIGN","SOURCE","COMPONENTS","MATERIALS","FLOW","PUBLISH"); toolNav["visible"]=.true; toolNav["action"]="STUDIO.NAVIGATE"
+  call must v~createInstance("tool-nav","WUIB_TOOL_NAV@1",toolNav,"root"); v~setActionAvailable("tool-nav","STUDIO.NAVIGATE",.true)
+
+  library=.table~new; library["items"]=self~artifactLibraryItems; library["visible"]=.true; library["action"]="ARTIFACT.SELECT"
+  call must v~createInstance("artifact-library","WUIB_ARTIFACT_LIBRARY@1",library,"root"); v~setActionAvailable("artifact-library","ARTIFACT.SELECT",.true)
+
+  inspector=.table~new; inspector["kind"]="NONE"; inspector["artifactId"]=""; inspector["draftRevision"]=""; inspector["publishVersion"]=""; inspector["detail"]="Select an artifact or canvas placement"; inspector["visible"]=.true
+  call must v~createInstance("selection-inspector","WUIB_SELECTION_INSPECTOR@1",inspector,"root")
+
+  flow=.table~new; flow["items"]=self~flowMapItems; flow["visible"]=.true; flow["action"]="FLOW.SELECT"
+  call must v~createInstance("flow-map","WUIB_FLOW_MAP@1",flow,"root"); v~setActionAvailable("flow-map","FLOW.SELECT",.true)
+
+  /* SOURCE is a first-class authoritative workspace.  The browser receives only
+     the current source window; filtering changes membership scope while sorting
+     changes order only.  Stable source identity remains the catalogue path. */
+  call must self~registerWorkspace(sourceWorkspaceRef)
+  call must self~setWorkspaceSort(sourceWorkspaceRef,sourceSortRef,sourceSortDirection)
+  source=.table~new
+  source["collectionRef"]=sourceWorkspaceRef; source["windowOffset"]=0; source["windowLimit"]=sourceWindowLimit
+  source["windowTotalCount"]=0; source["windowRevision"]=0; source["sortRef"]=sourceSortRef; source["filterRef"]=sourceFilter; source["anchorRef"]=""; source["visible"]=.true
+  call must v~createInstance("source-files","WUIB_SOURCE_FILES@1",source,"root")
+  sourceControl=.table~new; sourceControl["filter"]=""; sourceControl["sortRef"]="PATH"; sourceControl["direction"]="ASC"; sourceControl["offset"]=0; sourceControl["limit"]=sourceWindowLimit; sourceControl["visible"]=.true; sourceControl["action"]="SOURCE.WINDOW"
+  call must v~createInstance("source-window-control","WUIB_SOURCE_WINDOW_CONTROL@1",sourceControl,"root"); v~setActionAvailable("source-window-control","SOURCE.WINDOW",.true)
+
+  sourceDetail=.table~new
+  sourceDetail["path"]=""; sourceDetail["classes"]=""; sourceDetail["methods"]=""
+  sourceDetail["attributes"]=""; sourceDetail["constants"]=""
+  sourceDetail["requires"]=""; sourceDetail["packageOptions"]=""
+  sourceDetail["queryRevision"]=0; sourceDetail["scopeRevision"]=0; sourceDetail["selectionRevision"]=0; sourceDetail["visible"]=.false
+  call must v~createInstance("source-detail","WUIB_SOURCE_DETAIL@1",sourceDetail,"root")
+  call must self~refreshSourceWindow(sourceWindowOffset,sourceWindowLimit,.false)
+
+  defaultState=self~defaultTargetJourneyState
+  canvas=.table~new; canvas["items"]=self~compositionCanvasItems("HUMAN_VISUAL",defaultState,"DEFAULT"); canvas["visible"]=.true; canvas["action"]="COMPOSITION.SELECT"; canvas["actions"]=.array~of("COMPOSITION.SELECT","DESIGN.COMPOSITION.MOVE","DESIGN.COMPOSITION.RESIZE","DESIGN.COMPOSITION.RELOCATE","DESIGN.COMPOSITION.ALIGN")
+  call must v~createInstance("composition-canvas","WUIB_COMPOSITION_CANVAS@1",canvas,"root")
+  do canvasAction over canvas["actions"]; v~setActionAvailable("composition-canvas",canvasAction,.true); end
+  ignore=self~installEditor(v,"composition-editor","WUIB_COMPOSITION_EDITOR@1","DESIGN.COMPOSITION.DRAFT",.array~of("artifactId","publishVersion","journeyId","profile","stateId","layoutModel","presentationPolicyId","presentationPolicyVersion","elementId","projectionId","region","order","span","rowSpan","align","viewportClass","whenMode","whenConditionIds","suppressConditionIds","presentationClass"))
+  ignore=self~installEditor(v,"preview-control","WUIB_PREVIEW_CONTROL@1","PREVIEW.CONFIGURE",.array~of("profile","journeyState","viewportClass","experimentId","variantId"))
+  summary=.table~new; summary["mode"]="DRAFT"; summary["profile"]="HUMAN_VISUAL"; summary["journeyState"]=defaultState; summary["viewportClass"]="DEFAULT"; summary["variant"]=""; summary["compositionCount"]=canvas["items"]~items; summary["activeDefinitions"]=""; summary["visible"]=.true
+  call must v~createInstance("preview-summary","WUIB_PREVIEW_SUMMARY@1",summary,"root")
+
+  ignore=self~installEditor(v,"component-editor","WUIB_COMPONENT_EDITOR@1","DESIGN.COMPONENT.DRAFT",.array~of("artifactId","publishVersion","primitive"))
+  ignore=self~installEditor(v,"element-editor","WUIB_ELEMENT_EDITOR@1","DESIGN.ELEMENT.DRAFT",.array~of("artifactId","publishVersion","semanticType","fields","actions","audiencePolicyRef"))
+  ignore=self~installEditor(v,"projection-editor","WUIB_PROJECTION_EDITOR@1","DESIGN.PROJECTION.DRAFT",.array~of("artifactId","publishVersion","profile","elementId","componentId","definitionId","action","styleRole","materialRole","resourceRole","resourceId","resourceVersion","resourceContentAddress","resourceClass","resourceLocale","rowCollectionSlot","rowCountSlot","rowIdentityField","rowFields","rowSelectionMode","rowSelectedIdsSlot","rowWorkspaceContextSlot","rowEmptyPolicy","rowFilterFields","rowSortFields","rowAction","rowSelectionAction","rowFilterAction","rowSortAction"))
+  ignore=self~installEditor(v,"material-editor","WUIB_MATERIAL_EDITOR@1","DESIGN.MATERIAL.DRAFT",.array~of("artifactId","publishVersion","tokenName","tokenValue"))
+  ignore=self~installEditor(v,"journey-editor","WUIB_JOURNEY_EDITOR@1","DESIGN.JOURNEY.DRAFT",.array~of("artifactId","publishVersion","initialState","initialFlowId","flowId","flowInitialState","stateId","active","prefetch","onDemand","fromState","toState","trigger","purpose","transitionWhenMode","transitionWhenConditionIds","transitionSuppressConditionIds"))
+  ignore=self~installEditor(v,"condition-editor","WUIB_CONDITION_EDITOR@1","DESIGN.CONDITION.DRAFT",.array~of("artifactId","publishVersion","sourceKind","sourceRef","operator","expectedValue","authorityRef"))
+  ignore=self~installEditor(v,"presentation-policy-editor","WUIB_PRESENTATION_POLICY_EDITOR@1","DESIGN.PRESENTATION_POLICY.DRAFT",.array~of("artifactId","publishVersion","precedence","region","capacity"))
+  ignore=self~installEditor(v,"experiment-editor","WUIB_EXPERIMENT_EDITOR@1","DESIGN.EXPERIMENT.DRAFT",.array~of("artifactId","publishVersion","targetElementId","variantAProjectionId","variantBProjectionId"))
+  ignore=self~installEditor(v,"publish","WUIB_PUBLISH@1","DESIGN.PUBLISH",.array~of("releaseId","releaseVersion"))
+
+  p=self~projection; p~bind("projectRevision","project","revision"); p~bind("projectDraftCount","project","draftCount")
+  p~bind("artifactLibraryItems","artifact-library","items")
+  p~bind("flowMapItems","flow-map","items")
+  p~bind("selectionKind","selection-inspector","kind"); p~bind("selectionArtifactId","selection-inspector","artifactId")
+  p~bind("selectionDraftRevision","selection-inspector","draftRevision"); p~bind("selectionPublishVersion","selection-inspector","publishVersion"); p~bind("selectionDetail","selection-inspector","detail")
+  p~bind("sourceDetailPath","source-detail","path")
+  p~bind("sourceDetailClasses","source-detail","classes")
+  p~bind("sourceDetailMethods","source-detail","methods")
+  p~bind("sourceDetailAttributes","source-detail","attributes")
+  p~bind("sourceDetailConstants","source-detail","constants")
+  p~bind("sourceDetailRequires","source-detail","requires")
+  p~bind("sourceDetailPackageOptions","source-detail","packageOptions")
+  p~bind("sourceDetailQueryRevision","source-detail","queryRevision")
+  p~bind("sourceDetailScopeRevision","source-detail","scopeRevision")
+  p~bind("sourceDetailSelectionRevision","source-detail","selectionRevision")
+  p~bind("sourceDetailVisible","source-detail","visible")
+  do name over .array~of("filter","sortRef","direction","offset","limit"); p~bind("sourceControl."name,"source-window-control",name); end
+  p~bind("compositionCanvasItems","composition-canvas","items")
+  do name over .array~of("artifactId","publishVersion","journeyId","profile","stateId","layoutModel","presentationPolicyId","presentationPolicyVersion","elementId","projectionId","region","order","span","rowSpan","align","viewportClass","whenMode","whenConditionIds","suppressConditionIds","presentationClass")
+    p~bind("compositionEdit."name,"composition-editor",name)
+  end
+  ignore=self~bindEditorProjection(p,"componentEdit","component-editor",.array~of("artifactId","publishVersion","primitive"))
+  ignore=self~bindEditorProjection(p,"elementEdit","element-editor",.array~of("artifactId","publishVersion","semanticType","fields","actions","audiencePolicyRef"))
+  ignore=self~bindEditorProjection(p,"projectionEdit","projection-editor",.array~of("artifactId","publishVersion","profile","elementId","componentId","definitionId","action","styleRole","materialRole","resourceRole","resourceId","resourceVersion","resourceContentAddress","resourceClass","resourceLocale"))
+  ignore=self~bindEditorProjection(p,"materialEdit","material-editor",.array~of("artifactId","publishVersion","tokenName","tokenValue"))
+  ignore=self~bindEditorProjection(p,"journeyEdit","journey-editor",.array~of("artifactId","publishVersion","initialState","initialFlowId","flowId","flowInitialState","stateId","active","prefetch","onDemand","fromState","toState","trigger","purpose","transitionWhenMode","transitionWhenConditionIds","transitionSuppressConditionIds"))
+  ignore=self~bindEditorProjection(p,"conditionEdit","condition-editor",.array~of("artifactId","publishVersion","sourceKind","sourceRef","operator","expectedValue","authorityRef"))
+  ignore=self~bindEditorProjection(p,"policyEdit","presentation-policy-editor",.array~of("artifactId","publishVersion","precedence","region","capacity"))
+  ignore=self~bindEditorProjection(p,"experimentEdit","experiment-editor",.array~of("artifactId","publishVersion","targetElementId","variantAProjectionId","variantBProjectionId"))
+  p~bind("previewMode","preview-summary","mode"); p~bind("previewProfile","preview-summary","profile"); p~bind("previewJourneyState","preview-summary","journeyState")
+  p~bind("previewViewportClass","preview-summary","viewportClass"); p~bind("previewVariant","preview-summary","variant"); p~bind("previewCompositionCount","preview-summary","compositionCount"); p~bind("previewActiveDefinitions","preview-summary","activeDefinitions")
+
+  /* Server v0.16 state-group projection lets one semantic Builder action change
+     several related facts without exposing transient half-updated UI revisions.
+     Keep the ordinary one-key bindings above for simple mutations; grouped
+     actions use this derived projector over the same semantic slots. */
+  groupKeys=.array~new
+  do key over .array~of("projectRevision","projectDraftCount","artifactLibraryItems","flowMapItems","selectionKind","selectionArtifactId","selectionDraftRevision","selectionPublishVersion","selectionDetail","sourceDetailPath","sourceDetailClasses","sourceDetailMethods","sourceDetailAttributes","sourceDetailConstants","sourceDetailRequires","sourceDetailPackageOptions","sourceDetailQueryRevision","sourceDetailScopeRevision","sourceDetailSelectionRevision","sourceDetailVisible","compositionCanvasItems","previewMode","previewProfile","previewJourneyState","previewViewportClass","previewVariant","previewCompositionCount","previewActiveDefinitions")
+    groupKeys~append(key)
+  end
+  do prefix over .array~of("sourceControl","compositionEdit","componentEdit","elementEdit","projectionEdit","materialEdit","journeyEdit","conditionEdit","policyEdit","experimentEdit")
+    select
+      when prefix="sourceControl" then fields=.array~of("filter","sortRef","direction","offset","limit")
+      when prefix="compositionEdit" then fields=.array~of("artifactId","publishVersion","journeyId","profile","stateId","layoutModel","presentationPolicyId","presentationPolicyVersion","elementId","projectionId","region","order","span","rowSpan","align","viewportClass","whenMode","whenConditionIds","suppressConditionIds","presentationClass")
+      when prefix="componentEdit" then fields=.array~of("artifactId","publishVersion","primitive")
+      when prefix="elementEdit" then fields=.array~of("artifactId","publishVersion","semanticType","fields","actions","audiencePolicyRef")
+      when prefix="projectionEdit" then fields=.array~of("artifactId","publishVersion","profile","elementId","componentId","definitionId","action","styleRole","materialRole","resourceRole","resourceId","resourceVersion","resourceContentAddress","resourceClass","resourceLocale")
+      when prefix="materialEdit" then fields=.array~of("artifactId","publishVersion","tokenName","tokenValue")
+      when prefix="journeyEdit" then fields=.array~of("artifactId","publishVersion","initialState","initialFlowId","flowId","flowInitialState","stateId","active","prefetch","onDemand","fromState","toState","trigger","purpose","transitionWhenMode","transitionWhenConditionIds","transitionSuppressConditionIds")
+      when prefix="conditionEdit" then fields=.array~of("artifactId","publishVersion","sourceKind","sourceRef","operator","expectedValue","authorityRef")
+      when prefix="policyEdit" then fields=.array~of("artifactId","publishVersion","precedence","region","capacity")
+      when prefix="experimentEdit" then fields=.array~of("artifactId","publishVersion","targetElementId","variantAProjectionId","variantBProjectionId")
+      otherwise fields=.array~new
+    end
+    do fieldName over fields; groupKeys~append(prefix"."fieldName); end
+  end
+  call must p~bindDerived(groupKeys,.WireUIBuilderStateGroupProjector~new)
+  return .WireUIResult~success(.true,"BUILDER_STUDIO_INITIAL_VIEW_INSTALLED")
+
+::method installEditor private
+  use arg v,instanceId,definitionKey,action,fieldNames
+  slots=.table~new; do name over fieldNames; slots[name]=""; end
+  slots["visible"]=.true; slots["action"]=action
+  call must v~createInstance(instanceId,definitionKey,slots,"root")
+  v~setActionAvailable(instanceId,action,.true)
+  return .true
+
+::method bindEditorProjection private
+  use arg projection,prefix,instanceId,fieldNames
+  do name over fieldNames; projection~bind(prefix"."name,instanceId,name); end
+  return .true
+
+::method dispatchSemanticAction
+  expose targetProject sourceCatalogue lastPublished studioState sourceWorkspaceRef sourceWindowOffset sourceWindowLimit sourceFilter sourceSortRef sourceSortDirection
+  use arg action,message
+  detail=self~detailOf(message)
+  if action="STUDIO.NAVIGATE" then do
+    targetState=self~field(detail,"value",self~field(detail,"id",self~field(detail,"key","")))~string~strip~translate
+    if targetState="" then return .WireUIResult~failure("BUILDER_STUDIO_STATE_REQUIRED")
+    r=self~advanceJourney(targetState,"STUDIO.NAVIGATE",detail)
+    if \r~ok then return r
+    studioState=targetState
+    call must self~mutateState("artifactLibraryItems",self~artifactLibraryItems(targetState))
+    if targetState="SOURCE" then call must self~refreshSourceWindow(sourceWindowOffset,sourceWindowLimit,.true)
+    return .WireUIResult~success(targetState,"BUILDER_STUDIO_NAVIGATED")
+  end
+  if action="SOURCE.WINDOW" then do
+    if sourceCatalogue==.nil then return .WireUIResult~failure("BUILDER_SOURCE_CATALOGUE_UNAVAILABLE")
+    requestedFilter=self~field(detail,"filter","")~string~strip
+    requestedSort=self~field(detail,"sortRef","PATH")~string~strip~translate
+    requestedDirection=self~field(detail,"direction","ASC")~string~strip~translate
+    if requestedSort<>"PATH" then return .WireUIResult~failure("BUILDER_SOURCE_SORT_UNSUPPORTED",requestedSort)
+    if requestedDirection<>"ASC" & requestedDirection<>"DESC" then return .WireUIResult~failure("BUILDER_SOURCE_SORT_DIRECTION_INVALID",requestedDirection)
+    requestedLimit=self~numberOr(self~field(detail,"limit",sourceWindowLimit),sourceWindowLimit)
+    if requestedLimit<5 then requestedLimit=5
+    if requestedLimit>100 then requestedLimit=100
+    requestedOffset=self~numberOr(self~field(detail,"offset",sourceWindowOffset),sourceWindowOffset)
+    if requestedOffset<0 then requestedOffset=0
+    scopeChanged=requestedFilter<>sourceFilter
+    if scopeChanged then do
+      if requestedFilter="" then wr=self~removeWorkspaceFilter(sourceWorkspaceRef,"PATH_CONTAINS")
+      else wr=self~setWorkspaceFilter(sourceWorkspaceRef,"PATH_CONTAINS",requestedFilter)
+      if \wr~ok then return wr
+      requestedOffset=0
+      sourceFilter=requestedFilter
+    end
+    if requestedSort<>sourceSortRef | requestedDirection<>sourceSortDirection then do
+      wr=self~setWorkspaceSort(sourceWorkspaceRef,requestedSort,requestedDirection); if \wr~ok then return wr
+      sourceSortRef=requestedSort; sourceSortDirection=requestedDirection
+    end
+    sourceWindowLimit=requestedLimit; sourceWindowOffset=requestedOffset
+    updates=.table~new
+    if scopeChanged then updates["sourceDetailVisible"]=.false
+    updates["sourceControl.filter"]=sourceFilter
+    updates["sourceControl.sortRef"]=sourceSortRef
+    updates["sourceControl.direction"]=sourceSortDirection
+    updates["sourceControl.offset"]=sourceWindowOffset
+    updates["sourceControl.limit"]=sourceWindowLimit
+    ur=self~mutateStateGroup(updates); if \ur~ok then return ur
+    /* Publish the new row window last.  Once a newly-visible row can be acted on,
+       the client has necessarily consumed every state patch produced by this
+       SOURCE.WINDOW action and therefore holds the current view revision. */
+    r=self~refreshSourceWindow(sourceWindowOffset,sourceWindowLimit,.true); if \r~ok then return r
+    return .WireUIResult~success(self~workspaceContext(sourceWorkspaceRef),"BUILDER_SOURCE_WINDOW_UPDATED")
+  end
+  if action="SOURCE.OPEN" then do
+    if sourceCatalogue==.nil then return .WireUIResult~failure("BUILDER_SOURCE_CATALOGUE_UNAVAILABLE")
+    sourceKey=self~field(detail,"id",self~field(detail,"key",self~field(detail,"ref",self~field(detail,"value",""))))
+    if sourceKey="" then do
+      instanceId=self~field(message,"elementInstance","")
+      row=self~view~instance(instanceId)
+      if row<>.nil then sourceKey=self~field(row["slots"],"label","")
+    end
+    sourceFile=sourceCatalogue~file(sourceKey)
+    if sourceFile==.nil then return .WireUIResult~failure("BUILDER_SOURCE_NOT_FOUND",sourceKey)
+    q=self~workspaceQuery(sourceWorkspaceRef)
+    sr=self~setWorkspaceSelection(sourceWorkspaceRef,q~scopeRevision,.array~of(sourceKey)); if \sr~ok then return sr
+    sourceWire=sourceFile~asWire
+    ctx=self~workspaceContext(sourceWorkspaceRef)
+    updates=.table~new
+    updates["sourceDetailPath"]=sourceWire["path"]
+    updates["sourceDetailClasses"]=self~sourceSymbolText(sourceWire["classes"])
+    updates["sourceDetailMethods"]=self~sourceSymbolText(sourceWire["methods"])
+    updates["sourceDetailAttributes"]=self~sourceSymbolText(sourceWire["attributes"])
+    updates["sourceDetailConstants"]=self~sourceSymbolText(sourceWire["constants"])
+    updates["sourceDetailRequires"]=self~sourceValueText(sourceWire["requires"])
+    updates["sourceDetailPackageOptions"]=self~sourceValueText(sourceWire["packageOptions"])
+    updates["sourceDetailQueryRevision"]=ctx["queryRevision"]
+    updates["sourceDetailScopeRevision"]=ctx["scopeRevision"]
+    updates["sourceDetailSelectionRevision"]=ctx["selectionRevision"]
+    updates["sourceDetailVisible"]=.true
+    call must self~mutateStateGroup(updates)
+    if studioState<>"SOURCE" then do
+      nav=self~advanceJourney("SOURCE","SOURCE.OPEN",sourceWire["path"]); if \nav~ok then return nav
+      studioState="SOURCE"
+    end
+    return .WireUIResult~success(sourceWire,"BUILDER_SOURCE_SELECTED")
+  end
+  if action="ARTIFACT.SELECT" then do
+    itemId=self~field(detail,"id",self~field(detail,"key",""))
+    item=self~artifactLibraryItem(itemId)
+    if item==.nil then return .WireUIResult~failure("BUILDER_ARTIFACT_NOT_FOUND",itemId)
+    ignore=self~mutateState("selectionKind",item["kind"]); ignore=self~mutateState("selectionArtifactId",item["artifactId"])
+    ignore=self~mutateState("selectionDraftRevision",item["draftRevision"]); ignore=self~mutateState("selectionPublishVersion",item["publishVersion"])
+    ignore=self~mutateState("selectionDetail",item["kind"]" draft · revision "item["draftRevision"])
+    ignore=self~populateArtifactEditor(item)
+    return .WireUIResult~success(item,"BUILDER_ARTIFACT_SELECTED")
+  end
+  if action="FLOW.SELECT" then do
+    itemId=self~field(detail,"id",self~field(detail,"key",""))
+    item=self~flowMapItem(itemId)
+    if item==.nil then return .WireUIResult~failure("BUILDER_FLOW_STATE_NOT_FOUND",itemId)
+    updates=.table~new
+    updates["selectionKind"]="JOURNEY_STATE"; updates["selectionArtifactId"]=item["journeyId"]":"item["stateId"]
+    updates["selectionDraftRevision"]=""; updates["selectionPublishVersion"]=""
+    updates["selectionDetail"]="active "item["activeCount"]" · next "item["nextStates"]
+    preview=self~previewStateUpdates("HUMAN_VISUAL",item["stateId"],"DEFAULT","","")
+    do key over preview~allIndexes; updates[key]=preview[key]; end
+    call must self~mutateStateGroup(updates)
+    return .WireUIResult~success(item,"BUILDER_FLOW_STATE_SELECTED")
+  end
+  if action="COMPOSITION.SELECT" then do
+    itemId=self~field(detail,"id",self~field(detail,"key",""))
+    item=self~compositionCanvasItem(itemId)
+    if item==.nil then return .WireUIResult~failure("BUILDER_COMPOSITION_ITEM_NOT_FOUND",itemId)
+    updates=.table~new
+    do name over .array~of("artifactId","publishVersion","journeyId","profile","stateId","layoutModel","presentationPolicyId","presentationPolicyVersion","elementId","projectionId","region","order","span","rowSpan","align","viewportClass","whenMode","whenConditionIds","suppressConditionIds","presentationClass")
+      updates["compositionEdit."name]=self~field(item,name,"")
+    end
+    updates["selectionKind"]="COMPOSITION_PLACEMENT"; updates["selectionArtifactId"]=item["elementId"]
+    updates["selectionDraftRevision"]=targetProject~revision; updates["selectionPublishVersion"]=item["publishVersion"]
+    updates["selectionDetail"]="region "item["region"]" · span "item["span"]"/12 · order "item["order"]
+    call must self~mutateStateGroup(updates)
+    return .WireUIResult~success(item,"BUILDER_COMPOSITION_SELECTED")
+  end
+  if action="PREVIEW.CONFIGURE" then do
+    r=self~refreshPreview(self~field(detail,"profile","HUMAN_VISUAL"),self~field(detail,"journeyState",""),self~field(detail,"viewportClass","DEFAULT"),self~field(detail,"experimentId",""),self~field(detail,"variantId",""))
+    return r
+  end
+  if action="DESIGN.COMPOSITION.MOVE" then do
+    source=self~compositionCanvasItem(self~field(detail,"sourceId","")); target=self~compositionCanvasItem(self~field(detail,"targetId",""))
+    if source==.nil | target==.nil then return .WireUIResult~failure("BUILDER_COMPOSITION_MOVE_ITEM_NOT_FOUND")
+    if source["artifactId"]<>target["artifactId"] then return .WireUIResult~failure("BUILDER_COMPOSITION_MOVE_CROSS_ARTIFACT")
+    payload=.table~new; payload["artifactId"]=source["artifactId"]
+    payload["sourcePlacementKey"]=self~placementKey(source); payload["targetPlacementKey"]=self~placementKey(target)
+    op=.WireUIDesignOperation~new("browser-move-"targetProject~revision"-".WireUIDesignUtil~token(payload["sourcePlacementKey"]"|"payload["targetPlacementKey"]),"DESIGN.COMPOSITION.MOVE",targetProject~revision,.nil,payload,"WIRE_UI:BUILDER","direct visual composition move")
+    r=targetProject~applyOperation(op); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+    ignore=self~refreshDesignCollections
+    return .WireUIResult~success(r~value~asWire,"BUILDER_COMPOSITION_MOVED")
+  end
+  if action="DESIGN.COMPOSITION.RESIZE" then do
+    item=self~compositionCanvasItem(self~field(detail,"id","")); if item==.nil then return .WireUIResult~failure("BUILDER_COMPOSITION_RESIZE_ITEM_NOT_FOUND")
+    span=self~field(detail,"span","")
+    if span="" then span=(item["span"]+0)+self~numberOr(self~field(detail,"deltaSpan",""),0)
+    if span<1 then span=1
+    if span>12 then span=12
+    payload=.table~new; payload["artifactId"]=item["artifactId"]; payload["placementKey"]=self~placementKey(item); payload["span"]=span; payload["rowSpan"]=self~numberOr(self~field(detail,"rowSpan",""),item["rowSpan"])
+    op=.WireUIDesignOperation~new("browser-resize-"targetProject~revision"-".WireUIDesignUtil~token(payload["placementKey"]"|"span),"DESIGN.COMPOSITION.RESIZE",targetProject~revision,.nil,payload,"WIRE_UI:BUILDER","direct visual composition resize")
+    r=targetProject~applyOperation(op); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+    ignore=self~refreshDesignCollections
+    return .WireUIResult~success(r~value~asWire,"BUILDER_COMPOSITION_RESIZED")
+  end
+  if action="DESIGN.COMPOSITION.RELOCATE" then do
+    item=self~compositionCanvasItem(self~field(detail,"id","")); if item==.nil then return .WireUIResult~failure("BUILDER_COMPOSITION_RELOCATE_ITEM_NOT_FOUND")
+    region=self~field(detail,"region","")~string~strip; if region="" then return .WireUIResult~failure("BUILDER_COMPOSITION_REGION_REQUIRED")
+    payload=.table~new; payload["artifactId"]=item["artifactId"]; payload["placementKey"]=self~placementKey(item); payload["region"]=region
+    op=.WireUIDesignOperation~new("browser-relocate-"targetProject~revision"-".WireUIDesignUtil~token(payload["placementKey"]"|"region),"DESIGN.COMPOSITION.RELOCATE",targetProject~revision,.nil,payload,"WIRE_UI:BUILDER","direct visual composition region relocation")
+    r=targetProject~applyOperation(op); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+    ignore=self~refreshDesignCollections
+    return .WireUIResult~success(r~value~asWire,"BUILDER_COMPOSITION_RELOCATED")
+  end
+  if action="DESIGN.COMPOSITION.ALIGN" then do
+    item=self~compositionCanvasItem(self~field(detail,"id","")); if item==.nil then return .WireUIResult~failure("BUILDER_COMPOSITION_ALIGN_ITEM_NOT_FOUND")
+    align=self~field(detail,"align","")~string~strip~translate; if align="" then return .WireUIResult~failure("BUILDER_COMPOSITION_ALIGN_REQUIRED")
+    payload=.table~new; payload["artifactId"]=item["artifactId"]; payload["placementKey"]=self~placementKey(item); payload["align"]=align
+    op=.WireUIDesignOperation~new("browser-align-"targetProject~revision"-".WireUIDesignUtil~token(payload["placementKey"]"|"align),"DESIGN.COMPOSITION.ALIGN",targetProject~revision,.nil,payload,"WIRE_UI:BUILDER","direct visual composition alignment")
+    r=targetProject~applyOperation(op); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+    ignore=self~refreshDesignCollections
+    return .WireUIResult~success(r~value~asWire,"BUILDER_COMPOSITION_ALIGNED")
+  end
+  if action="DESIGN.PUBLISH" then do
+    releaseId=self~field(detail,"releaseId",""); releaseVersion=self~field(detail,"releaseVersion","")
+    r=targetProject~publish(releaseId,releaseVersion); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+    lastPublished=r~value
+    ignore=self~refreshPreview("HUMAN_VISUAL","","DEFAULT","","")
+    return .WireUIResult~success(r~value["release"]~ref~asWire,"BUILDER_TARGET_PUBLISHED")
+  end
+  if action~left(7)<>"DESIGN." | action~right(6)<>".DRAFT" then return .WireUIResult~failure("BUILDER_ACTION_UNSUPPORTED",action)
+  payload=self~draftPayload(action,detail); if payload==.nil then return .WireUIResult~failure("BUILDER_DRAFT_INPUT_INVALID",action)
+  op=.WireUIDesignOperation~new("browser-"targetProject~revision"-".WireUIDesignUtil~token(action"|".WireUIDesignUtil~canonicalTable(payload)),action,targetProject~revision,.nil,payload,"WIRE_UI:BUILDER","Builder Studio semantic action")
+  r=targetProject~applyOperation(op); if \r~ok then return .WireUIResult~failure(r~code,r~detail)
+  updates=.table~new
+  updates["projectRevision"]=targetProject~revision
+  updates["projectDraftCount"]=targetProject~drafts~items
+  updates["artifactLibraryItems"]=self~artifactLibraryItems(studioState)
+  updates["flowMapItems"]=self~flowMapItems
+  if action="DESIGN.COMPOSITION.DRAFT" then do
+    preview=self~previewStateUpdates("HUMAN_VISUAL","","DEFAULT","","")
+    do key over preview~allIndexes; updates[key]=preview[key]; end
+  end
+  call must self~mutateStateGroup(updates)
+  return .WireUIResult~success(r~value~asWire,"BUILDER_DRAFT_UPDATED")
+
+::method sourceSymbolText private
+  use arg items
+  text=""
+  if items==.nil then return text
+  do item over items
+    name=""
+    if item~isA(.Table) | item~isA(.Directory) then do
+      if item~hasIndex("name") then name=item["name"]
+      if item~hasIndex("line") & item["line"]<>"" then name ||= " @"item["line"]
+    end
+    else name=item~string
+    if name="" then iterate
+    if text<>"" then text ||= .endOfLine
+    text ||= name
+  end
+  return text
+
+::method sourceValueText private
+  use arg items
+  text=""
+  if items==.nil then return text
+  do item over items
+    if text<>"" then text ||= .endOfLine
+    text ||= item~string
+  end
+  return text
+
+::method draftPayload private
+  expose targetProject
+  use arg action,detail
+  id=self~field(detail,"artifactId","")~string~strip; pv=self~field(detail,"publishVersion","")~string~strip
+  if id="" | pv="" then return .nil
+  spec=.table~new; spec["publishVersion"]=pv
+  select
+    when action="DESIGN.COMPONENT.DRAFT" then spec["primitive"]=self~field(detail,"primitive","")
+    when action="DESIGN.ELEMENT.DRAFT" then do
+      spec["semanticType"]=self~field(detail,"semanticType",""); spec["fields"]=self~csv(self~field(detail,"fields","")); spec["actions"]=self~csv(self~field(detail,"actions","")); spec["audiencePolicyRef"]=self~field(detail,"audiencePolicyRef","PUBLIC")
+    end
+    when action="DESIGN.PROJECTION.DRAFT" then do
+      do k over .array~of("profile","elementId","componentId","definitionId","action","styleRole","materialRole"); spec[k]=self~field(detail,k,""); end
+      bindings=.table~new; elementDraft=targetProject~draft("ELEMENT",spec["elementId"])
+      if elementDraft<>.nil then do
+        elementFields=self~field(elementDraft~spec,"fields",.array~new)
+        do fieldName over elementFields; bindings[fieldName]=fieldName; end
+      end
+      spec["bindings"]=bindings
+      resources=.array~new
+      priorProjection=targetProject~draft("PROJECTION",id)
+      if priorProjection<>.nil then resources=.WireUIDesignUtil~copyArray(self~field(priorProjection~spec,"resourceBindings",.array~new))
+      rid=self~field(detail,"resourceId","")~string~strip
+      if rid<>"" then do
+        rr=.table~new; rr["resourceId"]=rid; rr["version"]=self~field(detail,"resourceVersion",""); rr["contentAddress"]=self~field(detail,"resourceContentAddress",""); rr["resourceClass"]=self~field(detail,"resourceClass","STRUCTURED"); rr["locale"]=self~field(detail,"resourceLocale","")
+        rb=.table~new; rb["role"]=self~field(detail,"resourceRole","PRIMARY_CONTENT"); rb["resourceRef"]=rr; rb["required"]=.true
+        next=.array~new; replaced=.false
+        do oldrb over resources
+          if self~field(oldrb,"role","")=rb["role"] then do; next~append(rb); replaced=.true; end; else next~append(oldrb)
+        end
+        if \replaced then next~append(rb); resources=next
+      end
+      spec["resourceBindings"]=resources
+      rowCollectionSlot=self~field(detail,"rowCollectionSlot","")~string~strip
+      if rowCollectionSlot<>"" then do
+        rc=.table~new
+        rc["collectionSlot"]=rowCollectionSlot
+        rc["countSlot"]=self~field(detail,"rowCountSlot","")~string~strip
+        rc["identityField"]=self~field(detail,"rowIdentityField","")~string~strip
+        rc["rowFields"]=self~csv(self~field(detail,"rowFields",""))
+        rc["selectionMode"]=self~field(detail,"rowSelectionMode","NONE")~string~strip~translate
+        rc["selectedIdsSlot"]=self~field(detail,"rowSelectedIdsSlot","selectedIds")~string~strip
+        rc["workspaceContextSlot"]=self~field(detail,"rowWorkspaceContextSlot","workspaceContext")~string~strip
+        rc["emptyPolicy"]=self~field(detail,"rowEmptyPolicy","ALLOW_EMPTY")~string~strip~translate
+        rc["filterFields"]=self~csv(self~field(detail,"rowFilterFields",""))
+        rc["sortFields"]=self~csv(self~field(detail,"rowSortFields",""))
+        rc["rowAction"]=self~field(detail,"rowAction","")~string~strip
+        rc["selectionAction"]=self~field(detail,"rowSelectionAction","")~string~strip
+        rc["filterAction"]=self~field(detail,"rowFilterAction","")~string~strip
+        rc["sortAction"]=self~field(detail,"rowSortAction","")~string~strip
+        spec["rowContract"]=rc
+      end
+      else if priorProjection<>.nil then do
+        priorSpec=priorProjection~spec
+        if priorSpec~hasIndex("rowContract") then spec["rowContract"]=priorSpec["rowContract"]
+      end
+    end
+    when action="DESIGN.MATERIAL.DRAFT" then do
+      tokens=.table~new; recipes=.table~new
+      prior=targetProject~draft("MATERIAL",id)
+      if prior<>.nil then do; old=prior~spec; tokens=.WireUIDesignUtil~copyTable(old["tokens"]); recipes=.WireUIDesignUtil~copyTable(old["recipes"]); end
+      name=self~field(detail,"tokenName",""); if name="" then return .nil
+      tokens[name]=self~field(detail,"tokenValue",""); spec["tokens"]=tokens; spec["recipes"]=recipes
+    end
+    when action="DESIGN.JOURNEY.DRAFT" then do
+      spec["initialState"]=self~field(detail,"initialState",""); spec["initialFlowId"]=self~field(detail,"initialFlowId","")
+      states=.array~new; flows=.array~new; prior=targetProject~draft("JOURNEY",id)
+      if prior<>.nil then do; old=prior~spec; states=.WireUIDesignUtil~copyArray(old["states"]); flows=.WireUIDesignUtil~copyArray(self~field(old,"flows",.array~new)); spec["transitions"]=self~field(old,"transitions",.array~new); end
+      fid=self~field(detail,"flowId","")~string~strip; fis=self~field(detail,"flowInitialState","")~string~strip
+      if fid<>"" then do
+        fr=.table~new; fr["flowId"]=fid; fr["initialState"]=fis
+        fn=.array~new; ff=.false; do row over flows; if self~field(row,"flowId","")=fid then do; fn~append(fr); ff=.true; end; else fn~append(row); end; if \ff then fn~append(fr); flows=fn
+      end
+      spec["flows"]=flows
+      sid=self~field(detail,"stateId",""); if sid="" then return .nil
+      replacement=.table~new; replacement["stateId"]=sid; replacement["flowId"]=fid; replacement["ACTIVE"]=self~csv(self~field(detail,"active","")); replacement["PREFETCH"]=self~csv(self~field(detail,"prefetch","")); replacement["ON_DEMAND"]=self~csv(self~field(detail,"onDemand",""))
+      next=.array~new; found=.false; do row over states; if row["stateId"]=sid then do; next~append(replacement); found=.true; end; else next~append(row); end; if \found then next~append(replacement); spec["states"]=next
+      fromState=self~field(detail,"fromState","")~string~strip; toState=self~field(detail,"toState","")~string~strip
+      if fromState<>"" | toState<>"" then do
+        if fromState="" | toState="" then return .nil
+        transitions=.WireUIDesignUtil~copyArray(self~field(spec,"transitions",.array~new))
+        tr=.table~new; tr["fromState"]=fromState; tr["toState"]=toState; tr["trigger"]=self~field(detail,"trigger","")~string~strip; tr["purpose"]=self~field(detail,"purpose","")~string~strip
+        tr["whenMode"]=self~field(detail,"transitionWhenMode","ALL")~string~strip~translate; tr["whenConditionIds"]=self~csv(self~field(detail,"transitionWhenConditionIds","")); tr["suppressConditionIds"]=self~csv(self~field(detail,"transitionSuppressConditionIds",""))
+        tn=.array~new; tf=.false
+        do oldtr over transitions
+          same=self~field(oldtr,"fromState","")=fromState & self~field(oldtr,"toState","")=toState & self~field(oldtr,"trigger","")=tr["trigger"]
+          if same then do; tn~append(tr); tf=.true; end; else tn~append(oldtr)
+        end
+        if \tf then tn~append(tr)
+        spec["transitions"]=tn
+      end
+    end
+    when action="DESIGN.CONDITION.DRAFT" then do
+      do k over .array~of("sourceKind","sourceRef","operator","authorityRef"); spec[k]=self~field(detail,k,""); end
+      if self~field(detail,"expectedValue","")<>"" then spec["expectedValue"]=self~field(detail,"expectedValue","")
+    end
+    when action="DESIGN.PRESENTATION_POLICY.DRAFT" then do
+      prior=targetProject~draft("PRESENTATION_POLICY",id); precedence=.array~new; capacities=.table~new
+      if prior<>.nil then do; precedence=.WireUIDesignUtil~copyArray(self~field(prior~spec,"precedence",.array~new)); capacities=.WireUIDesignUtil~copyTable(self~field(prior~spec,"capacities",.table~new)); end
+      if self~field(detail,"precedence","")<>"" then precedence=self~csv(self~field(detail,"precedence",""))
+      region=self~field(detail,"region","")~string~strip; if region<>"" then capacities[region]=self~numberOr(self~field(detail,"capacity",""),1)
+      spec["precedence"]=precedence; spec["capacities"]=capacities
+    end
+    when action="DESIGN.COMPOSITION.DRAFT" then do
+      do k over .array~of("journeyId","profile","stateId","layoutModel","presentationPolicyId","presentationPolicyVersion"); spec[k]=self~field(detail,k,""); end
+      placements=.array~new; prior=targetProject~draft("COMPOSITION",id)
+      if prior<>.nil then placements=.WireUIDesignUtil~copyArray(prior~spec["placements"])
+      replacement=.table~new
+      replacement["elementId"]=self~field(detail,"elementId",""); if replacement["elementId"]="" then return .nil
+      replacement["projectionId"]=self~field(detail,"projectionId","")
+      replacement["region"]=self~field(detail,"region","main"); replacement["order"]=self~numberOr(self~field(detail,"order",""),0)
+      replacement["span"]=self~numberOr(self~field(detail,"span",""),12); replacement["rowSpan"]=self~numberOr(self~field(detail,"rowSpan",""),1)
+      replacement["align"]=self~field(detail,"align","STRETCH"); replacement["viewportClass"]=self~field(detail,"viewportClass","DEFAULT"); replacement["whenMode"]=self~field(detail,"whenMode","ALL"); replacement["whenConditionIds"]=self~csv(self~field(detail,"whenConditionIds","")); replacement["suppressConditionIds"]=self~csv(self~field(detail,"suppressConditionIds","")); replacement["presentationClass"]=self~field(detail,"presentationClass","STANDARD")
+      next=.array~new; found=.false
+      do row over placements
+        same=row["elementId"]=replacement["elementId"] & self~field(row,"projectionId","")=replacement["projectionId"] & self~field(row,"viewportClass","DEFAULT")=replacement["viewportClass"]
+        if same then do; next~append(replacement); found=.true; end; else next~append(row)
+      end
+      if \found then next~append(replacement)
+      spec["placements"]=next
+    end
+    when action="DESIGN.EXPERIMENT.DRAFT" then do
+      spec["targetElementId"]=self~field(detail,"targetElementId",""); vars=.array~new
+      a=.table~new; a["variantId"]="A"; a["weight"]=50; a["projectionId"]=self~field(detail,"variantAProjectionId",""); vars~append(a)
+      b=.table~new; b["variantId"]="B"; b["weight"]=50; b["projectionId"]=self~field(detail,"variantBProjectionId",""); vars~append(b)
+      spec["variants"]=vars
+    end+    otherwise return .nil
+  end
+  payload=.table~new; payload["artifactId"]=id; payload["spec"]=spec; return payload
+
+::method refreshSourceWindow private
+  expose sourceCatalogue sourceWorkspaceRef sourceWindowRevision sourceWindowOffset sourceWindowLimit sourceFilter sourceSortRef sourceSortDirection
+  use arg requestedOffset=0, requestedLimit=25, emitPatch=.true
+  paths=self~sourceWindowPaths
+  total=paths~items
+  requestedLimit=max(5,min(100,requestedLimit+0))
+  requestedOffset=max(0,requestedOffset+0)
+  if total=0 then requestedOffset=0
+  else if requestedOffset>=total then requestedOffset=max(0,total-requestedLimit)
+  sourceWindowOffset=requestedOffset; sourceWindowLimit=requestedLimit
+  rows=.array~new
+  last=min(total,requestedOffset+requestedLimit)
+  if last>0 then do i=requestedOffset+1 to last
+    path=paths[i]
+    slots=.table~new; slots["label"]=path; slots["visible"]=.true; slots["action"]="SOURCE.OPEN"
+    row=.table~new; row["instanceId"]="source-row-".WireUIDesignUtil~token(path); row["definitionKey"]="WUIB_SOURCE_ROW@1"; row["slots"]=slots
+    rows~append(row)
+  end
+  sourceWindowRevision+=1
+  anchor=""; if rows~items>0 then anchor=rows[1]["slots"]["label"]
+  window=.WireUICollectionWindow~new("source-files",requestedOffset,requestedLimit,total,sourceSortRef":"sourceSortDirection,sourceFilter,sourceWindowRevision,anchor)
+  if emitPatch then r=self~reconcileCollectionWindow("source-files",rows,window)
+  else r=self~view~reconcileCollectionWindow("source-files",rows,window)
+  if \r~ok then return r
+  do row over rows; self~view~setActionAvailable(row["instanceId"],"SOURCE.OPEN",.true); end
+  return .WireUIResult~success(window~asWire,"BUILDER_SOURCE_WINDOW_RECONCILED")
+
+::method sourceWindowPaths private
+  expose sourceCatalogue sourceFilter sourceSortDirection
+  out=.array~new
+  if sourceCatalogue==.nil then return out
+  wanted=sourceFilter~string~translate
+  do sourceFile over sourceCatalogue~files
+    path=sourceFile~path
+    if wanted<>"" & pos(wanted,path~translate)=0 then iterate
+    out~append(path)
+  end
+  out~sort
+  if sourceSortDirection="DESC" then do
+    reversed=.array~new
+    do i=out~items to 1 by -1; reversed~append(out[i]); end
+    out=reversed
+  end
+  return out
+
+::method populateArtifactEditor private
+  expose targetProject
+  use arg item
+  kind=self~field(item,"kind",""); artifactId=self~field(item,"artifactId","")
+  draft=targetProject~draft(kind,artifactId); if draft==.nil then return .false
+  spec=draft~spec; pv=self~field(spec,"publishVersion","")
+  select
+    when kind="COMPONENT" then do
+      ignore=self~setEditorValues("componentEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"primitive",self~field(spec,"primitive","")))
+    end
+    when kind="ELEMENT" then do
+      ignore=self~setEditorValues("elementEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"semanticType",self~field(spec,"semanticType",""),"fields",self~join(self~field(spec,"fields",.array~new),","),"actions",self~join(self~field(spec,"actions",.array~new),","),"audiencePolicyRef",self~field(spec,"audiencePolicyRef","PUBLIC")))
+    end
+    when kind="PROJECTION" then do
+      values=.array~of("artifactId",artifactId,"publishVersion",pv,"profile",self~field(spec,"profile",""),"elementId",self~field(spec,"elementId",""),"componentId",self~field(spec,"componentId",""),"definitionId",self~field(spec,"definitionId",""),"action",self~field(spec,"action",""),"styleRole",self~field(spec,"styleRole",""),"materialRole",self~field(spec,"materialRole",""))
+      resources=self~field(spec,"resourceBindings",.array~new)
+      if resources~items>0 then do
+        rb=resources[1]; rr=self~field(rb,"resourceRef",.nil)
+        if rr<>.nil then do
+          values~append("resourceRole"); values~append(self~field(rb,"role","PRIMARY_CONTENT"))
+          values~append("resourceId"); values~append(self~field(rr,"resourceId",""))
+          values~append("resourceVersion"); values~append(self~field(rr,"version",""))
+          values~append("resourceContentAddress"); values~append(self~field(rr,"contentAddress",""))
+          values~append("resourceClass"); values~append(self~field(rr,"resourceClass",""))
+          values~append("resourceLocale"); values~append(self~field(rr,"locale",""))
+        end
+      end
+      rc=self~field(spec,"rowContract",.nil)
+      if rc<>.nil then do
+        values~append("rowCollectionSlot"); values~append(self~field(rc,"collectionSlot",""))
+        values~append("rowCountSlot"); values~append(self~field(rc,"countSlot",""))
+        values~append("rowIdentityField"); values~append(self~field(rc,"identityField",""))
+        values~append("rowFields"); values~append(self~join(self~field(rc,"rowFields",.array~new),","))
+        values~append("rowSelectionMode"); values~append(self~field(rc,"selectionMode","NONE"))
+        values~append("rowSelectedIdsSlot"); values~append(self~field(rc,"selectedIdsSlot","selectedIds"))
+        values~append("rowWorkspaceContextSlot"); values~append(self~field(rc,"workspaceContextSlot","workspaceContext"))
+        values~append("rowEmptyPolicy"); values~append(self~field(rc,"emptyPolicy","ALLOW_EMPTY"))
+        values~append("rowFilterFields"); values~append(self~join(self~field(rc,"filterFields",.array~new),","))
+        values~append("rowSortFields"); values~append(self~join(self~field(rc,"sortFields",.array~new),","))
+        values~append("rowAction"); values~append(self~field(rc,"rowAction",""))
+        values~append("rowSelectionAction"); values~append(self~field(rc,"selectionAction",""))
+        values~append("rowFilterAction"); values~append(self~field(rc,"filterAction",""))
+        values~append("rowSortAction"); values~append(self~field(rc,"sortAction",""))
+      end
+      ignore=self~setEditorValues("projectionEdit",values)
+    end
+    when kind="MATERIAL" then do
+      tokens=self~field(spec,"tokens",.table~new); tokenName=""; tokenValue=""
+      keys=tokens~allIndexes; keys~sort
+      if keys~items>0 then do; tokenName=keys[1]; tokenValue=tokens[tokenName]; end
+      ignore=self~setEditorValues("materialEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"tokenName",tokenName,"tokenValue",tokenValue))
+    end
+    when kind="JOURNEY" then do
+      fid=""; fis=""; sid=""; active=""; prefetch=""; onDemand=""; fromState=""; toState=""; trigger=""; purpose=""; transitionWhenMode="ALL"; transitionWhenConditionIds=""; transitionSuppressConditionIds=""
+      flows=self~field(spec,"flows",.array~new); if flows~items>0 then do; fid=self~field(flows[1],"flowId",""); fis=self~field(flows[1],"initialState",""); end
+      states=self~field(spec,"states",.array~new); if states~items>0 then do; st=states[1]; sid=self~field(st,"stateId",""); if fid="" then fid=self~field(st,"flowId",""); active=self~join(self~field(st,"ACTIVE",.array~new),","); prefetch=self~join(self~field(st,"PREFETCH",.array~new),","); onDemand=self~join(self~field(st,"ON_DEMAND",.array~new),","); end
+      transitions=self~field(spec,"transitions",.array~new); if transitions~items>0 then do; tr=transitions[1]; fromState=self~field(tr,"fromState",""); toState=self~field(tr,"toState",""); trigger=self~field(tr,"trigger",""); purpose=self~field(tr,"purpose",""); transitionWhenMode=self~field(tr,"whenMode","ALL"); transitionWhenConditionIds=self~join(self~field(tr,"whenConditionIds",.array~new),","); transitionSuppressConditionIds=self~join(self~field(tr,"suppressConditionIds",.array~new),","); end
+      ignore=self~setEditorValues("journeyEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"initialState",self~field(spec,"initialState",""),"initialFlowId",self~field(spec,"initialFlowId",""),"flowId",fid,"flowInitialState",fis,"stateId",sid,"active",active,"prefetch",prefetch,"onDemand",onDemand,"fromState",fromState,"toState",toState,"trigger",trigger,"purpose",purpose,"transitionWhenMode",transitionWhenMode,"transitionWhenConditionIds",transitionWhenConditionIds,"transitionSuppressConditionIds",transitionSuppressConditionIds))
+    end
+    when kind="CONDITION" then do
+      ignore=self~setEditorValues("conditionEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"sourceKind",self~field(spec,"sourceKind",""),"sourceRef",self~field(spec,"sourceRef",""),"operator",self~field(spec,"operator",""),"expectedValue",self~field(spec,"expectedValue",""),"authorityRef",self~field(spec,"authorityRef","")))
+    end
+    when kind="PRESENTATION_POLICY" then do
+      capacities=self~field(spec,"capacities",.table~new); region=""; capacity=""; keys=capacities~allIndexes; keys~sort; if keys~items>0 then do; region=keys[1]; capacity=capacities[region]; end
+      ignore=self~setEditorValues("policyEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"precedence",self~join(self~field(spec,"precedence",.array~new),","),"region",region,"capacity",capacity))
+    end
+    when kind="EXPERIMENT" then do
+      a=""; b=""; do variant over self~field(spec,"variants",.array~new); if self~field(variant,"variantId","")="A" then a=self~field(variant,"projectionId",""); if self~field(variant,"variantId","")="B" then b=self~field(variant,"projectionId",""); end
+      ignore=self~setEditorValues("experimentEdit",.array~of("artifactId",artifactId,"publishVersion",pv,"targetElementId",self~field(spec,"targetElementId",""),"variantAProjectionId",a,"variantBProjectionId",b))
+    end
+    otherwise nop
+  end
+  return .true
+
+::method setEditorValues private
+  use arg prefix,pairs
+  updates=.table~new
+  do i=1 to pairs~items by 2; updates[prefix"."pairs[i]]=pairs[i+1]; end
+  r=self~mutateStateGroup(updates)
+  return r~ok
+
+::method artifactKindsForState private
+  use arg stateId="DESIGN"
+  stateId=stateId~string~translate
+  select
+    when stateId="COMPONENTS" then return .set~of("COMPONENT","ELEMENT","PROJECTION")
+    when stateId="MATERIALS" then return .set~of("MATERIAL")
+    when stateId="FLOW" then return .set~of("JOURNEY","CONDITION","PRESENTATION_POLICY","EXPERIMENT")
+    otherwise return .nil
+  end
+
+::method refreshDesignCollections private
+  expose targetProject studioState
+  stateId=self~currentPreviewState
+  updates=.table~new
+  updates["projectRevision"]=targetProject~revision
+  updates["projectDraftCount"]=targetProject~drafts~items
+  updates["artifactLibraryItems"]=self~artifactLibraryItems(studioState)
+  updates["flowMapItems"]=self~flowMapItems
+  preview=self~previewStateUpdates("HUMAN_VISUAL",stateId,"DEFAULT","","")
+  do key over preview~allIndexes; updates[key]=preview[key]; end
+  r=self~mutateStateGroup(updates)
+  return r~ok
+
+::method artifactLibraryItems private
+  expose targetProject studioState
+  use arg stateId=""
+  if stateId="" then stateId=studioState
+  kinds=self~artifactKindsForState(stateId)
+  out=.array~new
+  do draft over targetProject~drafts
+    if kinds<>.nil then if \kinds~hasIndex(draft~kind) then iterate
+    item=.table~new; item["id"]=draft~key; item["kind"]=draft~kind; item["artifactId"]=draft~artifactId
+    item["draftRevision"]=draft~draftRevision; item["publishVersion"]=self~field(draft~spec,"publishVersion","")
+    out~append(item)
+  end
+  return out
+
+::method artifactLibraryItem private
+  use arg itemId
+  do item over self~artifactLibraryItems("DESIGN")
+    if item["id"]=itemId then return item
+  end
+  return .nil
+
+::method flowMapItems private
+  expose targetProject
+  out=.array~new
+  do draft over targetProject~drafts
+    if draft~kind<>"JOURNEY" then iterate
+    spec=draft~spec; transitions=self~field(spec,"transitions",.array~new)
+    do state over self~field(spec,"states",.array~new)
+      sid=self~field(state,"stateId",""); next=.array~new; branchLabels=.array~new; conditionalBranchCount=0; branchCount=0
+      do tr over transitions
+        if self~field(tr,"fromState","")<>sid then iterate
+        branchCount+=1; target=self~field(tr,"toState",""); next~append(target)
+        whenIds=self~field(tr,"whenConditionIds",.array~new); suppressIds=self~field(tr,"suppressConditionIds",.array~new)
+        conditional=(whenIds~items>0 | suppressIds~items>0)
+        label=self~field(tr,"trigger",""); if label="" then label="transition"
+        if conditional then do
+          conditionalBranchCount+=1; condText=self~join(whenIds,"+"); if condText="" then condText="conditional"
+          if suppressIds~items>0 then condText ||= " / suppress:"self~join(suppressIds,"+")
+          label ||= " ? "condText
+        end
+        label ||= " → "target; branchLabels~append(label)
+      end
+      conditionalPlacementCount=0; conditionalPlacementConditions=.array~new
+      do placement over self~compositionCanvasItems("",sid,"DEFAULT")
+        wc=self~field(placement,"whenConditionIds",""); sc=self~field(placement,"suppressConditionIds","")
+        if wc<>"" | sc<>"" then do
+          conditionalPlacementCount+=1; label=self~field(placement,"elementId","")
+          if wc<>"" then label ||= " ? "wc
+          if sc<>"" then label ||= " / suppress:"sc
+          conditionalPlacementConditions~append(label)
+        end
+      end
+      item=.table~new; item["id"]=draft~artifactId"|"sid; item["journeyId"]=draft~artifactId; item["stateId"]=sid; item["flowId"]=self~field(state,"flowId","")
+      active=self~field(state,"ACTIVE",.array~new); prefetch=self~field(state,"PREFETCH",.array~new); onDemand=self~field(state,"ON_DEMAND",.array~new)
+      item["activeCount"]=active~items; item["prefetchCount"]=prefetch~items; item["onDemandCount"]=onDemand~items
+      item["activeElements"]=self~join(active,","); item["prefetchElements"]=self~join(prefetch,","); item["layoutSignature"]=self~flowLayoutSignature(sid)
+      item["branchCount"]=branchCount; item["conditionalBranchCount"]=conditionalBranchCount; item["branches"]=self~join(branchLabels," | ")
+      item["conditionalPlacementCount"]=conditionalPlacementCount; item["conditionalPlacements"]=self~join(conditionalPlacementConditions," | ")
+      item["nextStates"]=self~join(next," → "); if item["nextStates"]="" then item["nextStates"]="END"
+      out~append(item)
+    end
+  end
+  return out
+
+::method flowLayoutSignature private
+  use arg stateId
+  text=""
+  do item over self~compositionCanvasItems("",stateId,"DEFAULT")
+    part=self~field(item,"region","main")"~"self~field(item,"span",12)"~"self~field(item,"elementId","")"~"self~field(item,"align","STRETCH")
+    if text<>"" then text ||= "|"
+    text ||= part
+  end
+  return text
+
+::method flowMapItem private
+  use arg itemId
+  do item over self~flowMapItems
+    if item["id"]=itemId then return item
+  end
+  return .nil
+
+::method placementKey private
+  use arg item
+  return self~field(item,"elementId","")"|"self~field(item,"projectionId","")"|"self~field(item,"viewportClass","DEFAULT")
+
+::method compositionCanvasItems private
+  expose targetProject
+  use arg profile="",stateId="",viewportClass="DEFAULT"
+  out=.array~new
+  do draft over targetProject~drafts
+    if draft~kind<>"COMPOSITION" then iterate
+    spec=draft~spec
+    if profile<>"" & self~field(spec,"profile","")<>profile then iterate
+    if stateId<>"" & self~field(spec,"stateId","")<>stateId then iterate
+    do placement over self~field(spec,"placements",.array~new)
+      vp=self~field(placement,"viewportClass","DEFAULT")
+      if viewportClass<>"" & vp<>"DEFAULT" & vp<>viewportClass then iterate
+      item=.table~new
+      item["id"]=draft~artifactId"|"self~field(spec,"stateId","")"|"vp"|"placement["elementId"]"|"self~field(placement,"projectionId","")
+      item["artifactId"]=draft~artifactId; item["publishVersion"]=self~field(spec,"publishVersion",""); item["journeyId"]=self~field(spec,"journeyId","")
+      item["profile"]=self~field(spec,"profile",""); item["stateId"]=self~field(spec,"stateId",""); item["layoutModel"]=self~field(spec,"layoutModel","GRID12")
+      do k over .array~of("elementId","projectionId","region","order","span","rowSpan","align","viewportClass","whenMode","presentationClass"); item[k]=self~field(placement,k,""); end; item["whenConditionIds"]=self~join(self~field(placement,"whenConditionIds",.array~new),","); item["suppressConditionIds"]=self~join(self~field(placement,"suppressConditionIds",.array~new),",")
+      elementDraft=targetProject~draft("ELEMENT",item["elementId"]); item["semanticType"]=""
+      if elementDraft<>.nil then item["semanticType"]=self~field(elementDraft~spec,"semanticType","")
+      out~append(item)
+    end
+  end
+  return out
+
+::method compositionCanvasItem private
+  use arg itemId
+  do item over self~compositionCanvasItems("","","")
+    if item["id"]=itemId then return item
+  end
+  return .nil
+
+::method previewStateUpdates private
+  expose targetProject lastPublished
+  use arg profile="HUMAN_VISUAL",stateId="",viewportClass="DEFAULT",experimentId="",variantId=""
+  if profile="" then profile="HUMAN_VISUAL"
+  if viewportClass="" then viewportClass="DEFAULT"
+  if stateId="" then stateId=self~defaultTargetJourneyState
+  mode="DRAFT"; activeText=""; variantText=variantId; count=0
+  if lastPublished<>.nil then do
+    pkg=lastPublished["package"]; release=lastPublished["release"]
+    if stateId="" then do
+      do plan over pkg~journeyPlans
+        if plan["profile"]=profile then do; stateId=plan["initialState"]; leave; end
+      end
+    end
+    if stateId<>"" then do
+      scenario=.WireUIPreviewScenario~new("BUILDER_PREVIEW","1","builder-preview",.true,profile,stateId,release~ref)
+      if experimentId<>"" & variantId<>"" then scenario~assignExperiment(experimentId,variantId)
+      scenario~seal
+      pr=.WireUICompiler~new~previewManifest(targetProject~workspace,pkg,scenario)
+      if pr~ok then do
+        mode="PUBLISHED"; manifest=pr~value; count=manifest["compositions"]~items
+        defs=.array~new; do d over manifest["ACTIVEDefinitions"]; defs~append(d["definitionKey"]); end
+        activeText=self~join(defs,", ")
+        resolved=manifest["resolvedExperiments"]; if experimentId<>"" & resolved~hasIndex(experimentId) then variantText=resolved[experimentId]
+      end
+    end
+  end
+  if mode="DRAFT" then count=self~compositionCanvasItems(profile,stateId,viewportClass)~items
+  updates=.table~new
+  updates["previewMode"]=mode; updates["previewProfile"]=profile; updates["previewJourneyState"]=stateId
+  updates["previewViewportClass"]=viewportClass; updates["previewVariant"]=variantText; updates["previewCompositionCount"]=count; updates["previewActiveDefinitions"]=activeText
+  updates["compositionCanvasItems"]=self~compositionCanvasItems(profile,stateId,viewportClass)
+  return updates
+
+::method refreshPreview private
+  use arg profile="HUMAN_VISUAL",stateId="",viewportClass="DEFAULT",experimentId="",variantId=""
+  r=self~mutateStateGroup(self~previewStateUpdates(profile,stateId,viewportClass,experimentId,variantId))
+  if \r~ok then return r
+  return .WireUIResult~success(.true,"BUILDER_PREVIEW_CONFIGURED")
+
+::method defaultTargetJourneyState private
+  expose targetProject
+  do draft over targetProject~drafts
+    if draft~kind="JOURNEY" then return self~field(draft~spec,"initialState","")
+  end
+  return ""
+
+::method currentPreviewState private
+  state=self~defaultTargetJourneyState
+  instance=self~view~instance("preview-summary")
+  if instance<>.nil then do
+    slots=self~field(instance,"slots",.nil)
+    if slots<>.nil then do
+      current=self~field(slots,"journeyState","")~string~strip
+      if current<>"" then state=current
+    end
+  end
+  return state
+
+::method numberOr private
+  use arg value,default
+  if value==.nil | value~string~strip="" then return default
+  return value+0
+
+::method join private
+  use arg values,separator=", "
+  text=""; do v over values; if text<>"" then text ||= separator; text ||= v~string; end; return text
+
+::method csv private
+  use arg text
+  out=.array~new; text=text~string
+  do while text<>""
+    parse var text item "," text
+    item=item~strip; if item<>"" then out~append(item)
+  end
+  return out
+::method detailOf private
+  use arg message
+  if message<>.nil & message~hasIndex("detail") & message["detail"]<>.nil then return message["detail"]
+  return .directory~new
+::method field private
+  use arg t,k,default=.nil
+  if t<>.nil & t~hasIndex(k) then return t[k]
+  return default
+
+::class WireUIBuilderStateGroupProjector public
+::method call
+  use arg state,changedKeys
+  output=.table~new
+  do key over changedKeys
+    target=""; slot=""
+    select
+      when key="projectRevision" then do; target="project"; slot="revision"; end
+      when key="projectDraftCount" then do; target="project"; slot="draftCount"; end
+      when key="artifactLibraryItems" then do; target="artifact-library"; slot="items"; end
+      when key="flowMapItems" then do; target="flow-map"; slot="items"; end
+      when key="selectionKind" then do; target="selection-inspector"; slot="kind"; end
+      when key="selectionArtifactId" then do; target="selection-inspector"; slot="artifactId"; end
+      when key="selectionDraftRevision" then do; target="selection-inspector"; slot="draftRevision"; end
+      when key="selectionPublishVersion" then do; target="selection-inspector"; slot="publishVersion"; end
+      when key="selectionDetail" then do; target="selection-inspector"; slot="detail"; end
+      when key="sourceDetailPath" then do; target="source-detail"; slot="path"; end
+      when key="sourceDetailClasses" then do; target="source-detail"; slot="classes"; end
+      when key="sourceDetailMethods" then do; target="source-detail"; slot="methods"; end
+      when key="sourceDetailAttributes" then do; target="source-detail"; slot="attributes"; end
+      when key="sourceDetailConstants" then do; target="source-detail"; slot="constants"; end
+      when key="sourceDetailRequires" then do; target="source-detail"; slot="requires"; end
+      when key="sourceDetailPackageOptions" then do; target="source-detail"; slot="packageOptions"; end
+      when key="sourceDetailQueryRevision" then do; target="source-detail"; slot="queryRevision"; end
+      when key="sourceDetailScopeRevision" then do; target="source-detail"; slot="scopeRevision"; end
+      when key="sourceDetailSelectionRevision" then do; target="source-detail"; slot="selectionRevision"; end
+      when key="sourceDetailVisible" then do; target="source-detail"; slot="visible"; end
+      when key="compositionCanvasItems" then do; target="composition-canvas"; slot="items"; end
+      when key="previewMode" then do; target="preview-summary"; slot="mode"; end
+      when key="previewProfile" then do; target="preview-summary"; slot="profile"; end
+      when key="previewJourneyState" then do; target="preview-summary"; slot="journeyState"; end
+      when key="previewViewportClass" then do; target="preview-summary"; slot="viewportClass"; end
+      when key="previewVariant" then do; target="preview-summary"; slot="variant"; end
+      when key="previewCompositionCount" then do; target="preview-summary"; slot="compositionCount"; end
+      when key="previewActiveDefinitions" then do; target="preview-summary"; slot="activeDefinitions"; end
+      otherwise do
+        dot=pos(".",key)
+        if dot>1 then do
+          prefix=key~left(dot-1); slot=key~substr(dot+1)
+          select
+            when prefix="sourceControl" then target="source-window-control"
+            when prefix="compositionEdit" then target="composition-editor"
+            when prefix="componentEdit" then target="component-editor"
+            when prefix="elementEdit" then target="element-editor"
+            when prefix="projectionEdit" then target="projection-editor"
+            when prefix="materialEdit" then target="material-editor"
+            when prefix="journeyEdit" then target="journey-editor"
+            when prefix="conditionEdit" then target="condition-editor"
+            when prefix="policyEdit" then target="presentation-policy-editor"
+            when prefix="experimentEdit" then target="experiment-editor"
+            otherwise do; target=""; slot=""; end
+          end
+        end
+      end
+    end
+    if target<>"" & state~hasIndex(key) then do
+      slots=output[target]
+      if slots==.nil then do; slots=.table~new; output[target]=slots; end
+      slots[slot]=state[key]
+    end
+  end
+  return output
+
+::class WireUIBuilderRuntimeFactory public
+::method build class
+  use arg targetProject, sourceCatalogue=.nil, applicationId="WIRE-UI-BUILDER", sessionId="BUILDER-SESSION", accessPointId="BUILDER-WEB", studioPackage=.nil
+  if studioPackage==.nil then do
+    studio=.WireUIBuilderStudioFixture~build(sourceCatalogue)
+    pub=studio~publish("WIRE_UI_BUILDER_STUDIO","0.11"); if \pub~ok then return pub
+    studioPackage=pub~value["package"]
+  end
+  else if studioPackage~isA(.String) then studioPackage=.json~fromJsonFile(studioPackage)
+  catalogue=.WireUICompiledCatalogue~new(studioPackage)
+  view=.WireUIView~new("WireUI.Builder.Studio","root"); projection=.WireUIProjection~new
+  app=.WireUIBuilderApplication~new(applicationId,sessionId,accessPointId,view,projection,targetProject,sourceCatalogue)
+  bound=app~bindCompiledRelease(catalogue,.WireUIProtocol~PROFILE_HUMAN_VISUAL,"DESIGN"); if \bound~ok then return bound
+  installed=app~installInitialView; if \installed~ok then return installed
+  return .WireUIResult~success(app,"WIRE_UI_BUILDER_APPLICATION_READY")
+
+::routine must
+  use arg r
+  if \r~ok then raise syntax 88.900 array(r~code,r~detail)
+  return r
+::requires "json.cls"
+::requires "WireUIAll.cls"
+::requires "WireUICompiledCatalogue.cls"
+::requires "WireUIBuilderStudioFixture.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/run_builder_studio.sh b/wire_ui_builder_v0.12-dev2-readiness/run_builder_studio.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b10852806281cc0d938b838ed4852609d4e3fdee
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/run_builder_studio.sh
@@ -0,0 +1,135 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+SEARCH_ROOT="$(pwd)"
+ROLLUP=""
+SERVER_ZIP=""
+RUNTIME_DIR=""
+OOREXX_HOME_ARG="${OOREXX_HOME:-}"
+OOREXX_DEB=""
+HOST_ARGS=()
+
+usage(){ cat <<'TXT'
+Wire UI Builder Studio v0.12-dev1 live launcher
+
+Usage:
+  ./run_builder_studio.sh [runtime options] [--port 8765] [--open]
+
+Runtime options (normally auto-detected):
+  --runtime-dir DIR    directory containing extracted dependency packages/zips
+  --rollup ZIP         oorexxapis roll-up containing Queue Fabric/JS dependencies
+  --server-zip ZIP     wire_ui_server_v0.17 zip when not already extracted
+  --oorexx-home DIR    ooRexx installation root (default: OOREXX_HOME or /usr/local)
+  --oorexx-deb DEB     ooRexx 5.3.0 r13196 .deb; extracted privately if not installed
+
+Host options passed through:
+  --host HOST          default 127.0.0.1
+  --port PORT          default 8765; use 0 for an ephemeral port
+  --open               open the resulting URL with the desktop browser
+  --json               keep startup output machine-friendly
+
+No Python application server is used. The live runtime is:
+  ooRexx -> WireUIServer v0.17 -> Queue Fabric -> Web Gateway v0.2 -> JS v0.4-dev5-row1
+TXT
+}
+
+while (($#)); do
+  case "$1" in
+    --runtime-dir) RUNTIME_DIR="$2"; shift 2;;
+    --rollup) ROLLUP="$2"; shift 2;;
+    --server-zip) SERVER_ZIP="$2"; shift 2;;
+    --oorexx-home) OOREXX_HOME_ARG="$2"; shift 2;;
+    --oorexx-deb) OOREXX_DEB="$2"; shift 2;;
+    --host|--port) HOST_ARGS+=("$1" "$2"); shift 2;;
+    --open|--json) HOST_ARGS+=("$1"); shift;;
+    -h|--help) usage; exit 0;;
+    *) echo "Unknown option: $1" >&2; usage >&2; exit 2;;
+  esac
+done
+
+TMP="$(mktemp -d "${TMPDIR:-/tmp}/wire-ui-builder-v08.XXXXXX")"
+cleanup(){ rm -rf "$TMP"; }
+trap cleanup EXIT INT TERM
+
+candidate_roots=("$ROOT" "$(dirname "$ROOT")" "$SEARCH_ROOT")
+[[ -n "$RUNTIME_DIR" ]] && candidate_roots=("$RUNTIME_DIR" "${candidate_roots[@]}")
+
+find_dir(){
+  local name="$1" base hit
+  for base in "${candidate_roots[@]}"; do
+    [[ -d "$base" ]] || continue
+    hit="$(find "$base" -maxdepth 5 -type d -name "$name" -exec sh -c 'test -d "$1/src" && printf "%s\n" "$1"' sh {} \; 2>/dev/null | head -1 || true)"
+    [[ -n "$hit" ]] && { printf '%s\n' "$hit"; return 0; }
+  done
+  return 1
+}
+find_zip(){
+  local pattern="$1" base hit
+  for base in "${candidate_roots[@]}"; do
+    [[ -d "$base" ]] || continue
+    hit="$(find "$base" -maxdepth 2 -type f -name "$pattern" -print -quit 2>/dev/null || true)"
+    [[ -n "$hit" ]] && { printf '%s\n' "$hit"; return 0; }
+  done
+  return 1
+}
+extract_zip(){
+  local zip="$1" name="$2"
+  local dest="$TMP/$name"
+  mkdir -p "$dest"; unzip -q "$zip" -d "$dest"
+  local hit="$(find "$dest" -maxdepth 4 -type d -name "$name" -exec sh -c 'test -d "$1/src" && printf "%s\n" "$1"' sh {} \; | head -1)"
+  [[ -n "$hit" ]] || { echo "Archive $zip does not contain $name" >&2; return 1; }
+  printf '%s\n' "$hit"
+}
+ensure_rollup(){
+  if [[ -z "$ROLLUP" ]]; then ROLLUP="$(find_zip 'oorexxapis*.zip' || true)"; fi
+  [[ -n "$ROLLUP" && -f "$ROLLUP" ]] || return 1
+}
+resolve_pkg(){
+  local name="$1" dir zip inner
+  dir="$(find_dir "$name" || true)"; [[ -n "$dir" ]] && { printf '%s\n' "$dir"; return; }
+  zip="$(find_zip "$name*.zip" || true)"; [[ -n "$zip" ]] && { extract_zip "$zip" "$name"; return; }
+  if ensure_rollup; then
+    inner="$TMP/$name.zip"
+    if unzip -p "$ROLLUP" "current/$name.zip" >"$inner" 2>/dev/null && [[ -s "$inner" ]]; then extract_zip "$inner" "$name"; return; fi
+  fi
+  echo "Missing exact runtime package $name" >&2
+  exit 3
+}
+
+SERVER_ROOT="$(find_dir wire_ui_server_v0.17 || true)"
+if [[ -z "$SERVER_ROOT" ]]; then
+  [[ -n "$SERVER_ZIP" ]] || SERVER_ZIP="$(find_zip 'wire_ui_server_v0.17*.zip' || true)"
+  [[ -n "$SERVER_ZIP" && -f "$SERVER_ZIP" ]] || { echo 'Missing wire_ui_server_v0.16. Supply --server-zip or an extracted server directory.' >&2; exit 3; }
+  SERVER_ROOT="$(extract_zip "$SERVER_ZIP" wire_ui_server_v0.17)"
+fi
+QF_ROOT="$(resolve_pkg oorexx_queue_fabric_v0.9-dev4)"
+GATEWAY_ROOT="$(resolve_pkg oorexx_queue_fabric_web_gateway_v0.2)"
+JS_ROOT="$(resolve_pkg alchemy_wire_ui_js_v0.4-dev5-row1)"
+ALCHEMY_ROOT="$(resolve_pkg alchemy_objects_v0.8)"
+CRYPTO_ROOT="$(resolve_pkg oorexx_crypto_v0.8.3)"
+
+if [[ -n "$OOREXX_HOME_ARG" && -x "$OOREXX_HOME_ARG/bin/rexx" ]]; then
+  OOR="$OOREXX_HOME_ARG"
+elif command -v rexx >/dev/null 2>&1; then
+  REXX_BIN="$(command -v rexx)"; OOR="$(cd "$(dirname "$REXX_BIN")/.." && pwd)"
+else
+  [[ -n "$OOREXX_DEB" ]] || OOREXX_DEB="$(find_zip 'oorexx-5.3.0-13196*.deb' || true)"
+  [[ -n "$OOREXX_DEB" && -f "$OOREXX_DEB" ]] || { echo 'ooRexx 5.3.0 r13196 not found. Install it or supply --oorexx-deb.' >&2; exit 4; }
+  mkdir -p "$TMP/oorexx"; dpkg-deb -x "$OOREXX_DEB" "$TMP/oorexx"; OOR="$TMP/oorexx/usr/local"
+fi
+[[ -x "$OOR/bin/rexx" ]] || { echo "ooRexx executable not found under $OOR/bin" >&2; exit 4; }
+
+export OOREXX_HOME="$OOR"
+export WUIB_BUILDER_ROOT="$ROOT"
+export WUIB_REXX="$OOR/bin/rexx"
+export WUIB_GATEWAY_ROOT="$GATEWAY_ROOT"
+export WUIB_JS_ROOT="$JS_ROOT"
+export WIRE_UI_SERVER_SRC="$SERVER_ROOT/src"
+export QUEUE_FABRIC_SRC="$QF_ROOT/src"
+export ALCHEMY_OBJECTS_SRC="$ALCHEMY_ROOT/src"
+export OOREXX_CRYPTO_SRC="$CRYPTO_ROOT/src"
+export PATH="$ROOT/src:$ROOT/examples:$ROOT/integration:$SERVER_ROOT/src:$GATEWAY_ROOT/src:$QF_ROOT/src:$ALCHEMY_ROOT/src:$CRYPTO_ROOT/src:$OOR/bin:$PATH"
+export REXX_PATH="$ROOT/src:$ROOT/examples:$ROOT/integration:$SERVER_ROOT/src:$GATEWAY_ROOT/src:$QF_ROOT/src:$ALCHEMY_ROOT/src:$CRYPTO_ROOT/src:$OOR/bin${REXX_PATH:+:$REXX_PATH}"
+export LD_LIBRARY_PATH="$OOR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+
+exec node "$ROOT/tools/builder-live-host.mjs" "${HOST_ARGS[@]}"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/run_tests.sh b/wire_ui_builder_v0.12-dev2-readiness/run_tests.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8207c36a061a62d0fdea536944a39773a103fdd1
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/run_tests.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+: "${OOREXX_HOME:=/usr/local}"
+: "${ALCHEMY_OBJECTS_SRC:?set ALCHEMY_OBJECTS_SRC to alchemy_objects_v0.8/src}"
+: "${OOREXX_CRYPTO_SRC:?set OOREXX_CRYPTO_SRC to oorexx_crypto_v0.3/src}"
+SERVER_PATH=""
+if [[ -n "${WIRE_UI_SERVER_SRC:-}" ]]; then SERVER_PATH+=":$WIRE_UI_SERVER_SRC"; fi
+if [[ -n "${QUEUE_FABRIC_SRC:-}" ]]; then SERVER_PATH+=":$QUEUE_FABRIC_SRC"; fi
+if [[ -n "${WUIB_GATEWAY_ROOT:-}" && -d "${WUIB_GATEWAY_ROOT}/src" ]]; then SERVER_PATH+=":${WUIB_GATEWAY_ROOT}/src"; fi
+export PATH="$ROOT/src:$ROOT/examples:$ROOT/integration:$ALCHEMY_OBJECTS_SRC:$OOREXX_CRYPTO_SRC${SERVER_PATH}:$OOREXX_HOME/bin:$PATH"
+export REXX_PATH="$ROOT/src:$ROOT/examples:$ROOT/integration:$ALCHEMY_OBJECTS_SRC:$OOREXX_CRYPTO_SRC${SERVER_PATH}:$OOREXX_HOME/bin${REXX_PATH:+:$REXX_PATH}"
+export LD_LIBRARY_PATH="$OOREXX_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+cd "$ROOT/tests"
+core=(
+  test_versioning.rex test_compile_release.rex test_row_collection_contract.rex test_row_collection_project_draft.rex test_element_experiment.rex
+  test_multiuser_preview.rex test_ab_preview.rex test_preview_evidence.rex
+  test_alchemy_adoption.rex test_workspace_operations.rex test_preview_matrix.rex
+  test_render_observation.rex test_builder_action_adapter.rex test_v02_alchemy_adoption.rex
+  test_package_identity.rex test_v03_alchemy_adoption.rex test_v04_alchemy_adoption.rex
+  test_project_drafts.rex test_project_roundtrip.rex test_source_catalogue_self.rex test_source_catalogue_v031.rex
+  test_conditional_resources_flows.rex test_conditional_arbitration_model.rex test_conditional_preview_flow.rex
+  test_composition_publish.rex test_composition_move.rex test_composition_resize_relocate.rex test_composition_align.rex test_composition_experiment_preview.rex test_builder_studio_navigation.rex
+  test_builder_studio_publish.rex test_project_audit_publish.rex test_project_experiment_publish.rex
+)
+for t in "${core[@]}"; do echo "=== $t ==="; rexx "$t"; done
+
+echo "=== test_builder_web_shell.sh ==="
+"$ROOT/tests/test_builder_web_shell.sh"
+
+echo "=== test_composition_controller.mjs ==="
+node "$ROOT/tests/test_composition_controller.mjs"
+
+if [[ -n "${SSC_ROOT:-}" ]]; then
+  echo "=== test_semantic_source_control.sh ==="
+  "$ROOT/tests/test_semantic_source_control.sh"
+fi
+
+if [[ -n "${WIRE_UI_SERVER_SRC:-}" ]]; then
+  export PATH="$WIRE_UI_SERVER_SRC:$PATH"
+  echo "=== test_builder_application_self_source.rex ==="
+  (cd "$ROOT" && rexx tests/test_builder_application_self_source.rex)
+  echo "=== test_builder_application_composition.rex ==="
+  (cd "$ROOT" && rexx tests/test_builder_application_composition.rex)
+  echo "=== test_builder_visual_workspace.rex ==="
+  (cd "$ROOT" && rexx tests/test_builder_visual_workspace.rex)
+  echo "=== test_source_workspace_v016.rex ==="
+  (cd "$ROOT" && rexx tests/test_source_workspace_v016.rex)
+  echo "=== test_builder_perspective_editors.rex ==="
+  (cd "$ROOT" && rexx tests/test_builder_perspective_editors.rex)
+  echo "=== test_flow_conditional_authoring.rex ==="
+  (cd "$ROOT" && rexx tests/test_flow_conditional_authoring.rex)
+  echo "=== test_conditional_runtime_fail_closed.rex ==="
+  (cd "$ROOT" && rexx tests/test_conditional_runtime_fail_closed.rex)
+fi
+
+if [[ -n "${WIRE_UI_JS_SRC:-}" ]]; then
+  echo "=== test_studio_js.mjs ==="
+  WIRE_UI_BUILDER_STUDIO_JSON="$ROOT/studio/wire_ui_builder_studio_v0.11.json" node "$ROOT/tests/test_studio_js.mjs"
+fi
+
+if [[ -n "${WUIB_GATEWAY_ROOT:-}" && -n "${WUIB_JS_ROOT:-}" && -n "${WUIB_REXX:-}" && -n "${QUEUE_FABRIC_SRC:-}" && -n "${WIRE_UI_SERVER_SRC:-}" ]]; then
+  echo "=== test_live_studio_runtime.mjs ==="
+  WUIB_BUILDER_ROOT="$ROOT" node "$ROOT/tests/test_live_studio_runtime.mjs"
+fi
+
+if [[ -n "${WUIB_TEST_ROLLUP:-}" && -n "${WUIB_TEST_SERVER_ZIP:-}" && -n "${WUIB_TEST_OOREXX_DEB:-}" ]]; then
+  echo "=== test_live_studio_launcher.mjs ==="
+  WUIB_BUILDER_ROOT="$ROOT" node "$ROOT/tests/test_live_studio_launcher.mjs"
+fi
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderActionAdapter.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderActionAdapter.cls
new file mode 100644
index 0000000000000000000000000000000000000000..5483af2a558beda62211d4de3b7ab6abfd05047c
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderActionAdapter.cls
@@ -0,0 +1,52 @@
+/*
+  Meeting point between a Wire UI builder access point and the authoring model.
+  The owning Wire UIApplication remains responsible for authentication/authorisation.
+  This adapter only converts an already-authorised semantic action to the same
+  typed WireUIDesignOperation used by direct human/AI tooling.
+*/
+::class WireUIBuilderActionAdapter subclass AlchemyObject public
+::attribute workspace get
+::method init
+  expose workspace
+  use arg workspace
+  self~init:super(.WireUIDesignAlchemy~metadata("Wire UI semantic-action adapter for Builder authoring operations"))
+  if \workspace~isA(.WireUIDesignWorkspace) then raise syntax 93.948 array("workspace")
+::method apply
+  expose workspace
+  use arg action, detail
+  action=action~string~strip~translate
+  if detail==.nil | \(detail~isA(.Table) | detail~isA(.Directory)) then return .WireUIDesignResult~failure("BUILDER_ACTION_DETAIL_REQUIRED")
+  operationId=self~field(detail,"operationId","")
+  expected=self~field(detail,"expectedRevision",-1)
+  actorRef=self~field(detail,"actorRef","")
+  reason=self~field(detail,"reason","")
+  target=self~refFromWire(self~field(detail,"targetRef",.nil))
+  if self~field(detail,"targetRef",.nil)<>.nil & target==.nil then return .WireUIDesignResult~failure("BUILDER_TARGET_REF_INVALID")
+  payload=.WireUIDesignUtil~copyTable(self~field(detail,"payload",.nil))
+  if payload~hasIndex("componentRef") then do
+    cr=self~refFromWire(payload["componentRef"]); if cr==.nil then return .WireUIDesignResult~failure("BUILDER_COMPONENT_REF_INVALID")
+    payload["componentRef"]=cr
+  end
+  evidence=.array~new
+  rawEvidence=self~field(detail,"evidenceRefs",.nil)
+  if rawEvidence<>.nil then do r over rawEvidence
+    rr=self~refFromWire(r); if rr==.nil then return .WireUIDesignResult~failure("BUILDER_EVIDENCE_REF_INVALID")
+    evidence~append(rr)
+  end
+  if operationId="" | expected<0 then return .WireUIDesignResult~failure("BUILDER_OPERATION_ID_OR_REVISION_REQUIRED")
+  op=.WireUIDesignOperation~new(operationId,action,expected,target,payload,actorRef,reason,evidence)
+  return workspace~applyOperation(op)
+::method refFromWire private
+  use arg value
+  if value==.nil then return .nil
+  if value~isA(.WireUIArtifactRef) then return value
+  if \(value~isA(.Table) | value~isA(.Directory)) then return .nil
+  kind=self~field(value,"kind",""); id=self~field(value,"id",""); version=self~field(value,"version",""); address=self~field(value,"contentAddress","")
+  if kind="" | id="" | version="" then return .nil
+  return .WireUIArtifactRef~new(kind,id,version,address)
+::method field private
+  use arg t,k,default=.nil
+  if t==.nil then return default
+  if t~hasIndex(k) then return t[k]
+  return default
+::requires "WireUIDesignWorkspace.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderAll.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderAll.cls
new file mode 100644
index 0000000000000000000000000000000000000000..5c56830794e31dc9d6ab21a6029c3bf9bff0909b
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderAll.cls
@@ -0,0 +1,17 @@
+::requires "WireUICompiler.cls"
+::requires "WireUICompositionDesign.cls"
+::requires "WireUIPreviewEvidence.cls"
+::requires "WireUIPreviewMatrix.cls"
+::requires "WireUIRenderObservation.cls"
+::requires "WireUIDesignAssessment.cls"
+::requires "WireUIDesignProposal.cls"
+::requires "WireUIBuilderActionAdapter.cls"
+::requires "WireUIBuilderDraft.cls"
+::requires "WireUIBuilderProject.cls"
+::requires "WireUIBuilderProjectActionAdapter.cls"
+::requires "WireUISourceCatalogue.cls"
+::requires "WireUIResourceRef.cls"
+::requires "WireUIConditionDesign.cls"
+::requires "WireUIPresentationPolicy.cls"
+
+::requires "WireUIRowCollectionContract.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderDraft.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderDraft.cls
new file mode 100644
index 0000000000000000000000000000000000000000..a3f5e1fbb23f7244b84c8a8a83a986f7a527a48e
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderDraft.cls
@@ -0,0 +1,36 @@
+/* Immutable snapshot of one mutable project draft. Draft revisions are not public artifact versions. */
+::class WireUIBuilderDraft subclass AlchemyObject public
+::attribute kind get
+::attribute artifactId get
+::attribute draftRevision get
+::attribute baseRef get
+::attribute contentAddress get
+::method init
+  expose kind artifactId draftRevision baseRef spec contentAddress
+  use arg kind, artifactId, draftRevision, spec=.nil, baseRef=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Builder working draft snapshot; not a published artifact version"))
+  kind=kind~string~strip~translate; artifactId=artifactId~string~strip
+  if kind="" | artifactId="" | draftRevision<0 then raise syntax 93.906 array("builder draft",artifactId)
+  if baseRef<>.nil then if \baseRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("baseRef")
+  spec=.WireUIDesignUtil~copyTable(spec)
+  contentAddress="draft-" || .WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("artifactId","PUBLIC","stable draft artifact identity")
+  self~registerStateVariable("draftRevision","PUBLIC","project revision which produced this draft snapshot")
+  self~registerStateVariable("contentAddress","PUBLIC","tamper-evident draft snapshot address")
+::method key
+  expose kind artifactId
+  return kind":"artifactId
+::method spec
+  expose spec
+  return .WireUIDesignUtil~copyTable(spec)
+::method canonicalText
+  expose kind artifactId draftRevision baseRef spec
+  base=""; if baseRef<>.nil then base=baseRef~canonicalText
+  return kind"|"artifactId"|"draftRevision"|"base"|".WireUIDesignUtil~canonicalTable(spec)
+::method asWire
+  expose kind artifactId draftRevision baseRef spec contentAddress
+  d=.directory~new; d["kind"]=kind; d["artifactId"]=artifactId; d["draftRevision"]=draftRevision
+  if baseRef==.nil then d["baseRef"]=.nil; else d["baseRef"]=baseRef~asWire
+  d["spec"]=.WireUIDesignUtil~copyTable(spec); d["contentAddress"]=contentAddress
+  return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProject.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProject.cls
new file mode 100644
index 0000000000000000000000000000000000000000..489194fbb156124ae31b06d998ea569e6b691e10
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProject.cls
@@ -0,0 +1,491 @@
+/*
+  Consumer-neutral Builder project.
+  Many draft edits advance project revision only. Publication materialises one
+  explicit immutable artifact version per draft into WireUIDesignWorkspace.
+*/
+::class WireUIBuilderProject subclass AlchemyObject public
+::attribute projectId get
+::attribute title get
+::attribute revision get
+::attribute workspace get
+::method init
+  expose projectId title revision workspace drafts operationLog operationsById metadata
+  use arg projectId, title="", workspace=.nil, metadata=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Consumer-neutral Wire UI Builder project"))
+  projectId=projectId~string~strip; title=title~string~strip
+  if projectId="" then raise syntax 93.906 array("builder project")
+  if workspace==.nil then workspace=.WireUIDesignWorkspace~new(projectId".workspace")
+  if \workspace~isA(.WireUIDesignWorkspace) then raise syntax 93.948 array("workspace")
+  revision=0; drafts=.table~new; operationLog=.array~new; operationsById=.table~new; metadata=.WireUIDesignUtil~copyTable(metadata)
+  self~registerStateVariable("projectId","PUBLIC","stable Builder project identity")
+  self~registerStateVariable("revision","PUBLIC","mutable draft project compare-and-swap revision")
+
+::method applyOperation
+  expose revision drafts operationLog operationsById
+  use arg operation
+  if \operation~isA(.WireUIDesignOperation) then return .WireUIDesignResult~failure("INVALID_DESIGN_OPERATION")
+  oid=operation~operationId
+  if operationsById~hasIndex(oid) then do
+    prior=operationsById[oid]
+    if prior~contentAddress=operation~contentAddress then return .WireUIDesignResult~success(prior,"OPERATION_ALREADY_APPLIED")
+    return .WireUIDesignResult~failure("OPERATION_ID_CONFLICT",oid)
+  end
+  if operation~expectedRevision<>revision then return .WireUIDesignResult~failure("DESIGN_REVISION_CONFLICT",operation~expectedRevision"|"revision)
+  verb=operation~verb
+  select
+    when verb="DESIGN.COMPONENT.DRAFT" then r=self~putDraft("COMPONENT",operation)
+    when verb="DESIGN.ELEMENT.DRAFT" then r=self~putDraft("ELEMENT",operation)
+    when verb="DESIGN.MATERIAL.DRAFT" then r=self~putDraft("MATERIAL",operation)
+    when verb="DESIGN.CONDITION.DRAFT" then r=self~putDraft("CONDITION",operation)
+    when verb="DESIGN.PRESENTATION_POLICY.DRAFT" then r=self~putDraft("PRESENTATION_POLICY",operation)
+    when verb="DESIGN.PROJECTION.DRAFT" then r=self~putDraft("PROJECTION",operation)
+    when verb="DESIGN.JOURNEY.DRAFT" then r=self~putDraft("JOURNEY",operation)
+    when verb="DESIGN.COMPOSITION.DRAFT" then r=self~putDraft("COMPOSITION",operation)
+    when verb="DESIGN.COMPOSITION.MOVE" then r=self~moveComposition(operation)
+    when verb="DESIGN.COMPOSITION.RESIZE" then r=self~resizeComposition(operation)
+    when verb="DESIGN.COMPOSITION.RELOCATE" then r=self~relocateComposition(operation)
+    when verb="DESIGN.COMPOSITION.ALIGN" then r=self~alignComposition(operation)
+    when verb="DESIGN.EXPERIMENT.DRAFT" then r=self~putDraft("EXPERIMENT",operation)
+    otherwise return .WireUIDesignResult~failure("UNSUPPORTED_PROJECT_OPERATION",verb)
+  end
+  if \r~ok then return r
+  revision += 1
+  /* Re-stamp the draft with the accepted project revision. */
+  candidate=r~value
+  final=.WireUIBuilderDraft~new(candidate~kind,candidate~artifactId,revision,candidate~spec,candidate~baseRef)
+  drafts[final~key]=final
+  operationLog~append(operation); operationsById[oid]=operation
+  return .WireUIDesignResult~success(final,"PROJECT_DRAFT_APPLIED")
+
+::method putDraft private
+  expose drafts revision
+  use arg kind, operation
+  p=operation~payload
+  artifactId=self~field(p,"artifactId","")~string~strip
+  spec=self~field(p,"spec",.nil)
+  if artifactId="" then return .WireUIDesignResult~failure(kind"_DRAFT_ID_REQUIRED")
+  if spec==.nil | \(spec~isA(.Table) | spec~isA(.Directory)) then return .WireUIDesignResult~failure(kind"_DRAFT_SPEC_REQUIRED")
+  vr=self~validateSpec(kind,spec); if \vr~ok then return vr
+  baseRef=.nil; key=kind":"artifactId
+  if drafts~hasIndex(key) then baseRef=drafts[key]~baseRef
+  if p~hasIndex("baseRef") then do
+    b=p["baseRef"]
+    if b<>.nil & \b~isA(.WireUIArtifactRef) then return .WireUIDesignResult~failure("DRAFT_BASE_REF_INVALID")
+    baseRef=b
+  end
+  return .WireUIDesignResult~success(.WireUIBuilderDraft~new(kind,artifactId,revision+1,spec,baseRef),"DRAFT_READY")
+
+::method moveComposition private
+  expose drafts revision
+  use arg operation
+  p=operation~payload; artifactId=self~field(p,"artifactId","")~string~strip
+  if artifactId="" then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_ID_REQUIRED")
+  key="COMPOSITION:"artifactId
+  if \drafts~hasIndex(key) then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_NOT_FOUND",artifactId)
+  sourceKey=self~field(p,"sourcePlacementKey",""); targetKey=self~field(p,"targetPlacementKey","")
+  if sourceKey="" | targetKey="" | sourceKey=targetKey then return .WireUIDesignResult~failure("COMPOSITION_MOVE_INVALID")
+  prior=drafts[key]; spec=prior~spec; rows=self~field(spec,"placements",.array~new)
+  sourceIndex=0; targetIndex=0; i=0
+  do row over rows
+    i+=1; rk=self~placementKey(row)
+    if rk=sourceKey then sourceIndex=i
+    if rk=targetKey then targetIndex=i
+  end
+  if sourceIndex=0 | targetIndex=0 then return .WireUIDesignResult~failure("COMPOSITION_MOVE_PLACEMENT_NOT_FOUND",sourceKey"|"targetKey)
+  ordered=.array~new; moving=rows[sourceIndex]
+  do i=1 to rows~items
+    if i=sourceIndex then iterate
+    if i=targetIndex then ordered~append(moving)
+    ordered~append(rows[i])
+  end
+  if sourceIndex>targetIndex then nop
+  else if targetIndex=rows~items then do
+    /* Moving forward to the last row needs append-after, not insert-before. */
+    ordered=.array~new
+    do i=1 to rows~items
+      if i=sourceIndex then iterate
+      ordered~append(rows[i])
+    end
+    ordered~append(moving)
+  end
+  normal=.array~new; n=0
+  do row over ordered
+    n+=1; copy=.WireUIDesignUtil~copyTable(row); copy["order"]=n*10; normal~append(copy)
+  end
+  spec["placements"]=normal
+  return .WireUIDesignResult~success(.WireUIBuilderDraft~new("COMPOSITION",artifactId,revision+1,spec,prior~baseRef),"COMPOSITION_MOVED")
+
+::method resizeComposition private
+  expose drafts revision
+  use arg operation
+  p=operation~payload; artifactId=self~field(p,"artifactId","")~string~strip
+  if artifactId="" then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_ID_REQUIRED")
+  key="COMPOSITION:"artifactId
+  if \drafts~hasIndex(key) then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_NOT_FOUND",artifactId)
+  placementKey=self~field(p,"placementKey",""); if placementKey="" then return .WireUIDesignResult~failure("COMPOSITION_RESIZE_PLACEMENT_REQUIRED")
+  prior=drafts[key]; spec=prior~spec; rows=self~field(spec,"placements",.array~new)
+  next=.array~new; found=.false
+  do row over rows
+    copy=.WireUIDesignUtil~copyTable(row)
+    if self~placementKey(row)=placementKey then do
+      span=self~field(p,"span",self~field(row,"span",12))+0
+      rowSpan=self~field(p,"rowSpan",self~field(row,"rowSpan",1))+0
+      if span<1 | span>12 | span<>span~trunc then return .WireUIDesignResult~failure("COMPOSITION_SPAN_INVALID",span)
+      if rowSpan<1 | rowSpan<>rowSpan~trunc then return .WireUIDesignResult~failure("COMPOSITION_ROW_SPAN_INVALID",rowSpan)
+      copy["span"]=span; copy["rowSpan"]=rowSpan; found=.true
+    end
+    next~append(copy)
+  end
+  if \found then return .WireUIDesignResult~failure("COMPOSITION_RESIZE_PLACEMENT_NOT_FOUND",placementKey)
+  spec["placements"]=next
+  return .WireUIDesignResult~success(.WireUIBuilderDraft~new("COMPOSITION",artifactId,revision+1,spec,prior~baseRef),"COMPOSITION_RESIZED")
+
+::method relocateComposition private
+  expose drafts revision
+  use arg operation
+  p=operation~payload; artifactId=self~field(p,"artifactId","")~string~strip
+  if artifactId="" then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_ID_REQUIRED")
+  key="COMPOSITION:"artifactId
+  if \drafts~hasIndex(key) then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_NOT_FOUND",artifactId)
+  placementKey=self~field(p,"placementKey",""); region=self~field(p,"region","")~string~strip
+  if placementKey="" then return .WireUIDesignResult~failure("COMPOSITION_RELOCATE_PLACEMENT_REQUIRED")
+  if region="" then return .WireUIDesignResult~failure("COMPOSITION_REGION_REQUIRED")
+  prior=drafts[key]; spec=prior~spec; rows=self~field(spec,"placements",.array~new)
+  next=.array~new; found=.false
+  do row over rows
+    copy=.WireUIDesignUtil~copyTable(row)
+    if self~placementKey(row)=placementKey then do; copy["region"]=region; found=.true; end
+    next~append(copy)
+  end
+  if \found then return .WireUIDesignResult~failure("COMPOSITION_RELOCATE_PLACEMENT_NOT_FOUND",placementKey)
+  spec["placements"]=next
+  return .WireUIDesignResult~success(.WireUIBuilderDraft~new("COMPOSITION",artifactId,revision+1,spec,prior~baseRef),"COMPOSITION_RELOCATED")
+
+::method alignComposition private
+  expose drafts revision
+  use arg operation
+  p=operation~payload; artifactId=self~field(p,"artifactId","")~string~strip
+  if artifactId="" then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_ID_REQUIRED")
+  key="COMPOSITION:"artifactId
+  if \drafts~hasIndex(key) then return .WireUIDesignResult~failure("COMPOSITION_DRAFT_NOT_FOUND",artifactId)
+  placementKey=self~field(p,"placementKey",""); align=self~field(p,"align","")~string~strip~translate
+  if placementKey="" then return .WireUIDesignResult~failure("COMPOSITION_ALIGN_PLACEMENT_REQUIRED")
+  if align<>"START" & align<>"CENTER" & align<>"END" & align<>"STRETCH" then return .WireUIDesignResult~failure("COMPOSITION_ALIGN_INVALID",align)
+  prior=drafts[key]; spec=prior~spec; rows=self~field(spec,"placements",.array~new)
+  next=.array~new; found=.false
+  do row over rows
+    copy=.WireUIDesignUtil~copyTable(row)
+    if self~placementKey(row)=placementKey then do; copy["align"]=align; found=.true; end
+    next~append(copy)
+  end
+  if \found then return .WireUIDesignResult~failure("COMPOSITION_ALIGN_PLACEMENT_NOT_FOUND",placementKey)
+  spec["placements"]=next
+  return .WireUIDesignResult~success(.WireUIBuilderDraft~new("COMPOSITION",artifactId,revision+1,spec,prior~baseRef),"COMPOSITION_ALIGNED")
+
+::method placementKey private
+  use arg row
+  return self~field(row,"elementId","")"|"self~field(row,"projectionId","")"|"self~field(row,"viewportClass","DEFAULT")
+
+::method validateSpec private
+  use arg kind, spec
+  pv=self~field(spec,"publishVersion","")~string~strip
+  if pv="" then return .WireUIDesignResult~failure("PUBLISH_VERSION_REQUIRED",kind)
+  if kind<>"MATERIAL" then do
+    inline=self~inlineDisplayContentKey(spec)
+    if inline<>"" then return .WireUIDesignResult~failure("INLINE_DISPLAY_CONTENT_FORBIDDEN",inline)
+  end
+  select
+    when kind="COMPONENT" then do
+      if self~field(spec,"primitive","")~string~strip="" then return .WireUIDesignResult~failure("COMPONENT_PRIMITIVE_REQUIRED")
+    end
+    when kind="ELEMENT" then do
+      if self~field(spec,"semanticType","")~string~strip="" then return .WireUIDesignResult~failure("ELEMENT_SEMANTIC_TYPE_REQUIRED")
+    end
+    when kind="MATERIAL" then nop
+    when kind="CONDITION" then do
+      do key over .array~of("sourceKind","sourceRef","operator","authorityRef")
+        if self~field(spec,key,"")~string~strip="" then return .WireUIDesignResult~failure("CONDITION_"key~translate"_REQUIRED")
+      end
+      sk=self~field(spec,"sourceKind","")~string~strip~translate; if sk<>"FACT" & sk<>"DECISION" then return .WireUIDesignResult~failure("CONDITION_SOURCE_KIND_INVALID",sk)
+      op=self~field(spec,"operator","")~string~strip~translate; if \(.set~of("EQ","NE","PRESENT","ABSENT","TRUE","FALSE")~hasIndex(op)) then return .WireUIDesignResult~failure("CONDITION_OPERATOR_INVALID",op)
+      if (op="EQ" | op="NE") & \spec~hasIndex("expectedValue") then return .WireUIDesignResult~failure("CONDITION_EXPECTED_VALUE_REQUIRED")
+    end
+    when kind="PRESENTATION_POLICY" then do+      prec=self~field(spec,"precedence",.nil); caps=self~field(spec,"capacities",.nil)
+      if prec==.nil | \prec~isA(.Array) then return .WireUIDesignResult~failure("PRESENTATION_POLICY_PRECEDENCE_REQUIRED")
+      if caps==.nil | \(caps~isA(.Table) | caps~isA(.Directory)) then return .WireUIDesignResult~failure("PRESENTATION_POLICY_CAPACITIES_REQUIRED")
+    end
+    when kind="PROJECTION" then do
+      do key over .array~of("profile","elementId","componentId","definitionId")
+        if self~field(spec,key,"")~string~strip="" then return .WireUIDesignResult~failure("PROJECTION_"key~translate"_REQUIRED")
+      end
+      resources=self~field(spec,"resourceBindings",.array~new)
+      if \resources~isA(.Array) then return .WireUIDesignResult~failure("PROJECTION_RESOURCE_BINDINGS_INVALID")
+      do rb over resources
+        if rb==.nil | \(rb~isA(.Table) | rb~isA(.Directory)) then return .WireUIDesignResult~failure("PROJECTION_RESOURCE_BINDING_INVALID")
+        if self~field(rb,"role","")~string~strip="" then return .WireUIDesignResult~failure("PROJECTION_RESOURCE_ROLE_REQUIRED")
+        rr=self~field(rb,"resourceRef",.nil); if rr==.nil | \(rr~isA(.Table) | rr~isA(.Directory)) then return .WireUIDesignResult~failure("PROJECTION_RESOURCE_REF_REQUIRED")
+        do rk over .array~of("resourceId","version","contentAddress","resourceClass")
+          if self~field(rr,rk,"")~string~strip="" then return .WireUIDesignResult~failure("PROJECTION_RESOURCE_"rk~translate"_REQUIRED")
+        end
+      end
+      if spec~hasIndex("rowContract") then do
+        rc=spec["rowContract"]
+        if rc==.nil | \(rc~isA(.Table) | rc~isA(.Directory)) then return .WireUIDesignResult~failure("PROJECTION_ROW_CONTRACT_INVALID")
+        if self~field(rc,"collectionSlot","")~string~strip="" then return .WireUIDesignResult~failure("PROJECTION_ROW_COLLECTION_SLOT_REQUIRED")
+        if self~field(rc,"identityField","")~string~strip="" then return .WireUIDesignResult~failure("PROJECTION_ROW_IDENTITY_FIELD_REQUIRED")
+        rowFields=self~field(rc,"rowFields",.nil)
+        if rowFields==.nil | \rowFields~isA(.Array) | rowFields~items=0 then return .WireUIDesignResult~failure("PROJECTION_ROW_FIELDS_REQUIRED")
+        selectionMode=self~field(rc,"selectionMode","NONE")~string~strip~translate
+        if \(.set~of("NONE","SINGLE","MULTI")~hasIndex(selectionMode)) then return .WireUIDesignResult~failure("PROJECTION_ROW_SELECTION_MODE_INVALID",selectionMode)
+        emptyPolicy=self~field(rc,"emptyPolicy","ALLOW_EMPTY")~string~strip~translate
+        if \(.set~of("ALLOW_EMPTY","FAIL_CLOSED")~hasIndex(emptyPolicy)) then return .WireUIDesignResult~failure("PROJECTION_ROW_EMPTY_POLICY_INVALID",emptyPolicy)
+      end
+    end
+    when kind="JOURNEY" then do
+      if self~field(spec,"initialState","")~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_INITIAL_STATE_REQUIRED")
+      states=self~field(spec,"states",.nil)
+      if states==.nil | \states~isA(.Array) | states~items=0 then return .WireUIDesignResult~failure("JOURNEY_STATES_REQUIRED")
+      flows=self~field(spec,"flows",.array~new)
+      if flows~items>0 then do
+        if self~field(spec,"initialFlowId","")~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_INITIAL_FLOW_REQUIRED")
+        do f over flows
+          if self~field(f,"flowId","")~string~strip="" | self~field(f,"initialState","")~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_FLOW_INVALID")
+        end
+        do st over states; if self~field(st,"flowId","")~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_STATE_FLOW_REQUIRED",self~field(st,"stateId","")); end
+      end
+      transitions=self~field(spec,"transitions",.array~new)
+      if \transitions~isA(.Array) then return .WireUIDesignResult~failure("JOURNEY_TRANSITIONS_INVALID")
+      do tr over transitions
+        if tr==.nil | \(tr~isA(.Table) | tr~isA(.Directory)) then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_INVALID")
+        if self~field(tr,"fromState","")~string~strip="" | self~field(tr,"toState","")~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_STATES_REQUIRED")
+        mode=self~field(tr,"whenMode","ALL")~string~strip~translate
+        if mode<>"ALL" & mode<>"ANY" then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_WHEN_MODE_INVALID",mode)
+        do ck over .array~of("whenConditionIds","suppressConditionIds")
+          ca=self~field(tr,ck,.array~new); if \ca~isA(.Array) then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_CONDITION_IDS_INVALID",ck)
+        end
+      end
+    end
+    when kind="COMPOSITION" then do
+      do key over .array~of("journeyId","profile","stateId","layoutModel")
+        if self~field(spec,key,"")~string~strip="" then return .WireUIDesignResult~failure("COMPOSITION_"key~translate"_REQUIRED")
+      end
+      rows=self~field(spec,"placements",.nil)
+      if rows==.nil | \rows~isA(.Array) | rows~items=0 then return .WireUIDesignResult~failure("COMPOSITION_PLACEMENTS_REQUIRED")
+      do row over rows
+        if row==.nil | \(row~isA(.Table) | row~isA(.Directory)) then return .WireUIDesignResult~failure("COMPOSITION_PLACEMENT_INVALID")
+        if self~field(row,"elementId","")~string~strip="" then return .WireUIDesignResult~failure("COMPOSITION_PLACEMENT_ELEMENT_REQUIRED")
+        span=self~field(row,"span",12)+0; if span<1 | span>12 | span<>span~trunc then return .WireUIDesignResult~failure("COMPOSITION_SPAN_INVALID",span)
+        rowSpan=self~field(row,"rowSpan",1)+0; if rowSpan<1 | rowSpan<>rowSpan~trunc then return .WireUIDesignResult~failure("COMPOSITION_ROW_SPAN_INVALID",rowSpan)
+        mode=self~field(row,"whenMode","ALL")~string~strip~translate; if mode<>"ALL" & mode<>"ANY" then return .WireUIDesignResult~failure("COMPOSITION_WHEN_MODE_INVALID",mode)
+        do ck over .array~of("whenConditionIds","suppressConditionIds")
+          ca=self~field(row,ck,.array~new); if \ca~isA(.Array) then return .WireUIDesignResult~failure("COMPOSITION_CONDITION_IDS_INVALID",ck)
+        end
+      end
+    end
+    when kind="EXPERIMENT" then do
+      if self~field(spec,"targetElementId","")~string~strip="" then return .WireUIDesignResult~failure("EXPERIMENT_TARGET_REQUIRED")
+      vars=self~field(spec,"variants",.nil)
+      if vars==.nil | \vars~isA(.Array) | vars~items<2 then return .WireUIDesignResult~failure("EXPERIMENT_VARIANTS_REQUIRED")
+    end
+    otherwise return .WireUIDesignResult~failure("UNKNOWN_DRAFT_KIND",kind)
+  end
+  return .WireUIDesignResult~success(.true)
+
+::method draft
+  expose drafts
+  use arg kind, artifactId
+  key=kind~string~translate":"artifactId
+  if drafts~hasIndex(key) then return drafts[key]
+  return .nil
+::method drafts
+  expose drafts
+  out=.array~new; keys=drafts~allIndexes; keys~sort; do k over keys; out~append(drafts[k]); end; return out
+::method operations
+  expose operationLog
+  return .WireUIDesignUtil~copyArray(operationLog)
+
+::method publish
+  expose workspace projectId title metadata
+  use arg releaseId, releaseVersion, releaseMetadata=.nil
+  releaseId=releaseId~string~strip; releaseVersion=releaseVersion~string~strip
+  if releaseId="" | releaseVersion="" then return .WireUIDesignResult~failure("RELEASE_ID_VERSION_REQUIRED")
+  published=.table~new
+  do kind over .array~of("COMPONENT","ELEMENT","MATERIAL","CONDITION","PRESENTATION_POLICY","PROJECTION","JOURNEY","COMPOSITION","EXPERIMENT")
+    do d over self~drafts
+      if d~kind<>kind then iterate
+      r=self~materialize(d,published)
+      if \r~ok then return r
+      artifact=r~value; rr=workspace~register(artifact); if \rr~ok then return rr
+      published[d~key]=artifact
+    end
+  end
+  releaseInfo=.WireUIDesignUtil~copyTable(releaseMetadata)
+  releaseInfo["builderProjectId"]=projectId; releaseInfo["builderProjectRevision"]=self~revision; releaseInfo["builderProjectMetadata"]=.WireUIDesignUtil~copyTable(metadata)
+  ledger=""; do operation over self~operations; ledger ||= "|"operation~contentAddress; end
+  releaseInfo["builderOperationLedgerFingerprint"]="ledger-" || .WireUIDesignUtil~token(ledger)
+  release=.WireUISiteRelease~new(releaseId,releaseVersion,releaseInfo)
+  keys=published~allIndexes; keys~sort
+  do k over keys; r=release~pin(published[k]~ref); if \r~ok then return r; end
+  r=release~seal; if \r~ok then return r
+  r=workspace~register(release); if \r~ok then return r
+  cr=.WireUICompiler~new~compile(workspace,release); if \cr~ok then return cr
+  publishedResult=.directory~new; publishedResult["project"]=self; publishedResult["workspace"]=workspace; publishedResult["release"]=release; publishedResult["package"]=cr~value; publishedResult["published"]=published
+  return .WireUIDesignResult~success(publishedResult,"PROJECT_PUBLISHED")
+
+::method materialize private
+  expose workspace
+  use arg draft, published
+  s=draft~spec; id=draft~artifactId; v=s["publishVersion"]~string
+  kind=draft~kind
+  select
+    when kind="COMPONENT" then return .WireUIDesignResult~success(.WireUIVisualComponent~new(id,v,s["primitive"],self~field(s,"slotSchema",.nil),self~field(s,"styleHooks",.nil),self~field(s,"capabilities",.nil)))
+    when kind="ELEMENT" then return .WireUIDesignResult~success(.WireUISemanticElement~new(id,v,s["semanticType"],self~field(s,"fields",.nil),self~field(s,"actions",.nil),self~field(s,"audiencePolicyRef","PUBLIC"),self~field(s,"metadata",.nil)))
+    when kind="MATERIAL" then return .WireUIDesignResult~success(.WireUIMaterialSet~new(id,v,self~field(s,"tokens",.nil),self~field(s,"recipes",.nil)))
+    when kind="CONDITION" then return .WireUIDesignResult~success(.WireUIConditionDesign~new(id,v,s["sourceKind"],s["sourceRef"],s["operator"],self~field(s,"expectedValue",.nil),s["authorityRef"],self~field(s,"metadata",.nil)))
+    when kind="PRESENTATION_POLICY" then return .WireUIDesignResult~success(.WireUIPresentationPolicy~new(id,v,self~field(s,"precedence",.nil),self~field(s,"capacities",.nil),self~field(s,"metadata",.nil)))
+    when kind="PROJECTION" then do
+      er=self~resolveRef("ELEMENT",s["elementId"],self~field(s,"elementVersion",""),published); if er==.nil then return .WireUIDesignResult~failure("PROJECTION_ELEMENT_UNRESOLVED",id)
+      cr=self~resolveRef("COMPONENT",s["componentId"],self~field(s,"componentVersion",""),published); if cr==.nil then return .WireUIDesignResult~failure("PROJECTION_COMPONENT_UNRESOLVED",id)
+      rowContract=.nil; if s~hasIndex("rowContract") then rowContract=.WireUIRowCollectionContract~fromWire(s["rowContract"])
+      return .WireUIDesignResult~success(.WireUIProjectionDesign~new(id,v,s["profile"],er,cr,s["definitionId"],self~field(s,"action",""),self~field(s,"styleRole",""),self~field(s,"materialRole",""),self~field(s,"bindings",.nil),self~field(s,"metadata",.nil),self~field(s,"resourceBindings",.nil),rowContract))
+    end
+    when kind="JOURNEY" then do
+      j=.WireUIJourneyDesign~new(id,v,s["initialState"],self~field(s,"initialFlowId",""))
+      do flow over self~field(s,"flows",.array~new)
+        r=j~defineFlow(self~field(flow,"flowId",""),self~field(flow,"initialState",""),self~field(flow,"metadata",.nil)); if \r~ok then return r
+      end
+      do row over s["states"]
+        sid=self~field(row,"stateId",""); if sid="" then return .WireUIDesignResult~failure("JOURNEY_STATE_ID_REQUIRED",id)
+        r=j~defineState(sid,self~field(row,"ACTIVE",.nil),self~field(row,"PREFETCH",.nil),self~field(row,"ON_DEMAND",.nil),self~field(row,"flowId","")); if \r~ok then return r
+      end
+      ts=self~field(s,"transitions",.nil)
+      if ts<>.nil then do t over ts
+        r=j~allowTransition(self~field(t,"fromState",""),self~field(t,"toState",""),self~field(t,"trigger",""),self~field(t,"purpose",""),self~field(t,"whenConditionIds",.nil),self~field(t,"suppressConditionIds",.nil),self~field(t,"whenMode","ALL")); if \r~ok then return r
+      end
+      r=j~seal; if \r~ok then return r
+      return .WireUIDesignResult~success(j)
+    end
+    when kind="COMPOSITION" then do
+      jr=self~resolveRef("JOURNEY",s["journeyId"],self~field(s,"journeyVersion",""),published)
+      if jr==.nil then return .WireUIDesignResult~failure("COMPOSITION_JOURNEY_UNRESOLVED",id)
+      pref=.nil
+      if self~field(s,"presentationPolicyId","")<>"" then do
+        pref=self~resolveRef("PRESENTATION_POLICY",s["presentationPolicyId"],self~field(s,"presentationPolicyVersion",""),published)
+        if pref==.nil then return .WireUIDesignResult~failure("COMPOSITION_PRESENTATION_POLICY_UNRESOLVED",id)
+      end
+      c=.WireUICompositionDesign~new(id,v,jr,s["profile"],s["stateId"],self~field(s,"layoutModel","GRID12"),s["placements"],self~field(s,"metadata",.nil),pref)
+      return .WireUIDesignResult~success(c)
+    end
+    when kind="EXPERIMENT" then do
+      e=.WireUIExperiment~new(id,v,s["targetElementId"],self~field(s,"assignmentUnit","USER"))
+      do row over s["variants"]
+        pr=self~resolveRef("PROJECTION",self~field(row,"projectionId",""),self~field(row,"projectionVersion",""),published)
+        if pr==.nil then return .WireUIDesignResult~failure("EXPERIMENT_PROJECTION_UNRESOLVED",id)
+        r=e~addVariant(self~field(row,"variantId",""),self~field(row,"weight",0),pr); if \r~ok then return r
+      end
+      r=e~seal; if \r~ok then return r
+      return .WireUIDesignResult~success(e)
+    end
+  end
+  return .WireUIDesignResult~failure("UNKNOWN_DRAFT_KIND",kind)
+
+::method resolveRef private
+  expose workspace
+  use arg kind,id,version,published
+  key=kind":"id
+  if published~hasIndex(key) then return published[key]~ref
+  if version="" then return .nil
+  a=workspace~artifact(kind,id,version); if a==.nil then return .nil
+  return a~ref
+
+::method asWire
+  expose projectId title revision metadata
+  d=.directory~new; d["schema"]="wire-ui-builder-project-v0.7"; d["projectId"]=projectId; d["title"]=title; d["revision"]=revision; d["metadata"]=.WireUIDesignUtil~copyTable(metadata)
+  aa=.array~new; do draft over self~drafts; aa~append(draft~asWire); end; d["drafts"]=aa
+  oo=.array~new; do operation over self~operations; oo~append(operation~projectWire); end; d["operations"]=oo
+  d["contentAddress"]="project-" || .WireUIDesignUtil~token(projectId"|"title"|"revision"|".WireUIDesignUtil~canonicalArray(aa)"|".WireUIDesignUtil~canonicalArray(oo))
+  return d
+
+::method save
+  use arg path
+  .json~toJsonFile(path,self~asWire,.true)
+  return .WireUIDesignResult~success(path,"PROJECT_SAVED")
+
+::method load class
+  use arg path
+  wire=.json~fromJsonFile(path)
+  if wire==.nil then return .WireUIDesignResult~failure("PROJECT_FILE_INVALID",path)
+  if wire["schema"]<>"wire-ui-builder-project-v0.7" & wire["schema"]<>"wire-ui-builder-project-v0.6" & wire["schema"]<>"wire-ui-builder-project-v0.5" & wire["schema"]<>"wire-ui-builder-project-v0.4" & wire["schema"]<>"wire-ui-builder-project-v0.3" then return .WireUIDesignResult~failure("PROJECT_SCHEMA_UNSUPPORTED",wire["schema"])
+  p=.WireUIBuilderProject~new(wire["projectId"],wire["title"],.nil,wire["metadata"])
+  r=p~restoreSnapshot(wire); if \r~ok then return r
+  if wire~hasIndex("contentAddress") & wire["contentAddress"]<>"" then if p~asWire["contentAddress"]<>wire["contentAddress"] then return .WireUIDesignResult~failure("PROJECT_CONTENT_MISMATCH",path)
+  return .WireUIDesignResult~success(p,"PROJECT_LOADED")
+
+::method restoreSnapshot
+  expose revision drafts operationLog operationsById
+  use arg wire
+  drafts=.table~new; operationLog=.array~new; operationsById=.table~new
+  rev=wire["revision"]+0
+  if wire~hasIndex("operations") & wire["operations"]<>.nil then do row over wire["operations"]
+    rr=.WireUIDesignOperation~fromProjectWire(row); if \rr~ok then return rr
+    op=rr~value
+    if operationsById~hasIndex(op~operationId) then return .WireUIDesignResult~failure("PROJECT_OPERATION_DUPLICATE",op~operationId)
+    operationLog~append(op); operationsById[op~operationId]=op
+  end
+  if operationLog~items<>rev then return .WireUIDesignResult~failure("PROJECT_OPERATION_LEDGER_INCOMPLETE",operationLog~items"|"rev)
+  do row over wire["drafts"]
+    base=.nil
+    if row["baseRef"]<>.nil then do
+      b=row["baseRef"]; base=.WireUIArtifactRef~new(b["kind"],b["id"],b["version"],b["contentAddress"])
+    end
+    d=.WireUIBuilderDraft~new(row["kind"],row["artifactId"],row["draftRevision"]+0,row["spec"],base)
+    if d~contentAddress<>row["contentAddress"] then return .WireUIDesignResult~failure("PROJECT_DRAFT_CONTENT_MISMATCH",d~key)
+    drafts[d~key]=d
+  end
+  revision=rev
+  return .WireUIDesignResult~success(self,"PROJECT_RESTORED")
+
+::method inlineDisplayContentKey private
+  use arg value, path="spec"
+  if value==.nil then return ""
+  if value~isA(.Table) | value~isA(.Directory) then do
+    forbidden=.set~of("TEXT","LABEL","COPY","CAPTION","HEADLINE","BODY","HTML","MARKDOWN","IMAGE","IMAGEURL","IMAGESRC","SRC","ALTTEXT","DESCRIPTION","LITERALTEXT","DISPLAYTEXT")
+    safeSubtrees=.set~of("BINDINGS","SLOTSCHEMA","STYLEHOOKS","CAPABILITIES")
+    do k over value~allIndexes
+      ku=k~string~translate
+      if safeSubtrees~hasIndex(ku) then iterate
+      if forbidden~hasIndex(ku) then return path"."k
+      r=self~inlineDisplayContentKey(value[k],path"."k); if r<>"" then return r
+    end
+  end
+  else if value~isA(.Array) then do
+    i=0; do item over value; i+=1; r=self~inlineDisplayContentKey(item,path"["i"]"); if r<>"" then return r; end
+  end
+  return ""
+
+::method field private
+  use arg t,k,default=.nil
+  if t==.nil then return default
+  if t~hasIndex(k) then return t[k]
+  return default
+
+::requires "json.cls"
+::requires "WireUIBuilderDraft.cls"
+::requires "WireUIDesignWorkspace.cls"
+::requires "WireUIDesignOperation.cls"
+::requires "WireUICompiler.cls"
+::requires "WireUISiteRelease.cls"
+::requires "WireUIVisualComponent.cls"
+::requires "WireUISemanticElement.cls"
+::requires "WireUIMaterialSet.cls"
+::requires "WireUIConditionDesign.cls"
+::requires "WireUIPresentationPolicy.cls"
+::requires "WireUIResourceRef.cls"
+::requires "WireUIProjectionDesign.cls"
+::requires "WireUIJourneyDesign.cls"
+::requires "WireUIExperiment.cls"
+
+::requires "WireUICompositionDesign.cls"
+
+::requires "WireUIRowCollectionContract.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProjectActionAdapter.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProjectActionAdapter.cls
new file mode 100644
index 0000000000000000000000000000000000000000..8d1727ecd34b1925c60db632fb553a6bb5478658
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIBuilderProjectActionAdapter.cls
@@ -0,0 +1,32 @@
+/* Browser/AI semantic-action adapter for draft project operations. */
+::class WireUIBuilderProjectActionAdapter subclass AlchemyObject public
+::attribute project get
+::method init
+  expose project
+  use arg project
+  self~init:super(.WireUIDesignAlchemy~metadata("Wire UI semantic-action adapter for draft Builder projects"))
+  if \project~isA(.WireUIBuilderProject) then raise syntax 93.948 array("project")
+::method apply
+  expose project
+  use arg action, detail
+  action=action~string~strip~translate
+  if detail==.nil | \(detail~isA(.Table) | detail~isA(.Directory)) then return .WireUIDesignResult~failure("BUILDER_ACTION_DETAIL_REQUIRED")
+  operationId=self~field(detail,"operationId","")
+  if operationId="" then operationId="builder-"project~revision"-".WireUIDesignUtil~token(action"|".WireUIDesignUtil~canonicalTable(detail))
+  expected=self~field(detail,"expectedRevision",project~revision)
+  actorRef=self~field(detail,"actorRef","")
+  reason=self~field(detail,"reason","")
+  payload=.WireUIDesignUtil~copyTable(self~field(detail,"payload",.nil))
+  /* Forms may send artifactId/spec fields directly rather than a nested payload. */
+  if payload~items=0 & detail~hasIndex("artifactId") then do
+    payload["artifactId"]=detail["artifactId"]
+    if detail~hasIndex("spec") then payload["spec"]=detail["spec"]
+  end
+  if payload~items=0 then return .WireUIDesignResult~failure("BUILDER_PROJECT_PAYLOAD_REQUIRED")
+  op=.WireUIDesignOperation~new(operationId,action,expected,.nil,payload,actorRef,reason)
+  return project~applyOperation(op)
+::method field private
+  use arg t,k,default=.nil
+  if t~hasIndex(k) then return t[k]
+  return default
+::requires "WireUIBuilderProject.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiledPackage.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiledPackage.cls
new file mode 100644
index 0000000000000000000000000000000000000000..73df5e9b8ab0a565b0359606bdc860f715ac5d3d
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiledPackage.cls
@@ -0,0 +1,62 @@
+/* Compiler output consumed later by a Wire UI runtime adapter. */
+::class WireUICompiledPackage subclass AlchemyObject public
+::attribute packageId get
+::attribute packageVersion get
+::attribute releaseRef get
+::attribute contentAddress get
+::method init
+  expose packageId packageVersion releaseRef definitions journeyPlans experiments materials compositions conditions presentationPolicies previewContract contentAddress
+  use arg packageId, packageVersion, releaseRef
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned compiled interaction package"))
+  definitions=.array~new; journeyPlans=.array~new; experiments=.array~new; materials=.array~new; compositions=.array~new; conditions=.array~new; presentationPolicies=.array~new
+  previewContract=.table~new
+  previewContract["requiresRenderedCapture"]=.true
+  previewContract["captureBindsReleaseContentAddress"]=.true
+  previewContract["captureBindsScenarioContentAddress"]=.true
+  previewContract["semanticManifestAvailable"]=.true
+  previewContract["conditionsRequireAuthoritativeRuntimeEvaluation"]=.true
+  previewContract["conditionalTransitionsRequireAuthoritativeRuntimeEvaluation"]=.true
+  previewContract["authoringPreviewAcceptsExplicitConditionOutcomes"]=.true
+  previewContract["unknownPreviewConditionPolicy"]="OMIT_OR_DENY"
+  previewContract["resourceBytesAreExternalToBuilder"]=.true
+  contentAddress=""
+::method addDefinition
+  expose definitions contentAddress; use arg d; definitions~append(d); contentAddress=""; return self
+::method addJourneyPlan
+  expose journeyPlans contentAddress; use arg p; journeyPlans~append(p); contentAddress=""; return self
+::method addExperiment
+  expose experiments contentAddress; use arg e; experiments~append(e); contentAddress=""; return self
+::method addMaterial
+  expose materials contentAddress; use arg m; materials~append(m); contentAddress=""; return self
+::method addComposition
+  expose compositions contentAddress; use arg c; compositions~append(c); contentAddress=""; return self
+::method addCondition
+  expose conditions contentAddress; use arg c; conditions~append(c); contentAddress=""; return self
+::method addPresentationPolicy
+  expose presentationPolicies contentAddress; use arg p; presentationPolicies~append(p); contentAddress=""; return self
+::method definitions
+  expose definitions; return .WireUIDesignUtil~copyArray(definitions)
+::method journeyPlans
+  expose journeyPlans; return .WireUIDesignUtil~copyArray(journeyPlans)
+::method experiments
+  expose experiments; return .WireUIDesignUtil~copyArray(experiments)
+::method materials
+  expose materials; return .WireUIDesignUtil~copyArray(materials)
+::method compositions
+  expose compositions; return .WireUIDesignUtil~copyArray(compositions)
+::method conditions
+  expose conditions; return .WireUIDesignUtil~copyArray(conditions)
+::method presentationPolicies
+  expose presentationPolicies; return .WireUIDesignUtil~copyArray(presentationPolicies)
+::method previewContract
+  expose previewContract; return .WireUIDesignUtil~copyTable(previewContract)
+::method asWire
+  expose packageId packageVersion releaseRef definitions journeyPlans experiments materials compositions conditions presentationPolicies previewContract contentAddress
+  d=.directory~new; d["packageId"]=packageId; d["packageVersion"]=packageVersion; d["releaseRef"]=releaseRef~asWire; d["contentAddress"]=contentAddress
+  d["definitions"]=.WireUIDesignUtil~copyArray(definitions); d["journeyPlans"]=.WireUIDesignUtil~copyArray(journeyPlans); d["experiments"]=.WireUIDesignUtil~copyArray(experiments); d["materials"]=.WireUIDesignUtil~copyArray(materials); d["compositions"]=.WireUIDesignUtil~copyArray(compositions); d["conditions"]=.WireUIDesignUtil~copyArray(conditions); d["presentationPolicies"]=.WireUIDesignUtil~copyArray(presentationPolicies); d["previewContract"]=.WireUIDesignUtil~copyTable(previewContract)
+  return d
+::method seal
+  expose packageId packageVersion releaseRef definitions journeyPlans experiments materials compositions conditions presentationPolicies previewContract contentAddress
+  text=packageId"|"packageVersion"|"releaseRef~canonicalText"|".WireUIDesignUtil~canonicalArray(definitions)"|".WireUIDesignUtil~canonicalArray(journeyPlans)"|".WireUIDesignUtil~canonicalArray(experiments)"|".WireUIDesignUtil~canonicalArray(materials)"|".WireUIDesignUtil~canonicalArray(compositions)"|".WireUIDesignUtil~canonicalArray(conditions)"|".WireUIDesignUtil~canonicalArray(presentationPolicies)"|".WireUIDesignUtil~canonicalTable(previewContract)
+  contentAddress=.WireUIDesignUtil~token(text); return self
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiler.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiler.cls
new file mode 100644
index 0000000000000000000000000000000000000000..46315c2ce5ddac22667a4c305c15e00ae79f573b
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUICompiler.cls
@@ -0,0 +1,579 @@
+/* Compile exact release graph to profile-aware runtime-neutral Wire UI artifacts. */
+::class WireUICompiler subclass AlchemyObject public
+::method init
+  self~init:super(.WireUIDesignAlchemy~metadata("Wire UI design graph validator/compiler"))
+
+::method compile
+  use arg workspace, release
+  if \release~isA(.WireUISiteRelease) | \release~isSealed then return .WireUIDesignResult~failure("RELEASE_NOT_SEALED")
+  pkg=.WireUICompiledPackage~new(release~releaseId, release~version, release~ref)
+  refs=release~refs
+  pinned=.table~new
+  do r over refs; pinned[r~key]=r; end
+  /* Every exact release ref must exist with exactly the pinned content address. */
+  do r over refs
+    a=workspace~artifact(r~kind,r~artifactId,r~version)
+    if a==.nil then return .WireUIDesignResult~failure("PINNED_ARTIFACT_MISSING",r~key)
+    if r~contentAddress="" | a~ref~contentAddress \= r~contentAddress then return .WireUIDesignResult~failure("PINNED_CONTENT_MISMATCH",r~key)
+  end
+  /* Material and projection definitions are emitted independently; multiple versions coexist. */
+  do r over refs
+    a=workspace~artifact(r~kind,r~artifactId,r~version)
+    select
+      when r~kind="MATERIAL" then pkg~addMaterial(a~asWire)
+      when r~kind="CONDITION" then pkg~addCondition(a~asWire)
+      when r~kind="PRESENTATION_POLICY" then pkg~addPresentationPolicy(a~asWire)
+      when r~kind="PROJECTION" then do
+        er=a~elementRef; cr=a~componentRef
+        if \pinned~hasIndex(er~key) then return .WireUIDesignResult~failure("PROJECTION_ELEMENT_NOT_PINNED",a~projectionId)
+        if \pinned~hasIndex(cr~key) then return .WireUIDesignResult~failure("PROJECTION_COMPONENT_NOT_PINNED",a~projectionId)
+        component=workspace~artifact(cr~kind,cr~artifactId,cr~version)
+        d=.table~new
+        d["semanticElementRef"]=er~asWire
+        d["projectionRef"]=a~ref~asWire
+        d["definitionId"]=a~definitionId
+        d["definitionVersion"]=a~version
+        d["definitionKey"]=a~definitionId"@"a~version
+        d["profile"]=a~profile
+        d["primitive"]=component~primitive
+        d["componentRef"]=cr~asWire
+        d["styleRole"]=a~styleRole
+        d["materialRole"]=a~materialRole
+        aw=a~asWire; d["action"]=aw["action"]; d["bindings"]=aw["bindings"]; d["resourceBindings"]=aw["resourceBindings"]; if aw~hasIndex("rowContract") then d["rowContract"]=aw["rowContract"]
+        md=.WireUIDesignUtil~copyTable(aw["metadata"])
+        hints=self~compositionHints(workspace,refs,a)
+        if hints~items>0 then md["compositionHints"]=hints
+        d["metadata"]=md
+        d["contentAddress"]=.WireUIDesignUtil~token(.WireUIDesignUtil~canonicalTable(d))
+        pkg~addDefinition(d)
+      end
+      when r~kind="JOURNEY" then do
+        if \a~isSealed then return .WireUIDesignResult~failure("JOURNEY_NOT_SEALED",a~journeyId)
+        /* Compile each journey state against every profile represented in the pinned projections.
+           Conditional-only placements are NOT ordinary ACTIVE/PREFETCH/ON_DEMAND participants.
+           They are emitted separately so a runtime which does not implement authoritative
+           condition evaluation fails closed by never subscribing/delivering those definitions. */
+        profiles=.set~new
+        do rr over refs
+          if rr~kind="PROJECTION" then profiles~put(workspace~artifact(rr~kind,rr~artifactId,rr~version)~profile)
+        end
+        do profile over profiles
+          plan=.table~new; plan["journeyRef"]=a~ref~asWire; plan["profile"]=profile; plan["initialState"]=a~initialState; plan["initialFlowId"]=a~initialFlowId; plan["flows"]=a~flows
+          plan["conditionalParticipationContract"]="AUTHORITATIVE_ADMISSION_REQUIRED"