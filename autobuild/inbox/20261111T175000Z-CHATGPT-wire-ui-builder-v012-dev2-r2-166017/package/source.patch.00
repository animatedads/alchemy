+
+  call put p,"DESIGN.PROJECTION.DRAFT","BUILDER_SHELL_VIEW",self~projection("1","HUMAN_VISUAL","BUILDER_SHELL","PANEL","WUIB_SHELL","","builder.panel","builder.panel",.nil)
