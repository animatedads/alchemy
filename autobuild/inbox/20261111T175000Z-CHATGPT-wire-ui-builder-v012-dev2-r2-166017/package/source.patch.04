+.wui-builder-studio-region[data-wire-studio-region="library"]{grid-column:1 / 4!important}.wui-builder-studio-region[data-wire-studio-region="canvas"]{grid-column:4 / 10!important}.wui-builder-studio-region[data-wire-studio-region="inspector"]{grid-column:10 / 13!important}
+.wui-builder-flow-map{display:flex!important;position:relative;gap:10px!important;align-items:stretch!important;overflow-x:auto!important;padding-top:38px!important;scroll-snap-type:x proximity}
+.wui-builder-flow-map::before{position:absolute!important;left:14px;top:14px;margin:0!important}.wui-builder-flow-map>.wui-builder-flow-card{flex:0 0 210px;width:210px!important;scroll-snap-align:start}
+@media(max-width:1100px){.wui-builder-studio-region[data-wire-studio-region]{grid-column:1/-1!important}}
+
+/* v0.9 designer ergonomics. These controls only emit typed Builder operations;
+   the DOM remains a view of the semantic project. */
+.wui-builder-placement-card{position:relative!important;padding-right:18px!important;overflow:visible}
+.wui-builder-drag-grip{display:grid;place-items:center;width:24px;height:24px;border:1px solid #d7e0ed;border-radius:5px;background:#f8fafc;color:#50627b;font-size:12px;font-weight:900;cursor:grab;user-select:none}.wui-builder-drag-grip:active{cursor:grabbing}.wui-builder-drag-source{opacity:.52!important;transform:scale(.99)!important}
