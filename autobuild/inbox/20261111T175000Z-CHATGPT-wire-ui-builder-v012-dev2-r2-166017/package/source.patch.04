+++ b/wire_ui_builder_v0.12-dev2-readiness/web/config.example.json
@@ -0,0 +1 @@
+{"bootstrapUrl":"/wire-ui/bootstrap"}
diff --git a/wire_ui_builder_v0.12-dev2-readiness/web/index.html b/wire_ui_builder_v0.12-dev2-readiness/web/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..02c05eba6a5064c9b17c05e50320348bf1f49f81
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/web/index.html
@@ -0,0 +1,9 @@
+<!doctype html>
+<html lang="en">
+<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Wire UI Builder Studio</title><link rel="stylesheet" href="builder.css"></head>
+<body>
+<header class="builder-topbar"><div><strong>Wire UI Builder</strong><span>Studio v0.11 · visual workspace</span></div><div id="wire-ui-connection" role="status" aria-live="polite">Connecting…</div></header>
+<main class="builder-stage"><aside class="builder-intro"><h1>Design the system, not the DOM.</h1><p>The panels are projected from the Builder’s own versioned Wire UI release. Target projects remain drafts until explicitly published.</p></aside><section id="wire-ui-root" class="wire-ui-root" aria-label="Wire UI Builder authoring workspace"></section></main>
+<script id="wire-ui-builder-config" type="application/json">{"bootstrapUrl":"/wire-ui/bootstrap"}</script>
+<script type="module" src="builder-wire-ui.js"></script>+</body></html>
diff --git a/wire_ui_builder_v0.12-dev2-readiness/web/session-readiness.js b/wire_ui_builder_v0.12-dev2-readiness/web/session-readiness.js
new file mode 100644
index 0000000000000000000000000000000000000000..cbb98287616f6e33827e8f0baefa8f89c740a00d
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/web/session-readiness.js
@@ -0,0 +1,32 @@
+export class BuilderSessionReadiness {
+  constructor({status, mount, MutationObserverImpl=globalThis.MutationObserver}={}) {
+    if(typeof status!=='function') throw new TypeError('status callback is required');
+    this.status=status;
+    this.mount=mount??null;
+    this.MutationObserverImpl=MutationObserverImpl;
+    this.connected=false;
+    this.viewSeen=false;
+    this.observer=null;
+  }
+  start(){
+    this.status('Connecting…','connecting');
+    if(!this.mount||typeof this.MutationObserverImpl!=='function') return;
+    this.observer=new this.MutationObserverImpl(()=>this.noteRenderedView());
+    this.observer.observe(this.mount,{childList:true,subtree:true});
+  }
+  noteTransportConnected(){
+    this.connected=true;
+    if(this.viewSeen) this.status('View ready','ready');
+    else this.status('Transport connected','transport');
+  }
+  noteRenderedView(){
+    if(!this.mount?.childNodes?.length) return;
+    this.viewSeen=true;
+    if(this.connected) this.status('View ready','ready');
+    else this.status('Receiving view…','view');
+  }
+  noteSynchronising(){this.status('Synchronising…','sync');}
+  noteError(){this.status('Resynchronising…','error');}
+  noteClosed(){this.status('Disconnected','closed');}
+  stop(){this.observer?.disconnect?.();this.observer=null;}
+}