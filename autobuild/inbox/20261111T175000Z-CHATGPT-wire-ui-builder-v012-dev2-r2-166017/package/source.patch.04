+.wui-builder-library-selected{border-color:#5f8dcc!important;background:#edf5ff!important;box-shadow:inset 3px 0 0 #3568b8}.wui-builder-library-related:not(.wui-builder-library-selected){border-color:#a7bddc!important;background:#f7fbff!important}.wui-builder-library-related:not(.wui-builder-library-selected)::after{content:"linked";grid-column:2;justify-self:end;font-size:7px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:#4c719f;background:#e8f1fc;border-radius:999px;padding:2px 5px}
+.wui-builder-flow-card{cursor:pointer!important;transition:border-color .12s,box-shadow .12s,transform .12s,background .12s}.wui-builder-flow-card:hover{border-color:#8eacd4!important;transform:translateY(-1px)}.wui-builder-flow-active{border-color:#4b7fbe!important;border-top-color:#164f97!important;background:#f7fbff!important;box-shadow:0 0 0 2px rgba(47,103,184,.12),0 8px 18px rgba(36,94,169,.10)!important}.wui-builder-flow-active .wui-builder-flow-state{color:#0a468e}.wui-builder-flow-active::before{content:"editing";position:absolute;right:9px;top:8px;padding:2px 5px;border-radius:999px;background:#dfeeff;color:#205997;font-size:7px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
+.wui-builder-inspector{padding-bottom:10px!important}.wui-builder-inspector .wui-record-field{border:0!important;padding:3px 0!important}.wui-builder-inspector [data-wire-inspector-field="kind"]{display:block!important;margin-bottom:2px}.wui-builder-inspector [data-wire-inspector-field="kind"] .wui-record-label{display:none}.wui-builder-inspector [data-wire-inspector-field="kind"] .wui-record-value{display:inline-block;padding:3px 6px;border-radius:999px;background:#e6effc;color:#35619a;font-size:8px;font-weight:900;letter-spacing:.06em}.wui-builder-inspector [data-wire-inspector-field="artifact-id"]{display:block!important}.wui-builder-inspector [data-wire-inspector-field="artifact-id"] .wui-record-label{display:none}.wui-builder-inspector [data-wire-inspector-field="artifact-id"] .wui-record-value{font-size:14px;font-weight:800;color:#183d6b}.wui-builder-inspector [data-wire-inspector-field="detail"]{display:block!important;padding:5px 0!important}.wui-builder-inspector [data-wire-inspector-field="detail"] .wui-record-label{display:none}.wui-builder-inspector [data-wire-inspector-field="detail"] .wui-record-value{font-size:9px;color:#6c7c92}.wui-builder-inspector [data-wire-inspector-field="draft-revision"],.wui-builder-inspector [data-wire-inspector-field="publish-version"]{display:inline-grid!important;grid-template-columns:auto auto!important;gap:4px!important;margin-right:10px}.wui-builder-inspector [data-wire-inspector-field="draft-revision"] .wui-record-label,.wui-builder-inspector [data-wire-inspector-field="publish-version"] .wui-record-label{font-size:8px;text-transform:uppercase;letter-spacing:.05em}.wui-builder-inspector [data-wire-inspector-field="draft-revision"] .wui-record-value,.wui-builder-inspector [data-wire-inspector-field="publish-version"] .wui-record-value{font-size:9px;font-weight:800}
+[data-wire-definition="WUIB_COMPOSITION_EDITOR@1"]::before{content:"Layout properties"}.wui-builder-context-card{display:grid;gap:10px;margin-bottom:9px}.wui-builder-context-placeholder{display:grid;gap:4px;padding:12px;border:1px dashed #cbd7e7;border-radius:8px;background:#f8fbff}.wui-builder-context-placeholder strong{font-size:11px;color:#315a8f}.wui-builder-context-placeholder span{font-size:9px;line-height:1.45;color:#7b899c}.wui-builder-context-hero{display:grid;gap:3px;padding-bottom:9px;border-bottom:1px solid #e4eaf3}.wui-builder-context-hero>span{font-size:8px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#7189a7}.wui-builder-context-hero>strong{font-size:14px;color:#173f72}.wui-builder-context-hero>small{font-size:8px;color:#8491a3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wui-builder-property-group{display:grid;gap:5px}.wui-builder-property-label{font-size:8px;font-weight:900;letter-spacing:.07em;text-transform:uppercase;color:#7c899b}.wui-builder-property-values{display:flex;gap:4px;align-items:center;flex-wrap:wrap}.wui-builder-property-chip{appearance:none;border:1px solid #d2dce9;background:#f8fafc;color:#51647e;border-radius:6px;padding:5px 7px;font-size:8px;font-weight:800;cursor:pointer}.wui-builder-property-chip:hover{border-color:#94b2db;background:#edf5ff;color:#245a9f}.wui-builder-property-chip.is-active,.wui-builder-property-chip[aria-pressed="true"]{background:#dfeeff;border-color:#7ca3d5;color:#174d8f}.wui-builder-span-range{flex:1 1 100px;min-width:80px;accent-color:#3568b8}.wui-builder-span-value{min-width:32px;text-align:right;font-size:9px;font-weight:900;color:#315a8f}.wui-builder-context-advanced{margin-top:8px;border-top:1px solid #e2e8f1;padding-top:8px}.wui-builder-context-advanced>summary{cursor:pointer;list-style:none;font-size:8px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:#77869a}.wui-builder-context-advanced>summary::before{content:"＋";margin-right:5px}.wui-builder-context-advanced[open]>summary::before{content:"−"}.wui-builder-context-advanced:not([open])>.wui-field,.wui-builder-context-advanced:not([open])>.wui-primary-action{display:none!important}.wui-builder-context-empty .wui-builder-context-advanced{display:none}.wui-builder-context-advanced .wui-field{margin-top:7px}
+@media(max-width:900px){.wui-builder-resize-handle{display:none}.wui-builder-property-values{gap:6px}.wui-builder-property-chip{padding:7px 9px}}
+
+/* v0.9 live-browser layout stabilisation.
+   The Studio shell is the one semantic workspace; region stacks must stretch
+   across that workspace and hidden parked stacks must not participate in grid
+   sizing. This is presentation only -- authored GRID12 spans remain semantic. */
+.wire-ui-root{display:block!important;width:100%!important;min-width:0!important}
+.wire-ui-root>.wui-builder-composition-grid{display:grid!important;width:100%!important;min-width:0!important;max-width:none!important;justify-self:stretch!important}
+.wui-builder-composition-grid{width:100%!important;min-width:0!important;max-width:100%;grid-template-columns:repeat(12,minmax(0,1fr))!important;grid-auto-flow:row}
+.wui-builder-studio-region{width:100%;min-width:0!important;max-width:100%}
+.wui-builder-studio-region[hidden]{display:none!important}
+.wui-builder-studio-region>[data-wire-definition]{min-width:0!important;max-width:100%}
+.wui-builder-canvas,.wui-builder-flow-map,.wui-builder-library,.wui-builder-inspector,.wui-builder-preview-summary,.wui-builder-preview-control{width:100%!important;min-width:0}
+.wui-builder-placement-main{flex:1 1 auto;min-width:0}.wui-builder-placement-tools{flex:0 0 auto}
+
+/* v0.9 DESIGN chrome topology.
+   The outer Studio workspace is not the target application's 12-column canvas.
+   Named areas give the browser a deterministic four-row Studio topology while
+   the target canvas keeps its own semantic GRID12 internally. */
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]{
+  grid-template-columns:minmax(180px,3fr) minmax(0,6fr) minmax(220px,3fr)!important;
+  grid-template-areas:
+    "header header header"
+    "nav nav nav"
+    "library canvas inspector"
+    "flow flow flow" !important;
+  grid-auto-flow:row!important;
+  align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="header"]{grid-area:header!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="nav"]{grid-area:nav!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="library"]{grid-area:library!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="canvas"]{grid-area:canvas!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="inspector"]{grid-area:inspector!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region[data-wire-studio-region="flow"]{grid-area:flow!important}
+.wui-builder-composition-grid[data-wire-composition-state="DESIGN"]>.wui-builder-studio-region{justify-self:stretch!important;align-self:start!important;width:auto!important;max-width:none!important}
+@media(max-width:1100px){
+  .wui-builder-composition-grid[data-wire-composition-state="DESIGN"]{
+    grid-template-columns:minmax(0,1fr)!important;
+    grid-template-areas:"header" "nav" "library" "canvas" "inspector" "flow" !important;
+  }
+}
+
+/* v0.9 conditional/fact-flow authoring cues. These are Builder chrome only;
+   customer-visible copy remains resource-owned outside Builder. */
+.wui-builder-placement-conditional{box-shadow:inset 3px 0 0 currentColor}
+.wui-builder-placement-conditional .wui-builder-placement-meta{font-weight:600}
+.wui-builder-flow-id{display:inline-flex;align-self:flex-start;padding:2px 5px;border:1px solid #cbd5e1;border-radius:999px;font-size:9px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
+
+/* v0.11 non-DESIGN Studio topology.
+   These are editor-chrome areas only. A single semantic region wrapper must
+   never collapse two sibling authoring perspectives into a vertical stack;
+   SOURCE in particular is a 4/8 catalogue/detail workbench. */
+.wui-builder-composition-grid[data-wire-composition-state="SOURCE"]{
+  grid-template-columns:minmax(260px,4fr) minmax(0,8fr)!important;
+  grid-template-areas:"header header" "nav nav" "source-list source-detail"!important;
+  grid-auto-flow:row!important;align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]{
+  grid-template-columns:repeat(4,minmax(0,1fr))!important;
+  grid-template-areas:"header header header header" "nav nav nav nav" "catalogue component-editor element-editor projection-editor"!important;
+  grid-auto-flow:row!important;align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="MATERIALS"]{
+  grid-template-columns:repeat(3,minmax(0,1fr))!important;
+  grid-template-areas:"header header header" "nav nav nav" "catalogue material-editor preview"!important;
+  grid-auto-flow:row!important;align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]{
+  grid-template-columns:repeat(12,minmax(0,1fr))!important;
+  grid-template-areas:
+    "header header header header header header header header header header header header"
+    "nav nav nav nav nav nav nav nav nav nav nav nav"
+    "catalogue catalogue catalogue flow flow flow flow flow flow flow flow flow"
+    "journey-editor journey-editor journey-editor journey-editor condition-editor condition-editor condition-editor condition-editor policy-editor policy-editor policy-editor policy-editor"
+    "experiment-editor experiment-editor experiment-editor experiment-editor experiment-editor experiment-editor preview preview preview preview preview preview"!important;
+  grid-auto-flow:row!important;align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]{
+  grid-template-columns:minmax(240px,4fr) minmax(0,5fr) minmax(220px,3fr)!important;
+  grid-template-areas:"header header header" "nav nav nav" "catalogue preview publish"!important;
+  grid-auto-flow:row!important;align-items:start!important;
+}
+.wui-builder-composition-grid[data-wire-composition-state="SOURCE"]>.wui-builder-studio-region[data-wire-studio-region="source-list"]{grid-area:source-list!important}
+.wui-builder-composition-grid[data-wire-composition-state="SOURCE"]>.wui-builder-studio-region[data-wire-studio-region="source-detail"]{grid-area:source-detail!important}
+.wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]>.wui-builder-studio-region[data-wire-studio-region="catalogue"],.wui-builder-composition-grid[data-wire-composition-state="MATERIALS"]>.wui-builder-studio-region[data-wire-studio-region="catalogue"],.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="catalogue"],.wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]>.wui-builder-studio-region[data-wire-studio-region="catalogue"]{grid-area:catalogue!important}
+.wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]>.wui-builder-studio-region[data-wire-studio-region="component-editor"]{grid-area:component-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]>.wui-builder-studio-region[data-wire-studio-region="element-editor"]{grid-area:element-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]>.wui-builder-studio-region[data-wire-studio-region="projection-editor"]{grid-area:projection-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="MATERIALS"]>.wui-builder-studio-region[data-wire-studio-region="material-editor"]{grid-area:material-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="MATERIALS"]>.wui-builder-studio-region[data-wire-studio-region="preview"]{grid-area:preview!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="flow"]{grid-area:flow!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="journey-editor"]{grid-area:journey-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="condition-editor"]{grid-area:condition-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="policy-editor"]{grid-area:policy-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="experiment-editor"]{grid-area:experiment-editor!important}
+.wui-builder-composition-grid[data-wire-composition-state="FLOW"]>.wui-builder-studio-region[data-wire-studio-region="preview"]{grid-area:preview!important}
+.wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]>.wui-builder-studio-region[data-wire-studio-region="preview"]{grid-area:preview!important}
+.wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]>.wui-builder-studio-region[data-wire-studio-region="publish"]{grid-area:publish!important}
+
+/* v0.11 SOURCE is an authoritative window over source facts, not a raw object dump. */
+[data-wire-definition="WUIB_SOURCE_WINDOW_CONTROL@1"]{display:grid;grid-template-columns:minmax(160px,2fr) repeat(4,minmax(70px,1fr));gap:8px;align-items:end}
+[data-wire-definition="WUIB_SOURCE_WINDOW_CONTROL@1"] .wui-field{margin:0}
+[data-wire-definition="WUIB_SOURCE_FILES@1"]{padding:10px!important}
+[data-wire-definition="WUIB_SOURCE_FILES@1"]>.wui-record-field{display:inline-grid!important;grid-template-columns:auto auto!important;gap:4px!important;margin:0 10px 8px 0;padding:2px 0!important;border:0!important;font-size:9px}
+[data-wire-definition="WUIB_SOURCE_FILES@1"]>.wui-record-field .wui-record-label{font-size:8px;text-transform:uppercase;letter-spacing:.04em;color:#7b8798}
+[data-wire-definition="WUIB_SOURCE_ROW@1"]{display:block;width:100%;text-align:left;border:1px solid #dce2ed;background:#fff;border-radius:var(--builder-radius);padding:9px 10px;margin:0 0 6px;cursor:pointer;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;line-height:1.35;overflow-wrap:anywhere;word-break:break-word;color:inherit}
+[data-wire-definition="WUIB_SOURCE_ROW@1"]:hover{border-color:#9bb8dd;background:#f7fbff}
+[data-wire-definition="WUIB_SOURCE_DETAIL@1"] .wui-record-value{overflow-wrap:anywhere;word-break:break-word;white-space:pre-wrap}
+[data-wire-definition="WUIB_SOURCE_DETAIL@1"] .wui-record-field{grid-template-columns:minmax(90px,140px) minmax(0,1fr)}
+@media(max-width:900px){[data-wire-definition="WUIB_SOURCE_WINDOW_CONTROL@1"]{grid-template-columns:minmax(0,1fr)}}
+
+@media(max-width:1100px){
+  .wui-builder-composition-grid[data-wire-composition-state="SOURCE"],
+  .wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"],
+  .wui-builder-composition-grid[data-wire-composition-state="MATERIALS"],
+  .wui-builder-composition-grid[data-wire-composition-state="FLOW"],
+  .wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]{
+    grid-template-columns:minmax(0,1fr)!important;
+  }
+  .wui-builder-composition-grid[data-wire-composition-state="SOURCE"]{grid-template-areas:"header" "nav" "source-list" "source-detail"!important}
+  .wui-builder-composition-grid[data-wire-composition-state="COMPONENTS"]{grid-template-areas:"header" "nav" "catalogue" "component-editor" "element-editor" "projection-editor"!important}
+  .wui-builder-composition-grid[data-wire-composition-state="MATERIALS"]{grid-template-areas:"header" "nav" "catalogue" "material-editor" "preview"!important}
+  .wui-builder-composition-grid[data-wire-composition-state="FLOW"]{grid-template-areas:"header" "nav" "catalogue" "flow" "journey-editor" "condition-editor" "policy-editor" "experiment-editor" "preview"!important}
+  .wui-builder-composition-grid[data-wire-composition-state="PUBLISH"]{grid-template-areas:"header" "nav" "catalogue" "preview" "publish"!important}
+}
+
+/* v0.11 fact-flow cues: conditional participation and conditional journey
+   edges are visible semantic facts, not browser predicates. */
+.wui-builder-flow-signals{display:flex;gap:4px;flex-wrap:wrap;min-height:0}
+.wui-builder-flow-signal{display:inline-flex;padding:2px 5px;border-radius:999px;border:1px solid #d8c7f0;background:#f7f1ff;color:#69449d;font-size:7px;font-weight:900;letter-spacing:.04em;text-transform:uppercase}
+.wui-builder-flow-branches{display:grid;gap:3px;align-self:end;min-width:0}
+.wui-builder-flow-branch{display:block;padding:3px 5px;border-left:2px solid #b9c8dc;background:#f7f9fc;color:#335b86;font-size:8px;line-height:1.25;white-space:normal;overflow-wrap:anywhere}
+.wui-builder-flow-branch.is-conditional{border-left-color:#8a5bc4;background:#faf6ff;color:#643b96}
diff --git a/wire_ui_builder_v0.12-dev2-readiness/web/composition-controller.js b/wire_ui_builder_v0.12-dev2-readiness/web/composition-controller.js
new file mode 100644
index 0000000000000000000000000000000000000000..bdb9960b1aed55b9a6edb8394a165ec62cf2be27
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/web/composition-controller.js
@@ -0,0 +1,537 @@
+function parseDefinitionKey(value='') {
+  const at=String(value).lastIndexOf('@');
+  if(at<=0) return null;
+  const version=Number(String(value).slice(at+1));
+  if(!Number.isSafeInteger(version)||version<1) return null;
+  return {id:String(value).slice(0,at),version};
+}
+
+export function viewportClassForWidth(width) {
+  const n=Number(width);
+  if(!Number.isFinite(n)) return 'DEFAULT';
+  if(n<640) return 'SMALL';
+  if(n<1024) return 'MEDIUM';
+  return 'LARGE';
+}
+
+export function stateFromJourneyPlan(plan={},applicationId='') {
+  const explicit=String(plan.stateId??plan.state??'').trim();
+  if(explicit) return explicit;
+  const planId=String(plan.planId??'').trim();
+  if(!planId) return null;
+  const prefix=applicationId ? `${applicationId}:` : '';
+  let rest=prefix && planId.startsWith(prefix) ? planId.slice(prefix.length) : planId;
+  const parts=rest.split(':').filter(Boolean);
+  if(parts.length>1 && /^\d+$/.test(parts.at(-1))) parts.pop();
+  return parts.at(-1) ?? null;
+}
+
+export function selectCompositionHint(definition,{stateId=null,viewportClass='DEFAULT'}={}) {
+  const hints=definition?.semantic?.metadata?.compositionHints;
+  if(!Array.isArray(hints)) return null;
+  const state=hints.filter((hint)=>!stateId || hint?.stateId===stateId);
+  if(!state.length) return null;
+  const exact=state.find((hint)=>String(hint?.placement?.viewportClass??'DEFAULT').toUpperCase()===String(viewportClass).toUpperCase());
+  return exact ?? state.find((hint)=>String(hint?.placement?.viewportClass??'DEFAULT').toUpperCase()==='DEFAULT') ?? state[0];
+}
+
+export function placementPresentation(hint) {
+  const p=hint?.placement??{};
+  const span=Math.max(1,Math.min(12,Number(p.span??12)||12));
+  const rowSpan=Math.max(1,Number(p.rowSpan??1)||1);
+  const align=String(p.align??'STRETCH').toUpperCase();
+  return Object.freeze({
+    layoutModel:String(hint?.layoutModel??'GRID12').toUpperCase(),
+    region:String(p.region??'main'),
+    order:Number(p.order??0)||0,
+    span,
+    rowSpan,
+    alignSelf:({START:'start',CENTER:'center',END:'end',STRETCH:'stretch'})[align]??'stretch'
+  });
+}
+
+export function parseCollectionItemText(text='') {
+  const out=Object.create(null);
+  for(const part of String(text).split(' · ')) {
+    const at=part.indexOf(':');
+    if(at<=0) continue;
+    out[part.slice(0,at).trim()]=part.slice(at+1).trim();
+  }
+  return out;
+}
+
+export function nextAlignment(current='STRETCH') {
+  const values=['STRETCH','START','CENTER','END'];
+  const value=String(current??'STRETCH').toUpperCase();
+  const at=values.indexOf(value);
+  return values[(at+1+values.length)%values.length];
+}
+
+export function parseFlowLayoutSignature(value='') {
+  if(!value) return [];
+  return String(value).split('|').filter(Boolean).map((part)=>{
+    const [region='main',span='12',elementId='',align='STRETCH']=part.split('~');
+    return Object.freeze({region,span:Math.max(1,Math.min(12,Number(span)||12)),elementId,align:String(align).toUpperCase()});
+  });
+}
+
+export function semanticRegionList(observed=[]) {
+  return [...new Set([...observed,'header','sidebar','main','secondary','footer'].map((v)=>String(v??'').trim()).filter(Boolean))];
+}
+
+export function nextRegion(current, observed=[]) {
+  const values=semanticRegionList(observed);
+  if(!values.length) return 'main';
+  const at=values.indexOf(String(current??''));
+  return values[(at+1+values.length)%values.length];
+}
+
+export function resizedSpan(startSpan,deltaPx,totalWidth) {
+  const initial=Math.max(1,Math.min(12,Number(startSpan)||1));
+  const width=Number(totalWidth);
+  const delta=Number(deltaPx);
+  if(!Number.isFinite(width)||width<=0||!Number.isFinite(delta)) return initial;
+  const columns=Math.round(delta/(width/12));
+  return Math.max(1,Math.min(12,initial+columns));
+}
+
+// Stable browser placement for the Studio's structural regions.  These line
+// numbers are only a presentation of the authored GRID12 composition: the
+// semantic region/span values remain the source of truth.  Using explicit
+// grid lines avoids relying on auto-placement for the three-column DESIGN
+// workspace and also makes Firefox/Chromium agree when live roots are
+// re-parented into presentation-only region stacks.
+export function studioRegionGridColumn(region,span=12) {
+  const name=String(region??'').trim().toLowerCase();
+  const fixed={header:'1 / 13',nav:'1 / 13',library:'1 / 4',canvas:'4 / 10',inspector:'10 / 13',flow:'1 / 13'};
+  if(fixed[name]) return fixed[name];
+  const width=Math.max(1,Math.min(12,Number(span)||12));
+  return `auto / span ${width}`;
+}
+
+// DESIGN is Studio chrome, not the target composition. Give those chrome
+// regions explicit rows as well as columns so browser grid auto-placement can
+// never move FLOW beside CANVAS or compress the workbench into early tracks.
+// Other Studio states retain authored-span auto placement.
+export function studioRegionGridRow(region,stateId='') {
+  const state=String(stateId??'').toUpperCase();
+  const name=String(region??'').trim().toLowerCase();
+  const fixed={
+    DESIGN:{header:'1',nav:'2',library:'3',canvas:'3',inspector:'3',flow:'4'},
+    SOURCE:{header:'1',nav:'2','source-list':'3','source-detail':'3'},
+    COMPONENTS:{header:'1',nav:'2',catalogue:'3','component-editor':'3','element-editor':'3','projection-editor':'3'},
+    MATERIALS:{header:'1',nav:'2',catalogue:'3','material-editor':'3',preview:'3'},
+    FLOW:{header:'1',nav:'2',catalogue:'3',flow:'3','journey-editor':'4','condition-editor':'4','policy-editor':'4','experiment-editor':'5',preview:'5'},
+    PUBLISH:{header:'1',nav:'2',catalogue:'3',preview:'3',publish:'3'}
+  };
+  return fixed[state]?.[name]??'auto';
+}
+
+export function studioRegionGridArea(region,stateId='') {
+  const state=String(stateId??'').toUpperCase();
+  const name=String(region??'').trim().toLowerCase();
+  const allowed={
+    DESIGN:['header','nav','library','canvas','inspector','flow'],
+    SOURCE:['header','nav','source-list','source-detail'],
+    COMPONENTS:['header','nav','catalogue','component-editor','element-editor','projection-editor'],
+    MATERIALS:['header','nav','catalogue','material-editor','preview'],
+    FLOW:['header','nav','catalogue','flow','journey-editor','condition-editor','policy-editor','experiment-editor','preview'],
+    PUBLISH:['header','nav','catalogue','preview','publish']
+  };
+  return allowed[state]?.includes(name)?name:'';
+}
+
+function safeStop(event) { event?.preventDefault?.(); event?.stopPropagation?.(); }
+
+export class BuilderCompositionController {
+  constructor({comms,runtime,renderer,definitions,mount,journeyController,ownership={},window=globalThis.window,MutationObserverImpl=globalThis.MutationObserver}) {
+    this.comms=comms; this.runtime=runtime; this.renderer=renderer; this.definitions=definitions; this.mount=mount; this.journeyController=journeyController; this.ownership=ownership;
