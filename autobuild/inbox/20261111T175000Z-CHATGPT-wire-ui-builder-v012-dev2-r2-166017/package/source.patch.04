+@media(max-width:900px){.wui-builder-canvas-grid>.wui-collection-item{grid-column:1/-1!important}.wui-builder-grid-ruler{display:none}}
+
+/* v0.6 Studio region stacks. These wrappers are presentation-only: live Wire UI
+   instance roots are merely re-parented beneath a semantic region container. */
+.wui-builder-studio-region{display:flex;flex-direction:column;gap:10px;align-self:start;min-width:0;background:transparent;border:0;padding:0;box-shadow:none}
+.wui-builder-studio-region>[data-wire-definition]{grid-column:auto!important;grid-row:auto!important;order:initial!important;width:100%}
