{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "oorexx_diplomacy_gopher_sphere",
    "version": "0.5",
    "kind": "sphere"
  },
  "tests": [
    {
      "name": "manifest",
      "argv": [
        "sha256sum",
        "--check",
        "--quiet",
        "MANIFEST.sha256"
      ],
      "timeout_seconds": 30
    },
    {
      "name": "json-documents",
      "argv": [
        "rexx",
        "tests/check.rex"
      ],
      "timeout_seconds": 60
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "spheres/oorexx_diplomacy_gopher_sphere_v0.5"
    }
  }
}
