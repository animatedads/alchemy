 d["evidenceRefs"]=er; d["contentAddress"]=contentAddress; return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignOperation.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignOperation.cls
new file mode 100644
index 0000000000000000000000000000000000000000..23efd96cf601b3481218efce9f026d39ccd55430
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignOperation.cls
@@ -0,0 +1,73 @@
+/* Immutable typed authoring operation. Humans and AI use the same operation vocabulary. */
+::class WireUIDesignOperation subclass AlchemyObject public
+::attribute operationId get
+::attribute verb get
+::attribute expectedRevision get
+::attribute targetRef get
+::attribute actorRef get
+::attribute reason get
+::attribute contentAddress get
+::method init
+  expose operationId verb expectedRevision targetRef payload actorRef reason evidenceRefs contentAddress auditDigest
+  use arg operationId, verb, expectedRevision, targetRef=.nil, payload=.nil, actorRef="", reason="", evidenceRefs=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Immutable typed Wire UI design operation"))
+  operationId=operationId~string~strip
+  verb=verb~string~strip~translate
+  actorRef=actorRef~string~strip
+  reason=reason~string~strip
+  if operationId="" | verb="" | expectedRevision<0 then raise syntax 93.906 array("design operation",operationId)
+  if targetRef<>.nil then if \targetRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("targetRef")
+  payload=.WireUIDesignUtil~copyTable(payload)
+  evidenceRefs=.WireUIDesignUtil~copyArray(evidenceRefs)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText); auditDigest=""
+  self~registerStateVariable("operationId","PUBLIC","globally unique immutable authoring operation identity")
+  self~registerStateVariable("verb","PUBLIC","typed semantic design mutation")
+  self~registerStateVariable("expectedRevision","PUBLIC","workspace compare-and-swap revision")
+  self~registerStateVariable("contentAddress","PUBLIC","fast deterministic authoring operation identity")
+
+::method auditDigest
+  expose auditDigest
+  if auditDigest="" then auditDigest=.WireUIDesignUtil~strongToken(self~canonicalText)
+  return auditDigest
+::method payload
+  expose payload
+  return .WireUIDesignUtil~copyTable(payload)
+::method evidenceRefs
+  expose evidenceRefs
+  return .WireUIDesignUtil~copyArray(evidenceRefs)
+::method canonicalText
+  expose operationId verb expectedRevision targetRef payload actorRef reason evidenceRefs
+  target=""
+  if targetRef<>.nil then target=targetRef~canonicalText
+  return operationId"|"verb"|"expectedRevision"|"target"|"actorRef"|"reason"|".WireUIDesignUtil~canonicalTable(payload)"|".WireUIDesignUtil~canonicalArray(evidenceRefs)
+::method ref
+  expose operationId contentAddress
+  return .WireUIArtifactRef~new("DESIGN_OPERATION",operationId,"1",contentAddress)
+::method projectWire
+  expose operationId verb expectedRevision targetRef payload actorRef reason evidenceRefs contentAddress
+  d=.table~new
+  d["operationId"]=operationId; d["verb"]=verb; d["expectedRevision"]=expectedRevision
+  if targetRef==.nil then d["targetRef"]=.nil; else d["targetRef"]=targetRef~asWire
+  d["payload"]=.WireUIDesignUtil~copyTable(payload); d["actorRef"]=actorRef; d["reason"]=reason
+  er=.array~new; do r over evidenceRefs; if r~isA(.WireUIArtifactRef) then er~append(r~asWire); else er~append(r); end
+  d["evidenceRefs"]=er; d["contentAddress"]=contentAddress
+  return d
+::method asWire
+  d=self~projectWire; d["auditDigest"]=self~auditDigest; return d
+::method fromProjectWire class
+  use arg row
+  if row==.nil | \(row~isA(.Table) | row~isA(.Directory)) then return .WireUIDesignResult~failure("DESIGN_OPERATION_WIRE_INVALID")
+  target=.nil
+  if row~hasIndex("targetRef") & row["targetRef"]<>.nil then do
+    t=row["targetRef"]
+    target=.WireUIArtifactRef~new(t["kind"],t["id"],t["version"],t["contentAddress"])
+  end
+  evidence=.array~new
+  if row~hasIndex("evidenceRefs") & row["evidenceRefs"]<>.nil then do e over row["evidenceRefs"]
+    if (e~isA(.Table) | e~isA(.Directory)) & e~hasIndex("kind") & e~hasIndex("id") & e~hasIndex("version") then evidence~append(.WireUIArtifactRef~new(e["kind"],e["id"],e["version"],e["contentAddress"]))
+    else evidence~append(e)
+  end
+  op=self~new(row["operationId"],row["verb"],row["expectedRevision"]+0,target,row["payload"],row["actorRef"],row["reason"],evidence)
+  if row~hasIndex("contentAddress") & row["contentAddress"]<>"" then if op~contentAddress<>row["contentAddress"] then return .WireUIDesignResult~failure("DESIGN_OPERATION_CONTENT_MISMATCH",op~operationId)
+  return .WireUIDesignResult~success(op,"DESIGN_OPERATION_RESTORED")
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignProposal.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignProposal.cls
new file mode 100644
index 0000000000000000000000000000000000000000..6ad75b060c0bc4665864b2a6f366e361ecc3148f
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignProposal.cls
@@ -0,0 +1,25 @@
+/* Reviewable bridge from an assessment to one or more exact typed operations. */
+::class WireUIDesignProposal subclass AlchemyObject public
+::attribute proposalId get
+::attribute version get
+::attribute assessmentRef get
+::attribute contentAddress get
+::method init
+  expose proposalId version assessmentRef operationRefs contentAddress
+  use arg proposalId, version, assessmentRef, operationRefs=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Reviewable Wire UI design change proposal"))
+  proposalId=proposalId~string~strip; version=version~string~strip
+  if proposalId="" | version="" | \assessmentRef~isA(.WireUIArtifactRef) then raise syntax 93.906 array("design proposal",proposalId)
+  operationRefs=.WireUIDesignUtil~copyArray(operationRefs)
+  do r over operationRefs; if \r~isA(.WireUIArtifactRef) then raise syntax 93.948 array("operationRef"); end
+  contentAddress=.WireUIDesignUtil~strongToken(self~canonicalText)
+::method operationRefs
+  expose operationRefs
+  return .WireUIDesignUtil~copyArray(operationRefs)
+::method canonicalText
+  expose proposalId version assessmentRef operationRefs
+  return proposalId"|"version"|"assessmentRef~canonicalText"|".WireUIDesignUtil~canonicalArray(operationRefs)
+::method ref
+  expose proposalId version contentAddress
+  return .WireUIArtifactRef~new("DESIGN_PROPOSAL",proposalId,version,contentAddress)
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignSupport.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignSupport.cls
new file mode 100644
index 0000000000000000000000000000000000000000..8b0fee346c1e8ebece53f922e465fca6aeb74af2
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignSupport.cls
@@ -0,0 +1,152 @@
+/* Shared support for versioned Wire UI authoring artifacts. */
+::requires "AlchemyObject.cls"
+::requires "crypto.cls"
+
+::class WireUIDesignAlchemy public
+::constant PACKAGE_VERSION "0.11"
+::constant SCHEMA "WIRE-UI-DESIGN/0.7"
+::method metadata class
+  use arg purpose, limitations = .nil
+  m=.directory~new
+  m["purpose"]=purpose
+  m["package"]="wire_ui_builder"
+  m["package_version"]=self~PACKAGE_VERSION
+  m["authorship"]=.array~of("Alchemy Wire UI")
+  m["standards"]=.array~of("ALCHEMY-HOUSE-OBJECT-0.5", self~SCHEMA, "WIRE-UI/0.1")
+  if limitations == .nil then limitations=.array~of("authoring/compiler schema v0.7; Builder product v0.11; first-class journey flows, declarative conditional placements and transitions, preview-only condition simulation, presentation arbitration, and fixed external resource bindings; compiled interaction package contract remains WIRE-UI/0.1")
+  m["design_limitations"]=limitations
+  return m
+
+::class WireUIDesignResult public
+::attribute ok get
+::attribute code get
+::attribute value get
+::attribute detail get
+::method init
+  expose ok code value detail
+  use arg ok, code="OK", value=.nil, detail=""
+::method success class
+  use arg value=.nil, code="OK"
+  return self~new(.true,code,value,"")
+::method failure class
+  use arg code, detail="", value=.nil
+  return self~new(.false,code,value,detail)
+
+::class WireUIDesignUtil public
+::method token class
+  use arg text
+  numeric digits 20
+  h=2166136261
+  text=text~string
+  do i=1 to text~length
+    h=(h*16777619 + text~substr(i,1)~c2d) // 2147483647
+  end
+  return "wuid01-" || d2x(h~format(,0),8)
+
+::method hashNumber class
+  use arg text
+  numeric digits 20
+  h=2166136261
+  text=text~string
+  do i=1 to text~length
+    h=(h*16777619 + text~substr(i,1)~c2d) // 2147483647
+  end
+  return h
+
+::method strongToken class
+  use arg text
+  return "sha512-" || .SHA512~new(text~string)~digest
+
+::method copyTable class
+  use arg source
+  target=.table~new
+  if source == .nil then return target
+  do k over source~allIndexes
+    target[k]=source[k]
+  end
+  return target
+
+::method copyArray class
+  use arg source
+  target=.array~new
+  if source == .nil then return target
+  do v over source; target~append(v); end
+  return target
+
+::method canonicalTable class
+  use arg source
+  if source == .nil then return "{}"
+  keys=source~allIndexes
+  keys~sort
+  text="{"
+  first=.true
+  do k over keys
+    if \first then text ||= ","
+    first=.false
+    text ||= self~escape(k) || ":" || self~canonicalValue(source[k])
+  end
+  return text || "}"
+
+::method canonicalArray class
+  use arg source
+  if source == .nil then return "[]"
+  text="["
+  first=.true
+  do v over source
+    if \first then text ||= ","
+    first=.false
+    text ||= self~canonicalValue(v)
+  end
+  return text || "]"
+
+::method canonicalValue class
+  use arg value
+  if value == .nil then return "null"
+  if value~isA(.Table) | value~isA(.Directory) then return self~canonicalTable(value)
+  if value~isA(.Array) then return self~canonicalArray(value)
+  if value~isA(.Set) then do
+    a=value~makeArray; a~sort; return self~canonicalArray(a)
+  end
+  if value~hasMethod("CANONICALTEXT") then return "<" || value~canonicalText || ">"
+  return self~escape(value~string)
+
+::method escape class private
+  use arg s
+  s=s~string
+  s=s~changeStr("\\","\\\\")
+  s=s~changeStr("|","\\p")
+  s=s~changeStr(":","\\c")
+  s=s~changeStr(",","\\m")
+  return s
+
+::class WireUIArtifactRef subclass AlchemyObject public
+::attribute kind get
+::attribute artifactId get
+::attribute version get
+::attribute contentAddress get
+::method init
+  expose kind artifactId version contentAddress
+  use arg kind, artifactId, version, contentAddress=""
+  self~init:super(.WireUIDesignAlchemy~metadata("Exact immutable Wire UI artifact reference"))
+  kind=kind~string~strip~translate
+  artifactId=artifactId~string~strip
+  version=version~string~strip
+  contentAddress=contentAddress~string~strip
+  if kind="" | artifactId="" | version="" then raise syntax 93.906 array("artifact reference", artifactId)
+  self~registerStateVariable("artifactId","PUBLIC","stable semantic artifact identity")
+  self~registerStateVariable("version","PUBLIC","exact immutable artifact version")
+  self~registerStateVariable("contentAddress","PUBLIC","optional exact content address")
+::method key
+  expose kind artifactId version
+  return kind || ":" || artifactId || "@" || version
+::method canonicalText
+  expose kind artifactId version contentAddress
+  return kind || "|" || artifactId || "|" || version || "|" || contentAddress
+::method withContentAddress
+  expose kind artifactId version
+  use arg address
+  return .WireUIArtifactRef~new(kind,artifactId,version,address)
+::method asWire
+  expose kind artifactId version contentAddress
+  d=.table~new; d["kind"]=kind; d["id"]=artifactId; d["version"]=version; d["contentAddress"]=contentAddress
+  return d
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignWorkspace.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignWorkspace.cls
new file mode 100644
index 0000000000000000000000000000000000000000..2bc5ab6236ab2ff893b17f08bf6c07307815afae
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIDesignWorkspace.cls
@@ -0,0 +1,201 @@
+/* Mutable authoring workspace. Published artifacts remain immutable; typed operations derive new versions. */
+::class WireUIDesignWorkspace subclass AlchemyObject public
+::attribute workspaceId get
+::attribute revision get
+::attribute basedOnReleaseRef get
+::attribute basedOnGraphDigest get
+::method init
+  expose workspaceId artifacts projectionsByProfileElement revision basedOnReleaseRef basedOnGraphDigest operationLog operationsById lineages
+  use arg workspaceId, basedOnReleaseRef=.nil, basedOnGraphDigest=""
+  self~init:super(.WireUIDesignAlchemy~metadata("Human/AI Wire UI authoring workspace"))
+  workspaceId=workspaceId~string~strip; artifacts=.table~new; projectionsByProfileElement=.table~new
+  revision=0; basedOnGraphDigest=basedOnGraphDigest~string~strip; operationLog=.array~new; operationsById=.table~new; lineages=.table~new
+  if workspaceId="" then raise syntax 93.906 array("workspace")
+  if basedOnReleaseRef<>.nil then if \basedOnReleaseRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("basedOnReleaseRef")
+  self~registerStateVariable("workspaceId","PUBLIC","mutable authoring workspace identity")
+  self~registerStateVariable("revision","PUBLIC","compare-and-swap authoring revision")
+  self~registerStateVariable("basedOnGraphDigest","PUBLIC","optional immutable graph digest this workspace was forked from")
+
+/* Import/load an already immutable artifact. This deliberately does not count as an authoring edit. */
+::method register
+  expose artifacts projectionsByProfileElement
+  use arg artifact
+  if \artifact~hasMethod("REF") then return .WireUIDesignResult~failure("NOT_VERSIONED_ARTIFACT")
+  ref=artifact~ref
+  if ref == .nil then return .WireUIDesignResult~failure("ARTIFACT_NOT_SEALED")
+  key=ref~key
+  if artifacts~hasIndex(key) then do
+    prior=artifacts[key]
+    if prior~ref~contentAddress \= ref~contentAddress then return .WireUIDesignResult~failure("ARTIFACT_IMMUTABILITY_CONFLICT",key)
+    return .WireUIDesignResult~success(prior,"ALREADY_REGISTERED")
+  end
+  artifacts[key]=artifact
+  if artifact~isA(.WireUIProjectionDesign) then do
+    pkey=artifact~profile"|"artifact~elementRef~artifactId
+    rows=projectionsByProfileElement[pkey]; if rows==.nil then do; rows=.array~new; projectionsByProfileElement[pkey]=rows; end
+    rows~append(artifact)
+  end
+  return .WireUIDesignResult~success(artifact)
+
+/* Apply one semantic authoring operation at exactly the revision it was based on. */
+::method applyOperation
+  expose revision operationLog operationsById
+  use arg operation
+  if \operation~isA(.WireUIDesignOperation) then return .WireUIDesignResult~failure("INVALID_DESIGN_OPERATION")
+  oid=operation~operationId
+  if operationsById~hasIndex(oid) then do
+    prior=operationsById[oid]
+    if prior~contentAddress=operation~contentAddress then return .WireUIDesignResult~success(prior,"OPERATION_ALREADY_APPLIED")
+    return .WireUIDesignResult~failure("OPERATION_ID_CONFLICT",oid)
+  end
+  if operation~expectedRevision \= revision then return .WireUIDesignResult~failure("DESIGN_REVISION_CONFLICT",operation~expectedRevision"|"revision)
+  verb=operation~verb
+  select
+    when verb="DESIGN.PROJECTION.SET_COMPONENT" then r=self~opProjectionSetComponent(operation)
+    when verb="DESIGN.PROJECTION.SET_MATERIAL" then r=self~opProjectionSetMaterial(operation)
+    when verb="DESIGN.MATERIAL.SET_TOKEN" then r=self~opMaterialSetToken(operation)
+    when verb="DESIGN.JOURNEY.SET_PREFETCH" then r=self~opJourneySetPrefetch(operation)
+    when verb="DESIGN.ELEMENT.SET_AUDIENCE" then r=self~opElementSetAudience(operation)
+    otherwise return .WireUIDesignResult~failure("UNSUPPORTED_DESIGN_OPERATION",verb)
+  end
+  if \r~ok then return r
+  operationLog~append(operation); operationsById[oid]=operation; revision += 1
+  return .WireUIDesignResult~success(r~value,"OPERATION_APPLIED")
+
+::method operations
+  expose operationLog
+  return .WireUIDesignUtil~copyArray(operationLog)
+::method operation
+  expose operationsById
+  use arg operationId
+  if operationsById~hasIndex(operationId) then return operationsById[operationId]
+  return .nil
+::method lineageFor
+  expose lineages
+  use arg artifactRef
+  if artifactRef==.nil then return .nil
+  if lineages~hasIndex(artifactRef~key) then return lineages[artifactRef~key]
+  return .nil
+
+::method artifact
+  expose artifacts
+  use arg kind,id,version
+  key=kind~string~translate":"id"@"version
+  if artifacts~hasIndex(key) then return artifacts[key]
+  return .nil
+::method projectionFor
+  expose projectionsByProfileElement
+  use arg profile, elementId, requestedVersion=""
+  key=profile~string~translate"|"elementId
+  rows=projectionsByProfileElement[key]
+  if rows==.nil then return .nil
+  if requestedVersion="" then do
+    if rows~items=1 then return rows[1]
+    return .nil /* ambiguous is safer than silently selecting latest */
+  end
+  do p over rows; if p~version=requestedVersion then return p; end
+  return .nil
+::method allArtifacts
+  expose artifacts
+  a=.array~new; keys=artifacts~allIndexes; keys~sort; do k over keys; a~append(artifacts[k]); end; return a
+::method lineages
+  expose lineages
+  a=.array~new; keys=lineages~allIndexes; keys~sort; do k over keys; a~append(lineages[k]); end; return a
+::method asWire
+  expose workspaceId revision basedOnReleaseRef basedOnGraphDigest
+  d=.table~new; d["workspaceId"]=workspaceId; d["revision"]=revision; d["basedOnGraphDigest"]=basedOnGraphDigest
+  if basedOnReleaseRef==.nil then d["basedOnReleaseRef"]=.nil; else d["basedOnReleaseRef"]=basedOnReleaseRef~asWire
+  ar=.array~new; do a over self~allArtifacts; ar~append(a~ref~asWire); end; d["artifactRefs"]=ar
+  oo=.array~new; do o over self~operations; oo~append(o~asWire); end; d["operations"]=oo
+  ll=.array~new; do l over self~lineages; ll~append(l~asWire); end; d["lineages"]=ll
+  return d
+
+::method opProjectionSetComponent private
+  use arg operation
+  prior=self~targetArtifact(operation,"PROJECTION"); if prior==.nil then return .WireUIDesignResult~failure("DESIGN_TARGET_NOT_FOUND")
+  p=operation~payload; nv=self~field(p,"newVersion","")~string~strip; cr=self~field(p,"componentRef",.nil)
+  if nv="" | nv=prior~version then return .WireUIDesignResult~failure("NEW_VERSION_REQUIRED")
+  if cr==.nil | \cr~isA(.WireUIArtifactRef) | cr~kind<>"COMPONENT" then return .WireUIDesignResult~failure("COMPONENT_REF_REQUIRED")
+  if self~artifact(cr~kind,cr~artifactId,cr~version)==.nil then return .WireUIDesignResult~failure("COMPONENT_NOT_REGISTERED",cr~key)
+  w=prior~asWire
+  derived=.WireUIProjectionDesign~new(prior~projectionId,nv,prior~profile,prior~elementRef,cr,prior~definitionId,w["action"],prior~styleRole,prior~materialRole,w["bindings"],w["metadata"],w["resourceBindings"],self~rowContractFromWire(w))
+  return self~registerDerived(derived,prior~ref,operation)
+
+::method opProjectionSetMaterial private
+  use arg operation
+  prior=self~targetArtifact(operation,"PROJECTION"); if prior==.nil then return .WireUIDesignResult~failure("DESIGN_TARGET_NOT_FOUND")
+  p=operation~payload; nv=self~field(p,"newVersion","")~string~strip
+  if nv="" | nv=prior~version then return .WireUIDesignResult~failure("NEW_VERSION_REQUIRED")
+  style=self~field(p,"styleRole",prior~styleRole); material=self~field(p,"materialRole",prior~materialRole); w=prior~asWire
+  derived=.WireUIProjectionDesign~new(prior~projectionId,nv,prior~profile,prior~elementRef,prior~componentRef,prior~definitionId,w["action"],style,material,w["bindings"],w["metadata"],w["resourceBindings"],self~rowContractFromWire(w))
+  return self~registerDerived(derived,prior~ref,operation)
+
+::method rowContractFromWire private
+  use arg wire
+  if wire~hasIndex("rowContract") then return .WireUIRowCollectionContract~fromWire(wire["rowContract"])
+  return .nil
+
+::method opMaterialSetToken private
+  use arg operation
+  prior=self~targetArtifact(operation,"MATERIAL"); if prior==.nil then return .WireUIDesignResult~failure("DESIGN_TARGET_NOT_FOUND")
+  p=operation~payload; nv=self~field(p,"newVersion","")~string~strip; name=self~field(p,"tokenName","")~string~strip
+  if nv="" | nv=prior~version then return .WireUIDesignResult~failure("NEW_VERSION_REQUIRED")
+  if name="" | \p~hasIndex("tokenValue") then return .WireUIDesignResult~failure("MATERIAL_TOKEN_REQUIRED")
+  w=prior~asWire; tokens=.WireUIDesignUtil~copyTable(w["tokens"]); tokens[name]=p["tokenValue"]
+  derived=.WireUIMaterialSet~new(prior~materialId,nv,tokens,w["recipes"])
+  return self~registerDerived(derived,prior~ref,operation)
+
+::method opJourneySetPrefetch private
+  use arg operation
+  prior=self~targetArtifact(operation,"JOURNEY"); if prior==.nil then return .WireUIDesignResult~failure("DESIGN_TARGET_NOT_FOUND")
+  p=operation~payload; nv=self~field(p,"newVersion","")~string~strip; stateId=self~field(p,"stateId","")~string~strip; elements=self~field(p,"elements",.nil)
+  if nv="" | nv=prior~version then return .WireUIDesignResult~failure("NEW_VERSION_REQUIRED")
+  if stateId="" | prior~state(stateId)==.nil | elements==.nil | \elements~isA(.Array) then return .WireUIDesignResult~failure("JOURNEY_PREFETCH_INPUT_INVALID")
+  derived=.WireUIJourneyDesign~new(prior~journeyId,nv,prior~initialState)
+  do sid over prior~stateIds
+    s=prior~state(sid); pref=s["PREFETCH"]; if sid=stateId then pref=elements
+    rr=derived~defineState(sid,s["ACTIVE"],pref,s["ON_DEMAND"]); if \rr~ok then return rr
+  end
+  do t over prior~transitions
+    rr=derived~allowTransition(t["fromState"],t["toState"],t["trigger"],t["purpose"]); if \rr~ok then return rr
+  end
+  rr=derived~seal; if \rr~ok then return rr
+  return self~registerDerived(derived,prior~ref,operation)
+
+::method opElementSetAudience private
+  use arg operation
+  prior=self~targetArtifact(operation,"ELEMENT"); if prior==.nil then return .WireUIDesignResult~failure("DESIGN_TARGET_NOT_FOUND")
+  p=operation~payload; nv=self~field(p,"newVersion","")~string~strip; audience=self~field(p,"audiencePolicyRef","")~string~strip
+  if nv="" | nv=prior~version then return .WireUIDesignResult~failure("NEW_VERSION_REQUIRED")
+  if audience="" then return .WireUIDesignResult~failure("AUDIENCE_POLICY_REQUIRED")
+  w=prior~asWire
+  derived=.WireUISemanticElement~new(prior~elementId,nv,prior~semanticType,w["fields"],w["actions"],audience,w["metadata"])
+  return self~registerDerived(derived,prior~ref,operation)
+
+::method targetArtifact private
+  use arg operation, expectedKind
+  r=operation~targetRef
+  if r==.nil | r~kind<>expectedKind then return .nil
+  return self~artifact(r~kind,r~artifactId,r~version)
+::method registerDerived private
+  expose lineages
+  use arg derived, predecessorRef, operation
+  rr=self~register(derived); if \rr~ok then return rr
+  lineage=.WireUIDesignLineage~new(derived~ref,predecessorRef,operation~ref,operation~evidenceRefs)
+  lineages[derived~ref~key]=lineage
+  return .WireUIDesignResult~success(derived,"DERIVED_ARTIFACT_REGISTERED")
+::method field private
+  use arg t,k,default=.nil
+  if t==.nil then return default
+  if t~hasIndex(k) then return t[k]
+  return default
+
+::requires "WireUIProjectionDesign.cls"
+::requires "WireUIMaterialSet.cls"
+::requires "WireUIJourneyDesign.cls"
+::requires "WireUISemanticElement.cls"
+::requires "WireUIDesignOperation.cls"
+::requires "WireUIDesignLineage.cls"
+::requires "WireUIDesignSupport.cls"
+
+::requires "WireUIRowCollectionContract.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIExperiment.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIExperiment.cls
new file mode 100644
index 0000000000000000000000000000000000000000..cde7d852afb8def21c81dba0dd3745dbbc8baa97
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIExperiment.cls
@@ -0,0 +1,53 @@
+/* Element-centric A/B experiment: exact projection variants for one semantic element. */
+::class WireUIExperiment subclass AlchemyObject public
+::attribute experimentId get
+::attribute version get
+::attribute targetElementId get
+::attribute assignmentUnit get
+::attribute contentAddress get
+::method init
+  expose experimentId version targetElementId assignmentUnit variants totalWeight contentAddress sealed
+  use arg experimentId, version, targetElementId, assignmentUnit="USER"
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned element-centric UI experiment"))
+  experimentId=experimentId~string~strip; version=version~string~strip; targetElementId=targetElementId~string~strip; assignmentUnit=assignmentUnit~string~strip~translate
+  variants=.array~new; totalWeight=0; contentAddress=""; sealed=.false
+  if experimentId="" | version="" | targetElementId="" then raise syntax 93.906 array("experiment", experimentId)
+::method addVariant
+  expose variants totalWeight sealed targetElementId
+  use arg variantId, weight, projectionRef
+  if sealed then return .WireUIDesignResult~failure("EXPERIMENT_SEALED")
+  if weight <= 0 then return .WireUIDesignResult~failure("INVALID_VARIANT_WEIGHT",weight)
+  if \projectionRef~isA(.WireUIArtifactRef) then return .WireUIDesignResult~failure("INVALID_PROJECTION_REF")
+  v=.table~new; v["variantId"]=variantId; v["weight"]=weight; v["projectionRef"]=projectionRef
+  variants~append(v); totalWeight += weight
+  return .WireUIDesignResult~success(self)
+::method seal
+  expose variants sealed contentAddress
+  if variants~items < 2 then return .WireUIDesignResult~failure("EXPERIMENT_NEEDS_VARIANTS")
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText); sealed=.true
+  return .WireUIDesignResult~success(self)
+::method assign
+  expose variants totalWeight sealed
+  use arg subjectKey
+  numeric digits 20
+  if \sealed then return .WireUIDesignResult~failure("EXPERIMENT_NOT_SEALED")
+  bucket=.WireUIDesignUtil~hashNumber(subjectKey~string || "|" || self~canonicalText) // totalWeight
+  cursor=0
+  do v over variants
+    cursor += v["weight"]
+    if bucket < cursor then return .WireUIDesignResult~success(v)
+  end
+  return .WireUIDesignResult~success(variants[variants~items])
+::method variants
+  expose variants
+  a=.array~new; do v over variants; c=.table~new; c["variantId"]=v["variantId"]; c["weight"]=v["weight"]; c["projectionRef"]=v["projectionRef"]; a~append(c); end; return a
+::method canonicalText
+  expose experimentId version targetElementId assignmentUnit variants
+  text=experimentId"|"version"|"targetElementId"|"assignmentUnit
+  do v over variants; text ||= "|"v["variantId"]":"v["weight"]":"v["projectionRef"]~canonicalText; end
+  return text
+::method ref
+  expose experimentId version contentAddress sealed
+  if \sealed then return .nil
+  return .WireUIArtifactRef~new("EXPERIMENT",experimentId,version,contentAddress)
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIJourneyDesign.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIJourneyDesign.cls
new file mode 100644
index 0000000000000000000000000000000000000000..25bb675568f944f70c14a8d99298c51da810ef75
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIJourneyDesign.cls
@@ -0,0 +1,116 @@
+/* Journey authoring uses semantic element identities, not pages or DOM nodes.
+   A journey may contain named flows. Flows group journey states; they are not
+   independent applications or detached flow artifacts. State ids remain
+   journey-unique so the existing WIRE-UI/0.1 runtime can flatten safely.
+
+   v0.11 also makes conditional journey edges first-class. Conditions are exact
+   semantic CONDITION artifact ids evaluated authoritatively by a capable
+   runtime (or explicitly by an authoring preview scenario). The browser never
+   owns transition predicates. */
+::class WireUIJourneyDesign subclass AlchemyObject public
+::attribute journeyId get
+::attribute version get
+::attribute initialState get
+::attribute initialFlowId get
+::attribute contentAddress get
+::method init
+  expose journeyId version initialState initialFlowId states transitions flows contentAddress sealed
+  use arg journeyId, version, initialState, initialFlowId=""
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned semantic customer journey design"))
+  journeyId=journeyId~string~strip; version=version~string~strip; initialState=initialState~string~strip; initialFlowId=initialFlowId~string~strip
+  states=.table~new; transitions=.table~new; flows=.table~new; sealed=.false; contentAddress=""
+  if journeyId="" | version="" | initialState="" then raise syntax 93.906 array("journey", journeyId)
+::method defineFlow
+  expose flows sealed
+  use arg flowId, flowInitialState, metadata=.nil
+  if sealed then return .WireUIDesignResult~failure("JOURNEY_SEALED")
+  flowId=flowId~string~strip; flowInitialState=flowInitialState~string~strip
+  if flowId="" | flowInitialState="" then return .WireUIDesignResult~failure("JOURNEY_FLOW_ID_INITIAL_REQUIRED")
+  f=.table~new; f["flowId"]=flowId; f["initialState"]=flowInitialState; f["metadata"]=.WireUIDesignUtil~copyTable(metadata); flows[flowId]=f
+  return .WireUIDesignResult~success(self)
+::method defineState
+  expose states sealed flows
+  use arg stateId, active=.nil, prefetch=.nil, onDemand=.nil, flowId=""
+  if sealed then return .WireUIDesignResult~failure("JOURNEY_SEALED")
+  stateId=stateId~string~strip; flowId=flowId~string~strip
+  if stateId="" then return .WireUIDesignResult~failure("JOURNEY_STATE_ID_REQUIRED")
+  if flowId<>"" & flows~items>0 & \flows~hasIndex(flowId) then return .WireUIDesignResult~failure("JOURNEY_STATE_FLOW_UNDEFINED",flowId)
+  s=.table~new; s["ACTIVE"]=.WireUIDesignUtil~copyArray(active); s["PREFETCH"]=.WireUIDesignUtil~copyArray(prefetch); s["ON_DEMAND"]=.WireUIDesignUtil~copyArray(onDemand); s["flowId"]=flowId
+  states[stateId]=s
+  return .WireUIDesignResult~success(self)
+::method allowTransition
+  expose transitions sealed
+  use arg fromState,toState,trigger="",purpose="",whenConditionIds=.nil,suppressConditionIds=.nil,whenMode="ALL"
+  if sealed then return .WireUIDesignResult~failure("JOURNEY_SEALED")
+  fromState=fromState~string~strip; toState=toState~string~strip; trigger=trigger~string~strip; purpose=purpose~string~strip
+  whenMode=whenMode~string~strip~translate
+  if fromState="" | toState="" then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_STATES_REQUIRED")
+  if whenMode<>"ALL" & whenMode<>"ANY" then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_WHEN_MODE_INVALID",whenMode)
+  whenConditionIds=.WireUIDesignUtil~copyArray(whenConditionIds); suppressConditionIds=.WireUIDesignUtil~copyArray(suppressConditionIds)
+  do ids over .array~of(whenConditionIds,suppressConditionIds)
+    do cid over ids
+      if cid~string~strip="" then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_CONDITION_ID_REQUIRED")
+    end
+  end
+  t=.table~new; t["fromState"]=fromState; t["toState"]=toState; t["trigger"]=trigger; t["purpose"]=purpose
+  t["whenMode"]=whenMode; t["whenConditionIds"]=whenConditionIds; t["suppressConditionIds"]=suppressConditionIds
+  /* Trigger participates in identity so a journey may expose more than one
+     semantic route between the same state pair without accidental overwrite. */
+  transitions[fromState"|"toState"|"trigger]=t
+  return .WireUIDesignResult~success(self)
+::method seal
+  expose states initialState initialFlowId flows transitions sealed contentAddress
+  if \states~hasIndex(initialState) then return .WireUIDesignResult~failure("INITIAL_STATE_UNDEFINED",initialState)
+  if flows~items>0 then do
+    if initialFlowId="" | \flows~hasIndex(initialFlowId) then return .WireUIDesignResult~failure("JOURNEY_INITIAL_FLOW_UNDEFINED",initialFlowId)
+    do fid over flows~allIndexes
+      f=flows[fid]; sid=f["initialState"]
+      if \states~hasIndex(sid) then return .WireUIDesignResult~failure("JOURNEY_FLOW_INITIAL_STATE_UNDEFINED",fid"|"sid)
+      if states[sid]["flowId"]<>fid then return .WireUIDesignResult~failure("JOURNEY_FLOW_INITIAL_STATE_MISMATCH",fid"|"sid)
+    end
+    do sid over states~allIndexes
+      fid=states[sid]["flowId"]
+      if fid="" | \flows~hasIndex(fid) then return .WireUIDesignResult~failure("JOURNEY_STATE_FLOW_REQUIRED",sid)
+    end
+  end
+  do tk over transitions~allIndexes
+    t=transitions[tk]
+    if \states~hasIndex(t["fromState"]) then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_FROM_STATE_UNDEFINED",t["fromState"])
+    if \states~hasIndex(t["toState"]) then return .WireUIDesignResult~failure("JOURNEY_TRANSITION_TO_STATE_UNDEFINED",t["toState"])
+  end
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText); sealed=.true
+  return .WireUIDesignResult~success(self)
+::method isSealed
+  expose sealed; return sealed
+::method state
+  expose states; use arg stateId; if states~hasIndex(stateId) then return states[stateId]; return .nil
+::method stateIds
+  expose states; a=states~allIndexes; a~sort; return a
+::method flow
+  expose flows; use arg flowId; if flows~hasIndex(flowId) then return .WireUIDesignUtil~copyTable(flows[flowId]); return .nil
+::method flowIds
+  expose flows; a=flows~allIndexes; a~sort; return a
+::method flows
+  expose flows; a=.array~new; keys=flows~allIndexes; keys~sort; do k over keys; a~append(.WireUIDesignUtil~copyTable(flows[k])); end; return a
+::method transitions
+  expose transitions; a=.array~new; keys=transitions~allIndexes; keys~sort; do k over keys; a~append(.WireUIDesignUtil~copyTable(transitions[k])); end; return a
+::method canonicalText
+  expose journeyId version initialState initialFlowId states transitions flows
+  text=journeyId"|"version"|"initialState"|"initialFlowId"|"
+  fkeys=flows~allIndexes; fkeys~sort; do k over fkeys; text ||= "F:"k":".WireUIDesignUtil~canonicalTable(flows[k])"|"; end
+  keys=states~allIndexes; keys~sort
+  do k over keys
+    s=states[k]; text ||= "S:"k":"s["flowId"]":".WireUIDesignUtil~canonicalArray(s["ACTIVE"] )":".WireUIDesignUtil~canonicalArray(s["PREFETCH"] )":".WireUIDesignUtil~canonicalArray(s["ON_DEMAND"] )"|"
+  end
+  tkeys=transitions~allIndexes; tkeys~sort; do k over tkeys; text ||= "T:"k":".WireUIDesignUtil~canonicalTable(transitions[k])"|"; end
+  return text
+::method ref
+  expose journeyId version contentAddress sealed
+  if \sealed then return .nil
+  return .WireUIArtifactRef~new("JOURNEY",journeyId,version,contentAddress)
+::method asWire
+  expose journeyId version initialState initialFlowId states contentAddress sealed
+  d=.table~new; d["journeyId"]=journeyId; d["version"]=version; d["initialState"]=initialState; d["initialFlowId"]=initialFlowId; d["flows"]=self~flows; d["contentAddress"]=contentAddress; d["sealed"]=sealed
+  ss=.array~new; keys=states~allIndexes; keys~sort; do k over keys; r=.table~new; r["stateId"]=k; r["flowId"]=states[k]["flowId"]; r["ACTIVE"]=.WireUIDesignUtil~copyArray(states[k]["ACTIVE"]); r["PREFETCH"]=.WireUIDesignUtil~copyArray(states[k]["PREFETCH"]); r["ON_DEMAND"]=.WireUIDesignUtil~copyArray(states[k]["ON_DEMAND"]); ss~append(r); end
+  d["states"]=ss; d["transitions"]=self~transitions; return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIMaterialSet.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIMaterialSet.cls
new file mode 100644
index 0000000000000000000000000000000000000000..d36296026b5b4ffed406869d0e468f86de822597
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIMaterialSet.cls
@@ -0,0 +1,26 @@
+/* Versioned design-system material tokens and recipes. */
+::class WireUIMaterialSet subclass AlchemyObject public
+::attribute materialId get
+::attribute version get
+::attribute contentAddress get
+::method init
+  expose materialId version tokens recipes contentAddress
+  use arg materialId, version, tokens=.nil, recipes=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned site material/design-system set"))
+  materialId=materialId~string~strip; version=version~string~strip
+  if materialId="" | version="" then raise syntax 93.906 array("material set", materialId)
+  tokens=.WireUIDesignUtil~copyTable(tokens); recipes=.WireUIDesignUtil~copyTable(recipes)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("materialId","PUBLIC","stable material/design-system identity")
+  self~registerStateVariable("version","PUBLIC","immutable material set version")
+::method canonicalText
+  expose materialId version tokens recipes
+  return materialId"|"version"|".WireUIDesignUtil~canonicalTable(tokens)"|".WireUIDesignUtil~canonicalTable(recipes)
+::method ref
+  expose materialId version contentAddress
+  return .WireUIArtifactRef~new("MATERIAL",materialId,version,contentAddress)
+::method asWire
+  expose materialId version tokens recipes contentAddress
+  d=.table~new; d["materialId"]=materialId; d["version"]=version; d["tokens"]=.WireUIDesignUtil~copyTable(tokens); d["recipes"]=.WireUIDesignUtil~copyTable(recipes); d["contentAddress"]=contentAddress
+  return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPresentationPolicy.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPresentationPolicy.cls
new file mode 100644
index 0000000000000000000000000000000000000000..2fdfdd5ab246a51a3a3f873622e548a2e96f6225
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPresentationPolicy.cls
@@ -0,0 +1,27 @@
+/* Arbitration for simultaneously-valid conditional placements. */
+::class WireUIPresentationPolicy subclass AlchemyObject public
+::attribute policyId get
+::attribute version get
+::attribute contentAddress get
+::method init
+  expose policyId version precedence capacities metadata contentAddress
+  use arg policyId, version, precedence=.nil, capacities=.nil, metadata=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned presentation arbitration policy"))
+  policyId=policyId~string~strip; version=version~string~strip
+  if policyId="" | version="" then raise syntax 93.906 array("presentation policy",policyId)
+  precedence=.WireUIDesignUtil~copyArray(precedence); capacities=.WireUIDesignUtil~copyTable(capacities); metadata=.WireUIDesignUtil~copyTable(metadata)
+  do k over capacities~allIndexes
+    n=capacities[k]+0
+    if n<0 | n<>n~trunc then raise syntax 93.914 array("presentation capacity",k)
+  end
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+::method canonicalText
+  expose policyId version precedence capacities metadata
+  return policyId"|"version"|".WireUIDesignUtil~canonicalArray(precedence)"|".WireUIDesignUtil~canonicalTable(capacities)"|".WireUIDesignUtil~canonicalTable(metadata)
+::method ref
+  expose policyId version contentAddress
+  return .WireUIArtifactRef~new("PRESENTATION_POLICY",policyId,version,contentAddress)
+::method asWire
+  expose policyId version precedence capacities metadata contentAddress
+  d=.table~new; d["policyId"]=policyId; d["version"]=version; d["precedence"]=.WireUIDesignUtil~copyArray(precedence); d["capacities"]=.WireUIDesignUtil~copyTable(capacities); d["metadata"]=.WireUIDesignUtil~copyTable(metadata); d["contentAddress"]=contentAddress; return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewEvidence.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewEvidence.cls
new file mode 100644
index 0000000000000000000000000000000000000000..41ff00a3a212a5b8b6999890bd1a51a687660a54
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewEvidence.cls
@@ -0,0 +1,42 @@
+/* Browser-produced evidence that lets a human/AI inspect what was actually rendered. */
+::class WireUIPreviewEvidence subclass AlchemyObject public
+::attribute evidenceId get
+::attribute version get
+::attribute releaseRef get
+::attribute scenarioRef get
+::attribute manifestContentAddress get
+::attribute screenshotContentAddress get
+::attribute semanticCaptureContentAddress get
+::attribute contentAddress get
+::method init
+  expose evidenceId version releaseRef scenarioRef manifestContentAddress screenshotContentAddress semanticCaptureContentAddress viewport elementGeometry materialObservation contentAddress
+  use arg evidenceId, version, releaseRef, scenarioRef, manifestContentAddress, screenshotContentAddress, semanticCaptureContentAddress, viewport=.nil, elementGeometry=.nil, materialObservation=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Rendered preview evidence bound to exact Wire UI release and scenario"))
+  evidenceId=evidenceId~string~strip; version=version~string~strip
+  manifestContentAddress=manifestContentAddress~string~strip; screenshotContentAddress=screenshotContentAddress~string~strip; semanticCaptureContentAddress=semanticCaptureContentAddress~string~strip
+  if evidenceId="" | version="" | manifestContentAddress="" | screenshotContentAddress="" | semanticCaptureContentAddress="" then raise syntax 93.906 array("preview evidence",evidenceId)
+  if \releaseRef~isA(.WireUIArtifactRef) | \scenarioRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("preview evidence refs")
+  viewport=.WireUIDesignUtil~copyTable(viewport); elementGeometry=.WireUIDesignUtil~copyTable(elementGeometry); materialObservation=.WireUIDesignUtil~copyTable(materialObservation)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("releaseRef","PUBLIC","exact site release observed by renderer")
+  self~registerStateVariable("scenarioRef","PUBLIC","exact multi-user preview scenario observed by renderer")
+  self~registerStateVariable("screenshotContentAddress","PUBLIC","content address of rendered raster capture")
+::method canonicalText
+  expose evidenceId version releaseRef scenarioRef manifestContentAddress screenshotContentAddress semanticCaptureContentAddress viewport elementGeometry materialObservation
+  return evidenceId"|"version"|"releaseRef~canonicalText"|"scenarioRef~canonicalText"|"manifestContentAddress"|"screenshotContentAddress"|"semanticCaptureContentAddress"|".WireUIDesignUtil~canonicalTable(viewport)"|".WireUIDesignUtil~canonicalTable(elementGeometry)"|".WireUIDesignUtil~canonicalTable(materialObservation)
+::method verifyBinding
+  expose releaseRef scenarioRef manifestContentAddress
+  use arg compiledPackage, scenario, previewManifest
+  if releaseRef~contentAddress \= compiledPackage~releaseRef~contentAddress then return .WireUIDesignResult~failure("EVIDENCE_RELEASE_MISMATCH")
+  if scenarioRef~contentAddress \= scenario~ref~contentAddress then return .WireUIDesignResult~failure("EVIDENCE_SCENARIO_MISMATCH")
+  if \previewManifest~hasIndex("manifestContentAddress") then return .WireUIDesignResult~failure("EVIDENCE_MANIFEST_ADDRESS_MISSING")
+  if manifestContentAddress \= previewManifest["manifestContentAddress"] then return .WireUIDesignResult~failure("EVIDENCE_MANIFEST_MISMATCH")
+  return .WireUIDesignResult~success(self,"EVIDENCE_BOUND")
+::method ref
+  expose evidenceId version contentAddress
+  return .WireUIArtifactRef~new("PREVIEW_EVIDENCE",evidenceId,version,contentAddress)
+::method asWire
+  expose evidenceId version releaseRef scenarioRef manifestContentAddress screenshotContentAddress semanticCaptureContentAddress viewport elementGeometry materialObservation contentAddress
+  d=.table~new; d["evidenceId"]=evidenceId; d["version"]=version; d["releaseRef"]=releaseRef~asWire; d["scenarioRef"]=scenarioRef~asWire; d["manifestContentAddress"]=manifestContentAddress; d["screenshotContentAddress"]=screenshotContentAddress; d["semanticCaptureContentAddress"]=semanticCaptureContentAddress; d["viewport"]=.WireUIDesignUtil~copyTable(viewport); d["elementGeometry"]=.WireUIDesignUtil~copyTable(elementGeometry); d["materialObservation"]=.WireUIDesignUtil~copyTable(materialObservation); d["contentAddress"]=contentAddress
+  return d
+::requires "WireUIPreviewScenario.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewMatrix.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewMatrix.cls
new file mode 100644
index 0000000000000000000000000000000000000000..d1830d8e21908038ab52ed624ed927d8b36a0272
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewMatrix.cls
@@ -0,0 +1,52 @@
+/* Exact multi-user preview matrix over one immutable compiled release. */
+::class WireUIPreviewMatrix subclass AlchemyObject public
+::attribute matrixId get
+::attribute version get
+::attribute releaseRef get
+::attribute contentAddress get
+::method init
+  expose matrixId version releaseRef scenarios sealed contentAddress
+  use arg matrixId, version, releaseRef
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned multi-user Wire UI preview matrix"))
+  matrixId=matrixId~string~strip; version=version~string~strip; scenarios=.table~new; sealed=.false; contentAddress=""
+  if matrixId="" | version="" | \releaseRef~isA(.WireUIArtifactRef) then raise syntax 93.906 array("preview matrix",matrixId)
+::method addScenario
+  expose releaseRef scenarios sealed contentAddress
+  use arg scenario
+  if sealed then return .WireUIDesignResult~failure("PREVIEW_MATRIX_SEALED")
+  if \scenario~isA(.WireUIPreviewScenario) then return .WireUIDesignResult~failure("INVALID_PREVIEW_SCENARIO")
+  if scenario~releaseRef~contentAddress \= releaseRef~contentAddress then return .WireUIDesignResult~failure("PREVIEW_MATRIX_RELEASE_MISMATCH",scenario~scenarioId)
+  key=scenario~scenarioId"@"scenario~version
+  if scenarios~hasIndex(key) then do
+    prior=scenarios[key]; if prior~ref~contentAddress \= scenario~ref~contentAddress then return .WireUIDesignResult~failure("PREVIEW_SCENARIO_CONFLICT",key)
+    return .WireUIDesignResult~success(prior,"ALREADY_ADDED")
+  end
+  scenarios[key]=scenario; contentAddress=""; return .WireUIDesignResult~success(scenario)
+::method scenarios
+  expose scenarios
+  a=.array~new; keys=scenarios~allIndexes; keys~sort; do k over keys; a~append(scenarios[k]); end; return a
+::method seal
+  expose scenarios sealed contentAddress
+  if scenarios~items=0 then return .WireUIDesignResult~failure("EMPTY_PREVIEW_MATRIX")
+  contentAddress=.WireUIDesignUtil~strongToken(self~canonicalText); sealed=.true; return .WireUIDesignResult~success(self)
+::method execute
+  expose sealed
+  use arg compiler, workspace, compiledPackage
+  if \sealed then return .WireUIDesignResult~failure("PREVIEW_MATRIX_NOT_SEALED")
+  out=.table~new
+  do scenario over self~scenarios
+    r=compiler~previewManifest(workspace,compiledPackage,scenario)
+    if \r~ok then return .WireUIDesignResult~failure("PREVIEW_MATRIX_SCENARIO_FAILED",scenario~scenarioId"|"r~code)
+    out[scenario~scenarioId]=r~value
+  end
+  return .WireUIDesignResult~success(out,"PREVIEW_MATRIX_COMPLETE")
+::method canonicalText
+  expose matrixId version releaseRef scenarios
+  text=matrixId"|"version"|"releaseRef~canonicalText
+  keys=scenarios~allIndexes; keys~sort; do k over keys; text ||= "|"scenarios[k]~ref~canonicalText; end
+  return text
+::method ref
+  expose matrixId version contentAddress
+  if contentAddress="" then return .nil
+  return .WireUIArtifactRef~new("PREVIEW_MATRIX",matrixId,version,contentAddress)
+::requires "WireUIPreviewScenario.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewScenario.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewScenario.cls
new file mode 100644
index 0000000000000000000000000000000000000000..ad30dfa03e06cd66fa107fff5b291cf489ec5269
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIPreviewScenario.cls
@@ -0,0 +1,64 @@
+/* Multi-user/version/profile preview input. Identity is test context, not authority.
+   v0.11 adds explicit CONDITION outcomes for authoring-time simulation. These are
+   preview facts only: they do not make the browser authoritative and are never
+   substituted for a production fact/decision service. */
+::class WireUIPreviewScenario subclass AlchemyObject public
+::attribute scenarioId get
+::attribute version get
+::attribute subjectId get
+::attribute authenticated get
+::attribute profile get
+::attribute journeyState get
+::attribute releaseRef get
+::attribute contentAddress get
+::method init
+  expose scenarioId version subjectId authenticated profile journeyState releaseRef experimentAssignments conditionOutcomeMap attributes contentAddress
+  use arg scenarioId, version, subjectId, authenticated, profile, journeyState, releaseRef, attributes=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Exact multi-user Wire UI preview/test scenario"))
+  scenarioId=scenarioId~string~strip; version=version~string~strip; subjectId=subjectId~string~strip; profile=profile~string~strip~translate; journeyState=journeyState~string~strip
+  experimentAssignments=.table~new; conditionOutcomeMap=.table~new; attributes=.WireUIDesignUtil~copyTable(attributes)
+  if scenarioId="" | version="" | subjectId="" | profile="" | journeyState="" then raise syntax 93.906 array("preview scenario",scenarioId)
+  if \releaseRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("releaseRef")
+  contentAddress=""
+::method assignExperiment
+  expose experimentAssignments contentAddress
+  use arg experimentId, variantId
+  experimentAssignments[experimentId]=variantId; contentAddress=""; return self
+::method assignments
+  expose experimentAssignments
+  return .WireUIDesignUtil~copyTable(experimentAssignments)
+::method setConditionOutcome
+  expose conditionOutcomeMap contentAddress
+  use arg conditionId, outcome
+  conditionId=conditionId~string~strip
+  if conditionId="" then raise syntax 93.906 array("conditionId",conditionId)
+  normalized=self~normalizeConditionOutcome(outcome)
+  if normalized="" then raise syntax 93.914 array("conditionOutcome",outcome)
+  conditionOutcomeMap[conditionId]=normalized; contentAddress=""; return self
+::method conditionOutcome
+  expose conditionOutcomeMap
+  use arg conditionId
+  conditionId=conditionId~string~strip
+  if conditionOutcomeMap~hasIndex(conditionId) then return conditionOutcomeMap[conditionId]
+  return "UNKNOWN"
+::method conditionOutcomes
+  expose conditionOutcomeMap
+  return .WireUIDesignUtil~copyTable(conditionOutcomeMap)
+::method normalizeConditionOutcome private
+  use arg outcome
+  if outcome==.true then return "TRUE"
+  if outcome==.false then return "FALSE"
+  s=outcome~string~strip~translate
+  if s="TRUE" | s="FALSE" | s="UNKNOWN" then return s
+  return ""
+::method seal
+  expose contentAddress
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText); return self
+::method canonicalText
+  expose scenarioId version subjectId authenticated profile journeyState releaseRef experimentAssignments conditionOutcomeMap attributes
+  return scenarioId"|"version"|"subjectId"|"authenticated"|"profile"|"journeyState"|"releaseRef~canonicalText"|".WireUIDesignUtil~canonicalTable(experimentAssignments)"|".WireUIDesignUtil~canonicalTable(conditionOutcomeMap)"|".WireUIDesignUtil~canonicalTable(attributes)
+::method ref
+  expose scenarioId version contentAddress
+  if contentAddress="" then self~seal
+  return .WireUIArtifactRef~new("PREVIEW_SCENARIO",scenarioId,version,contentAddress)
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIProjectionDesign.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIProjectionDesign.cls
new file mode 100644
index 0000000000000000000000000000000000000000..7e9b34a6f0e4d426bdf5cefba344a4e5c9e2a35c
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIProjectionDesign.cls
@@ -0,0 +1,60 @@
+/* Exact profile projection from a semantic element into a visual/agent component. */
+::class WireUIProjectionDesign subclass AlchemyObject public
+::attribute projectionId get
+::attribute version get
+::attribute profile get
+::attribute elementRef get
+::attribute componentRef get
+::attribute definitionId get
+::attribute styleRole get
+::attribute materialRole get
+::attribute contentAddress get
+::attribute rowContract get
+::method init
+  expose projectionId version profile elementRef componentRef definitionId action styleRole materialRole bindings metadata resourceBindings rowContract contentAddress
+  use arg projectionId, version, profile, elementRef, componentRef, definitionId, action="", styleRole="", materialRole="", bindings=.nil, metadata=.nil, resources=.nil, rowContract=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned semantic-to-access-point projection"))
+  projectionId=projectionId~string~strip; version=version~string~strip; profile=profile~string~strip~translate; definitionId=definitionId~string~strip
+  if projectionId="" | version="" | profile="" | definitionId="" then raise syntax 93.906 array("projection", projectionId)
+  if \elementRef~isA(.WireUIArtifactRef) | \componentRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("projection refs")
+  action=action~string~strip; styleRole=styleRole~string~strip; materialRole=materialRole~string~strip
+  bindings=.WireUIDesignUtil~copyTable(bindings); metadata=.WireUIDesignUtil~copyTable(metadata)
+  resourceBindings=.array~new
+  if resources<>.nil then do row over resources; resourceBindings~append(self~normaliseResourceBinding(row)); end
+  if rowContract<>.nil & \rowContract~isA(.WireUIRowCollectionContract) then raise syntax 93.948 array("row collection contract")
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("projectionId","PUBLIC","stable projection identity")
+  self~registerStateVariable("version","PUBLIC","immutable projection version")
+  self~registerStateVariable("profile","PUBLIC","interaction profile selected by this projection")
+::method normaliseResourceBinding private
+  use arg row
+  if row==.nil | \(row~isA(.Table) | row~isA(.Directory)) then raise syntax 93.948 array("resource binding")
+  role=""; if row~hasIndex("role") then role=row["role"]~string~strip~translate
+  if role="" then raise syntax 93.906 array("resource binding role",projectionId)
+  rr=.nil
+  if row~hasIndex("resourceRef") then do
+    source=row["resourceRef"]
+    if source~isA(.WireUIResourceRef) then rr=source; else rr=.WireUIResourceRef~fromWire(source)
+  end
+  if rr==.nil then raise syntax 93.906 array("resourceRef",role)
+  d=.table~new; d["role"]=role; d["resourceRef"]=rr~asWire
+  required=.true; if row~hasIndex("required") then required=row["required"]
+  d["required"]=required
+  return d
+::method resourceBindings
+  expose resourceBindings
+  a=.array~new; do row over resourceBindings; a~append(.WireUIDesignUtil~copyTable(row)); end; return a
+::method canonicalText
+  expose projectionId version profile elementRef componentRef definitionId action styleRole materialRole bindings metadata resourceBindings rowContract
+  rowText=""; if rowContract<>.nil then rowText=rowContract~canonicalText
+  return projectionId"|"version"|"profile"|"elementRef~canonicalText"|"componentRef~canonicalText"|"definitionId"|"action"|"styleRole"|"materialRole"|".WireUIDesignUtil~canonicalTable(bindings)"|".WireUIDesignUtil~canonicalTable(metadata)"|".WireUIDesignUtil~canonicalArray(resourceBindings)"|"rowText
+::method ref
+  expose projectionId version contentAddress
+  return .WireUIArtifactRef~new("PROJECTION",projectionId,version,contentAddress)
+::method asWire
+  expose projectionId version profile elementRef componentRef definitionId action styleRole materialRole bindings metadata resourceBindings rowContract contentAddress
+  d=.table~new; d["projectionId"]=projectionId; d["version"]=version; d["profile"]=profile; d["elementRef"]=elementRef~asWire; d["componentRef"]=componentRef~asWire; d["definitionId"]=definitionId; d["action"]=action; d["styleRole"]=styleRole; d["materialRole"]=materialRole; d["bindings"]=.WireUIDesignUtil~copyTable(bindings); d["metadata"]=.WireUIDesignUtil~copyTable(metadata); d["resourceBindings"]=self~resourceBindings; if rowContract<>.nil then d["rowContract"]=rowContract~asWire; d["contentAddress"]=contentAddress
+  return d
+::requires "WireUIDesignSupport.cls"
+::requires "WireUIResourceRef.cls"
+::requires "WireUIRowCollectionContract.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRenderObservation.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRenderObservation.cls
