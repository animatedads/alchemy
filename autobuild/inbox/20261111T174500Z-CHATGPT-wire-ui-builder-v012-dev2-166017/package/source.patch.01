index 0000000000000000000000000000000000000000..fd56b0db22cb5710e366d93c0cd1c1c3662a4ceb
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRenderObservation.cls
@@ -0,0 +1,74 @@
+/* Renderer-correlated structural evidence: exact semantic meaning -> exact rendered instance. */
+::class WireUIRenderElementObservation subclass AlchemyObject public
+::attribute renderInstanceId get
+::attribute semanticRef get
+::attribute semanticInstanceId get
+::attribute projectionRef get
+::attribute componentRef get
+::attribute contentAddress get
+::method init
+  expose renderInstanceId semanticRef semanticInstanceId projectionRef componentRef materialRef bounds visible clipped enabled focused role accessibleName diagnostics contentAddress
+  use arg renderInstanceId, semanticRef, semanticInstanceId, projectionRef, componentRef, materialRef=.nil, bounds=.nil, visible=.true, clipped=.false, enabled=.true, focused=.false, role="", accessibleName="", diagnostics=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Exact rendered Wire UI element observation"))
+  renderInstanceId=renderInstanceId~string~strip; semanticInstanceId=semanticInstanceId~string~strip; role=role~string; accessibleName=accessibleName~string
+  if renderInstanceId="" | semanticInstanceId="" then raise syntax 93.906 array("render observation instance",renderInstanceId)
+  if \semanticRef~isA(.WireUIArtifactRef) | \projectionRef~isA(.WireUIArtifactRef) | \componentRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("render observation refs")
+  if materialRef<>.nil then if \materialRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("materialRef")
+  bounds=.WireUIDesignUtil~copyTable(bounds); diagnostics=.WireUIDesignUtil~copyArray(diagnostics)
+  contentAddress=.WireUIDesignUtil~strongToken(self~canonicalText)
+::method canonicalText
+  expose renderInstanceId semanticRef semanticInstanceId projectionRef componentRef materialRef bounds visible clipped enabled focused role accessibleName diagnostics
+  mr=""; if materialRef<>.nil then mr=materialRef~canonicalText
+  return renderInstanceId"|"semanticRef~canonicalText"|"semanticInstanceId"|"projectionRef~canonicalText"|"componentRef~canonicalText"|"mr"|".WireUIDesignUtil~canonicalTable(bounds)"|"visible"|"clipped"|"enabled"|"focused"|"role"|"accessibleName"|".WireUIDesignUtil~canonicalArray(diagnostics)
+::method asWire
+  expose renderInstanceId semanticRef semanticInstanceId projectionRef componentRef materialRef bounds visible clipped enabled focused role accessibleName diagnostics contentAddress
+  d=.table~new; d["renderInstanceId"]=renderInstanceId; d["semanticRef"]=semanticRef~asWire; d["semanticInstanceId"]=semanticInstanceId; d["projectionRef"]=projectionRef~asWire; d["componentRef"]=componentRef~asWire
+  if materialRef==.nil then d["materialRef"]=.nil; else d["materialRef"]=materialRef~asWire
+  d["bounds"]=.WireUIDesignUtil~copyTable(bounds); d["visible"]=visible; d["clipped"]=clipped; d["enabled"]=enabled; d["focused"]=focused; d["role"]=role; d["accessibleName"]=accessibleName; d["diagnostics"]=.WireUIDesignUtil~copyArray(diagnostics); d["contentAddress"]=contentAddress; return d
+
+::class WireUIRenderObservation subclass AlchemyObject public+::attribute observationId get
+::attribute version get
+::attribute releaseRef get
+::attribute scenarioRef get
+::attribute rendererRef get
+::attribute manifestContentAddress get
+::attribute contentAddress get
+::method init
+  expose observationId version releaseRef scenarioRef rendererRef manifestContentAddress viewport elements sealed contentAddress
+  use arg observationId, version, releaseRef, scenarioRef, rendererRef, manifestContentAddress, viewport=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Renderer/version-correlated Wire UI structural observation"))
+  observationId=observationId~string~strip; version=version~string~strip; manifestContentAddress=manifestContentAddress~string~strip
+  if observationId="" | version="" | manifestContentAddress="" then raise syntax 93.906 array("render observation",observationId)
+  if \releaseRef~isA(.WireUIArtifactRef) | \scenarioRef~isA(.WireUIArtifactRef) | \rendererRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("render observation refs")
+  if releaseRef~contentAddress="" | scenarioRef~contentAddress="" | rendererRef~contentAddress="" then raise syntax 93.906 array("render observation unsealed ref",observationId)
+  viewport=.WireUIDesignUtil~copyTable(viewport); elements=.array~new; sealed=.false; contentAddress=""
+  self~registerStateVariable("releaseRef","PUBLIC","exact site release rendered")
+  self~registerStateVariable("scenarioRef","PUBLIC","exact preview subject/scenario rendered")
+  self~registerStateVariable("rendererRef","PUBLIC","exact renderer implementation/build observed")
+::method addElement
+  expose elements sealed contentAddress
+  use arg element
+  if sealed then return .WireUIDesignResult~failure("RENDER_OBSERVATION_SEALED")
+  if \element~isA(.WireUIRenderElementObservation) then return .WireUIDesignResult~failure("INVALID_RENDER_ELEMENT_OBSERVATION")
+  elements~append(element); contentAddress=""; return .WireUIDesignResult~success(element)
+::method elements
+  expose elements
+  return .WireUIDesignUtil~copyArray(elements)
+::method seal
+  expose contentAddress sealed
+  contentAddress=.WireUIDesignUtil~strongToken(self~canonicalText); sealed=.true; return .WireUIDesignResult~success(self)
+::method canonicalText
+  expose observationId version releaseRef scenarioRef rendererRef manifestContentAddress viewport elements
+  text=observationId"|"version"|"releaseRef~canonicalText"|"scenarioRef~canonicalText"|"rendererRef~canonicalText"|"manifestContentAddress"|".WireUIDesignUtil~canonicalTable(viewport)
+  do e over elements; text ||= "|"e~canonicalText; end
+  return text
+::method ref
+  expose observationId version contentAddress
+  if contentAddress="" then return .nil
+  return .WireUIArtifactRef~new("RENDER_OBSERVATION",observationId,version,contentAddress)
+::method asWire
+  expose observationId version releaseRef scenarioRef rendererRef manifestContentAddress viewport elements contentAddress
+  d=.table~new; d["observationId"]=observationId; d["version"]=version; d["releaseRef"]=releaseRef~asWire; d["scenarioRef"]=scenarioRef~asWire; d["rendererRef"]=rendererRef~asWire; d["manifestContentAddress"]=manifestContentAddress; d["viewport"]=.WireUIDesignUtil~copyTable(viewport)
+  a=.array~new; do e over elements; a~append(e~asWire); end; d["elements"]=a; d["contentAddress"]=contentAddress; return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIResourceRef.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIResourceRef.cls
new file mode 100644
index 0000000000000000000000000000000000000000..8d937f1a7f9f42fbb41f31ba993cfaa9effa07c1
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIResourceRef.cls
@@ -0,0 +1,36 @@
+/*
+  Exact reference to a resource authored outside Wire UI Builder.
+
+  The Builder never owns resource bytes and never offers arbitrary display-copy
+  authoring. A Resource Editor (or another resource authority) publishes the
+  resource; Builder projections only bind this immutable identity.
+*/
+::class WireUIResourceRef public
+::attribute resourceId get
+::attribute version get
+::attribute contentAddress get
+::attribute resourceClass get
+::attribute locale get
+::method init
+  expose resourceId version contentAddress resourceClass locale
+  use arg resourceId, version, contentAddress, resourceClass="STRUCTURED", locale=""
+  resourceId=resourceId~string~strip; version=version~string~strip; contentAddress=contentAddress~string~strip
+  resourceClass=resourceClass~string~strip~translate; locale=locale~string~strip
+  if resourceId="" | version="" | contentAddress="" then raise syntax 93.906 array("fixed resource reference",resourceId)
+  if \(.set~of("TEXT","GRAPHIC","AUDIO","VIDEO","STRUCTURED","COMPOUND","OTHER")~hasIndex(resourceClass)) then raise syntax 93.914 array("resourceClass",resourceClass)
+::method canonicalText
+  expose resourceId version contentAddress resourceClass locale
+  return resourceId"|"version"|"contentAddress"|"resourceClass"|"locale
+::method asWire
+  expose resourceId version contentAddress resourceClass locale
+  d=.table~new; d["resourceId"]=resourceId; d["version"]=version; d["contentAddress"]=contentAddress; d["resourceClass"]=resourceClass; d["locale"]=locale; return d
+::method fromWire class
+  use arg row
+  if row==.nil | \(row~isA(.Table) | row~isA(.Directory)) then raise syntax 93.948 array("resourceRef")
+  id=""; if row~hasIndex("resourceId") then id=row["resourceId"]; else if row~hasIndex("id") then id=row["id"]
+  v=""; if row~hasIndex("version") then v=row["version"]
+  ca=""; if row~hasIndex("contentAddress") then ca=row["contentAddress"]
+  rc="STRUCTURED"; if row~hasIndex("resourceClass") then rc=row["resourceClass"]
+  locale=""; if row~hasIndex("locale") then locale=row["locale"]
+  return self~new(id,v,ca,rc,locale)
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRowCollectionContract.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRowCollectionContract.cls
new file mode 100644
index 0000000000000000000000000000000000000000..ecbee823e67c9f80b24bbd7d5731e12801f71ef3
--- /dev/null
+++ b/wire_ui_builder_v0.12-dev2-readiness/src/WireUIRowCollectionContract.cls
@@ -0,0 +1,105 @@
+/*
+ * Declarative authoritative row-collection contract.
+ *
+ * This is authoring/runtime metadata only. It never grants authority. The
+ * server still owns workspace/query/selection/result state and validates every
+ * semantic action. The contract prevents renderers from guessing row identity,
+ * field order, collection count, or filter/sort semantics.
+ */
+::class WireUIRowCollectionContract subclass AlchemyObject public
+::attribute collectionSlot get
+::attribute countSlot get
+::attribute identityField get
+::attribute rowFields get
+::attribute selectionMode get
+::attribute selectedIdsSlot get
+::attribute workspaceContextSlot get
+::attribute emptyPolicy get
+::attribute filterFields get
+::attribute sortFields get
+::attribute rowAction get
+::attribute selectionAction get
+::attribute filterAction get
+::attribute sortAction get
+::attribute contentAddress get
+
+::method init
+  expose collectionSlot countSlot identityField rowFields selectionMode selectedIdsSlot workspaceContextSlot emptyPolicy filterFields sortFields rowAction selectionAction filterAction sortAction contentAddress
+  use arg collectionSlot, identityField, rowFields=.nil, countSlot="", selectionMode="NONE", selectedIdsSlot="selectedIds", workspaceContextSlot="workspaceContext", emptyPolicy="ALLOW_EMPTY", filterFields=.nil, sortFields=.nil, rowAction="", selectionAction="", filterAction="", sortAction=""
+  self~init:super(.WireUIDesignAlchemy~metadata("Declarative authoritative row collection contract"))
+
+  collectionSlot=collectionSlot~string~strip
+  countSlot=countSlot~string~strip
+  identityField=identityField~string~strip
+  selectionMode=selectionMode~string~strip~translate
+  selectedIdsSlot=selectedIdsSlot~string~strip
+  workspaceContextSlot=workspaceContextSlot~string~strip
+  emptyPolicy=emptyPolicy~string~strip~translate
+  rowAction=rowAction~string~strip
+  selectionAction=selectionAction~string~strip
+  filterAction=filterAction~string~strip
+  sortAction=sortAction~string~strip
+
+  if collectionSlot="" then raise syntax 93.906 array("row collection slot",collectionSlot)
+  if identityField="" then raise syntax 93.906 array("row identity field",identityField)
+  if selectionMode<>"NONE" & selectionMode<>"SINGLE" & selectionMode<>"MULTI" then raise syntax 93.914 array("selectionMode",selectionMode)
+  if emptyPolicy<>"ALLOW_EMPTY" & emptyPolicy<>"FAIL_CLOSED" then raise syntax 93.914 array("emptyPolicy",emptyPolicy)
+  if selectionMode<>"NONE" & selectedIdsSlot="" then raise syntax 93.906 array("selectedIdsSlot",selectedIdsSlot)
+
+  rowFields=self~normaliseNames(rowFields,"row field")
+  filterFields=self~normaliseNames(filterFields,"filter field")
+  sortFields=self~normaliseNames(sortFields,"sort field")
+  if rowFields~items=0 then raise syntax 93.906 array("row fields",identityField)
+
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("collectionSlot","PUBLIC","explicit authoritative collection slot")
+  self~registerStateVariable("identityField","PUBLIC","stable semantic row identity field")
+  self~registerStateVariable("contentAddress","PUBLIC","deterministic row contract content address")
+
+::method normaliseNames private
+  use arg values, label
+  out=.array~new; seen=.set~new
+  if values==.nil then return out
+  do value over values
+    name=value~string~strip
+    if name="" then raise syntax 93.906 array(label,name)
+    if seen~hasIndex(name) then raise syntax 93.900 array(label" duplicate",name)
+    seen~put(name); out~append(name)
+  end
+  return out
+
+::method canonicalText
+  expose collectionSlot countSlot identityField rowFields selectionMode selectedIdsSlot workspaceContextSlot emptyPolicy filterFields sortFields rowAction selectionAction filterAction sortAction
+  return collectionSlot"|"countSlot"|"identityField"|".WireUIDesignUtil~canonicalArray(rowFields)"|"selectionMode"|"selectedIdsSlot"|"workspaceContextSlot"|"emptyPolicy"|".WireUIDesignUtil~canonicalArray(filterFields)"|".WireUIDesignUtil~canonicalArray(sortFields)"|"rowAction"|"selectionAction"|"filterAction"|"sortAction
+
+::method asWire
+  expose collectionSlot countSlot identityField rowFields selectionMode selectedIdsSlot workspaceContextSlot emptyPolicy filterFields sortFields rowAction selectionAction filterAction sortAction contentAddress
+  d=.table~new
+  d["collectionSlot"]=collectionSlot
+  d["countSlot"]=countSlot
+  d["identityField"]=identityField
+  d["rowFields"]=.WireUIDesignUtil~copyArray(rowFields)
+  d["selectionMode"]=selectionMode
+  d["selectedIdsSlot"]=selectedIdsSlot
+  d["workspaceContextSlot"]=workspaceContextSlot
+  d["emptyPolicy"]=emptyPolicy
+  d["filterFields"]=.WireUIDesignUtil~copyArray(filterFields)
+  d["sortFields"]=.WireUIDesignUtil~copyArray(sortFields)
+  d["rowAction"]=rowAction
+  d["selectionAction"]=selectionAction
+  d["filterAction"]=filterAction
+  d["sortAction"]=sortAction
+  d["contentAddress"]=contentAddress
+  return d
+
+::method fromWire class
+  use arg d
+  if d==.nil | \(d~isA(.Table) | d~isA(.Directory)) then return .nil
+  return self~new(self~field(d,"collectionSlot",""),self~field(d,"identityField",""),self~field(d,"rowFields",.nil),self~field(d,"countSlot",""),self~field(d,"selectionMode","NONE"),self~field(d,"selectedIdsSlot","selectedIds"),self~field(d,"workspaceContextSlot","workspaceContext"),self~field(d,"emptyPolicy","ALLOW_EMPTY"),self~field(d,"filterFields",.nil),self~field(d,"sortFields",.nil),self~field(d,"rowAction",""),self~field(d,"selectionAction",""),self~field(d,"filterAction",""),self~field(d,"sortAction",""))
+
+::method field class private
+  use arg d,n,default
+  if d~hasIndex(n) then return d[n]
+  return default
+
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.12-dev2-readiness/src/WireUISemanticElement.cls b/wire_ui_builder_v0.12-dev2-readiness/src/WireUISemanticElement.cls
