+.wui-builder-placement-card[data-wire-placement-align="START"]{align-self:start}.wui-builder-placement-card[data-wire-placement-align="CENTER"]{align-self:center}.wui-builder-placement-card[data-wire-placement-align="END"]{align-self:end}
+.wui-builder-flow-card{width:210px!important;min-height:155px!important}.wui-builder-flow-thumb{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:12px;gap:2px;align-content:start;min-height:42px;padding:5px;border:1px solid #d9e2ef;border-radius:5px;background-color:#f8fbff;background-image:linear-gradient(90deg,rgba(122,145,177,.08) 1px,transparent 1px);background-size:8.333% 100%}
