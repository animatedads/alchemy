+.wui-builder-inspector{border-top:3px solid #376eb8!important}.wui-builder-placement-selected{outline:3px solid rgba(47,103,184,.32)!important;box-shadow:0 0 0 2px #fff,0 8px 20px rgba(36,94,169,.18)!important}.wui-builder-placement-selected .wui-builder-placement-title{color:#0a468e}
