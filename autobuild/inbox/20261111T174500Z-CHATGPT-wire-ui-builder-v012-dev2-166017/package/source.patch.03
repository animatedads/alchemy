+.wui-builder-flow-map{display:flex!important;position:relative;gap:10px!important;align-items:stretch!important;overflow-x:auto!important;padding-top:38px!important;scroll-snap-type:x proximity}
+.wui-builder-flow-map::before{position:absolute!important;left:14px;top:14px;margin:0!important}.wui-builder-flow-map>.wui-builder-flow-card{flex:0 0 210px;width:210px!important;scroll-snap-align:start}
+@media(max-width:1100px){.wui-builder-studio-region[data-wire-studio-region]{grid-column:1/-1!important}}
+
+/* v0.9 designer ergonomics. These controls only emit typed Builder operations;
