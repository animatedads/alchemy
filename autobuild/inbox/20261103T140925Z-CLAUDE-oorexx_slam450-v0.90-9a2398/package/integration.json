{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "oorexx_slam450",
    "version": "0.90",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "PHYSICS_WORLD_ROOT": "${REPO_ROOT}/packages/oorexx_physics_world_v0.1-dev51",
      "MATHS_ROOT": "${REPO_ROOT}/packages/oorexx_maths_v0.20",
      "COMPRESS_ROOT": "${REPO_ROOT}/packages/oorexx_compress_v0.1-dev3",
      "ANTHROPIC_PROVIDER_ROOT": "${REPO_ROOT}/packages/oorexx_ai_provider_anthropic_v0.3",
      "FOREIGN_RUNTIME_ROOT": "${REPO_ROOT}/packages/oorexx_foreign_runtime_v0.22.6",
      "LD_LIBRARY_PATH": "${REPO_ROOT}/packages/oorexx_foreign_runtime_v0.22.6/build:/usr/local/lib:/usr/lib",
      "PYTHONPATH": "${REPO_ROOT}/packages/oorexx_maths_v0.20/python:${REPO_ROOT}/packages/oorexx_compress_v0.1-dev3/python"
    },
    "rexx_path": {
      "mode": "replace",
      "entries": [
        "${PACKAGE_ROOT}/src",
        "${REPO_ROOT}/packages/oorexx_physics_world_v0.1-dev51/rexx",
        "${REPO_ROOT}/packages/oorexx_maths_v0.20/rexx",
        "${REPO_ROOT}/packages/oorexx_foreign_runtime_v0.22.6/rexx",
        "${REPO_ROOT}/packages/oorexx_compress_v0.1-dev3/src",
        "${REPO_ROOT}/packages/oorexx_compress_v0.1-dev3/foreign",
        "${REPO_ROOT}/packages/oorexx_ai_provider_anthropic_v0.3/src",
        "${REPO_ROOT}/packages/alchemy_objects_v0.8/src",
        "${REPO_ROOT}/packages/oorexx_ai_access_v0.6/src",
        "${REPO_ROOT}/packages/oorexx_secret_broker_v0.2/src",
        "${REPO_ROOT}/packages/oorexx_crypto_v0.1/src"
      ],
      "require_entries": true
    },
    "require_dirs": [
      "PHYSICS_WORLD_ROOT",
      "MATHS_ROOT",
      "COMPRESS_ROOT",
      "ANTHROPIC_PROVIDER_ROOT"
    ],
    "report": [
      "PHYSICS_WORLD_ROOT",
      "MATHS_ROOT",
      "COMPRESS_ROOT",
      "ANTHROPIC_PROVIDER_ROOT"
    ]
  },
  "tests": [
    {
