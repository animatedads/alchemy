    {
      "name": "trio-quad-wing-race30-auditors",
      "argv": [
        "sh",
        "-c",
        "d=$(mktemp -d) && rexx bin/race450_trio.rex $d/race 45046 LEGACY 30 WIND BATTERY AUTO FIXED_WING PURE; rc=$?; test $rc -eq 0 -o $rc -eq 5 && python3 tests/audit_battery450.py $d/race >/dev/null && python3 tests/audit_aircraft_type450.py $d/race >/dev/null && python3 tests/audit_trio450.py $d/race --scene evidence/powerslam_v040_scene_ORACLE_ONLY.csv --camera-mode battery --out $d/g.json >/dev/null"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "squad-standin-race30-auditors",
      "argv": [
        "sh",
        "-c",
        "d=$(mktemp -d) && rexx bin/race450_squad.rex $d/race 45046 LEGACY 30 WIND BATTERY AUTO STANDIN EYES PURE OFF; rc=$?; test $rc -eq 0 -o $rc -eq 5 && python3 tests/audit_battery450.py $d/race >/dev/null && python3 tests/audit_aircraft_type450.py $d/race >/dev/null && python3 tests/audit_squad450.py $d/race --scene evidence/powerslam_v040_scene_ORACLE_ONLY.csv >/dev/null"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "squad-backseat-moving-race40-auditors",
      "argv": [
        "sh",
        "-c",
        "d=$(mktemp -d) && rexx bin/race450_squad.rex $d/race 45046 LEGACY 40 WIND BATTERY AUTO NONE EYES PURE OFF BACKSEAT MOVING NOMAP; rc=$?; test $rc -eq 0 -o $rc -eq 5 && python3 tests/audit_battery450.py $d/race >/dev/null && python3 tests/audit_aircraft_type450.py $d/race >/dev/null && python3 tests/audit_squad450.py $d/race --scene evidence/powerslam_v040_scene_ORACLE_ONLY.csv >/dev/null && python3 tests/audit_movers450.py $d/race --scene evidence/powerslam_v040_scene_ORACLE_ONLY.csv >/dev/null"
      ],
