# testimony.src - when Boston Crab's testimony policies apply in Diplomacy.
#   setting | value
# Architecture: Tom Dyer ("especially late game", 27 Nov 2026). This file: Claude (Opus 5.5).
# SELF-SERVING undercuts a promise not to take one of my centres from a power
# that can reach it, but only late in the game or when the sender is near a
# solo: earlier it would leave every neighbour's promise CANNOT TELL.
self_serving_from_year|1907
self_serving_solo_near|14
# IMPEACHMENT and ACCOMPLICE need a documented lie or attack, so they apply at
# any time, for as long as the ledger keeps the lie (two game years).
impeachment_years|2
