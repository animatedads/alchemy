{
  "kind": "access-policy",
  "id": "oorexx-access",
  "version": "0.1",
  "rules": [
    {
      "effect": "allow",
      "roles": [
        "llm",
        "operator"
      ],
      "actions": [
        "read",
        "exec"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "capability:*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "service:*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "read"
      ],
      "resource": "corpus:*"
    }
  ]
}
