{
  "kind": "access-policy",
  "id": "flylo-access",
  "version": "0.1",
  "rules": [
    {
      "effect": "allow",
      "roles": [
        "operator"
      ],
      "actions": [
        "read",
        "exec"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm"
      ],
      "actions": [
        "read"
      ],
      "resource": "*"
    }
  ]
}
