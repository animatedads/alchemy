{
  "schema": "alchemy.autobuild.integration/0.2",
  "package": {
    "name": "oorexx_crypto",
    "version": "0.1",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {},
    "prepend_path": []
  },
  "tests": [
    {
      "name": "prepare-authoritative-source",
      "argv": ["bash", "prepare_source.sh"],
      "timeout_seconds": 60
    },
    {
      "name": "verify-release-manifest",
      "argv": ["sha256sum", "-c", "MANIFEST.sha256"],
      "cwd": "release",
      "timeout_seconds": 60
    },
    {
      "name": "crypto-test-battery",
      "argv": ["bash", "run_tests.sh"],
      "cwd": "release",
      "timeout_seconds": 900
    }
  ],
  "publish": {
    "tree": {
      "source": "release",
      "path": "packages/oorexx_crypto_v0.1"
    },
    "files": [
      {
        "source": "release/src/crypto.cls",
        "path": "packages/oorexx_crypto_v0.1/src/crypto.cls",
        "when": "pass"
      },
      {
        "source": "release/benchmarks/benchmark_fast_mac.rex",
        "path": "packages/oorexx_crypto_v0.1/benchmarks/benchmark_fast_mac.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_asymmetric_misc.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_asymmetric_misc.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_chacha20.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_chacha20.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_ed25519.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_ed25519.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_hashes.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_hashes.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_hmac_sha512.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_hmac_sha512.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_input_validation.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_input_validation.rex",
        "when": "pass"
      },
      {
        "source": "release/tests/test_siphash128.rex",
        "path": "packages/oorexx_crypto_v0.1/tests/test_siphash128.rex",
        "when": "pass"
      }
    ]
  }
}
