{
  "schema": "alchemy.autobuild.integration/0.2",
  "package": {
    "name": "oorexx_crypto",
    "version": "0.1",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "REXX_PATH": "${PACKAGE_ROOT}/src"
    },
    "prepend_path": []
  },
  "tests": [
    {
      "name": "prepare-source",
      "argv": ["bash", "prepare_source.sh"],
      "timeout_seconds": 60
    },
    {
      "name": "manifest",
      "argv": ["sha256sum", "-c", "MANIFEST.sha256"],
      "timeout_seconds": 60
    },
    {
      "name": "crypto-test-battery",
      "argv": ["bash", "run_tests.sh"],
      "timeout_seconds": 900
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/oorexx_crypto_v0.1"
    },
    "files": [
      {
        "source": "src/crypto.cls",
        "path": "packages/oorexx_crypto_v0.1/src/crypto.cls",
        "when": "pass"
      }
    ]
  }
}
