      "name": "authenticated-ledger",
      "argv": ["rexx", "tests/test_authenticated_ledger.rex"],
      "timeout_seconds": 600,
      "environment": {
        "set": {
          "WLU_SRC": "${PACKAGE_ROOT}/src",
          "CRYPTO_SRC": "${REPO_ROOT}/packages/oorexx_crypto_v0.1/src"
        },
        "rexx_path": {
          "mode": "replace",
          "entries": ["${PACKAGE_ROOT}/src", "${REPO_ROOT}/packages/oorexx_crypto_v0.1/src"],
          "require_entries": true
        },
        "require_dirs": ["WLU_SRC", "CRYPTO_SRC"],
        "report": ["WLU_SRC", "CRYPTO_SRC"]
      }
