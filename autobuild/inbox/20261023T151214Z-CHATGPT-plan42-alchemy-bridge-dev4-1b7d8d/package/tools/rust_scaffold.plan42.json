{
  "spec": "1.1",
  "module": "RustScaffoldDemo",
  "description": "Small Plan42 program used to statically guard the Python-side Rust scaffold backend.",
  "nodes": [
    {
      "op": "const",
      "name": "GREETING",
      "type": "str",
      "value": {"op": "literal", "value": "hello", "type": "str"}
    },
    {
      "op": "routine",
      "name": "double",
      "params": ["x"],
      "param_types": {"x": "int"},
      "return_type": "int",
      "body": [
        {"op": "return", "expr": {"op": "mul", "left": {"op": "var", "name": "x", "type": "int"}, "right": {"op": "literal", "value": 2, "type": "int"}}}
      ]
    },
    {
      "op": "routine",
      "name": "main",
      "params": ["name"],
      "param_types": {"name": "str"},
      "body": [
        {"op": "declare", "name": "n", "type": "int", "value": {"op": "literal", "value": 21, "type": "int"}},
        {"op": "output", "expr": {"op": "format", "template": "{greeting} {name}", "args": {"greeting": {"op": "var", "name": "GREETING", "type": "str"}, "name": {"op": "var", "name": "name", "type": "str"}}}},
        {"op": "if", "cond": {"op": "eq", "left": {"op": "call", "routine": "double", "args": [{"op": "var", "name": "n", "type": "int"}]}, "right": {"op": "literal", "value": 42, "type": "int"}}, "body": [
          {"op": "output", "expr": {"op": "literal", "value": "logic preserved", "type": "str"}}
        ], "else_body": [
          {"op": "output", "expr": {"op": "literal", "value": "logic broken", "type": "str"}}
        ]},
        {"op": "for_range", "var": "i", "from": {"op": "literal", "value": 0, "type": "int"}, "to": {"op": "literal", "value": 3, "type": "int"}, "body": [
          {"op": "output", "expr": {"op": "format", "template": "i={i}", "args": {"i": {"op": "var", "name": "i", "type": "int"}}}}
        ]},
        {"op": "for_each", "var": "item", "in": {"op": "literal", "value": ["a", "b", "c"], "type": "list"}, "body": [
          {"op": "output", "expr": {"op": "format", "template": "item={item}", "args": {"item": {"op": "var", "name": "item", "type": "str"}}}}
        ]}
      ]
    }
  ]
}
