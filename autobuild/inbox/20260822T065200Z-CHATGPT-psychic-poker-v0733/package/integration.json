{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "psychic_poker",
    "version": "0.7.33",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {},
    "prepend_path": [],
    "rexx_path": {
      "mode": "replace",
      "entries": [
        "${PACKAGE_ROOT}",
        "${PACKAGE_ROOT}/nosqlserver/src"
      ],
      "require_entries": true
    }
  },
  "tests": [
    {
      "name": "psychic-poker-regression-suite",
      "argv": ["sh", "run_tests.sh"],
      "timeout_seconds": 600
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/psychic_poker_v0.7.33"
    }
  }
}
