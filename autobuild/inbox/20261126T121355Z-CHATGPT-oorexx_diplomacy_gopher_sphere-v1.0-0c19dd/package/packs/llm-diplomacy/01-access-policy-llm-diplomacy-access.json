{
  "kind": "access-policy",
  "id": "llm-diplomacy-access",
  "version": "1.0",
  "rules": [
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "reviewer",
        "admin"
