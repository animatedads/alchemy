{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "wire_ui_builder",
    "version": "0.6-ergonomics9-http-front-qualification",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "tests": [
    {
      "name": "prepare",
      "argv": ["bash", "prepare_package.sh"],
      "timeout_seconds": 60
    },
    {
      "name": "manifest",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && sha256sum -c MANIFEST.sha256"],
      "timeout_seconds": 60
    },
    {
      "name": "builder-web-shell",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && bash tests/test_builder_web_shell.sh"],
      "timeout_seconds": 60
    },
    {
      "name": "session-readiness",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && node tests/test_session_readiness.mjs"],
      "timeout_seconds": 60
    },
    {
      "name": "composition-controller",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && node tests/test_composition_controller.mjs"],
      "timeout_seconds": 60
    },
    {
      "name": "notnotes-web-preview",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && node tests/test_notnotes_web_preview.mjs"],
      "timeout_seconds": 60
    },
    {
      "name": "notnotes-live-bootstrap",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && node tests/test_notnotes_live_web_bootstrap.mjs"],
      "timeout_seconds": 60
    },
    {
      "name": "http-front-tools-syntax",
      "argv": ["bash", "-lc", "cd prepared/wire_ui_builder_v0.6 && bash -n tools/capture_http_front_contract.sh tools/compare_http_front_contract.sh"],
      "timeout_seconds": 60
    }
  ],
  "publish": {
    "tree": {
      "source": "prepared/wire_ui_builder_v0.6",
      "path": "packages/wire_ui_builder_v0.6-ergonomics9-http-front-qualification"
    }
  }
}