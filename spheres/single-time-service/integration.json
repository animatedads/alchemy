{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "single_time_service_sphere",
    "version": "0.1",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "tests": [
    {
      "name": "sphere-static-qualification",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 60
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "spheres/single-time-service"
    }
  }
}
