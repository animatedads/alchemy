{
  "kind": "access-policy",
  "id": "federationbank-access",
  "version": "0.2",
  "rules": [
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "read"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "capability:archive.zip.*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "service:core.archive.zip.*"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "capability:corpus.record.lookup"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "service:core.corpus.record.lookup"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "capability:crypto.sha256"
    },
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "exec"
      ],
      "resource": "service:core.crypto.sha256"
    }
  ]
}
