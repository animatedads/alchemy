{
  "kind": "access-policy",
  "id": "rx2cpp-access",
  "version": "0.5",
  "rules": [
    {
      "effect": "allow",
      "roles": [
        "llm",
        "developer",
        "operator",
        "admin"
      ],
      "actions": [
        "read",
        "exec"
      ],
      "resource": "*"
    }
  ]
}
