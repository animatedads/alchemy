{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "semantic_source_control_gopher_sphere",
    "version": "0.1-dev4",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "tests": [
    {
      "name": "manifest",
      "argv": [
        "sha256sum",
        "--check",
        "--quiet",
        "MANIFEST.sha256"
      ],
      "timeout_seconds": 30
    },
    {
      "name": "json-documents",
      "argv": [
        "rexx",
        "tests/check_sphere_json.rex",
        "."
      ],
      "timeout_seconds": 60
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "spheres/semantic_source_control_gopher_sphere_v0.1-dev4"
    }
  }
}
