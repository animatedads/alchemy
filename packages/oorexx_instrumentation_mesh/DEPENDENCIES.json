  "source_protocol": [
    "snapshot(observedAt)",
    "snapshots(observedAt)",
    "instrumentationSnapshot(observedAt)",
    "relationshipSet(observedAt)",
    "relationshipSets(observedAt)",
    "events(observedAt)"
  ],
  "policy": "Qualification fails closed when a direct class-file requirement cannot be resolved through REXX_PATH. Services retain semantic authority; Instrumentation Mesh observes and carries facts without becoming a service-specific management authority.",
  "qualified_consumers": [
    {
      "name": "Wire3D / Keynote Global NOC",
      "package_line": "0.1-dev29.23",
      "contract": "InstrumentationCollector latest/history/series/publicationEvidence + relationship sets/history + operational event history + explicit correlation view + semantic_ref",
      "authority": "read-only consumer projection; source events/correlation context retain explicit provenance; deployment/static topology and incident/change lifecycles remain separately authoritative"
    }
  ],
  "relationship_contract": {
    "schemas": [
      "instrumentation.relationship/1",
      "instrumentation.relationship-set/1"
    ],
    "current_semantics": "complete sets replace current view only for exact authority + scope_id",
    "history": "bounded full-set history retained by collector",
    "authority": "relationship meaning and mutation remain with named domain authority; Instrumentation does not infer topology or withdrawals"
  },
  "event_contract": {
    "schema": "instrumentation.event/1",
    "publication": "optional replayable bounded source-event array",
    "dedupe": "authority + event_id",
    "queries": [
      "EVENTS",
      "EVENTS_HISTORY"
    ],
    "derived_authority": "INSTRUMENTATION_OBSERVER",
    "derived_semantics": "change in accepted observation evidence only; never source-domain mutation authority",
    "optional_additions": [
      "causation_id",
      "context_refs"
    ],
    "compatibility": "dev7 instrumentation.event/1 records lacking causation_id/context_refs remain valid dev8 input"
  },
  "correlation_contract": {
    "schema": "instrumentation.correlation/1",
    "api": "instrumentation.correlation/0.1",
    "basis": "EXPLICIT_CORRELATION_ID",
    "ordering": "COLLECTOR_ACCEPTANCE_ORDER",
    "joins": "non-empty producer-supplied correlation_id only",
    "never_infers_from": [
      "observed_at",
      "host/node",
      "MI",
      "service kind",
      "severity",
      "geography",
      "relationship proximity"
    ],
    "causation": "producer-supplied causation_id retained; unresolved references remain unresolved",
    "context": "producer-supplied context_refs retained as semantic evidence",
    "authority": "READ_ONLY_CORRELATION_VIEW; incident/change/deployment/remediation authority remains external"
  }
}
