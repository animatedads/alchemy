  "eventSchemas": [
    "instrumentation.event/1"
  ],
  "eventSemantics": "source authority retained; collector-derived observation changes explicitly use INSTRUMENTATION_OBSERVER and derived=true; causation_id/context_refs are optional source-declared evidence",
  "correlationSchemas": [
    "instrumentation.correlation/1"
  ],
  "correlationSemantics": "read-only grouping by explicit non-empty source-supplied correlation_id in collector acceptance order; no temporal/topological inference or incident/change authority"
}
