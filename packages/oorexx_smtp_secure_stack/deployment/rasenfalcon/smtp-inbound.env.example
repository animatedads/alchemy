RF_SMTP_HOST=0.0.0.0
RF_SMTP_PORT=25
RF_SMTP_LOCAL_DOMAINS=rasenfalcon.com
RF_SMTP_STORE_ROOT=/var/lib/rasenfalcon-mail/store
RF_SMTP_CATALOGUE_PATH=/var/lib/rasenfalcon-mail/catalogue.tsv
RF_SMTP_CERT_FILE=/etc/rasenfalcon/tls/mail-chain.pem
RF_SMTP_KEY_FILE=/etc/rasenfalcon/tls/mail-key.pem
RF_SMTP_BRIDGE_DIR=/opt/rasenfalcon/smtp/bridge
RF_SMTP_READY_FILE=/run/rasenfalcon-mail/smtp.ready
RF_SMTP_BANNER=mail.rasenfalcon.com
# Optional S/MIME trust anchor for signed inbound classification.
RF_SMTP_SMIME_CA_FILE=/etc/rasenfalcon/tls/mail-smime-ca.pem
RF_SMTP_TEMP_ROOT=/run/rasenfalcon-mail
RF_SMTP_OPENSSL=openssl
