{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.derived.evidence/0.1",
  "title": "Media Derived Evidence",
  "type": "object",
  "required": [
    "schema", "methodology_id", "implementation_id", "authority_effect",
    "source_refs", "output_ref", "time_support", "parameters"
  ],
  "properties": {
    "schema": {"const": "media.derived.evidence/0.1"},
    "methodology_id": {"type": "string"},
    "implementation_id": {"type": "string"},
    "authority_effect": {"enum": ["PRESERVE", "MEASURE", "RECONSTRUCT", "HYPOTHESIZE", "VISUALIZE"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "output_ref": {"type": ["string", "null"]},
    "time_support": {
      "type": "object",
      "required": ["clock"],
      "properties": {
        "clock": {"type": "string"},
        "start": {"type": ["number", "string", "null"]},
        "end": {"type": ["number", "string", "null"]}
      },
      "additionalProperties": true
    },
    "coordinate_system": {"type": ["string", "null"]},
    "transform_refs": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "support_map_ref": {"type": ["string", "null"]},
    "synthetic_mask_ref": {"type": ["string", "null"]},
    "uncertainty_ref": {"type": ["string", "null"]},
    "controls": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["DERIVED", "CANDIDATE", "HYPOTHESIS", "VISUALIZATION"]}
  },
  "additionalProperties": true
}
