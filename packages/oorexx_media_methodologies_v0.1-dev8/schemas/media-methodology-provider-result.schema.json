    "output_ref": {
      "type": "string"
    },
    "support_map_ref": {
      "type": "string"
    },
    "uncertainty_ref": {
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "source_evidence_ref": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    }
