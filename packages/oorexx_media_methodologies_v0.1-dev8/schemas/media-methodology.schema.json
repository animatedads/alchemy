{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.methodology.spec/0.1",
  "title": "Media Methodology Specification",
  "type": "object",
  "required": [
    "id", "name", "domain", "family", "maturity", "authority_effect",
    "experimental", "reconstructive", "principle", "input_kinds",
    "output_kinds", "assumptions", "failure_modes", "required_controls",
    "source_preservation", "uncertainty_required", "allowed_claim",
    "forbidden_claim", "composition_tags"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "domain": {"enum": ["VIDEO", "AUDIO", "CROSS_MODAL", "VALIDATION"]},
    "family": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["ESTABLISHED", "QUALIFIED_PATTERN", "EXPERIMENTAL", "MODEL_ASSISTED", "FORENSIC_CAUTIOUS"]},
    "authority_effect": {"enum": ["PRESERVE", "MEASURE", "RECONSTRUCT", "HYPOTHESIZE", "VISUALIZE"]},
    "experimental": {"type": "boolean"},
    "reconstructive": {"type": "boolean"},
    "principle": {"type": "string", "minLength": 1},
    "input_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "output_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_controls": {"type": "array", "items": {"type": "string"}},
    "source_preservation": {"const": "MANDATORY"},
    "uncertainty_required": {"type": "boolean"},
    "allowed_claim": {"type": "string"},
    "forbidden_claim": {"type": "string"},
    "composition_tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
