{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-methodology-experiment.schema.json",
  "title": "Media Methodology Experiment",
  "type": "object",
  "required": ["experiment_id", "goal", "source_refs", "methodologies"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "methodologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["methodology_id", "implementation_id", "lineage_id"],
        "properties": {
          "methodology_id": {"type": "string", "minLength": 1},
          "implementation_id": {"type": "string", "minLength": 1},
          "lineage_id": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
