# Example ONLY — do not install on a live ED209 machine without approvals,
# non-colliding approved routes, private key installation and rollback test.
[Unit]
Description=SSH over authenticated XTP gateway (single session per process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xtpssh
Group=xtpssh
Environment=XTP_ROUTE_FILE=/etc/oorexx-xtp/routes.tsv
Environment=XTP_HEALTH_FILE=/var/lib/ssh-xtp/path-health.tsv
ExecStart=/usr/local/bin/ssh-xtp gateway --rx-peer gateway_rx --tx-peer client_rx --key-file /var/lib/ssh-xtp/client01.hex --client-id client01 --policy-file /etc/ssh-xtp/state --ssh-port 22
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/var/lib/ssh-xtp
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Example allows only XTP-over-UDP. Native raw36/L2 need deliberately
# scoped CAP_NET_RAW and a separately reviewed, carrier-aware unit.
# The policy is read-only to this user and MUST be root-owned.
