/* SlamProvenance.cls - which tool wrote which code, from the evidence the estate records, and nothing else.
 *
 * Architecture: Tom Dyer ("Failure to credit tools used in generation is a technical weakness. By knowing
 * which tool generated which code, if the tool has a habit of embedding a given error that error can be
 * identified at a tool level.")  Code: Claude (Opus 5.5), 2026-10-29.
 *
 * Levels, in the order they decide a unit's tool.  A unit gets the first level that has evidence; none is
 * guessed.  Claims of authorship come before records of who committed:
 *   HEADER       a credit line in the first 40 lines of the unit's file: "Code: X", "Coding: X",
 *                "Author: X", "Door code: X", "Written by X", "Generated by X"
 *   PROVENANCE   the same, in a PROVENANCE.md met walking up from the file: vendored code carries its own
 *                record, and must not take the credit of the package that vendors it
 *   GIT          per line: git blame of the unit's lines, each line's commit, that commit's Co-Authored-By
 *                trailer.  The tool of most of the unit's known lines, the split kept as evidence.  A trailer
 *                names the session that committed, which is not always the tool that wrote (a session can
 *                commit another tool's code), so it ranks below an explicit claim.  Only with the repository.
 *   README       the same as HEADER, in the package's README.md (package-wide, so least precise)
 *   NOT_RECORDED no evidence.  Said plainly: an unrecorded tool is a gap in the estate, not a fact about it.
 * When two levels name different tools, the deciding one wins and the other is kept: "CONFLICT: ...".
 *
 * Why git goes per line, not per file: the last commit to touch fd_door's FDDoorMicroMotion.cls is the
 * FDSqrt fix by Claude (Opus 5.5); crediting the whole 2,700-line file to it from that would be false.
 *
 * Tool names are normalised so the levels agree: "Claude Opus 5.5 <noreply@anthropic.com>" (a trailer) and
 * "Claude (Opus 5.5), 2026-10-28" (a header) are both "Claude (Opus 5.5)".  A parenthesis is kept only when
 * it holds a version (a digit): "ChatGPT (the door package)" is "ChatGPT".
 */

::class SlamProvenance public

/* The tool named by one credit line, or '' when the line is not a credit line. */
::method credit class
  use strict arg line
  u = line~upper
  labels = .array~of('CODING:', 'CODE:', 'AUTHOR:', 'AUTHORS:', 'CODED BY ', 'WRITTEN BY ', 'GENERATED BY ', 'IMPLEMENTED BY ')
  at = 0
  do lab over labels
    p = u~pos(lab)
    do while p > 0
      before = ''
      if p > 1 then before = u~substr(p - 1, 1)
      if \datatype(before, 'U') then do      /* a label is a whole word: BARCODE: is not CODE: */
        if at = 0 | p < at then do; at = p; size = lab~length; end
        leave
      end
      p = u~pos(lab, p + 1)
    end
  end
  if at = 0 then return ''
  v = line~substr(at + size)~strip('L')
  v = v~strip('L', '*')~strip('L')           /* markdown: **Coding:** Claude */
  if v == '' then return ''
  if \datatype(v~left(1), 'U') then do       /* a credit names someone: "code: see below" is not one, */
    o = v~pos('('); c = v~pos(')')             /* but "the rx2cpp lane (ChatGPT and Claude)" names two */
    if o = 0 | c < o then return ''
    v = v~substr(o + 1, c - o - 1)~strip
    if v == '' | \datatype(v~left(1), 'U') then return ''
  end
  out = ''; depth = 0; mixed = .false
  do i = 1 to v~length
    ch = v~substr(i, 1)
    if ch == '(' then depth += 1
    if ch == ')' then depth -= 1
    if depth = 0 then do
      if ch == '*' then leave
      if ch == '.' then if i = v~length | v~substr(i + 1, 1) == ' ' then leave
      if ch == ';' then mixed = .true   /* a second credit follows */
      if ch == ',' & \mixed then leave                           /* a date or a note follows */
    end
    out = out || ch
  end
  /* several tools for one thing: keep the whole credit, do not pick one */
  if mixed then return 'MIXED:' out~strip
  return self~normal(out)

/* One spelling per tool, whichever level named it. */
::method normal class
  use strict arg name
  n = name~strip
  if n~pos('<') > 0 then n = n~left(n~pos('<') - 1)~strip     /* an e-mail address on a trailer */
  p = n~pos('(')
  if p > 0 then do
    inner = n~substr(p)
    if inner~verify('0123456789', 'M') = 0 then n = n~left(p - 1)~strip   /* no version: drop it */
    else n = n~left(p - 1)~strip '(' || inner~substr(2)~strip('T', ')')~strip || ')'
  end
  /* a trailer writes "Claude Opus 5.5"; a header writes "Claude (Opus 5.5)" */
  if n~word(1) == 'Claude' & n~pos('(') = 0 & n~words > 1 then n = 'Claude (' || n~subword(2) || ')'
  return n

/* HEADER, else README, else NOT_RECORDED, for one file.  Returns a Directory: TOOL LEVEL EVIDENCE. */
::method ofFile class
  use strict arg path
  out = .directory~new
  lines = self~firstLines(path, 40)
  do i = 1 to lines~items
    t = self~credit(lines[i])
    if t \== '' then return self~found(t, 'HEADER', path 'line' i || ':' lines[i]~strip~left(100))
  end
  rec = self~packageRecord(path)
  if rec \== '' then do
    level = 'README'
    if filespec('N', rec) == 'PROVENANCE.md' then level = 'PROVENANCE'
    lines = self~firstLines(rec, 200)
    do i = 1 to lines~items
      t = self~credit(lines[i])
      if t \== '' then return self~found(t, level, rec 'line' i || ':' lines[i]~strip~left(100))
    end
  end
  return self~found('NOT_RECORDED', 'NOT_RECORDED', 'no credit line in the file header or the package README')

::method found class private
  use strict arg tool, level, evidence
  d = .directory~new
  d['TOOL'] = tool; d['LEVEL'] = level; d['EVIDENCE'] = evidence
  return d

::method firstLines class private
  use strict arg path, n
  out = .array~new
  s = .stream~new(path)
  if s~open('READ') \== 'READY:' then return out
  do while s~lines > 0 & out~items < n
    out~append(s~linein)
  end
  s~close
  return out

/* The record that covers PATH: the first PROVENANCE.md or README.md found walking up from the file (a
   PROVENANCE.md first in each directory), stopping at the package root (a directory whose parent is named
   packages or examples) or at the filesystem root. */
::method packageRecord class private
  use strict arg path
  dir = filespec('L', path)~strip('T', '/')
  do 12
    if dir == '' then return ''
    if SysFileExists(dir || '/PROVENANCE.md') then return dir || '/PROVENANCE.md'
    cand = dir || '/README.md'
    if SysFileExists(cand) then return cand
    parent = dir~left(max(0, dir~lastPos('/') - 1))
    if filespec('N', parent) == 'packages' | filespec('N', parent) == 'examples' then return ''
    if parent == dir then return ''
    dir = parent
  end
  return ''

/* GIT: the tool for lines FIRST..LAST of REL in REPO, by blame and commit trailer.
   Returns a Directory: TOOL LEVEL EVIDENCE (the split), or .nil when git has nothing.
   Two limits, both kept in the evidence:
   - In a shallow clone, every line older than the clone's first commit is charged to that boundary commit
     (git marks it "boundary").  Such a line is UNKNOWN_HISTORY, never the boundary commit's tool.
   - A trailer names the session that committed a line, which is not always the tool that wrote it (a
     session can commit another tool's code).  So recordAll keeps the file's own credit beside it. */
::method ofLines class
  use strict arg repo, rel, first, last, cache
  cmd = 'git -C "' || repo || '" blame --porcelain -L' first || ',' || last '-- "' || rel || '" 2>/dev/null'
  address system cmd with output stem b.
  if rc \= 0 | b.0 = 0 then return .nil
  shas = .array~new                     /* one per source line, in order */
  boundary = .directory~new
  current = ''
  do i = 1 to b.0
    w1 = b.i~word(1)
    if w1~length = 40 & w1~verify('0123456789abcdef') = 0 & b.i~words >= 3 then do
      current = w1
      shas~append(w1)
    end
    else if b.i == 'boundary' then boundary[current] = .true
  end
  if shas~items = 0 then return .nil
  counts = .directory~new
  do sha over shas
    if boundary~hasIndex(sha) then t = 'UNKNOWN_HISTORY'
    else do
      if \cache~hasIndex(sha) then cache[sha] = self~commitTool(repo, sha)
      t = cache[sha]
    end
    if counts~hasIndex(t) then counts[t] = counts[t] + 1; else counts[t] = 1
  end
  best = 'NOT_RECORDED'; bestN = 0; split = ''
  do t over counts~allIndexes~sort
    split = split t || '=' || counts[t]
    if t \== 'UNKNOWN_HISTORY' & t \== 'NOT_RECORDED' then if counts[t] > bestN then do; best = t; bestN = counts[t]; end
  end
  return self~found(best, 'GIT', 'lines' first || '-' || last 'of' rel || ':' split~strip)

/* The tool a commit names in its Co-Authored-By trailer, or NOT_RECORDED. */
::method commitTool class
  use strict arg repo, sha
  cmd = 'git -C "' || repo || '" log -1 "--format=%(trailers:key=Co-Authored-By,valueonly,separator=;)"' sha '2>/dev/null'
  address system cmd with output stem t.
  v = ''
  do i = 1 to t.0
    v = v || t.i
  end
  v = v~strip
  if v == '' then return 'NOT_RECORDED'
  if v~pos(';') > 0 then v = v~left(v~pos(';') - 1)
  return self~normal(v)

/* Record provenance for every unit in STORE.  With REPO (an alchemy checkout) the GIT level is tried first
   for units inside it.  Returns a Directory of counts by level. */
::method recordAll class
  use strict arg store, repo = ''
  counts = .directory~new
  do lv over .array~of('GIT', 'HEADER', 'PROVENANCE', 'README', 'NOT_RECORDED')
    counts[lv] = 0
  end
  units = store~q('SELECT id AS id, path AS path, line AS line FROM unit ORDER BY path, line')~rows
  fileCache = .directory~new
  shaCache = .directory~new
  store~begin
  do i = 1 to units~items
    u = units[i]
    path = u['PATH']
    if path == '' | path == .nil then iterate
    d = .nil
    if repo \== '' & path~pos(repo || '/') = 1 then do
      first = u['LINE']
      last = 0
      if i < units~items then if units[i + 1]['PATH'] == path then last = units[i + 1]['LINE'] - 1
      if last < first then last = self~lineCount(path)
      if datatype(first, 'W') & first > 0 & last >= first then d = self~ofLines(repo, path~substr(repo~length + 2), first, last, shaCache)
      if d \== .nil then if d['TOOL'] == 'NOT_RECORDED' then d = .nil   /* git knows the commit, not the tool */
    end
    if \fileCache~hasIndex(path) then fileCache[path] = self~ofFile(path)
    f = fileCache[path]
    g = d
    select
      when f['LEVEL'] == 'HEADER' | f['LEVEL'] == 'PROVENANCE' then do      /* a claim of authorship */
        d = f
        if g \== .nil then if g['TOOL'] \== f['TOOL'] then d = self~found(f['TOOL'], f['LEVEL'], f['EVIDENCE'] '| CONFLICT: GIT says' g['TOOL'] '(' || g['EVIDENCE'] || ')')
      end
      when g \== .nil then do                                              /* who committed each line */
        d = g
        if f['LEVEL'] == 'README' & f['TOOL'] \== g['TOOL'] then d = self~found(g['TOOL'], 'GIT', g['EVIDENCE'] '| CONFLICT: README says' f['TOOL'])
      end
      otherwise d = f
    end
    store~setProvenance(u['ID'], d['TOOL'], d['LEVEL'], d['EVIDENCE'])
    counts[d['LEVEL']] = counts[d['LEVEL']] + 1
  end
  store~commit
  return counts

::method lineCount class private
  use strict arg path
  s = .stream~new(path)
  if s~open('READ') \== 'READY:' then return 0
  n = s~lines('C')
  s~close
  return n
