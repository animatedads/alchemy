/* BodySlamSphere.cls - Body Slam v0.2: the estate map as an LLM Gopher sphere.
 *
 * Architecture: Tom Dyer (gopher spheres as LLM-centric documentation; Body Slam).
 * Code: Claude (Opus 5.5), 2026-11-10.
 *
 * Writes into a sphere work tree made by LLM Gopher's Sphere Editor
 *   (gopher --profile sphere-authoring sphere edit create alchemy-estate --path DIR):
 *   packs/alchemy-estate/00-sphere.json        purpose, start_here, sections (one per estate area)
 *   packs/alchemy-estate/articles/<id>.json      estate.how-to-use, and one estate.family.<family> each
 *   packs/alchemy-estate/corpora/estate-index.json   one record per family, for corpus lookup
 * then the Sphere Editor's validate and lint judge it.
 *
 * Every fact is generated from Body Slam's database of one commit: nothing is typed in by hand, so a
 * new commit means a new run, not edits. A README line is quoted with structured provenance (the
 * file at that commit, its SHA-256, the line range); the SHA-256 is computed through crypto v0.8.3
 * and the Foreign Runtime (OpenSSL), which must be on REXX_PATH and LD_LIBRARY_PATH.
 */

::requires 'BodySlamReport.cls'
::requires 'json.cls'

::class BodySlamSphere public

::method init
  expose report root commit sphereId
  use strict arg report, root, commit, sphereId = 'alchemy-estate'

::method write
  expose report root commit sphereId
  use strict arg outDir
  pack = outDir || '/packs/' || sphereId
  call SysMkDir pack || '/articles'
  call SysMkDir pack || '/corpora'
  self~hashStart
  fams = report~familyRows
  edges = self~edges
  areas = .directory~new
  index = .array~new
  n = 0
  do fam over fams~allIndexes~sort
    best = fams[fam]['BEST']
    area = best['PATH']~left(max(best['PATH']~pos('/') - 1, 0))
    if area == '' then area = 'root'
    areas[area] = 1
    a = self~familyArticle(fam, fams[fam], edges, area)
    self~put(pack || '/articles/' || a['id'] || '.json', a)
    rec = .directory~new
    rec['id'] = 'family.' || fam
    rec['term'] = fam
    def = best['TITLE']
    if best['SUMMARY'] \== '' then def = def || ': ' || best['SUMMARY']
    if def == '' then def = 'No README at the project root; newest version' best['PATH']
    rec['definition'] = def
    rec['related'] = .array~of(a['id'])
    index~append(rec)
    n += 1
  end
  corpus = .directory~new
  corpus['kind'] = 'corpus'; corpus['id'] = 'estate-index'; corpus['sphere'] = sphereId
  corpus['title'] = 'Alchemy estate index: one record per family'
  corpus['records'] = index
  self~put(pack || '/corpora/estate-index.json', corpus)
  self~put(pack || '/articles/estate.how-to-use.json', self~howTo(n))
  self~put(pack || '/00-sphere.json', self~sphereObject(areas, n))
  return n

/* ---------- the objects ---------- */

::method sphereObject
  expose commit sphereId
  use strict arg areas, n
  s = .directory~new
  s['kind'] = 'sphere'; s['id'] = sphereId; s['version'] = '0.1'
  s['title'] = 'Alchemy estate map'
  s['access_policy'] = sphereId || '-access'
  s['purpose'] = 'What is in the Alchemy estate (animatedads/alchemy at' commit || '): one article per family with its newest version, size, public classes, what its README says it is, and which families it requires and is required by. Generated by Body Slam; look things up here instead of reading the estate.'
  s['start_here'] = .array~of('estate.how-to-use')
  secs = .array~new
  do a over areas~allIndexes~sort
    secs~append(.directory~of(('id', a), ('title', 'Families under' a || '/')))
  end
  s['sections'] = secs
  s['related_spheres'] = .array~of('semantic-source-control', 'alchemy-core')
  s['inherits_services_from'] = .array~of('core')
  return s

::method howTo
  expose commit sphereId
  use strict arg n
  a = self~article('estate.how-to-use', 'How to use the estate map', 'baseline')
  a['summary'] = 'The estate map holds' n 'families of animatedads/alchemy at' commit || ', generated by Body Slam. Use it to find what exists and which version is newest before building anything; read code only after the map has pointed at it.'
  a['invariants'] = .array~of( ,
    'The map is generated from one commit by Body Slam. It is never edited by hand; a new commit means a new run.', ,
    'A family is a package name without its version; its newest version is chosen by version order (0.10 after 0.9, a release after its own -dev builds, dev29 after dev3), not by text order.', ,
    'A family article quotes only its README and counts from the source; anything else is not claimed.', ,
    'An older version of a family is not the one to build on unless a family article or its README says why.')
  a['procedure'] = .array~of( ,
    'Before using a package, look up its family (corpus estate-index, or the article estate.family.<family>) and take the newest version it names.', ,
    'To search: rexx bin/bodyslam.rex find DB WORD (family names, README text and public class names).', ,
    'For classes and methods inside one package, baseline it in Semantic Source Control (osc baseline PATH --repo REPO --component NAME --level 1) and use osc surface and osc source, rather than reading files.', ,
    'For what breaks if something changes: rexx bin/bodyslam.rex blast DB TARGET.')
  return a

::method familyArticle
  expose report root commit
  use strict arg fam, f, edges, area
  best = f['BEST']
  a = self~article('estate.family.' || fam, fam, area)
  title = best['TITLE']
  if title \== '' then a['title'] = fam '-' title
  if best['SUMMARY'] \== '' then a['summary'] = best['SUMMARY']
  else if best['README'] == '' then a['summary'] = 'No README at the project root of' best['PATH'] || '.'
  else a['summary'] = title
  inv = .array~new
  inv~append('Newest version here:' best['PATH'] || '.')
  vers = f['VERSIONS']~copy~sort
  if vers~items > 1 then inv~append('Versions here (' || vers~items || '):' vers~makeString('L', ' ') || '.')
  classes = report~q('SELECT DISTINCT c.display AS d FROM cls c JOIN file x ON x.id = c.file_id WHERE x.project_id = ? AND c.public = 1 ORDER BY c.display LIMIT 12', best['ID'])
  names = ''
  do c over classes; names = names c['D']; end
  sizeLine = 'Newest version:' best['RX'] 'ooRexx files,' best['LN'] 'lines,' best['PUB'] 'public classes'
  if names \== '' then sizeLine = sizeLine || ':' names~strip~changeStr(' ', ', ')
  if best['PUB'] > 12 then sizeLine = sizeLine || ', and' best['PUB'] - 12 'more'
  inv~append(sizeLine || '.')
  if edges['OUT']~hasIndex(fam) then inv~append('Requires (definite, from any version):' self~list(edges['OUT'][fam]) || '.')
  if edges['IN']~hasIndex(fam) then inv~append('Required by (definite, from any version):' self~list(edges['IN'][fam]) || '.')
  a['invariants'] = inv
  prov = .array~new
  if best['README'] \== '' then do
    p = .directory~new
    p['artifact'] = 'animatedads/alchemy@' || commit || ':' || best['README']
    p['sha256'] = self~sha256(root || '/' || best['README'])
    p['member'] = best['README']
    if best['TLINE'] > 0 then p['line_start'] = best['TLINE']
    if best['RLINE'] > 0 then p['line_end'] = best['RLINE']
    else if best['TLINE'] > 0 then p['line_end'] = best['TLINE']
    p['claim'] = 'README title and first line of text.'
    prov~append(p)
  end
  a['provenance'] = prov
  return a

::method article
  expose sphereId
  use strict arg id, title, section
  a = .directory~new
  a['kind'] = 'article'; a['id'] = id; a['version'] = '0.1'; a['sphere'] = sphereId
  a['title'] = title; a['summary'] = ''; a['section'] = section
  a['authority'] = 'generated'
  a['invariants'] = .array~new; a['procedure'] = .array~new; a['provenance'] = .array~new
  return a

/* family -> families it requires, and the reverse (DEFINITE) */
::method edges
  expose report
  out = .directory~new; into = .directory~new
  do r over report~q(.BodySlamReport~edgeSql('DEFINITE'))
    if \out~hasIndex(r['SRC']) then out[r['SRC']] = .array~new
    out[r['SRC']]~append(r['DST'])
    if \into~hasIndex(r['DST']) then into[r['DST']] = .array~new
    into[r['DST']]~append(r['SRC'])
  end
  return .directory~of(('OUT', out), ('IN', into))

::method list
  use strict arg names
  s = names~copy~sort
  if s~items <= 12 then return s~makeString('L', ', ')
  return s~section(1, 12)~makeString('L', ', ') || ', and' s~items - 12 'more'

::method put
  use strict arg path, obj
  call SysFileDelete path
  s = .stream~new(path)
  s~open('write replace')
  s~charOut(.json~toJson(self~texts(obj)))
  s~lineOut('')
  s~close

/* ---------- SHA-256 through crypto v0.8.3 and the Foreign Runtime ---------- */

::method hashStart
  .context~package~loadPackage('CryptoForeignRuntimeProvider.cls')
  .CryptoForeignRuntimeInstaller~install
  d = .CryptoHash~hashString('abc', 'SHA256')
  e = .RuntimeImplementationSwitch~broker~lastEvidence
  if d \== 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad' then raise syntax 98.900 array('Body Slam sphere: SHA-256 known answer differs')
  if e~providerId \== 'foreign.openssl.crypto' then raise syntax 98.900 array('Body Slam sphere: SHA-256 is not going through the Foreign Runtime (' || e~providerId e~outcomeCode || '); set REXX_PATH and LD_LIBRARY_PATH for crypto v0.8.3')

::method sha256
  use strict arg path
  s = .stream~new(path)
  s~open('read shareread')
  body = s~charIn(1, s~chars)
  s~close
  return .CryptoHash~hashString(body, 'SHA256')

/* every text value as a .JsonString, so json.cls writes "0.1" and "2026" as strings; only the
   provenance line numbers stay numbers */
::method texts
  use strict arg x, key = ''
  if x~isA(.Directory) then do
    out = .directory~new
    do k over x~allIndexes
      out[k] = self~texts(x[k], k)
    end
    return out
  end
  if x~isA(.Array) then do
    out = .array~new
    do v over x
      out~append(self~texts(v))
    end
    return out
  end
  if key == 'line_start' | key == 'line_end' then return x
  return .JsonString~new(x)
