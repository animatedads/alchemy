/* North shore specific camera admission / geometry qualification.
 * Architecture Tom Dyer. Implementation ChatGPT GPT-6, 1 Nov 2026.
 * Real-world visibility, land-mask and line-of-sight are NOT qualified.
 */
numeric digits 20
call RxFuncAdd 'MathLoadFuncs','rxmath','MathLoadFuncs'
call MathLoadFuncs
parse arg dest
if dest=='' then dest='.'
p=.HarbourNorthShorePanorama~new
checks=0
m=p~candidateMeta
call check m['SITE']=='NORTH_SHORE','stable camera candidate ID'
call check m['LAT']=-33.848849 & m['LON']=151.213921,'user coordinate preserved exactly'
call check m['SITE_PROVENANCE']=='USER_SUPPLIED','supplied coordinate provenance'
call check m['ASL']=50,'50 metres above SEA level'
call check \m['LAND_MASK_QUALIFIED'],'not admitted as certified land mask point'
call check \m['OCCLUSION_QUALIFIED'],'not admitted as unobstructed line of sight'
call check p~scene~boxes~items=25,'wharf and landmark geometry unchanged'
call check p~wharves~items=9,'nine wharf identities unchanged'
cam=p~siteCamera('NORTH_SHORE')
user=p~scene~local(-33.848849,151.213921)
call check abs(cam[1]-user[1])<0.000001 & abs(cam[2]-user[2])<0.000001,'camera metres match user coordinate'
call check cam[3]=50,'camera height 50 m ASL'
old=p~siteCamera('KIRRIBILLI')
call check old[3]=50 & old[1]\=cam[1] & old[2]\=cam[2],'earlier Kirribilli House comparison retained but not reused'
/* Reference great-circle bearings computed separately using spherical formula,
 * independent from the tangent-plane model's atan-based bearing routine.
 * Tolerance 0.15 degrees allows the documented flat-earth approximation. */
ids=.array~of('O','T','S','N')
refs=.array~of(172.1363,197.9784,214.2213,232.1651)
angles=.array~new
do i=1 to ids~items
  q=p~pointAngles(p~scene~features[ids[i]],cam)
  angles~append(q[1])
  call check abs(q[1]-refs[i])<0.15,ids[i] 'bearing agrees independent spherical reference'
end
call check angles[1]<angles[2] & angles[2]<angles[3] & angles[3]<angles[4], 'south-facing horizontal order Opera Salesforce Bridge S Bridge N'
call check p~pointAngles(p~scene~features['N'],cam)[3]<250,'north pylon near camera (~214m)'
call check p~pointAngles(p~scene~features['O'],cam)[3]>800,'Opera House substantially farther than pylon'
call check p~pointAngles(p~scene~features['T'],cam)[3]>1500,'Salesforce far behind waterfront'
prev=0
do id over .array~of('CQ2','CQ3','CQ4','CQ5','CQ6')
  bearing=p~bearingOf(id,'NORTH_SHORE')
  call check bearing>prev,'CQ wharf order' id
  prev=bearing
end
call check p~bearingOf('CQ2','NORTH_SHORE')>180,'Circular Quay piers southwest'
call check p~bearingOf('CQ6','NORTH_SHORE')<p~pointAngles(p~scene~features['T'],cam)[1],'CQ piers west of Opera, east of Salesforce in bearings'
prev=0
do id over .array~of('WB23','WB45','WB67','WB89')
  bearing=p~bearingOf(id,'NORTH_SHORE')
  call check bearing>prev,'Walsh wharf order' id
  prev=bearing
end
call check p~bearingOf('WB89','NORTH_SHORE')<angles[4], 'Walsh Bay western piers overlap bridge approach bearing sector'
file=dest || '/north_shore_360.svg'
p~render('NORTH_SHORE',file)
call check stream(file,'C','QUERY EXISTS')\=='','SVG generated by model'
svg=charin(file,1,chars(file));call stream file,'C','CLOSE'
call check svg~left(4)=='<svg' & svg~strip('T','0a'x)~right(6)=='</svg>','SVG root well formed'
call check occurrences(svg,'<polygon ')=450,'25 cuboids x 6 surfaces x 3 wrapped copies'
call check lastpos('<polygon ',svg)<lastpos('</svg>',svg),'all surfaces within SVG root'
call check pos('Jeffrey Street area',svg)>0 & pos('50 m ASL',svg)>0,'viewpoint metadata embedded in geometry render'
call check pos('Salesforce 263m',svg)>0 & pos('Opera box',svg)>0,'major landmark annotations from model'
say 'POWER SLAM NORTH SHORE QUALIFICATION: PASS (' || checks || ' checks)'
exit 0
occurrences: procedure
  use arg s,needle
  n=0
  do forever
    k=pos(needle,s)
    if k=0 then leave
    n+=1;s=s~substr(k+needle~length)
  end
  return n
check: procedure expose checks
  use arg ok,label
  checks+=1
  if ok then say 'PASS' label
  else do
    say 'FAIL' label
    exit 1
  end
  return
::requires 'SlamHarbourNorthShore.cls'
