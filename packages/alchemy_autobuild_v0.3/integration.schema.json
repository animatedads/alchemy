{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alchemy.autobuild.integration/0.2",
  "type": "object",
  "required": ["schema", "package", "tests", "publish"],
  "properties": {
    "schema": {"const": "alchemy.autobuild.integration/0.2"},
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"type": "string"}
      },
      "additionalProperties": true
    },
    "working_directory": {"type": "string", "default": "."},
    "environment": {
      "type": "object",
      "properties": {
        "set": {"type": "object", "additionalProperties": {"type": "string"}},
        "prepend_path": {"type": "array", "items": {"type": "string"}},
        "append_path": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["argv"],
        "properties": {
          "name": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "tree": {
          "type": "object",
          "required": ["source", "path"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "artifact_only": {"type": "boolean"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "path"],
            "properties": {
              "source": {"type": "string"},
              "path": {"type": "string"},
              "when": {"enum": ["pass", "always"]},
              "legacy_bootstrap": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "oneOf": [
        {"required": ["tree"], "not": {"required": ["artifact_only"]}},
        {"required": ["artifact_only"], "properties": {"artifact_only": {"const": true}}, "not": {"required": ["tree"]}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
