{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "oorexx_physics_world",
    "version": "0.1-dev51",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "MATHS_ROOT": "${REPO_ROOT}/packages/oorexx_maths_v0.20",
      "UNITS_ROOT": "${REPO_ROOT}/packages/oorexx_units_v0.1-dev4",
      "LD_LIBRARY_PATH": "${REPO_ROOT}/packages/oorexx_foreign_runtime_v0.22.6/build:/usr/local/lib:/usr/lib",
      "PYTHONPATH": "${REPO_ROOT}/packages/oorexx_maths_v0.20/python"
    },
    "rexx_path": {
      "mode": "replace",
      "entries": [
        "${PACKAGE_ROOT}/rexx",
        "${REPO_ROOT}/packages/oorexx_units_v0.1-dev4/rexx",
        "${REPO_ROOT}/packages/oorexx_maths_v0.20/rexx",
        "${REPO_ROOT}/packages/oorexx_foreign_runtime_v0.22.6/rexx"
      ],
      "require_entries": true
    },
    "require_dirs": [
      "MATHS_ROOT",
      "UNITS_ROOT"
    ],
    "report": [
      "MATHS_ROOT",
      "UNITS_ROOT"
    ]
  },
  "tests": [
    {
