#!/usr/bin/env python3
"""Storage Fabric operator CLI.  Keeps operations in existing ooRexx provider code.

REXX CLI protocol: tab-delimited OBJECT/LOCATION/RESULT rows, with StorageCodec
escaping on text fields.  No credentials are accepted on the command line.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import mimetypes
import re
import os
from pathlib import Path
import socket
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
COMMAND_REXX = ROOT / 'bin' / 'storage-cmd.rex'


def parser():
    p = argparse.ArgumentParser(prog='storage', description='Persistent ooRexx Storage Fabric CLI')
    p.add_argument('--state-root', default=os.environ.get('STORAGE_STATE_ROOT',
        str(Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local' / 'state'))) / 'storage-fabric')),
        help='durable authority checkpoint directory')
    p.add_argument('--node', default=os.environ.get('STORAGE_NODE_ID', socket.gethostname()),
        help='logical MI/MU node identity')
    sub = p.add_subparsers(dest='command', required=True)
    listp = sub.add_parser('list', help='list registered files from the retained Storage catalogue')
    listp.add_argument('--node', dest='filter_node', default='')
    listp.add_argument('--provider', default='')
    listp.add_argument('--prefix', default='')
    listp.add_argument('--underreplicated', action='store_true')
    listp.add_argument('--path', default='', help='virtual path prefix')
    listp.add_argument('--namespace', default='', help='namespace filter')
    listp.add_argument('--tag', action='append', default=[], help='require exact tag (repeatable)')
    listp.add_argument('--meta', action='append', default=[], help='require exact metadata key=value')
    listp.add_argument('--query', default='', help='search name, virtual path, description, tags, metadata')
    listp.add_argument('--format', choices=('table', 'json'), default='table')
    for cmd in ('locate', 'status'):
        c = sub.add_parser(cmd, help=f'{cmd} a uniquely identified registered file')
        c.add_argument('file', help='StorageRef object ID or exact unique display name')
        c.add_argument('--format', choices=('table', 'json'), default='table')
    add = sub.add_parser('add', help='register a file at a durable virtual path with metadata')
    add.add_argument('path')
    add.add_argument('--virtual', required=True, help='absolute logical namespace path')
    add.add_argument('--namespace', default='media')
    add.add_argument('--name', default='')
    add.add_argument('--media-type', default='', help='override auto-detected MIME type')
    add.add_argument('--description', default='')
    add.add_argument('--tag', action='append', default=[])
    add.add_argument('--meta', action='append', default=[])
    add.add_argument('--format', choices=('table', 'json'), default='table')
    bind = sub.add_parser('bind', help='attach another virtual path to an existing registered StorageRef')
    bind.add_argument('file')
    bind.add_argument('--virtual', required=True)
    bind.add_argument('--namespace', default='media')
    bind.add_argument('--format', choices=('table', 'json'), default='table')
    rem = sub.add_parser('remove', help='unpublish a virtual path; leave all physical files intact')
    rem.add_argument('file', help='virtual path, or StorageRef ID with --forget --yes')
    rem.add_argument('--namespace', default='media')
    rem.add_argument('--forget', action='store_true', help='also unregister unbound StorageRef and its replica policy')
    rem.add_argument('--yes', action='store_true', help='required for --forget')
    rem.add_argument('--format', choices=('table', 'json'), default='table')
    ann = sub.add_parser('annotate', help='add searchable metadata to existing StorageRef')
    ann.add_argument('file')
    ann.add_argument('--description', default='')
    ann.add_argument('--tag', action='append', default=[])
    ann.add_argument('--untag', action='append', default=[])
    ann.add_argument('--meta', action='append', default=[])
    ann.add_argument('--unset', action='append', default=[])
    ann.add_argument('--format', choices=('table', 'json'), default='table')
    find = sub.add_parser('find', help='search all registered names, virtual paths and metadata')
    find.add_argument('query')
    find.add_argument('--format', choices=('table', 'json'), default='table')
    reg = sub.add_parser('register', help='hash and register a local permanent file')
    reg.add_argument('path')
    reg.add_argument('--name', default='')
    reg.add_argument('--media-type', default='', help='override auto-detected MIME type')
    reg.add_argument('--format', choices=('table', 'json'), default='table')
    scan = sub.add_parser('scan', help='register each regular file beneath a local directory')
    scan.add_argument('directory')
    scan.add_argument('--no-recursive', action='store_true')
    scan.add_argument('--virtual-root', default='', help='register relative names under this virtual path')
    scan.add_argument('--namespace', default='media')
    scan.add_argument('--tag', action='append', default=[])
    scan.add_argument('--meta', action='append', default=[])
    scan.add_argument('--format', choices=('table', 'json'), default='table')
    mat = sub.add_parser('materialise', help='retrieve one object to this node, verify, and persist catalogue location')
    mat.add_argument('file')
    mat.add_argument('--to', required=True, help='nonexistent target path (parent directory must exist)')
    mat.add_argument('--from-peer', default='', help='peer source; requires runtime-bound authenticated peer transport')
    mat.add_argument('--format', choices=('table', 'json'), default='table')
    ens = sub.add_parser('ensure', help='ensure verified durable Azure Git second copy and two-replica policy')
    ens.add_argument('file')
    ens.add_argument('--replicas', type=int, choices=(2,), default=2)
    ens.add_argument('--provider', choices=('azure-git',), default='azure-git')
    ens.add_argument('--format', choices=('table', 'json'), default='table')
    return p


def codec_dec(value):
    """Mirror StorageCodec decoding, including percent-escaped file names."""
    for a, b in [('%09','\t'), ('%0A','\n'), ('%0D','\r'), ('%1E','\x1e'), ('%1F','\x1f'), ('%25','%')]:
        value = value.replace(a,b)
    return value


def decode_rows(stdout):
    objects = []
    current = None
    result = None
    for line in stdout.splitlines():
        cells = line.split('\t')
        if cells[0] == 'OBJECT' and len(cells) == 10:
            current = {
                'id': codec_dec(cells[1]), 'name': codec_dec(cells[2]),
                'size_bytes': int(cells[3]), 'media_type': codec_dec(cells[4]),
                'digest': codec_dec(cells[5]), 'known_locations': int(cells[6]),
                'durable_verified_copies': int(cells[7]), 'replica_policy': cells[8],
                'catalogue_revision': int(cells[9]), 'locations': [],
                'virtual_paths': [], 'description': '', 'tags': [], 'metadata': {}
            }
            objects.append(current)
        elif cells[0] == 'VPATH' and len(cells) == 3:
            if current is None:
                raise ValueError('virtual path without object')
            current['virtual_paths'].append({'namespace': codec_dec(cells[1]), 'path': codec_dec(cells[2])})
        elif cells[0] == 'EA' and len(cells) == 4:
            if current is None:
                raise ValueError('metadata without object')
            namespace, name, value = (codec_dec(v) for v in cells[1:])
            if namespace == 'catalog' and name == 'description':
                current['description'] = value
            elif namespace == 'tag' and value == '1':
                current['tags'].append(name)
            elif namespace == 'meta':
                current['metadata'][name] = value
        elif cells[0] == 'LOCATION' and len(cells) == 11:
            if current is None:
                raise ValueError('location without object')
            current['locations'].append({
                'provider': codec_dec(cells[1]), 'node': codec_dec(cells[2]),
                'locator': codec_dec(cells[3]), 'state': cells[4],
                'verified_at_recording': cells[5] == '1',
                'safety': cells[6], 'lifecycle': cells[7],
                'vendor': codec_dec(cells[8]), 'site': codec_dec(cells[9]),
                'failure_domain': codec_dec(cells[10])
            })
        elif cells[0] == 'RESULT' and len(cells) >= 2:
            result = cells[1]
        elif line.strip():
            raise ValueError('unexpected ooRexx command output')
    if result is None:
        raise ValueError('missing ooRexx RESULT')
    return result, objects


def valid_namespace(value):
    if not re.fullmatch(r'[a-zA-Z][a-zA-Z0-9_-]{0,63}', value):
        raise ValueError('namespace must be a simple identifier (max 64 chars)')
    return value


def valid_virtual(value):
    if (not value.startswith('/') or value == '/' or '//' in value or '\\' in value or
            any(x in ('', '.', '..') for x in value[1:].split('/')) or
            any(ord(c) < 32 or ord(c) == 127 for c in value)):
        raise ValueError('virtual path must be absolute, canonical, and contain no dot segments')
    return value


def checked_text(value):
    if any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise ValueError('metadata contains forbidden control characters')
    if len(value) > 4096:
        raise ValueError('metadata value exceeds 4096 characters')
    return value


def packed_list(values):
    return '\x1e'.join(checked_text(v) for v in values)


def packed_meta(values):
    packed = []
    for item in values:
        k, delim, v = item.partition('=')
        if not delim or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_-]{0,63}', k):
            raise ValueError('metadata must use KEY=VALUE; KEY is a simple identifier')
        packed.append(k + '\x1f' + checked_text(v))
    return '\x1e'.join(packed)


def validate_tags(tags):
    for t in tags:
        if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_-]{0,63}', t):
            raise ValueError('tag must be a simple identifier')


def mime_for(path, override=''):
    value = override or mimetypes.guess_type(str(path))[0] or 'application/octet-stream'
    if not re.fullmatch(r'[A-Za-z0-9.+_-]+/[A-Za-z0-9.+_-]+', value):
        raise ValueError('invalid MIME media type')
    return value


def ensure_regular(path):
    original = Path(path).expanduser()
    if original.is_symlink():
        raise ValueError('file must not be a symlink')
    actual = original.resolve(strict=True)
    if not actual.is_file():
        raise ValueError('file must be regular')
    return str(actual)


def select_files(objects, *, provider='', node='', prefix='', underreplicated=False,
                 path='', namespace='', tags=(), metas=(), query=''):
    kv = {}
    for item in metas:
        k, delimiter, v = item.partition('=')
        if not delimiter:
            raise ValueError('--meta filter must be KEY=VALUE')
        kv[k] = v
    result = []
    for obj in objects:
        if (provider or node) and not any(
            (not provider or loc['provider'] == provider) and (not node or loc['node'] == node)
            for loc in obj['locations']):
            continue
        if prefix and not obj['name'].startswith(prefix):
            continue
        if underreplicated and obj['replica_policy'] == 'SATISFIED':
            continue
        if path or namespace:
            if not any((not path or p['path'].startswith(path)) and
                       (not namespace or p['namespace'] == namespace) for p in obj['virtual_paths']):
                continue
        if not all(t in obj['tags'] for t in tags):
            continue
        if not all(obj['metadata'].get(k) == v for k,v in kv.items()):
            continue
        if query:
            fields = [obj['id'], obj['name'], obj['description'],
                      *(p['path'] for p in obj['virtual_paths']),
                      *obj['tags'], *obj['metadata'].keys(), *obj['metadata'].values()]
            if not any(query.casefold() in f.casefold() for f in fields):
                continue
        result.append(obj)
    return result


def run_rexx(op, args, path='', key='', name='', peer='', virtual='', namespace='media',
             description='', tags=(), metadata=(), untags=(), unsets=(), forget=False, media_type=''):
    state_root = Path(args.state_root).expanduser().resolve()
    state_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Serialize readers and writers on one host; actual distributed mutation
    # authority/fencing remains an explicit grid deployment requirement.
    lockpath = state_root / 'CLI.lock'
    env = os.environ.copy()
    env.update({
        'STORAGE_CLI_STATE_ROOT': str(state_root),
        'STORAGE_CLI_NODE': args.node,
        'STORAGE_CLI_LOCAL_SAFETY': env.get('STORAGE_LOCAL_SAFETY', 'UNKNOWN'),
        'STORAGE_CLI_LOCAL_VENDOR': env.get('STORAGE_LOCAL_VENDOR', ''),
        'STORAGE_CLI_LOCAL_SITE': env.get('STORAGE_LOCAL_SITE', args.node),
        'STORAGE_CLI_OP': op,
        'STORAGE_CLI_PATH': path,
        'STORAGE_CLI_KEY': key,
        'STORAGE_CLI_NAME': name,
        'STORAGE_CLI_MEDIA_TYPE': media_type,
        'STORAGE_CLI_PEER': peer,
        'STORAGE_CLI_VIRTUAL': virtual,
        'STORAGE_CLI_NAMESPACE': namespace,
        'STORAGE_CLI_DESCRIPTION': checked_text(description),
        'STORAGE_CLI_TAGS': packed_list(tags),
        'STORAGE_CLI_METADATA': packed_meta(metadata),
        'STORAGE_CLI_UNTAGS': packed_list(untags),
        'STORAGE_CLI_UNSETS': packed_list(unsets),
        'STORAGE_CLI_FORGET': '1' if forget else '0',
        # Both direct class requires and inherited 'src/Class.cls' requires must resolve.
        'REXX_PATH': os.pathsep.join([str(ROOT / 'src'), str(ROOT)] + ([env['REXX_PATH']] if env.get('REXX_PATH') else [])),
    })
    executable = env.get('REXX_BIN', 'rexx')
    with lockpath.open('a+b') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            completed = subprocess.run([executable, str(COMMAND_REXX)], env=env,
                                       text=True, capture_output=True, check=False)
        except FileNotFoundError as exc:
            raise RuntimeError(f'ooRexx executable unavailable: {executable}') from exc
    if completed.stderr.strip() and completed.returncode:
        raise RuntimeError('ooRexx command failed: ' + completed.stderr.strip()[-1200:])
    code, objects = decode_rows(completed.stdout)
    if code != 'OK' or completed.returncode:
        raise RuntimeError(code + (f' (rc={completed.returncode})' if completed.returncode else ''))
    return objects


def render(objects, format, *, command):
    if format == 'json':
        print(json.dumps({'schema': 'storage.fabric.cli/0.1', 'command': command,
                          'view': 'retained_catalogue', 'files': objects, 'count': len(objects)},
                         indent=2, ensure_ascii=False))
        return
    print(f"{'FILE':27} {'SIZE':>13} {'VERIFIED':>8} {'VIRTUAL PATH':45} LOCATIONS")
    for obj in sorted(objects, key=lambda x: (x['name'].casefold(), x['id'])):
        locs = ', '.join(f"{v['provider']}@{v['node'] or '-'}:{v['state']}" for v in obj['locations']) or '-'
        virt = ', '.join(p['path'] for p in obj['virtual_paths']) or '-'
        print(f"{obj['name'][:27]:27} {obj['size_bytes']:>13} {obj['durable_verified_copies']:>8} "
              f"{virt[:45]:45} {locs}")
        if obj['description']:
            print('  Description:', obj['description'])
        if obj['tags']:
            print('  Tags:', ', '.join(sorted(obj['tags'])))
        if command in ('locate', 'status', 'ensure', 'materialise', 'register', 'add', 'bind', 'remove', 'annotate'):
            print('  StorageRef:', obj['id'])
            for v in obj['locations']:
                print(f"  {v['provider']} {v['node']} {v['locator']} "
                      f"verified={v['verified_at_recording']} safe={v['safety']} "
                      f"failure_domain={v['failure_domain']}")


def run(args):
    cmd = args.command
    if cmd == 'scan':
        root = Path(args.directory).expanduser().resolve(strict=True)
        if not root.is_dir():
            raise ValueError('scan directory is not a directory')
        if args.virtual_root:
            valid_namespace(args.namespace)
            valid_virtual(args.virtual_root)
            validate_tags(args.tag)
        paths = sorted(root.rglob('*') if not args.no_recursive else root.iterdir())
        registered = []
        for path in paths:
            if path.is_file() and not path.is_symlink():
                if args.virtual_root:
                    virt = valid_virtual(args.virtual_root.rstrip('/') + '/' + path.relative_to(root).as_posix())
                    registered.extend(run_rexx('add', args, path=str(path), name=path.name,
                                               virtual=virt, namespace=args.namespace,
                                               tags=args.tag, metadata=args.meta,
                                               media_type=mime_for(path)))
                else:
                    registered.extend(run_rexx('register', args, path=str(path), name=path.name,
                                               media_type=mime_for(path)))
        render(registered, args.format, command=cmd)
        return
    if cmd in ('list', 'find'):
        objects = run_rexx('list', args)
        if cmd == 'list':
            objects = select_files(objects, provider=args.provider, node=args.filter_node,
                                   prefix=args.prefix, underreplicated=args.underreplicated,
                                   path=args.path, namespace=args.namespace,
                                   tags=args.tag, metas=args.meta, query=args.query)
        else:
            objects = select_files(objects, query=args.query)
        render(objects, args.format, command=cmd)
        return
    if cmd in ('register', 'add'):
        path = ensure_regular(args.path)
        if cmd == 'add':
            valid_namespace(args.namespace)
            valid_virtual(args.virtual)
            validate_tags(args.tag)
            objects = run_rexx('add', args, path=path, name=args.name or Path(path).name,
                               virtual=args.virtual, namespace=args.namespace,
                               description=args.description, tags=args.tag, metadata=args.meta,
                               media_type=mime_for(path, args.media_type))
        else:
            objects = run_rexx('register', args, path=path, name=args.name or Path(path).name,
                               media_type=mime_for(path, args.media_type))
    elif cmd == 'bind':
        valid_namespace(args.namespace)
        valid_virtual(args.virtual)
        objects = run_rexx('bind', args, key=args.file, virtual=args.virtual, namespace=args.namespace)
    elif cmd == 'remove':
        valid_namespace(args.namespace)
        if args.forget and not args.yes:
            raise ValueError('--forget requires --yes; physical data remains unchanged')
        if args.file.startswith('/'):
            valid_virtual(args.file)
        objects = run_rexx('remove', args, key=args.file, namespace=args.namespace, forget=args.forget)
    elif cmd == 'annotate':
        if not (args.description or args.tag or args.meta or args.untag or args.unset):
            raise ValueError('annotate requires at least one metadata operation')
        validate_tags((*args.tag, *args.untag))
        for k in args.unset:
            if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_-]{0,63}', k):
                raise ValueError('--unset expects a metadata key')
        objects = run_rexx('annotate', args, key=args.file,
                           description=args.description, tags=args.tag,
                           metadata=args.meta, untags=args.untag, unsets=args.unset)
    elif cmd in ('locate', 'status'):
        objects = run_rexx(cmd, args, key=args.file)
    elif cmd == 'materialise':
        target = Path(args.to).expanduser().absolute()
        if not target.parent.is_dir():
            raise ValueError('materialise target parent directory does not exist')
        if target.exists() or target.is_symlink():
            raise ValueError('materialise target already exists')
        objects = run_rexx(cmd, args, key=args.file, path=str(target), peer=args.from_peer)
    elif cmd == 'ensure':
        objects = run_rexx(cmd, args, key=args.file)
    else:
        raise ValueError('invalid command')
    render(objects, args.format, command=cmd)


def main(argv=None):
    try:
        args = parser().parse_args(argv)
        if not args.node:
            raise ValueError('node identity cannot be empty')
        run(args)
        return 0
    except (RuntimeError, ValueError, OSError) as exc:
        print(f'storage: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
