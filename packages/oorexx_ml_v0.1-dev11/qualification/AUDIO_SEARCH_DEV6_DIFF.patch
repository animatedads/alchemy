+::class AudioParetoDelegate public
+::method init
+  expose decoder cache
+  use strict arg decoder,cache
+::method constraintSubject
+  expose decoder
+  use strict arg genome
+  c=decoder~decodeGenome(genome); d=.directory~new; do k over c; d[k]=c[k]; end
+  if d~hasIndex('denoise_nf') then if d['denoise_nf']==.nil then d['denoise_nf']=999
+  return d
+::method scores
+  expose decoder cache
+  use strict arg genome
+  ignored=decoder~score(genome); r=self~recordFor(genome)
+  if r==.nil then raise syntax 88.900 array('audio Pareto score record unavailable',genome~id)
+  return .AudioParetoObjectives~scoresFromStats(r)
+::method evidence
+  use strict arg genome
+  return self~recordFor(genome)
+::method recordFor
+  expose decoder cache
+  use strict arg genome
+  c=decoder~decodeGenome(genome); key=self~configKey(c)
+  if cache~hasIndex(key) then return cache[key]
+  return .nil
+::method configKey private
+  use strict arg c
+  keys=.array~of('gain_db','highpass','lowpass','denoise_nf','echo_delay_ms','echo_gain','cancel_strength','cancel_tweak_ms','compress','compress_ratio','compress_threshold_db','reject_bands'); s=''
+  do k over keys
+    if c~hasIndex(k) then do; if c[k]==.nil then v='NONE'; else v=self~canonicalNumber(c[k]); end; else v=''
+    s=s||k||'='||v||';'
+  end
+  return s
+::method canonicalNumber private
+  use strict arg v
+  s=v~string; if s~left(1)='.' then return '0'||s; if s~left(2)='-.' then return '-0'||s~substr(2); return s
+
+::class AudioChainConstraint subclass MLHardConstraint public
+::method assess
+  use strict arg c
+  if c~isA(.MLFrozenMap) then c=c~toDirectory
+  if \c~isA(.Directory) then return .MLConstraintResult~new(self~id,.false,'CONFIGURATION_NOT_AVAILABLE')
+  if c['highpass']>=c['lowpass'] then return .MLConstraintResult~new(self~id,.false,'HIGHPASS_NOT_BELOW_LOWPASS')
+  if c['echo_delay_ms']=0 & c['echo_gain']<>0 then return .MLConstraintResult~new(self~id,.false,'ECHO_GAIN_WITHOUT_DELAY')
+  if c['cancel_strength']=0 & c['cancel_tweak_ms']<>0 then return .MLConstraintResult~new(self~id,.false,'CANCEL_TWEAK_WITHOUT_CANCELLATION')
+  return .MLConstraintResult~new(self~id,.true,'OK')
