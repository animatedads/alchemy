+runParetoGA: procedure
+  use strict arg ctx,limit,records,cache,runMeta,retention,paretoPromotions
+  plan=.MLGABudgetPlan~forCandidateLimit(limit,30,3,4); policy=.MLGeneticPolicy~new(.25,.12,.80,2)
+  objectives=.AudioParetoObjectives~create
+  hard=.array~new
+  hard~append(.MLSearchSpaceConstraint~new('audio-shared-domain',sharedSpaceC(),'P candidates must remain inside the declared shared C domain'))
+  hard~append(.AudioChainConstraint~new('audio-chain-valid','processor chain parameter interdependencies must be canonical'))
+  constraints=.MLConstraintSet~new('RECOVERED-AUDIO-HARD-V1',hard,'hard configuration validity; not traded against quality objectives')
+  rng=.MLDeterministicRNG~new(20906,'AUDIO-P-RNG'); cursor=rng~cursor; initial=.array~new
+  do i=1 to plan~populationSize
+    genes=.array~new; do j=1 to 10; genes~append(cursor~nextUnit); end; initial~append(genes)
+  end
+  ignored=rng~commitCursor(cursor,'AUDIO_P_INITIAL_POPULATION')
+  pop=.MLPopulation~new(initial,'AUDIO-P-POPULATION'); exp=.MLExperiment~new('AUDIO-P-SEARCH')
+  decoder=.AudioGAScoreEvaluator~new(ctx,records,cache); delegate=.AudioParetoDelegate~new(decoder,cache)
+  evaluator=.MLConstrainedEvaluatorAdapter~new(objectives,constraints,delegate)
+  ga=.MLConstrainedParetoGeneticAlgorithm~new(pop,objectives,constraints,rng,exp,policy)
+  run=ga~run(evaluator,plan~breedingSteps); final=run~finalEvaluation~result
+  selected=.MLConstrainedParetoRetentionSelector~select(final,retention)
+  if selected~items=0 then raise syntax 88.900 array('Pareto search produced no feasible promotable candidate')
+  do point over selected
+    r=delegate~recordFor(point~subject)
+    if r==.nil then raise syntax 88.900 array('Pareto frontier record missing from evaluation cache',point~subjectId)
+    r['pareto_rank']=point~rank; r['pareto_crowding']=point~crowdingDistance; r['pareto_objectives']=point~objectiveVector~canonicalText
+    paretoPromotions~append(r)
+  end
+  runMeta['pareto_objective_set']=objectives~id; runMeta['hard_constraint_set']=constraints~id
+  runMeta['pareto_feasible_final']=final~feasibleCount; runMeta['pareto_infeasible_final']=final~infeasibleCount; runMeta['pareto_front1_final']=final~nonDominated~items
+  runMeta['pareto_promoted']=selected~items; runMeta['pareto_final_generation']=run~finalPopulationGeneration; runMeta['pareto_generation_registry_count']=ga~generationRegistry~count
+  runMeta['ga_budget_plan']=plan~canonicalText; runMeta['ga_policy']=policy~canonicalText; runMeta['final_population_evaluated']=1
+  say run~canonicalText
+  say 'PARETO feasible='final~feasibleCount 'infeasible='final~infeasibleCount 'front1='final~nonDominated~items 'promoted='selected~items
+  return
