+/* An explicit broker disposition. A rejected send can be safely nacked;
+ * an unknown send may already exist at the broker and MUST remain uncertain.
+ * A successful send proves broker acceptance, not consumer execution.
+ */
+::class ConnectJmsSendReceipt public
+::attribute disposition get
+::method init
+  expose disposition
+  use strict arg disposition
+  disposition = disposition~string~translate
+  if disposition \== 'ACCEPTED' then do
+    if disposition \== 'REJECTED' then do
+      if disposition \== 'UNKNOWN' then
+        raise syntax 93.900 additional('JMS send disposition must be ACCEPTED, REJECTED, or UNKNOWN')
+    end
+  end
+
