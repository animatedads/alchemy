# kit.env -- this machine's locations for the browser UI kit.  Copy to var/kit.env and edit.
# Architecture: Tom Dyer.  Coding: Claude (Opus 5.5), 8 November 2026.
ALCHEMY_PACKAGES=$HOME/alchemy-autobuild/alchemy/packages
# Foreign Runtime: its rexx/ directory and its built library directory (the HTTPS fixture host needs it)
FOREIGN_RUNTIME_REXX=$HOME/alchemy-autobuild/foreign-runtime/rexx
FOREIGN_RUNTIME_LIB=$HOME/alchemy-autobuild/foreign-runtime/build
# where json.cls and socket.cls are installed
OOREXX_CLS=/usr/local/bin
# Chromium or Google Chrome.  A plain install is best.  A flatpak Chrome works only if its profiles live where
# the flatpak may write: then set BROWSER_PROFILES=$HOME/.var/app/com.google.Chrome/alchemy-profiles
CHROME=/usr/bin/google-chrome
# extra Chrome flags for this machine (a root container needs --no-sandbox; a desktop does not)
CHROME_FLAGS=
# where named sign-in profiles live (mode 700; they hold session cookies); default ~/.config/alchemy/browser-profiles
BROWSER_PROFILES=
# declared automation: appended to the user agent of every page the kit opens (browser-ui.rex --for overrides)
AGENT_REQUESTED_BY=
AGENT_CONTACT=https://rasenfalcon.com
# a compiled copy of Boston Crab (oorexx_slam_bostoncrab v0.21+) for free-text fetch orders; empty = FETCH URL only
BOSTON_CRAB_DIR=
