{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alchemy.autobuild.integration/0.1",
  "type": "object",
  "required": ["schema", "package", "tests"],
  "properties": {
    "schema": {"const": "alchemy.autobuild.integration/0.1"},
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"type": "string"}
      }
    },
    "working_directory": {"type": "string"},
    "environment": {
      "type": "object",
      "properties": {
        "set": {"type": "object", "additionalProperties": {"type": "string"}},
        "prepend_path": {"type": "array", "items": {"type": "string"}},
        "append_path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["argv"],
        "properties": {
          "name": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "path"],
            "properties": {
              "source": {"type": "string"},
              "path": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
