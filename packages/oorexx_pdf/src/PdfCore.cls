/* PdfCore.cls - native ooRexx PDF 1.4 writer + flowed report layout. */

::class PdfWriter public

::method init
  expose objects rootId infoId compressStreams
  objects = .Array~new
  rootId = 0
  infoId = 0
  compressStreams = .true

::method compressStreams attribute

::method addObject
  expose objects
  use strict arg body
  objects~append(body)
  return objects~items

::method addStream
  use strict arg dictionary, rawBytes, compress=.true
  data = rawBytes
  dict = dictionary~strip
  if compress then do
    data = .PdfDeflate~new~zlib(rawBytes)
    if dict = "" then dict = "/Filter /FlateDecode"
    else dict = dict || " /Filter /FlateDecode"
  end
  body = "<< " || dict || " /Length " || length(data) || " >>" || '0d0a'x || ,
         "stream" || '0d0a'x || data || '0d0a'x || "endstream"
  return self~addObject(body)

::method rootId attribute
::method infoId attribute

::method bytes
  expose objects rootId infoId
  if rootId <= 0 then raise syntax 93.900 array("PDF root object has not been assigned")
  eol = '0d0a'x
  out = "%PDF-1.4" || eol || "%" || 'e2e3cfd3'x || eol
  offsets = .Array~new
  offsets~append(0)

  do i = 1 to objects~items
    offsets~append(length(out))
    out = out || i || " 0 obj" || eol || objects[i] || eol || "endobj" || eol
  end

  xrefOffset = length(out)
  out = out || "xref" || eol || "0 " || (objects~items + 1) || eol
  out = out || "0000000000 65535 f " || eol
  do i = 1 to objects~items
    out = out || self~pad10(offsets[i + 1]) || " 00000 n " || eol
  end

  trailer = "<< /Size " || (objects~items + 1) || " /Root " || rootId || " 0 R"
  if infoId > 0 then trailer = trailer || " /Info " || infoId || " 0 R"
  trailer = trailer || " >>"
  out = out || "trailer" || eol || trailer || eol || "startxref" || eol || xrefOffset || eol || "%%EOF" || eol
  return out

::method writeFile
  use strict arg path
  data = self~bytes
  call stream path, 'c', 'open write replace'
  call charout path, data
  call stream path, 'c', 'close'
  return length(data)

::method pad10 private
  use strict arg n
  s = n~string
  return copies("0", 10 - length(s)) || s

::method objectsCount
  expose objects
  return objects~items

::class PdfText private

::method escape class
  use strict arg value
  text = value~string
  text = changestr("\\", text, "\\\\")
  text = changestr("(", text, "\\(")
  text = changestr(")", text, "\\)")
  text = changestr('0d'x, text, "\\r")
  text = changestr('0a'x, text, "\\n")
  return text

::method literal class
  use strict arg value
  return "(" || self~escape(value) || ")"

::class PdfPageCanvas public

::method init
  expose commands
  commands = ""

::method raw
  expose commands
  use strict arg command
  commands = commands || command || '0a'x
  return self

::method text
  use strict arg x, y, size, value, font="F1"
  safe = .PdfText~literal(value)
  return self~raw("BT /" || font || " " || size || " Tf 1 0 0 1 " || x || " " || y || " Tm " || safe || " Tj ET")

::method line
  use strict arg x1, y1, x2, y2, width=0.5
  return self~raw(width || " w " || x1 || " " || y1 || " m " || x2 || " " || y2 || " l S")

::method rect
  use strict arg x, y, width, height, lineWidth=0.5
  return self~raw(lineWidth || " w " || x || " " || y || " " || width || " " || height || " re S")

::method fillRect
  use strict arg x, y, width, height, gray=0.94
  self~raw("q " || gray || " g " || x || " " || y || " " || width || " " || height || " re f Q")
  return self

::method image
  use strict arg name, x, y, width, height
  return self~raw("q " || width || " 0 0 " || height || " " || x || " " || y || " cm /" || name || " Do Q")

::method textColor
  use strict arg r, g, b
  return self~raw(r || " " || g || " " || b || " rg")

::method bytes
  expose commands
  return commands

/* Legacy field report retained for compatibility. */
::class PdfReport public

::method init
  expose title subtitle fields footer
  title = "Report"
  subtitle = ""
  fields = .Array~new
  footer = "Generated by ooRexx PDF"

::method title attribute
::method subtitle attribute
::method footer attribute

::method addField
  expose fields
  use strict arg label, value
  fields~append(.Array~of(label~string, value~string))
  return self

::method fields
  expose fields
  return fields

::method render
  expose title subtitle fields footer
  use strict arg path
  flow = .PdfFlowReport~new
  flow~title = title
  flow~subtitle = subtitle
  flow~footer = footer
  do pair over fields
    flow~addField(pair[1], pair[2])
  end
  return flow~render(path)

/* A PdfCell is optional. Plain row values remain valid and mean span=1/left/default. */
::class PdfCell public

::method init
  expose value span align bold
  use strict arg value="", span=1, align="", bold=.false
  if span < 1 then raise syntax 93.900 array("PdfCell span must be >= 1")
  value = value~string
  span = span
  align = align~string~lower
  if align <> "" & align <> "left" & align <> "center" & align <> "right" then ,
    raise syntax 93.900 array("PdfCell alignment must be left, center or right")
  bold = bold

::method value attribute
::method span attribute
::method align attribute
::method bold attribute

/* A table is deliberately data-model-light: headers, widths and rows are Arrays.
   Every row is an Array, so callers can feed existing ooRexx tabular data directly. */
::class PdfTable public

::method init
  expose headers widths rows title repeatHeader zebra fontSize padding alignments columnTypes
  use strict arg headers, widths=.nil
  if headers == .nil then raise syntax 93.900 array("PdfTable requires a headers Array")
  headers = self~copyArray(headers)
  if widths == .nil then widths = .nil
  else widths = self~copyArray(widths)
  rows = .Array~new
  title = ""
  repeatHeader = .true
  zebra = .true
  fontSize = 8
  padding = 4
  alignments = .nil
  columnTypes = .nil

::method title attribute
::method repeatHeader attribute
::method zebra attribute
::method fontSize attribute
::method padding attribute
::method alignments attribute
::method columnTypes attribute

::method setAlignments
  expose alignments
  use strict arg values
  alignments = self~copyArray(values)
  return self

::method setColumnTypes
  expose columnTypes
  use strict arg values
  columnTypes = self~copyArray(values)
  return self

::method cell class
  use strict arg value="", span=1, align="", bold=.false
  return .PdfCell~new(value, span, align, bold)

::method headers
  expose headers
  return headers

::method widths
  expose widths
  return widths

::method rows
  expose rows
  return rows

::method addRow
  expose rows
  use strict arg row
  rows~append(self~copyArray(row))
  return self

::method addRows
  use strict arg source
  do row over source
    self~addRow(row)
  end
  return self

::method copyArray private
  use strict arg source
  out = .Array~new
  do item over source
    out~append(item)
  end
  return out

::class PdfJpegImage public

::method init
  expose path data width height components
  use strict arg path
  call stream path, 'c', 'open read'
  size = stream(path, 'c', 'query size')
  data = charin(path, 1, size)
  call stream path, 'c', 'close'
  if substr(data,1,2) <> 'ffd8'x then raise syntax 93.900 array("PdfJpegImage requires a JPEG file")
  width = 0; height = 0; components = 0
  posn = 3
  do while posn < length(data)
    if c2d(substr(data,posn,1)) <> 255 then do; posn = posn + 1; iterate; end
    do while posn <= length(data) & c2d(substr(data,posn,1)) = 255
      posn = posn + 1
    end
    if posn > length(data) then leave
    code = c2d(substr(data,posn,1)); posn = posn + 1
    if code = 216 | code = 217 then iterate
    if posn + 1 > length(data) then leave
    seglen = self~u16(data, posn)
    if seglen < 2 then leave
    if self~isSof(code) then do
      if posn + 7 > length(data) then leave
      height = self~u16(data, posn + 3)
      width = self~u16(data, posn + 5)
      components = c2d(substr(data,posn + 7,1))
      leave
    end
    posn = posn + seglen
  end
  if width <= 0 | height <= 0 then raise syntax 93.900 array("Unable to determine JPEG dimensions")

::method path attribute
::method data attribute
::method width attribute
::method height attribute
::method components attribute

::method colorSpace
  expose components
  if components = 1 then return "/DeviceGray"
  if components = 4 then return "/DeviceCMYK"
  return "/DeviceRGB"

::method u16 private
  use strict arg bytes, p
  return c2d(substr(bytes,p,1)) * 256 + c2d(substr(bytes,p+1,1))

::method isSof private
  use strict arg code
  return code = 192 | code = 193 | code = 194 | code = 195 | code = 197 | code = 198 | code = 199 | code = 201 | code = 202 | code = 203 | code = 205 | code = 206 | code = 207

::class PdfFlowReport public

::method init
  expose title subtitle footer headerText blocks margin pageWidth pageHeight topY bottomY defaultFontSize orientation
  title = "Report"
  subtitle = ""
  footer = "Generated by ooRexx PDF"
  headerText = ""
  blocks = .Array~new
  margin = 42
  pageWidth = 595
  pageHeight = 842
  topY = 790
  bottomY = 52
  defaultFontSize = 9
  orientation = "portrait"

::method title attribute
::method subtitle attribute
::method footer attribute
::method headerText attribute
::method margin attribute
::method orientation attribute

::method landscape
  expose orientation pageWidth pageHeight topY bottomY
  orientation = "landscape"
  pageWidth = 842
  pageHeight = 595
  topY = 543
  bottomY = 52
  return self

::method portrait
  expose orientation pageWidth pageHeight topY bottomY
  orientation = "portrait"
  pageWidth = 595
  pageHeight = 842
  topY = 790
  bottomY = 52
  return self

::method addPageBreak
  expose blocks
  blocks~append(.Array~of("PAGEBREAK"))
  return self

::method addParagraph
  expose blocks
  use strict arg text, size=9, bold=.false, spacingAfter=8
  blocks~append(.Array~of("PARAGRAPH", text~string, size, bold, spacingAfter))
  return self

::method addField
  expose blocks
  use strict arg label, value
  blocks~append(.Array~of("FIELD", label~string, value~string))
  return self

::method addSection
  expose blocks
  use strict arg text, level=1
  blocks~append(.Array~of("SECTION", text~string, level))
  return self

::method addLink
  expose blocks
  use strict arg text, url, size=9
  blocks~append(.Array~of("LINK", text~string, url~string, size))
  return self

::method addJpeg
  expose blocks
  use strict arg path, displayWidth=.nil, caption=""
  blocks~append(.Array~of("JPEG", path~string, displayWidth, caption~string))
  return self

::method addTable
  expose blocks
  use strict arg table
  blocks~append(.Array~of("TABLE", table))
  return self

::method render
  expose title subtitle footer headerText blocks margin pageWidth pageHeight topY bottomY defaultFontSize
  use strict arg path

  writer = .PdfWriter~new
  fontRegular = writer~addObject("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>")
  fontBold = writer~addObject("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>")
  canvases = .Array~new
  yPositions = .Array~new
  sections = .Array~new
  links = .Array~new
  images = .Array~new

  self~newPage(canvases, yPositions)

  do block over blocks
    kind = block[1]
    select
      when kind = "PARAGRAPH" then self~renderParagraph(block, canvases, yPositions)
      when kind = "FIELD" then self~renderField(block, canvases, yPositions)
      when kind = "TABLE" then self~renderTable(block[2], canvases, yPositions)
      when kind = "SECTION" then self~renderSection(block, canvases, yPositions, sections)
      when kind = "LINK" then self~renderLink(block, canvases, yPositions, links)
      when kind = "JPEG" then self~renderJpeg(block, writer, canvases, yPositions, images)
      when kind = "PAGEBREAK" then self~newPage(canvases, yPositions)
      otherwise raise syntax 93.900 array("Unknown PDF flow block: " || kind)
    end
  end

  pageCount = canvases~items
  contentIds = .Array~new
  do i = 1 to pageCount
    canvas = canvases[i]
    if headerText <> "" then do
      canvas~line(margin, pageHeight - 30, pageWidth - margin, pageHeight - 30, 0.35)
      canvas~text(margin, pageHeight - 22, 7, headerText, "F1")
    end
    canvas~line(margin, 42, pageWidth - margin, 42, 0.4)
    canvas~text(margin, 28, 7, footer, "F1")
    pageLabel = "Page " || i || " of " || pageCount
    canvas~text(pageWidth - margin - 62, 28, 7, pageLabel, "F1")
    contentIds~append(writer~addStream("", canvas~bytes, .true))
  end

  annotRefs = .Array~new
  do i = 1 to pageCount
    annotRefs~append(.Array~new)
  end
  do mark over links
    pno = mark[1]
    body = "<< /Type /Annot /Subtype /Link /Rect [" || mark[2] || " " || mark[3] || " " || mark[4] || " " || mark[5] || "] /Border [0 0 0] /A << /S /URI /URI " || .PdfText~literal(mark[6]) || " >> >>"
    aid = writer~addObject(body)
    annotRefs[pno]~append(aid || " 0 R")
  end

  xobjects = ""
  do im over images
    xobjects = xobjects || " /" || im[1] || " " || im[2] || " 0 R"
  end
  if xobjects <> "" then xobjects = " /XObject <<" || xobjects || " >>"

  pageRefs = .Array~new
  firstPageId = writer~objectsCount + 1
  pagesId = firstPageId + pageCount
  do i = 1 to pageCount
    annots = ""
    if annotRefs[i]~items > 0 then do
      annots = " /Annots ["
      do ar over annotRefs[i]; annots = annots || " " || ar; end
      annots = annots || " ]"
    end
    body = "<< /Type /Page /Parent " || pagesId || " 0 R /MediaBox [0 0 " || pageWidth || " " || pageHeight || "] " || ,
           "/Resources << /Font << /F1 " || fontRegular || " 0 R /F2 " || fontBold || " 0 R >>" || xobjects || " >> " || ,
           "/Contents " || contentIds[i] || " 0 R" || annots || " >>"
    pageId = writer~addObject(body)
    pageRefs~append(pageId || " 0 R")
  end

  kids = ""
  do ref over pageRefs
    if kids <> "" then kids = kids || " "
    kids = kids || ref
  end
  actualPagesId = writer~addObject("<< /Type /Pages /Count " || pageCount || " /Kids [ " || kids || " ] >>")
  if actualPagesId \= pagesId then raise syntax 93.900 array("internal page tree object numbering mismatch")

  outlinesId = 0
  if sections~items > 0 then do
    firstItemId = writer~objectsCount + 1
    outlinesId = firstItemId + sections~items
    do i = 1 to sections~items
      sec = sections[i]
      body = "<< /Title " || .PdfText~literal(sec[1]) || " /Parent " || outlinesId || " 0 R /Dest [" || pageRefs[sec[2]] || " /XYZ null " || sec[3] || " null]"
      if i > 1 then body = body || " /Prev " || (firstItemId + i - 2) || " 0 R"
      if i < sections~items then body = body || " /Next " || (firstItemId + i) || " 0 R"
      body = body || " >>"
      ignored = writer~addObject(body)
    end
    actualOutlinesId = writer~addObject("<< /Type /Outlines /First " || firstItemId || " 0 R /Last " || (firstItemId + sections~items - 1) || " 0 R /Count " || sections~items || " >>")
    if actualOutlinesId \= outlinesId then raise syntax 93.900 array("internal outline object numbering mismatch")
  end

  catalogBody = "<< /Type /Catalog /Pages " || pagesId || " 0 R"
  if outlinesId > 0 then catalogBody = catalogBody || " /Outlines " || outlinesId || " 0 R /PageMode /UseOutlines"
  catalogBody = catalogBody || " >>"
  catalogId = writer~addObject(catalogBody)
  infoId = writer~addObject("<< /Producer " || .PdfText~literal("Alchemy ooRexx PDF v0.1-dev4") || " /Title " || .PdfText~literal(title) || " >>")
  writer~rootId = catalogId
  writer~infoId = infoId
  return writer~writeFile(path)

::method newPage private
  expose title subtitle margin topY pageWidth
  use strict arg canvases, yPositions
  canvas = .PdfPageCanvas~new
  canvas~text(margin, topY, 18, title, "F2")
  y = topY - 22
  if subtitle <> "" then do
    canvas~text(margin, y, 9, subtitle, "F1")
    y = y - 16
  end
  canvas~line(margin, y, pageWidth - margin, y, 0.7)
  y = y - 18
  canvases~append(canvas)
  yPositions~append(y)
  return canvases~items

::method ensureSpace private
  expose bottomY
  use strict arg needed, canvases, yPositions
  page = canvases~items
  if yPositions[page] - needed < bottomY then page = self~newPage(canvases, yPositions)
  return page

::method renderParagraph private
  expose margin pageWidth
  use strict arg block, canvases, yPositions
  text = block[2]
  size = block[3]
  bold = block[4]
  spacing = block[5]
  font = "F1"
  if bold then font = "F2"
  chars = self~charsForWidth(pageWidth - (2 * margin), size)
  lines = self~wrap(text, chars)
  leading = size + 3
  do line over lines
    page = self~ensureSpace(leading, canvases, yPositions)
    y = yPositions[page]
    canvases[page]~text(margin, y, size, line, font)
    yPositions[page] = y - leading
  end
  page = canvases~items
  yPositions[page] = yPositions[page] - spacing

::method renderField private
  expose margin pageWidth
  use strict arg block, canvases, yPositions
  label = block[2]
  value = block[3]
  labelWidth = 122
  valueX = margin + labelWidth
  valueWidth = pageWidth - margin - valueX
  lines = self~wrap(value, self~charsForWidth(valueWidth, 9))
  needed = max(24, lines~items * 12 + 6)
  page = self~ensureSpace(needed, canvases, yPositions)
  y = yPositions[page]
  canvases[page]~text(margin, y, 9, label, "F2")
  offset = 0
  do line over lines
    canvases[page]~text(valueX, y - offset, 9, line, "F1")
    offset = offset + 12
  end
  yPositions[page] = y - needed

::method renderSection private
  expose margin
  use strict arg block, canvases, yPositions, sections
  text = block[2]
  level = block[3]
  size = 14
  if level > 1 then size = 11
  page = self~ensureSpace(size + 18, canvases, yPositions)
  y = yPositions[page]
  canvases[page]~text(margin, y, size, text, "F2")
  sections~append(.Array~of(text, page, y + 8))
  yPositions[page] = y - size - 10

::method renderLink private
  expose margin pageWidth
  use strict arg block, canvases, yPositions, links
  text = block[2]; url = block[3]; size = block[4]
  lines = self~wrap(text, self~charsForWidth(pageWidth - (2 * margin), size))
  leading = size + 4
  do line over lines
    page = self~ensureSpace(leading, canvases, yPositions)
    y = yPositions[page]
    canvas = canvases[page]
    canvas~textColor(0, 0, 1)
    canvas~text(margin, y, size, line, "F1")
    canvas~textColor(0, 0, 0)
    w = length(line) * size * 0.50
    canvas~line(margin, y - 2, margin + w, y - 2, 0.3)
    links~append(.Array~of(page, margin, y - 3, margin + w, y + size + 2, url))
    yPositions[page] = y - leading
  end
  page = canvases~items
  yPositions[page] = yPositions[page] - 4

::method renderJpeg private
  expose margin pageWidth bottomY
  use strict arg block, writer, canvases, yPositions, images
  image = .PdfJpegImage~new(block[2])
  maxWidth = pageWidth - (2 * margin)
  drawWidth = block[3]
  if drawWidth == .nil then drawWidth = min(maxWidth, image~width)
  if drawWidth > maxWidth then drawWidth = maxWidth
  drawHeight = drawWidth * image~height / image~width
  available = yPositions[canvases~items] - bottomY - 10
  if drawHeight > available then do
    self~newPage(canvases, yPositions)
    available = yPositions[canvases~items] - bottomY - 10
  end
  if drawHeight > available then do
    scale = available / drawHeight
    drawWidth = drawWidth * scale
    drawHeight = drawHeight * scale
  end
  dict = "/Type /XObject /Subtype /Image /Width " || image~width || " /Height " || image~height || " /ColorSpace " || image~colorSpace || " /BitsPerComponent 8 /Filter /DCTDecode"
  oid = writer~addStream(dict, image~data, .false)
  name = "Im" || (images~items + 1)
  images~append(.Array~of(name, oid))
  page = canvases~items
  yTop = yPositions[page]
  yBottom = yTop - drawHeight
  canvases[page]~image(name, margin, yBottom, drawWidth, drawHeight)
  yPositions[page] = yBottom - 8
  caption = block[4]
  if caption <> "" then do
    pblock = .Array~of("PARAGRAPH", caption, 7, .false, 8)
    self~renderParagraph(pblock, canvases, yPositions)
  end

::method renderTable private
  expose margin pageWidth bottomY topY
  use strict arg table, canvases, yPositions
  headers = table~headers
  widths = self~resolvedWidths(table~widths, headers~items, pageWidth - (2 * margin))
  fontSize = table~fontSize
  padding = table~padding
  leading = fontSize + 2

  if table~title <> "" then do
    page = self~ensureSpace(22, canvases, yPositions)
    y = yPositions[page]
    canvases[page]~text(margin, y, 11, table~title, "F2")
    yPositions[page] = y - 17
  end

  self~drawTableHeader(table, widths, canvases, yPositions)
  rowNo = 0
  do row over table~rows
    rowNo = rowNo + 1
    cells = self~prepareRow(table, row, widths, fontSize, padding)
    lineOffset = 1
    totalLines = self~maxCellLineCount(cells)

    do while lineOffset <= totalLines
      page = canvases~items
      availableHeight = yPositions[page] - bottomY
      maxLinesHere = (availableHeight - (2 * padding)) % leading
      if maxLinesHere < 1 then do
        self~newPage(canvases, yPositions)
        if table~repeatHeader then self~drawTableHeader(table, widths, canvases, yPositions)
        iterate
      end

      remaining = totalLines - lineOffset + 1
      linesHere = min(remaining, maxLinesHere)
      rowHeight = (linesHere * leading) + (2 * padding)
      if rowHeight < leading + (2 * padding) then rowHeight = leading + (2 * padding)

      /* Avoid a tiny fragment when the complete remaining row fits on a fresh page. */
      freshCapacity = ((topY - 22 - 18) - bottomY - (2 * padding)) % leading
      if remaining > linesHere & linesHere < 2 & remaining <= freshCapacity then do
        self~newPage(canvases, yPositions)
        if table~repeatHeader then self~drawTableHeader(table, widths, canvases, yPositions)
        iterate
      end

      page = canvases~items
      yTop = yPositions[page]
      yBottom = yTop - rowHeight
      canvas = canvases[page]
      if table~zebra & (rowNo // 2 = 0) then canvas~fillRect(margin, yBottom, self~sumWidths(widths), rowHeight, 0.95)
      self~drawCellGrid(canvas, margin, yBottom, rowHeight, cells, widths)
      self~drawCellText(canvas, margin, yTop, cells, lineOffset, linesHere, widths, fontSize, padding, leading, "F1")
      yPositions[page] = yBottom
      lineOffset = lineOffset + linesHere

      if lineOffset <= totalLines then do
        self~newPage(canvases, yPositions)
        if table~repeatHeader then self~drawTableHeader(table, widths, canvases, yPositions)
      end
    end
  end
  page = canvases~items
  yPositions[page] = yPositions[page] - 12

::method drawTableHeader private
  expose margin
  use strict arg table, widths, canvases, yPositions
  fontSize = table~fontSize
  padding = table~padding
  leading = fontSize + 2
  cells = self~prepareRow(table, table~headers, widths, fontSize, padding)
  lineCount = self~maxCellLineCount(cells)
  rowHeight = (lineCount * leading) + (2 * padding)
  page = self~ensureSpace(rowHeight + 2, canvases, yPositions)
  yTop = yPositions[page]
  yBottom = yTop - rowHeight
  canvas = canvases[page]
  canvas~fillRect(margin, yBottom, self~sumWidths(widths), rowHeight, 0.88)
  self~drawCellGrid(canvas, margin, yBottom, rowHeight, cells, widths)
  self~drawCellText(canvas, margin, yTop, cells, 1, lineCount, widths, fontSize, padding, leading, "F2")
  yPositions[page] = yBottom

::method prepareRow private
  use strict arg table, row, widths, fontSize, padding
  cells = .Array~new
  column = 1
  do item over row
    if column > widths~items then leave
    span = 1
    align = ""
    bold = .false
    value = item
    if item~isInstanceOf(.PdfCell) then do
      value = item~value
      span = item~span
      align = item~align
      bold = item~bold
    end
    if span > widths~items - column + 1 then span = widths~items - column + 1
    if align = "" then align = self~alignmentFor(table, column)
    value = self~formatFor(table, column, value)
    cellWidth = 0
    do k = column to column + span - 1
      cellWidth = cellWidth + widths[k]
    end
    chars = self~charsForWidth(cellWidth - (2 * padding), fontSize)
    lines = self~wrap(value, chars)
    cells~append(.Array~of(column, span, value, align, bold, lines, cellWidth))
    column = column + span
  end
  do while column <= widths~items
    cellWidth = widths[column]
    cells~append(.Array~of(column, 1, "", self~alignmentFor(table,column), .false, self~wrap("",1), cellWidth))
    column = column + 1
  end
  return cells

::method alignmentFor private
  use strict arg table, column
  aligns = table~alignments
  if aligns \== .nil then do
    if column <= aligns~items then do
      a = aligns[column]~string~lower
      if a = "left" | a = "center" | a = "right" then return a
    end
  end
  types = table~columnTypes
  if types \== .nil then do
    if column <= types~items then do
      t = types[column]~string~lower
      if t = "integer" | t = "decimal" | t = "decimal2" | t = "money2" | t = "percent" | t = "percent2" then return "right"
    end
  end
  return "left"

::method formatFor private
  use strict arg table, column, value
  if value == .nil then return ""
  types = table~columnTypes
  if types == .nil then return value~string
  if column > types~items then return value~string
  t = types[column]~string~lower
  v = value~string
  if t = "decimal2" | t = "money2" then do
    if datatype(v, "N") then return format(v,,2)~strip
  end
  if t = "percent2" then do
    if datatype(v, "N") then return format(v,,2)~strip || "%"
  end
  if t = "percent" then do
    if datatype(v, "N") then return v || "%"
  end
  return v

::method drawCellGrid private
  use strict arg canvas, x, yBottom, rowHeight, cells, widths
  total = self~sumWidths(widths)
  canvas~rect(x, yBottom, total, rowHeight, 0.35)
  do cell over cells
    endColumn = cell[1] + cell[2] - 1
    if endColumn < widths~items then do
      cursor = x
      do k = 1 to endColumn
        cursor = cursor + widths[k]
      end
      canvas~line(cursor, yBottom, cursor, yBottom + rowHeight, 0.35)
    end
  end

::method drawCellText private
  use strict arg canvas, startX, yTop, cells, lineOffset, linesHere, widths, fontSize, padding, leading, defaultFont
  do cell over cells
    column = cell[1]
    span = cell[2]
    align = cell[4]
    bold = cell[5]
    lines = cell[6]
    cellWidth = cell[7]
    x = startX
    do k = 1 to column - 1
      x = x + widths[k]
    end
    font = defaultFont
    if bold then font = "F2"
    do j = 0 to linesHere - 1
      idx = lineOffset + j
      if idx <= lines~items then do
        line = lines[idx]
        textWidth = length(line) * fontSize * 0.50
        tx = x + padding
        if align = "right" then tx = x + cellWidth - padding - textWidth
        else if align = "center" then tx = x + ((cellWidth - textWidth) / 2)
        if tx < x + padding then tx = x + padding
        canvas~text(tx, yTop - padding - fontSize - (j * leading), fontSize, line, font)
      end
    end
  end

::method maxCellLineCount private
  use strict arg cells
  biggest = 1
  do cell over cells
    lines = cell[6]
    biggest = max(biggest, lines~items)
  end
  return biggest

::method resolvedWidths private
  use strict arg requested, columns, available
  out = .Array~new
  if requested == .nil | requested~items <> columns then do
    each = available / columns
    do i = 1 to columns
      out~append(each)
    end
    return out
  end
  total = 0
  do w over requested
    total = total + w
  end
  if total <= 0 then raise syntax 93.900 array("PdfTable widths must total more than zero")
  scale = available / total
  do w over requested
    out~append(w * scale)
  end
  return out

::method sumWidths private
  use strict arg widths
  total = 0
  do w over widths
    total = total + w
  end
  return total

::method charsForWidth private
  use strict arg width, fontSize
  /* Helvetica average glyph width is roughly 0.50 em for mixed report text.
     Conservative estimate keeps content inside cells without font metrics. */
  chars = (width / (fontSize * 0.52))~floor
  return max(1, chars)

::method wrap private
  use strict arg value, maxChars
  text = value~string
  lines = .Array~new
  if text = "" then do
    lines~append("")
    return lines
  end

  /* Preserve explicit line breaks, then word-wrap each logical line. */
  text = changestr('0d0a'x, text, '0a'x)
  text = changestr('0d'x, text, '0a'x)
  do while pos('0a'x, text) > 0
    p = pos('0a'x, text)
    part = substr(text, 1, p - 1)
    self~wrapOne(part, maxChars, lines)
    text = substr(text, p + 1)
  end
  self~wrapOne(text, maxChars, lines)
  return lines

::method wrapOne private
  use strict arg text, maxChars, lines
  if text = "" then do
    lines~append("")
    return
  end
  current = ""
  do i = 1 to text~words
    word = text~word(i)
    do while length(word) > maxChars
      if current <> "" then do
        lines~append(current)
        current = ""
      end
      lines~append(substr(word, 1, maxChars))
      word = substr(word, maxChars + 1)
    end
    if current = "" then candidate = word
    else candidate = current || " " || word
    if length(candidate) <= maxChars then current = candidate
    else do
      if current <> "" then lines~append(current)
      current = word
    end
  end
  if current <> "" then lines~append(current)

::requires 'PdfDeflate.cls'
