{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "camera_behaviour_oorexx",
    "version": "0.35",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "LIVE_CAMERA_ROOT": "/home/hc3/alchemy/camera_behaviour_oorexx"
    }
  },
  "tests": [
    {
      "name": "prepare-camera-v035",
      "argv": ["bash", "prepare_package.sh"],
      "timeout_seconds": 60,
      "environment": {
        "require_dirs": ["LIVE_CAMERA_ROOT"],
        "report": ["LIVE_CAMERA_ROOT"]
      }
    },
    {
      "name": "camera-v035-suite",
      "argv": ["bash", "run_tests.sh"],
      "timeout_seconds": 240,
      "environment": {
        "rexx_path": {
          "mode": "replace",
          "entries": ["${PACKAGE_ROOT}/prepared/camera_behaviour_oorexx_v0.35"],
          "require_entries": true
        }
      }
    }
  ],
  "publish": {
    "tree": {
      "source": "prepared/camera_behaviour_oorexx_v0.35",
      "path": "packages/camera_behaviour_oorexx_v0.35"
    }
  }
}
