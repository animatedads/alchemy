{
  "schema": "rasenfalcon.private-https-boundary/0.1",
  "decision_date": "2026-10-22",
  "status": "ARCHITECTURAL_DIRECTIVE_NOT_INSTALLED",
  "instances": {
    "noc.rasenfalcon.com": {
      "service": "rasenfalcon-noc-https.service",
      "owner": "RexxOS isolated NOC instance",
      "implementation": "owned_oorexx_https_server",
      "dedicated_process": true,
      "issuer": "owner_private_CA",
      "leaf_SAN": [
        "noc.rasenfalcon.com"
      ],
      "mTLS_client_cert": "required",
      "anonymous_access": "forbidden"
    },
    "office.rasenfalcon.com": {
      "service": "rasenfalcon-office-https.service",
      "owner": "RexxOS isolated Office instance",
      "implementation": "owned_oorexx_https_server",
      "dedicated_process": true,
      "issuer": "owner_private_CA",
      "leaf_SAN": [
        "office.rasenfalcon.com"
      ],
      "mTLS_client_cert": "required",
      "anonymous_access": "forbidden",
      "routes": [
        "/mail",
        "/notes"
      ]
    }
  },
  "private_ca": {
    "root_install": "approved_operator_devices_only",
    "different_server_certificates_and_keys": true,
    "per_device_client_certificate": true,
    "client_ca_distinct_from_server_ca_preferred": true,
    "no_private_keys_in_artifacts": true,
    "revocation_fail_closed": true
  },
  "tls_reject": [
    "missing_client_cert",
    "expired_client_cert",
    "revoked_client_cert",
    "wrong_EKU",
    "wrong_client_issuer",
    "unknown_SNI",
    "missing_SNI",
    "SNI_Host_mismatch",
    "missing_server_certificate",
    "invalid_issuer_state"
  ],
  "fallback_forbidden": [
    "HTTP_plaintext",
    "public_ACME",
    "public_CA",
    "anonymous_TLS",
    "password_only",
    "default_virtual_host",
    "public_site",
    "insecure_retry",
    "reverse_proxy_bypass"
  ],
  "applications": {
    "secondary_authorization": [
      "LDAP_identity",
      "Access_Permissions"
    ],
    "binding": "verified_TLS_client_identity_to_principal"
  },
  "public_site": {
    "host": "rasenfalcon.com",
    "separate_security_boundary": true,
    "public_TLS_allowed": true,
    "NOC_Office_mTLS_not_applied_to_public_site": true
  },
  "scheduling": {
    "schedule_authority": "bashqueues_cron_bridge",
    "ticker": "systemd_minute_timer",
    "actual_execution": "bashqueues_workers",
    "system_crond_dependency": false,
    "direct_systemd_business_job_timer": false
  },
  "live_changes_permitted": false
}
