+/* A broker can accept a send then throw: the resulting claim is uncertain.
+ * This must NOT nack or provoke a second send. */
+manager~ackSuccess=.true
+port~throwSend=.true
+manager~pending=.FakePackage~new('pkg-4','broker-throw','ct-4')
+oldNacks=manager~nacks
+oldAcks=manager~acks
+to=bridge~toJms('TOPIC.OUT')
+call check to~code == 'SEND_UNCERTAIN' & manager~nacks == oldNacks & manager~acks == oldAcks,'broker send exception remains uncertain without nack/ack'
+port~throwSend=.false
+/* Queue acknowledgement can throw AFTER the broker accepted a message. */
+manager~throwAck=.true
+manager~pending=.FakePackage~new('pkg-5','queue-ack-throw','ct-5')
+oldNacks=manager~nacks
+to=bridge~toJms('TOPIC.OUT')
+call check to~code == 'QUEUE_ACK_UNCERTAIN' & to~accepted & manager~nacks == oldNacks,'queue ack exception preserves broker acceptance and does not nack'
+manager~throwAck=.false
+/* Inbound JMS acknowledgement exceptions must not mask the durable commit. */
+port~throwAck=.true
+port~incoming=.ConnectJmsDelivery~new('jms-20','inbound-ack-throw')
+oldPuts=manager~puts
+from=bridge~fromJms('TOPIC.IN')
+call check from~code == 'ACK_UNCERTAIN' & from~durable & manager~puts == oldPuts + 1,'JMS ack exception preserves prior durable QueueFabric commit'
+port~throwAck=.false
+/* A receive exception is not evidence of an acquired or acknowledged message. */
+port~throwReceive=.true
+oldPuts=manager~puts
+from=bridge~fromJms('TOPIC.IN')
+call check from~code == 'RECEIVE_UNCERTAIN' & manager~puts == oldPuts,'receive exception fails closed before queue insertion'
+port~throwReceive=.false
+/* A queue port may throw after committing: no JMS ack or forced recovery. */
+manager~throwPut=.true
+oldAcks=port~acked
+oldRecoveries=port~recoveries
+from=bridge~fromJms('TOPIC.IN')
+call check from~code == 'QUEUE_COMMIT_UNCERTAIN' & port~acked == oldAcks & port~recoveries == oldRecoveries,'queue commit exception must not ack or force JMS recovery'
+manager~throwPut=.false
+manager~putSuccess=.false
+port~throwRecover=.true
+from=bridge~fromJms('TOPIC.IN')
+call check from~code == 'RECOVERY_UNCERTAIN' & port~acked == oldAcks,'recover exception is uncertain, not an ack'
+port~throwRecover=.false
+manager~putSuccess=.true
 say 'PASS JMS bridge: both directions, ack ordering, backout, uncertainty'
 exit 0
