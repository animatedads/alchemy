{
  "schema": "snmp.implementation.map/0.2",
  "name": "example-vendor-sensor",
  "objects": [
    {
      "name": "temperature",
      "oid": "1.3.6.1.4.1.99999.1.1.0",
      "kind": "scalar",
      "syntax": "INTEGER",
      "access": "read-only",
      "metadata": {
        "unit": "celsius"
      }
    },
    {
      "name": "fanMode",
      "oid": "1.3.6.1.4.1.99999.1.2.0",
      "kind": "scalar",
      "syntax": "INTEGER",
      "access": "read-write",
      "enum": {
        "1": "auto",
        "2": "full",
        "3": "quiet"
      }
    }
  ],
  "eventRules": [
    {
      "name": "temperatureCritical",
      "property": "temperature",
      "operator": "GE",
      "value": 80,
      "edge": "ENTER",
      "eventType": "SENSOR.TEMPERATURE.CRITICAL",
      "scope": "AGENT"
    },
    {
      "name": "temperatureRecovered",
      "property": "temperature",
      "operator": "GE",
      "value": 80,
      "edge": "EXIT",
      "eventType": "SENSOR.TEMPERATURE.RECOVERED",
      "scope": "AGENT"
    }
  ],
  "aliases": [
    {
      "name": "temperatureCelsius",
      "target": "temperature",
      "kind": "property",
      "scope": "AGENT"
    },
    {
      "name": "coolingMode",
      "target": "fanMode",
      "kind": "property",
      "scope": "AGENT"
    }
  ]
}
