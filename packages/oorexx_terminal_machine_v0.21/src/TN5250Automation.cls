/*
 * TN5250 runtime + automation boundary v0.9.
 *
 * Trusted runtime path:
 *   Telnet -> RFC1205 -> 5250 -> PresentationSpace -> raw outbound wire.
 *
 * Safe automation path:
 *   immutable snapshot -> field/cursor/AID/control action -> safe receipt.
 *
 * The safe facade deliberately has no feedNetwork(), drainOutbound(), model,
 * driver or Telnet getter.  This is not cosmetic: an outbound READ response can
 * contain a nondisplay/password field and must never be returned to the AI that
 * caused the action.
 */

::class TN5250AutomationBuild public
::constant RELEASE "0.9"
::constant API_VERSION "terminal.tn5250.automation/0.9"

/* Trusted result.  Only transport/runtime code should receive this object. */
::class TN5250RuntimeFeedResult public
::attribute outboundBytes get
::attribute telnetEvents get
::attribute driverResults get
::attribute snapshot get

::method init
  expose outboundBytes telnetEvents driverResults snapshot
  use arg outboundArg = "", eventsArg = .nil, resultsArg = .nil, snapshotArg = .nil
  outboundBytes = outboundArg
  telnetEvents = .TerminalUtil~copyArray(eventsArg)
  driverResults = .TerminalUtil~copyArray(resultsArg)
  if snapshotArg == .nil then snapshot = .nil
  else snapshot = snapshotArg~copyDetached

/* Safe action receipt.  transportOutputPending is a Boolean only; it never
 * contains the wire response generated by a password-bearing READ. */
::class TN5250ActionResult public
::attribute receipt get
::attribute transportOutputPending get
::attribute snapshot get

::method init
  expose receipt transportOutputPending snapshot
  use arg receiptArg, outputPendingArg = .false, snapshotArg = .nil
  receipt = receiptArg
  transportOutputPending = outputPendingArg == .true
  if snapshotArg == .nil then snapshot = .nil
  else snapshot = snapshotArg~copyDetached

/* Read-only observer facade.  It deliberately exposes snapshots and the
 * immutable WatchAlong history, but no mutation port, model, runtime or
 * transport object. */
::class TN5250ObservationSession public
::attribute sessionId get
::attribute terminalType get
::attribute deviceName get

::method init
  expose sessionId terminalType deviceName watchAlong agent knownStateTracker
  use arg sessionIdArg, terminalTypeArg, deviceNameArg, watchAlongArg, agentArg, knownStateTrackerArg = .nil
  sessionId = sessionIdArg~string
  terminalType = terminalTypeArg~string
  deviceName = deviceNameArg~string
  watchAlong = watchAlongArg
  agent = agentArg
  knownStateTracker = knownStateTrackerArg

::method snapshot
  expose agent
  return agent~snapshot

::method current
  expose watchAlong
  return watchAlong~current

::method back
  expose watchAlong
  use arg count = 1
  return watchAlong~back(count)

::method history
  expose watchAlong
  return watchAlong~history

::method knownStateStatus
  expose knownStateTracker
  if knownStateTracker == .nil then return "UNTRACKED"
  return knownStateTracker~currentStatus

::method knownStateId
  expose knownStateTracker
  if knownStateTracker == .nil then return ""
  return knownStateTracker~currentStateId

::method knownStateGeneration
  expose knownStateTracker
  if knownStateTracker == .nil then return 0
  return knownStateTracker~currentGeneration

::method knownStateHistory
  expose knownStateTracker
  if knownStateTracker == .nil then return .array~new
  return knownStateTracker~history

::class TN5250RuntimeSession public
::attribute sessionId get
::attribute terminalType get
::attribute deviceName get
::attribute terminalSession get
::attribute watchAlong get

::method init
  expose sessionId terminalType deviceName model terminalSession watchAlong profile telnet driver agent knownStateTracker
  use arg sessionIdArg, terminalTypeArg = "IBM-3179-2", deviceNameArg = "", watchCapacityArg = 64, codePageArg = .nil, collisionPolicyArg = "ADVANCE"
  sessionId = sessionIdArg~string
  terminalType = terminalTypeArg~string~strip~upper
  deviceName = deviceNameArg~string~strip~upper
  model = .PresentationSpace5250~new
  terminalSession = .TerminalSession~new(sessionId, model)
  watchAlong = .TerminalWatchAlong~new(watchCapacityArg)
  terminalSession~addWatcher(watchAlong)
  knownStateTracker = .nil
  profile = .TN5250TelnetProfile~new(terminalType, deviceName, collisionPolicyArg)
  telnet = .TelnetMachine~new(profile)
  driver = .TN5250DisplayDriver~new(model, terminalSession, codePageArg)
  agent = .Terminal5250AgentPort~new(terminalSession, model)

::method automationPort
  expose sessionId terminalType deviceName terminalSession watchAlong agent
  return .TN5250AutomationSession~new(sessionId, terminalType, deviceName, terminalSession, watchAlong, agent, self)

::method observationPort
  expose sessionId terminalType deviceName watchAlong agent knownStateTracker
  return .TN5250ObservationSession~new(sessionId, terminalType, deviceName, watchAlong, agent, knownStateTracker)

::method attachKnownStateCatalog
  expose terminalSession agent knownStateTracker
  use arg catalogArg, capacityArg = 64, sealerArg = .nil, alchemyAuthorityArg = .nil
  if catalogArg == .nil then return .TerminalResult~failure("KNOWN_STATE_CATALOG_REQUIRED", "catalog is required")
  if knownStateTracker \== .nil then return .TerminalResult~failure("KNOWN_STATE_TRACKER_EXISTS", "runtime already has a semantic state tracker")
  knownStateTracker = .TerminalKnownStateTracker~new(catalogArg, capacityArg, sealerArg, alchemyAuthorityArg)
  terminalSession~addWatcher(knownStateTracker)
  current = agent~snapshot
  if current~generation > 0 then knownStateTracker~observe(current)
  return .TerminalResult~success(knownStateTracker)

::method knownStateTracker
  expose knownStateTracker
  return knownStateTracker

::method snapshot
  expose agent
  return agent~snapshot

/* Trusted-only credential capability consumption.  The lease object is never
 * returned and is never reachable from automationPort(). */
::method applyCredentialLease
  expose agent
  use arg generationArg, userFieldIdArg, passwordFieldIdArg, leaseArg
  if leaseArg == .nil then return .TerminalResult~failure("CREDENTIAL_LEASE_REQUIRED", "trusted credential lease required")
  if \leaseArg~isA(.TerminalCredentialLease) then return .TerminalResult~failure("CREDENTIAL_LEASE_REQUIRED", "trusted credential lease required")
  secretResult = leaseArg~secretForTrustedConsumer
  if \secretResult~ok then return secretResult
  staged = agent~stageCredentialPair(generationArg, userFieldIdArg, leaseArg~userName, passwordFieldIdArg, secretResult~value, "CREDENTIAL_BROKER")
  if \staged~ok then return staged
  return .TerminalResult~success(agent~snapshot)

/* Trusted primitive used by specialized secret workflows such as IBM i
 * password change.  It is intentionally not surfaced by
 * TN5250AutomationSession. */
::method stageNondisplaySecretTriple
  expose agent
  use arg generationArg, firstFieldIdArg, firstValueArg, secondFieldIdArg, secondValueArg, thirdFieldIdArg, thirdValueArg, actorArg = "CREDENTIAL_BROKER"
  return agent~stageNondisplaySecretTriple(generationArg, firstFieldIdArg, firstValueArg, secondFieldIdArg, secondValueArg, thirdFieldIdArg, thirdValueArg, actorArg)

::method negotiatedDeviceName
  expose profile
  return profile~deviceName

::method deviceNameCollisionCount
  expose profile
  return profile~deviceNameCollisionCount

::method deviceNameCollisionPolicy
  expose profile
  return profile~collisionPolicy

::method strictDeviceCollisionDetected
  expose profile
  return profile~strictDeviceCollisionDetected

::method transparentReady
  expose profile
  return profile~transparentReady

::method parserState
  expose telnet
  return telnet~parserState

::method hasPendingTerminalOutput
  expose driver
  return driver~hasPendingTerminalOutput

/* Drain only terminal-originated RFC1205 responses which became ready because
 * of an automation action (AID, immediate pending response or control signal).
 * Returned bytes are trusted transport data and may contain secrets. */
::method drainTerminalOutput
  expose driver
  outbound = ""
  do forever
    pending = driver~takePendingTerminalTelnetFrame
    if pending~ok then outbound ||= pending~value
    else do
      if pending~code = "TN5250_NO_PENDING_OUTPUT" then leave
      return pending
    end
  end
  return .TerminalResult~success(outbound)

/* Feed arbitrary network chunks.  TelnetMachine is incremental, so a chunk may
 * end in the middle of IAC negotiation, subnegotiation or a logical record. */
::method feedNetwork
  expose telnet driver agent
  use arg bytesArg
  telnet~feed(bytesArg)
  outbound = telnet~drainOutbound
  events = telnet~drainEvents
  driverResults = .array~new

  do event over events
    if event~eventType \= "RECORD" then iterate
    handled = driver~consumeRecordBytes(event~data)
    if \handled~ok then return handled
    dr = handled~value
    driverResults~append(dr)
    do rawRecord over dr~outboundRecords
      outbound ||= .TN5250RecordCodec~telnetFrame(rawRecord)
    end

    /* A READ can arrive after an AID was retained, or an immediate READ can
     * make a response ready while this host record is being consumed. */
    do forever
      pending = driver~takePendingTerminalTelnetFrame
      if pending~ok then outbound ||= pending~value
      else do
        if pending~code = "TN5250_NO_PENDING_OUTPUT" then leave
        return pending
      end
    end
  end

  return .TerminalResult~success(.TN5250RuntimeFeedResult~new(outbound, events, driverResults, agent~snapshot))

/* Safe AI/operator facade.  Store runtime privately only so it can answer the
 * Boolean 'wire pending?' question after an action.  No method returns it. */
::class TN5250AutomationSession public
::attribute sessionId get
::attribute terminalType get
::attribute deviceName get
::attribute terminalSession get
::attribute watchAlong get

::method init
  expose sessionId terminalType deviceName terminalSession watchAlong agent runtime
  use arg sessionIdArg, terminalTypeArg, deviceNameArg, terminalSessionArg, watchAlongArg, agentArg, runtimeArg
  sessionId = sessionIdArg~string
  terminalType = terminalTypeArg~string
  deviceName = deviceNameArg~string
  terminalSession = terminalSessionArg
  watchAlong = watchAlongArg
  agent = agentArg
  runtime = runtimeArg

::method snapshot
  expose agent
  return agent~snapshot

::method setField
  expose agent
  use arg generationArg, fieldId, valueArg, actor = "AI"
  return agent~setField(generationArg, fieldId, valueArg, actor)

::method moveCursor
  expose agent
  use arg generationArg, rowArg, columnArg, actor = "AI"
  return agent~moveCursor(generationArg, rowArg, columnArg, actor)

::method focusField
  expose agent
  use arg generationArg, fieldIdArg, actor = "AI"
  return agent~focusField(generationArg, fieldIdArg, actor)

::method nextInputField
  expose agent
  use arg generationArg, actor = "AI"
  return agent~nextInputField(generationArg, actor)

::method previousInputField
  expose agent
  use arg generationArg, actor = "AI"
  return agent~previousInputField(generationArg, actor)

::method home
  expose agent
  use arg generationArg, actor = "AI"
  return agent~home(generationArg, actor)

::method typeAtCursor
  expose agent
  use arg generationArg, textArg, actor = "AI"
  return agent~typeAtCursor(generationArg, textArg, actor)

::method errorReset
  expose agent
  use arg generationArg, actor = "AI"
  return agent~errorReset(generationArg, actor)

::method press
  expose agent runtime
  use arg generationArg, aidName, actor = "AI"
  pressed = agent~press(generationArg, aidName, actor)
  if \pressed~ok then return pressed
  return .TerminalResult~success(.TN5250ActionResult~new(pressed~value, runtime~hasPendingTerminalOutput, agent~snapshot))

::method systemRequest
  expose agent runtime
  use arg generationArg, actor = "AI"
  requested = agent~systemRequest(generationArg, actor)
  if \requested~ok then return requested
  return .TerminalResult~success(.TN5250ActionResult~new(requested~value, runtime~hasPendingTerminalOutput, agent~snapshot))

