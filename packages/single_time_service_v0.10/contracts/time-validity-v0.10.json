{
  "schema": "single.time.validity/0.1",
  "scale": "POSIX_SECONDS",
  "bounds": {
    "notBefore": "inclusive",
    "notAfter": "exclusive",
    "clockLower": "inclusive",
    "clockUpper": "inclusive"
  },
  "status": [
    "DEFINITELY_TOO_EARLY",
    "DEFINITELY_EXPIRED",
    "INSIDE_TIME_WINDOW",
    "INDETERMINATE"
  ],
  "requiresClockSourceAuthorization": true,
  "authorisesCredentialUse": false,
  "networkExposure": false
}
