/*
 * REAL NoSQLServer v0.58 + Algorithm Relation bridge test.
 * Generated by run_nosqlserver_v058_live.sh with an absolute ::REQUIRES path.
 */

parse arg root
if root == '' then root = '/tmp/virtual_ryta_nosqlserver_v05'

say 'NOSQLSERVER V0.58 ALGORITHM RELATION LIVE START'

fed = .FederatedDatabaseEngine~new(root)
sql = .NoSQLServerSQL~new(fed)

world = .RYTAWorldState~new('WORLD-NOSQL-LIVE-1')
world~putKnown('HAS_QUERY', .true)
world~putKnown('PRODUCT_RELEVANT', .true)
world~putKnown('PRODUCT_VALUE_HIGH', .true)
world~putKnown('UPSELL_OPPORTUNITY', .true)
world~putKnown('ESSENTIAL_MEDICATION', .true)
world~putKnown('IMMEDIATE_ACCESS', .true)
world~putKnown('GUARANTEED_CUSTODY', .false)

provider = .RYTAAlgorithmProvider~new(.nil, '..')
algorithmEngine = .AlgorithmRelationEngine~new
call assert algorithmEngine~addProvider(provider), 'provider registration'

/* Pass the real NoSQLServer class object explicitly across package boundary. */
adapter = .NoSQLServerAlgorithmRelationAdapter~new(fed, algorithmEngine, .ObjectTableMapping)

/* Metadata bind must be pure. */
schema = adapter~describe('VIRTUAL_RYTA', 'RYTA_ACTION_DECISIONS')
call assert schema \== .nil, 'algorithm relation metadata description'
call assert provider~invocationCount = 0, 'metadata does not invoke provider'

context = .AlgorithmExecutionContext~new('NOSQL-LIVE-INV-1', world~snapshotOid, world~snapshotOid)
algorithmResult = adapter~materialize('VIRTUAL_RYTA', world, context)
call assert algorithmResult \== .nil, 'algorithm materialized'
call assert provider~invocationCount = 1, 'provider executed exactly once'

bindings = .directory~new
bindings['RYTA_ACTION_DECISIONS'] = 'ryta_actions'
bindings['RYTA_DECISION_TRACE'] = 'ryta_trace'
registered = adapter~registerMaterializedSet(algorithmResult, bindings)
call assert registered \== .nil, 'materialized relations registered'
call assert registered~items = 2, 'two Algorithm Relations registered'
call assert provider~invocationCount = 1, 'registration does not rerun provider'

/* Ordinary SQL filter/order over the frozen Algorithm Relation rows. */
query = "SELECT a.action_code, a.disposition " ||,
        "FROM ryta_actions a " ||,
        "WHERE a.disposition = 'PROHIBITED' " ||,
        "ORDER BY a.action_code"
rs = sql~execute(query)
call ok rs
say 'Prohibited Virtual RYTA actions through NoSQLServer:'
do row over rs~rows
  say '  ' row['a.action_code'] '|' row['a.disposition']
end
call assert rs~rows~items = 2, 'two prohibited actions'
call assert rs~rows[1]['a.action_code'] = 'BIG_UPSELL', 'BIG_UPSELL first prohibited action'
call assert rs~rows[2]['a.action_code'] = 'UPSELL', 'UPSELL second prohibited action'
call assert provider~invocationCount = 1, 'SQL scan cannot rerun provider'

/* Repeat the same SQL read: NoSQLServer rereads frozen objects, not algorithm. */
rs2 = sql~execute(query)
call ok rs2
call assert rs2~rows~items = 2, 'repeat SQL scan stable'
call assert provider~invocationCount = 1, 'repeat SQL scan still one provider execution'

/* Persisted table + Algorithm Relation federation in one ordinary SQL join. */
call ok sql~execute("CREATE TABLE action_labels (action_code VARCHAR PRIMARY KEY, label VARCHAR)")
call ok sql~execute("INSERT INTO action_labels VALUES ('WARNING','Safety warning'),('UPSELL','Upsell'),('BIG_UPSELL','Large upsell')")

joinQuery = "SELECT a.action_code, a.disposition, l.label " ||,
            "FROM ryta_actions a " ||,
            "JOIN action_labels l ON a.action_code = l.action_code " ||,
            "WHERE a.disposition = 'PROHIBITED' " ||,
            "ORDER BY a.action_code"
joined = sql~execute(joinQuery)
call ok joined
say 'Persisted + Algorithm Relation join:'
do row over joined~rows
  say '  ' row['a.action_code'] '|' row['a.disposition'] '|' row['l.label']
end
call assert joined~rows~items = 2, 'federated persisted/algorithm join rows'
call assert joined~rows[1]['l.label'] = 'Large upsell', 'BIG_UPSELL joined label'
call assert joined~rows[2]['l.label'] = 'Upsell', 'UPSELL joined label'
call assert provider~invocationCount = 1, 'join cannot rerun provider'

/* Algorithm Relation transport is read-only: no setter was mapped. */
updateAttempt = sql~execute("UPDATE ryta_actions SET disposition = 'PERMITTED' WHERE action_code = 'BIG_UPSELL'")
call assert updateAttempt~status \= .Error~SUCCESS, 'SQL UPDATE of Algorithm Relation rejected'
postUpdate = sql~execute(query)
call ok postUpdate
call assert postUpdate~rows~items = 2, 'failed UPDATE cannot mutate frozen rows'
call assert provider~invocationCount = 1, 'failed UPDATE cannot rerun provider'

/* Trace is also a normal relation from the SAME materialization. */
traceCount = sql~execute("SELECT COUNT(*) FROM ryta_trace")
call ok traceCount
call assert provider~invocationCount = 1, 'trace query uses same materialization'

say 'provider invocations:' provider~invocationCount
say 'materialization id:' algorithmResult~materializationId
say 'provider execution id:' algorithmResult~providerExecutionId
say 'NOSQLSERVER V0.58 ALGORITHM RELATION LIVE: OK'
exit 0

ok: procedure
  use arg rs
  if rs~status \= .Error~SUCCESS then do
    say 'FAILED:' rs~status rs~error rs~message
    exit 1
  end
  return .true

assert: procedure
  use arg condition, message
  if condition then return .true
  say 'ASSERT FAILED:' message
  exit 1

::requires '__NOSQLSERVER_CLS__'
::requires '../integration/NoSQLServerAlgorithmRelationAdapter.cls'
::requires '../algorithm/RYTAAlgorithmProvider.cls'
::requires '../HardWorld.cls'
