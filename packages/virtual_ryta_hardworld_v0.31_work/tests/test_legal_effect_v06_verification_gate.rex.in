say 'LEGAL EFFECT V0.6 VERIFICATION EVIDENCE / COMPILER PROMOTION GATE V0.19 START'
provider=.V06TestDigestProvider~new
verifier=.LegalSourceVerifier~new(provider,'ryta-v019-verifier')

/* Merely sealed remains non-authoritative. */
manualSource=.NormativeSource~new('MANUAL','CONTRACT','manual')
manualNorm=.LegalNorm~new('MANUAL-N','MANUAL','1','CONTRACT_TERM','ACT','PROHIBITED')
manualGeneration=.LegalRuleGeneration~new('MANUAL-G','0.6')
ignored=manualGeneration~addSource(manualSource)
ignored=manualGeneration~addNorm(manualNorm)
ignored=manualGeneration~seal
manualContext=.LegalContext~new('M','2026-08-20')
ignored=manualContext~bindSource('MANUAL','test')
manualPinned=.LegalEffectV06PinnedEvaluator~evaluate(.LegalEffectEngine~new,.LegalAction~new('ACT'),manualGeneration,manualContext)
call AssertTrue \manualPinned~ok,'manually sealed generation rejected'
call AssertEqual 'LEGAL_GENERATION_NOT_COMPILED',manualPinned~code,'manual refusal code'

/* Caller assertion does not create verifier evidence. */
sourceText='A verified provision prohibits ACT.'
sourceDigest='sha256:'||provider~digest(sourceText)
fakeIdentity=.LegalSourceIdentity~new('LAW','CONTRACT','expr-1','urn:test:law',sourceDigest,'PARTIES','*','VERIFIED')
call AssertEqual 'UNVERIFIED',fakeIdentity~verificationState,'caller VERIFIED does not become verifier state'
call AssertEqual 'VERIFIED',fakeIdentity~assertedVerificationState,'caller assertion retained only as assertion'
fakeUnit=.LegalCompilationUnit~new('FAKE-G','0.6','ryta-v019-test','1')
ignored=fakeUnit~addSource(fakeIdentity,.NormativeSource~new('LAW','CONTRACT','fake law'))
ref=.LegalProvisionReference~new('LAW','1','expr-1','clause 1',sourceDigest,sourceText,'VERIFIED')
ignored=fakeUnit~addProvision(ref,.LegalProvision~new('LAW','1','ACTIVE','BASE',sourceText))
norm=.LegalNorm~new('LAW-N','LAW','1','CONTRACT_TERM','ACT','PROHIBITED')
proposal=.LegalCompileProposal~new('P-LAW','NORM',norm,'test','HUMAN','1')
ignored=proposal~addEvidenceReference(ref)
ignored=fakeUnit~addProposal(proposal)
fakeReport=.LegalRuleCompiler~new~compile(fakeUnit)
call AssertTrue \fakeReport~ok,'compiler rejects unverified caller assertion'
call AssertTrue HasDiagnostic(fakeReport,'SOURCE_VERIFICATION_EVIDENCE_MISSING'),'missing source evidence diagnostic'
call AssertTrue HasDiagnostic(fakeReport,'PROVISION_VERIFICATION_EVIDENCE_MISSING'),'missing provision evidence diagnostic'

/* Build the same semantic material through actual verifier-issued evidence. */
unit=.LegalCompilationUnit~new('COMPILED-G','0.6','ryta-v019-test','1')
identity=.LegalSourceIdentity~new('LAW','CONTRACT','expr-1','urn:test:law',sourceDigest,'PARTIES','*','VERIFIED')
sourceObject=.NormativeSource~new('LAW','CONTRACT','verified law')
ignored=unit~addSource(identity,sourceObject)
provisionDigest='sha256:'||provider~digest(sourceText)
reference=.LegalProvisionReference~new('LAW','1','expr-1','clause 1',provisionDigest,sourceText,'VERIFIED')
ignored=unit~addProvision(reference,.LegalProvision~new('LAW','1','ACTIVE','BASE',sourceText))
sourceCarrier=.directory~new
sourceCarrier['kind']='TEST_LEGAL_SOURCE'
sourceCarrier['text']=sourceText
sourceMaterial=.LegalVerificationMaterial~fromText(sourceCarrier,sourceText,'urn:test:law','RAW_NORMATIVE_SOURCE')
sourceVerify=unit~verifySource('LAW',sourceMaterial,verifier)
call AssertTrue sourceVerify~ok,'source verification binds'
call AssertTrue sourceVerify~value~verified,'source evidence verified'
call AssertTrue sourceVerify~value~sourceObject == sourceCarrier,'retained source object identity preserved'
provisionCarrier=.directory~new
provisionCarrier['kind']='TEST_PROVISION'
provisionMaterial=.LegalVerificationMaterial~fromText(provisionCarrier,sourceText,'clause 1','PROVISION_LEXICAL_TEXT')
provisionVerify=unit~verifyProvision('LAW','1',provisionMaterial,verifier)
call AssertTrue provisionVerify~ok,'provision verification binds'
call AssertTrue provisionVerify~value~verified,'provision evidence verified'
call AssertTrue provisionVerify~value~parentEvidence == sourceVerify~value,'provision evidence links source evidence'
proposal2=.LegalCompileProposal~new('P-LAW','NORM',.LegalNorm~new('LAW-N','LAW','1','CONTRACT_TERM','ACT','PROHIBITED'),'test','HUMAN','1')
ignored=proposal2~addEvidenceReference(reference)
ignored=unit~addProposal(proposal2)
report=.LegalRuleCompiler~new~compile(unit)
call AssertTrue report~ok,'verifier-backed compilation succeeds'
generation=report~generation
call AssertTrue generation~publicationEligible,'compiled generation publication eligible'
certificate=report~certificate
call AssertTrue certificate \== .nil,'certificate attached'
call AssertEqual 2,certificate~verificationEvidence~items,'certificate snapshots source and provision evidence'

context=.LegalContext~new('E','2026-08-20')
ignored=context~bindSource('LAW','test')
pinned=.LegalEffectV06PinnedEvaluator~evaluate(.LegalEffectEngine~new,.LegalAction~new('ACT'),generation,context)
call AssertTrue pinned~ok,'v0.6 verifier-backed generation pins'
snapshot=pinned~envelope~generationSnapshot
call AssertEqual certificate~inputIdentity,snapshot~compilationInputIdentity,'compiler input identity bound'
call AssertTrue snapshot~certificateHash <> '','certificate hash bound'
call AssertTrue snapshot~verificationClosureHash <> '','verification closure bound'

promotions=.LegalEffectV06PromotionAdapter~promotionsFrom(pinned~envelope)
blocked=FindPromotion(promotions,'LEGAL_ACTION_BLOCKED')
call AssertTrue blocked \== .nil,'blocked promotion exists'
call AssertTrue blocked~promotionStatus='AUTHORIZED','promotion authorized'
call AssertTrue blocked~authority~pos('LEGAL_EFFECT/0.6/')=1,'v0.6 authority namespace'
call AssertTrue HasBasisKind(blocked,'LEGAL_COMPILATION_CERTIFICATE'),'certificate basis retained'
call AssertTrue HasBasisKind(blocked,'LEGAL_SOURCE_VERIFICATION_EVIDENCE'),'source verifier evidence retained'
call AssertTrue HasBasisKind(blocked,'LEGAL_PROVISION_VERIFICATION_EVIDENCE'),'provision verifier evidence retained'
sourceBasis=FindBasisKind(blocked,'LEGAL_SOURCE_VERIFICATION_EVIDENCE')
provBasis=FindBasisKind(blocked,'LEGAL_PROVISION_VERIFICATION_EVIDENCE')
call AssertTrue sourceBasis~nativeObject~sourceObject == sourceCarrier,'source verification snapshot retains native source object'
call AssertTrue provBasis~nativeObject~sourceObject == provisionCarrier,'provision verification snapshot retains native provision object'
call AssertEqual sourceVerify~value~evidenceIdentity,provBasis~nativeObject~parentEvidenceIdentity,'provision snapshot parent linkage retained'

say 'LEGAL EFFECT V0.6 VERIFICATION EVIDENCE / COMPILER PROMOTION GATE V0.19: OK'
exit 0

::class V06TestDigestProvider public
::method algorithm
 return 'SHA256'
::method digest
 use arg material
 return .AlgorithmDigest~sha256Text(material)

::routine HasDiagnostic
 use arg report,code
 do d over report~diagnostics
   if d~code=code then return .true
 end
 return .false
::routine FindPromotion
 use arg setObject,target
 do p over setObject~promotions
   if p~targetFactName=target then return p
 end
 return .nil
::routine HasBasisKind
 use arg promotion,kind
 return FindBasisKind(promotion,kind) \== .nil
::routine FindBasisKind
 use arg promotion,kind
 do item over promotion~basis
   if item~basisKind=kind then return item
 end
 return .nil
::routine AssertTrue
 use arg condition,label
 if \condition then raise syntax 88.900 array('ASSERT TRUE FAILED: '||label)
 return 0
::routine AssertEqual
 use arg expected,actual,label
 if expected \== actual then raise syntax 88.900 array('ASSERT EQUAL FAILED: '||label||' expected='||expected||' actual='||actual)
 return 0

::requires 'LegalEffect.cls'
::requires '__RYTA_ROOT__/algorithm/AlgorithmIntegrity.cls'
::requires '__RYTA_ROOT__/integration/LegalEffectV06PromotionAdapter.cls'
