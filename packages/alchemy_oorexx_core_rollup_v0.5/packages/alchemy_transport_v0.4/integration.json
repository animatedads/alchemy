{
  "schema": "alchemy.autobuild.integration/0.4",
  "package": {
    "name": "alchemy_transport",
    "version": "0.4",
    "kind": "oorexx"
  },
  "dependencies": [
    {
      "name": "alchemy_repository_lease",
      "version": "0.2",
      "export": "ALCHEMY_REPOSITORY_LEASE_ROOT"
    },
    {
      "name": "alchemy_core_component",
      "version": "0.1",
      "export": "ALCHEMY_CORE_COMPONENT_ROOT"
    },
    {
      "name": "alchemy_objects",
      "version": "0.4.3",
      "export": "ALCHEMY_OBJECTS_ROOT"
    },
    {
      "name": "oorexx_crypto",
      "version": "0.1",
      "export": "OOREXX_CRYPTO_ROOT"
    }
  ],
  "tests": [
    {
      "name": "transport-acceptance",
      "argv": [
        "rexx",
        "run_tests.rex"
      ],
      "timeout_seconds": 180,
      "environment": {
        "set": {
          "ALCHEMY_REPOSITORY_LEASE_ROOT": "${REPO_ROOT}/packages/alchemy_repository_lease_v0.2",
          "ALCHEMY_CORE_COMPONENT_ROOT": "${REPO_ROOT}/packages/alchemy_core_component_v0.1",
          "ALCHEMY_OBJECTS_ROOT": "${REPO_ROOT}/packages/alchemy_objects_v0.4.3",
          "OOREXX_CRYPTO_ROOT": "${REPO_ROOT}/packages/oorexx_crypto_v0.1"
        },
        "rexx_path": {
          "mode": "prepend",
          "entries": [
            "${PACKAGE_ROOT}/src",
            "${PACKAGE_ROOT}/tests",
            "${REPO_ROOT}/packages/alchemy_repository_lease_v0.2/src",
            "${REPO_ROOT}/packages/alchemy_core_component_v0.1/src",
            "${REPO_ROOT}/packages/alchemy_objects_v0.4.3/src",
            "${REPO_ROOT}/packages/oorexx_crypto_v0.1/src"
          ],
          "require_entries": true
        },
        "require_dirs": [
          "ALCHEMY_REPOSITORY_LEASE_ROOT",
          "ALCHEMY_CORE_COMPONENT_ROOT",
          "ALCHEMY_OBJECTS_ROOT",
          "OOREXX_CRYPTO_ROOT"
        ]
      }
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/alchemy_transport_v0.4"
    }
  }
}
