# Values only; secrets are referenced through ldap-secrets.map -> environment.
RF_LDAP_HOST=0.0.0.0
RF_LDAP_PORT=636
RF_LDAP_PEER_ID=rasenfalcon-identity-primary
RF_LDAP_NAMING_CONTEXT=dc=rasenfalcon,dc=com
RF_LDAP_STORE_ROOT=/var/lib/rasenfalcon-ldap/directory
RF_LDAP_SECRET_MAP_FILE=/etc/rasenfalcon/ldap-secrets.map
RF_LDAP_CERT_FILE=/etc/rasenfalcon/pki/ldap-chain.pem
RF_LDAP_KEY_FILE=/etc/rasenfalcon/pki/ldap-key.pem
RF_LDAP_BRIDGE_DIR=/opt/rasenfalcon/ldap/bridge
RF_LDAP_READY_FILE=/run/rasenfalcon-ldap/ready
# Optional private-CA client authentication:
# RF_LDAP_CLIENT_CA_FILE=/etc/rasenfalcon/pki/client-ca.pem
# RF_LDAP_REQUIRE_CLIENT_CERT=YES
