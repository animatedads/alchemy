/* NoSQLServer v0.84 - IBM Db2 compatibility personality
 *
 * This module is a SQL/product personality over NoSQLServer.  It does not
 * claim that the underlying engine is IBM Db2.  Product-specific spelling,
 * special registers and the small read-only catalog projection live here so
 * the generic SQL executor stays product-neutral.
 */

::requires "NoSQLServer.cls"

::class NoSQLServerDB2PersonalityInfo public
::attribute product
::attribute personality
::attribute personalityLevel
::attribute compatibilityTarget
::attribute backendVersion
::attribute capabilities

::method init
  use arg backendVersion
  self~product = "NoSQLServer"
  self~personality = "DB2"
  self~personalityLevel = "0.4"
  self~compatibilityTarget = "IBM Db2 SQL compatibility subset"
  self~backendVersion = backendVersion
  self~capabilities = .array~of("DB2_FETCH_FIRST_ROWS_ONLY", "DB2_OFFSET_FETCH", "DB2_SPECIAL_REGISTERS", "DB2_SYSDUMMY1", "DB2_SCHEMA_QUALIFIED_NAMES", "DB2_SYSCAT_TABLES", "DB2_SYSCAT_COLUMNS", "DB2_SYSCAT_INDEXES", "DB2_SYSCAT_INDEXCOLUSE", "DB2_SYSCAT_TABCONST", "DB2_SYSCAT_KEYCOLUSE", "DB2_SYSCAT_REFERENCES", "DB2_NAMED_CONSTRAINTS", "DB2_CREATE_INDEX", "DB2_DROP_INDEX", "DB2_CURRENT_ISOLATION", "DB2_RR_TRANSACTION", "DB2_WITH_RR")

::method supports
  use arg wanted
  do item over self~capabilities
    if item~caselessEquals(wanted) then return .true
  end
  return .false


::class NoSQLServerDB2Personality subclass NoSQLAlchemyObject public
::attribute engine
::attribute currentSchema
::attribute currentUser
::attribute currentServer
::attribute currentIsolation

::method init
  use arg engine, currentUser = "NOSQLSERVER", currentSchema = .nil, currentServer = .nil, alchemySealer = .nil, alchemyAuthority = .nil
  self~init:super("DB2_PERSONALITY", alchemySealer, alchemyAuthority)
  self~registerNoSQLMethod("EXECUTE", "execute SQL through the Db2 compatibility personality", "UNKNOWN")
  self~registerNoSQLMethod("VERSION", "describe the Db2 compatibility personality", "READ")
  self~registerNoSQLMethod("TRANSACTION", "create a Db2-personality transaction boundary", "MUTATE")
  self~engine = engine
  self~currentUser = currentUser~string~translate
  if currentSchema == .nil | currentSchema~string~strip = "" then currentSchema = self~currentUser
  self~currentSchema = currentSchema~string~translate
  if currentServer == .nil | currentServer~string~strip = "" then currentServer = self~catalogDatabaseName
  self~currentServer = currentServer~string~translate
  self~currentIsolation = ""

::method version
  return .NoSQLServerDB2PersonalityInfo~new(self~engine~version)

::method query
  use arg sqlText
  return self~execute(sqlText)

::method execute
  use arg sqlText
  text = self~normalize(sqlText)
  if text = "" then return self~failure(.Error~SQLPARSEERROR, "Empty SQL statement")
  upper = text~translate

  iso = self~trailingIsolation(text)
  if iso["matched"] then return self~failure(.Error~SQLUNSUPPORTED, "DB2 statement isolation " || iso["level"] || " requires a Db2 personality transaction; only RR is implemented")
  if upper~pos("GENERATED ALWAYS AS IDENTITY") > 0 | upper~pos("GENERATED BY DEFAULT AS IDENTITY") > 0 then ,
    return self~failure(.Error~SQLUNSUPPORTED, "DB2 identity generation is not implemented")

  setResult = self~executeSetRegister(text)
  if setResult \== .nil then return setResult

  specialResult = self~executeSpecialRegisterQuery(text)
  if specialResult \== .nil then return specialResult

  indexResult = self~executeIndexDDL(text)
  if indexResult \== .nil then return indexResult

  constraintMetadata = .nil
  if upper~startsWith("CREATE TABLE ") then do
    constraintMetadata = self~extractConstraintMetadata(text)
    text = self~stripNamedConstraintPrefixes(text)
  end
  if upper~startsWith("DROP TABLE ") then ignore = self~removeTableMetadata(text~substr(12)~strip)

  translated = self~translateCurrentSchemaQualification(text)
  translated = self~stripDb2AdvisoryClauses(translated)
  translated = self~translateDb2RowLimit(translated)
  if translated == .nil then return self~failure(.Error~SQLPARSEERROR, "Invalid DB2 row-limiting clause")
  translated = self~translateDb2TypeSpellings(translated)

  overlay = .NoSQLServerDB2CatalogOverlay~new(self~engine, self~currentSchema, self~currentUser, self~readMetadata)
  result = .NoSQLServerSQL~new(overlay, self~noSQLAlchemySealer, self~noSQLAlchemyAuthority)~execute(translated)
  if constraintMetadata \== .nil then if result~status = .Error~SUCCESS then ignore = self~saveConstraintMetadata(constraintMetadata)
  return result

::method transaction
  return .NoSQLServerDB2Transaction~new(self, self~engine~transaction, self~currentIsolation)

::method beginTransaction
  return self~transaction

::method prepareTransactionSQL
  use arg sqlText
  text = self~normalize(sqlText)
  if text = "" then return self~failure(.Error~SQLPARSEERROR, "Empty SQL statement")
  upper = text~translate
  if upper~startsWith("SET ") | upper~startsWith("CREATE INDEX ") | upper~startsWith("CREATE UNIQUE INDEX ") | upper~startsWith("DROP INDEX ") then return self~failure(.Error~SQLUNSUPPORTED, "DB2 session/index DDL is not executed inside the staged transaction boundary")
  if upper~pos("SYSIBM.SYSDUMMY1") > 0 | upper~pos("SYSCAT.") > 0 then return self~failure(.Error~SQLUNSUPPORTED, "DB2 special-register/catalog projections are not staged transaction relations")
  iso = self~trailingIsolation(text)
  if iso["matched"] then do
    if iso["level"] \= "RR" then return self~failure(.Error~SQLUNSUPPORTED, "DB2 statement isolation " || iso["level"] || " is not faithfully implemented")
    text = iso["sql"]
  end
  else if self~currentIsolation \= "" & self~currentIsolation \= "RR" then return self~failure(.Error~SQLUNSUPPORTED, "DB2 CURRENT ISOLATION " || self~currentIsolation || " is not faithfully implemented")
  text = self~translateCurrentSchemaQualification(text)
  text = self~stripDb2AdvisoryClauses(text)
  text = self~translateDb2RowLimit(text)
  if text == .nil then return self~failure(.Error~SQLPARSEERROR, "Invalid DB2 row-limiting clause")
  text = self~translateDb2TypeSpellings(text)
  return text

::method trailingIsolation private
  use arg text
  out = .table~new; out["matched"] = .false; out["level"] = ""; out["sql"] = text
  upper = text~translate~strip
  levels = .array~of("UR", "CS", "RS", "RR")
  do level over levels
    marker = " WITH " || level
    if upper~endsWith(marker) then do
      out["matched"] = .true
      out["level"] = level
      out["sql"] = text~left(text~length - marker~length)~strip
      return out
    end
  end
  return out

::method metadataPath private
  return self~engine~root || "/db2-personality.yaml"

::method readMetadata private
  path = self~metadataPath
  if stream(path, "c", "query exists") = "" then do
    raw = .table~new
    raw["constraints"] = .array~new
    raw["indexes"] = .array~new
    return raw
  end
  raw = .Yaml~new~parseFile(path)
  if raw["constraints"] == .nil then raw["constraints"] = .array~new
  if raw["indexes"] == .nil then raw["indexes"] = .array~new
  return raw

::method writeMetadata private
  use arg raw
  .Yaml~toYamlFile(raw, self~metadataPath)
  return .true

::method executeIndexDDL private
  use arg text
  upper = text~translate
  if upper~startsWith("CREATE UNIQUE INDEX ") then return self~failure(.Error~SQLUNSUPPORTED, "DB2 UNIQUE INDEX is not implemented; uniqueness would not be enforceable by the current derived-index engine")
  if upper~startsWith("CREATE INDEX ") then do
    rest = text~substr(14)~strip
    onPos = rest~translate~pos(" ON ")
    if onPos = 0 then return self~failure(.Error~SQLPARSEERROR, "CREATE INDEX requires ON")
    indexName = self~unquoteIdentifier(rest~left(onPos-1)~strip)
    target = rest~substr(onPos+4)~strip
    p = target~pos("(")
    if p = 0 then return self~failure(.Error~SQLPARSEERROR, "CREATE INDEX requires a column list")
    q = self~matchingParen(target,p)
    if q = 0 then return self~failure(.Error~SQLPARSEERROR, "CREATE INDEX has unmatched '('")
    tableName = self~stripCurrentSchema(target~left(p-1)~strip)
    cols = self~splitList(target~substr(p+1,q-p-1))
    if cols~items \= 1 then return self~failure(.Error~SQLUNSUPPORTED, "DB2 multi-column indexes are not implemented by the current single-column derived-index engine")
    columnName = self~unquoteIdentifier(cols[1]~strip)
    tableObject = self~engine~table(tableName)
    if tableObject == .nil then return self~failure(.Error~NOTFOUND, "Table not found:" tableName)
    canonical = tableObject~definition~canonicalColumn(columnName)
    if canonical == .nil then return self~failure(.Error~SCHEMAERROR, "Unknown index column:" columnName)
    raw = self~readMetadata
    do idx over raw["indexes"]
      if idx["name"]~string~caselessEquals(indexName) then return self~failure(.Error~ALREADYEXISTS, "Index already exists:" indexName)
    end
    snap = self~engine~indexSnapshot(tableName, canonical)
    if snap == .nil then do
      msg = self~engine~startIndexBuild(tableName, canonical)
      if msg == .nil then return self~failure(.Error~STORAGEERROR, "Unable to start index build")
      msg~wait
      if msg~errorCondition \== .nil then return self~failure(.Error~STORAGEERROR, "Index build failed:" msg~errorCondition~string)
    end
    idx = .table~new
    idx["name"] = indexName~translate
    idx["table"] = tableObject~definition~name~translate
    idx["column"] = canonical~translate
    raw["indexes"]~append(idx)
    ignore = self~writeMetadata(raw)
    return self~commandResult("INDEX CREATED=" || indexName~translate)
  end
  if upper~startsWith("DROP INDEX ") then do
    indexName = self~unquoteIdentifier(text~substr(12)~strip)
    indexName = self~stripCurrentSchema(indexName)
    raw = self~readMetadata
    kept = .array~new; found = .nil
    do idx over raw["indexes"]
      if idx["name"]~string~caselessEquals(indexName) then found = idx
      else kept~append(idx)
    end
    if found == .nil then return self~failure(.Error~NOTFOUND, "Index not found:" indexName)
    t = self~engine~table(found["table"])
    if t \== .nil then call SysFileDelete t~path || "/indexes/idx_" || found["column"]~string~translate || ".yaml"
    raw["indexes"] = kept
    ignore = self~writeMetadata(raw)
    return self~commandResult("INDEX DROPPED=" || indexName~translate)
  end
  return .nil

::method stripCurrentSchema private
  use arg name
  value = name~strip
  prefix = self~currentSchema || "."
  if value~translate~startsWith(prefix~translate) then value = value~substr(prefix~length+1)
  return self~unquoteIdentifier(value)

::method extractConstraintMetadata private
  use arg text
  out = .table~new
  rest = text~substr(14)~strip
  p = rest~pos("(")
  if p = 0 then return out
  q = self~matchingParen(rest,p)
  if q = 0 then return out
  tableName = self~stripCurrentSchema(rest~left(p-1)~strip)
  out["table"] = tableName~translate
  entries = .array~new
  do part over self~splitList(rest~substr(p+1,q-p-1))
    item = part~strip
    u = item~translate
    cpos = u~pos("CONSTRAINT ")
    if cpos > 0 then do
      after = item~substr(cpos + 11)~strip
      words = after~space~makeArray(" ")
      if words~items >= 2 then do
        cname = self~unquoteIdentifier(words[1])~translate
        remainder = after~substr(words[1]~length+1)~strip
        ru = remainder~translate
        e = .table~new; e["name"] = cname; e["table"] = tableName~translate
        if ru~startsWith("PRIMARY KEY") then e["type"] = "P"
        else if ru~startsWith("UNIQUE") then e["type"] = "U"
        else if ru~startsWith("FOREIGN KEY") then e["type"] = "F"
        else if ru~startsWith("REFERENCES ") then e["type"] = "F"
        else e = .nil
        if e \== .nil then entries~append(e)
      end
    end
  end
  out["constraints"] = entries
  return out

::method saveConstraintMetadata private
  use arg captured
  tableName = captured["table"]
  if tableName == .nil then return .false
  raw = self~readMetadata
  kept = .array~new
  do e over raw["constraints"]
    if \e["table"]~string~caselessEquals(tableName) then kept~append(e)
  end
  entries = captured["constraints"]
  if entries \== .nil then do e over entries; kept~append(e); end
  raw["constraints"] = kept
  return self~writeMetadata(raw)

::method removeTableMetadata private
  use arg tableName
  tableName = self~stripCurrentSchema(tableName)~translate
  raw = self~readMetadata
  constraints = .array~new
  do e over raw["constraints"]; if \e["table"]~string~caselessEquals(tableName) then constraints~append(e); end
  indexes = .array~new
  do e over raw["indexes"]; if \e["table"]~string~caselessEquals(tableName) then indexes~append(e); end
  raw["constraints"] = constraints; raw["indexes"] = indexes
  return self~writeMetadata(raw)

::method stripNamedConstraintPrefixes private
  use arg text
  rest = text~substr(14)~strip
  p = rest~pos("(")
  if p = 0 then return text
  q = self~matchingParen(rest,p)
  if q = 0 then return text
  head = rest~left(p)
  body = rest~substr(p+1,q-p-1)
  tail = rest~substr(q)
  parts = .array~new
  do part over self~splitList(body)
    item = part~strip
    if item~translate~startsWith("CONSTRAINT ") then do
      after = item~substr(12)~strip
      blank = after~pos(" ")
      if blank > 0 then item = after~substr(blank+1)~strip
    end
    parts~append(item)
  end
  rebuilt = ""
  do i=1 to parts~items
    if i>1 then rebuilt ||= ", "
    rebuilt ||= parts[i]
  end
  return "CREATE TABLE " || head || rebuilt || tail

::method splitList private
  use arg text
  out=.array~new; start=1; depth=0; quote=""; i=1
  do while i<=text~length
    ch=text~substr(i,1)
    if quote \= "" then do
      if ch=quote then do
        if i<text~length & text~substr(i+1,1)=quote then i+=1
        else quote=""
      end
    end
    else do
      if ch="'" | ch='"' then quote=ch
      else if ch="(" then depth+=1
      else if ch=")" then depth-=1
      else if ch="," & depth=0 then do
        out~append(text~substr(start,i-start)~strip); start=i+1
      end
    end
    i+=1
  end
  out~append(text~substr(start)~strip)
  return out

::method matchingParen private
  use arg text, openPos
  depth=0; quote=""; i=openPos
  do while i<=text~length
    ch=text~substr(i,1)
    if quote \= "" then do
      if ch=quote then do
        if i<text~length & text~substr(i+1,1)=quote then i+=1
        else quote=""
      end
    end
    else do
      if ch="'" | ch='"' then quote=ch
      else if ch="(" then depth+=1
      else if ch=")" then do; depth-=1; if depth=0 then return i; end
    end
    i+=1
  end
  return 0

::method normalize private
  use arg sqlText
  text = sqlText~string~strip
  if text~right(1) = ";" then text = text~left(text~length - 1)~strip
  return text~space

::method catalogDatabaseName private
  if self~engine~hasMethod("READCATALOG") then do
    raw = self~engine~readCatalog
    if raw \== .nil then do
      name = raw["name"]
      if name \== .nil & name~string~strip \= "" then return name~string
    end
  end
  return "NOSQLSERVER"

::method executeSetRegister private
  use arg text
  upper = text~translate
  prefix = "SET CURRENT SCHEMA "
  if upper~startsWith(prefix) then do
    value = text~substr(prefix~length + 1)~strip
    if value~left(1) = "=" then value = value~substr(2)~strip
    value = self~unquoteIdentifier(value)
    if value = "" then return self~failure(.Error~SQLPARSEERROR, "SET CURRENT SCHEMA requires a schema name")
    self~currentSchema = value~translate
    return self~commandResult("CURRENT SCHEMA=" || self~currentSchema)
  end
  prefix = "SET SCHEMA "
  if upper~startsWith(prefix) then do
    value = self~unquoteIdentifier(text~substr(prefix~length + 1)~strip)
    if value = "" then return self~failure(.Error~SQLPARSEERROR, "SET SCHEMA requires a schema name")
    self~currentSchema = value~translate
    return self~commandResult("CURRENT SCHEMA=" || self~currentSchema)
  end

  prefix = "SET CURRENT ISOLATION"
  if upper~startsWith(prefix) then do
    value = text~substr(prefix~length + 1)~strip
    if value~left(1) = "=" then value = value~substr(2)~strip
    else if value~translate~startsWith("TO ") then value = value~substr(4)~strip
    value = self~unquoteIdentifier(value)~space~translate
    if value = "RESET" then do
      self~currentIsolation = ""
      return self~commandResult("CURRENT ISOLATION=RESET")
    end
    if value = "SERIALIZABLE" | value = "REPEATABLE READ" then value = "RR"
    if value = "READ COMMITTED" then value = "CS"
    if value = "CURSOR STABILITY" then value = "CS"
    if value = "READ UNCOMMITTED" | value = "DIRTY READ" then value = "UR"
    if value = "RR" then do
      self~currentIsolation = "RR"
      return self~commandResult("CURRENT ISOLATION=RR")
    end
    if value = "UR" | value = "CS" | value = "RS" then return self~failure(.Error~SQLUNSUPPORTED, "DB2 isolation " || value || " is not faithfully implementable by the current serializable snapshot transaction engine")
    return self~failure(.Error~SQLPARSEERROR, "Unsupported SET CURRENT ISOLATION value: " || value)
  end
  return .nil

::method executeSpecialRegisterQuery private
  use arg text
  upper = text~translate
  if upper~startsWith("VALUES ") then do
    expression = text~substr(8)~strip
    value = self~specialRegisterValue(expression)
    if value["matched"] then return self~singleValueResult(expression~translate, value["value"])
  end

  dummy = " FROM SYSIBM.SYSDUMMY1"
  pos = upper~pos(dummy)
  if upper~startsWith("SELECT ") & pos > 0 then do
    tail = upper~substr(pos + dummy~length)~strip
    if tail \= "" then return .nil
    projection = text~substr(8, pos - 8)~strip
    alias = ""
    asPos = projection~translate~pos(" AS ")
    if asPos > 0 then do
      expression = projection~left(asPos - 1)~strip
      alias = self~unquoteIdentifier(projection~substr(asPos + 4)~strip)
    end
    else expression = projection
    value = self~specialRegisterValue(expression)
    if value["matched"] then do
      if alias = "" then alias = expression~translate
      return self~singleValueResult(alias, value["value"])
    end
    if expression~translate = "IBMREQD" then return self~singleValueResult("IBMREQD", "Y")
  end
  return .nil

::method specialRegisterValue private
  use arg expression
  out = .table~new
  out["matched"] = .true
  key = expression~strip~translate
  select
    when key = "CURRENT SERVER" then out["value"] = self~currentServer
    when key = "CURRENT ISOLATION" then out["value"] = self~currentIsolation
    when key = "CURRENT SCHEMA" then out["value"] = self~currentSchema
    when key = "CURRENT USER" | key = "SESSION_USER" | key = "SYSTEM_USER" | key = "USER" then out["value"] = self~currentUser
    when key = "CURRENT DATE" then out["value"] = self~currentDate
    when key = "CURRENT TIME" then out["value"] = time("N")
    when key = "CURRENT TIMESTAMP" then out["value"] = self~currentTimestamp
    otherwise do
      out["matched"] = .false
      out["value"] = .nil
    end
  end
  return out

::method currentDate private
  d = date("S")
  return d~left(4) || "-" || d~substr(5,2) || "-" || d~right(2)

::method currentTimestamp private
  return self~currentDate || "-" || time("L")


::method translateCurrentSchemaQualification private
  use arg text
  prefix = self~currentSchema || "."
  upperPrefix = prefix~translate
  out = ""
  quote = ""
  i = 1
  do while i <= text~length
    ch = text~substr(i,1)
    if quote = "" then do
      if ch = "'" | ch = '"' then do
        quote = ch
        out ||= ch
        i += 1
        iterate
      end
      if text~substr(i, prefix~length)~translate = upperPrefix then do
        i += prefix~length
        iterate
      end
    end
    else if ch = quote then do
      if i < text~length & text~substr(i+1,1) = quote then do
        out ||= ch || ch
        i += 2
        iterate
      end
      quote = ""
    end
    out ||= ch
    i += 1
  end
  return out

::method stripDb2AdvisoryClauses private
  use arg text
  upper = text~translate
  marker = " OPTIMIZE FOR "
  p = upper~pos(marker)
  if p > 0 then do
    tail = text~substr(p + marker~length)~strip~space
    words = tail~makeArray(" ")
    if words~items >= 2 then do
      if datatype(words[1], "W") & (words[2]~translate = "ROW" | words[2]~translate = "ROWS") then text = text~left(p - 1)~strip
    end
  end
  upper = text~translate
  if upper~endsWith(" FOR READ ONLY") then text = text~left(text~length - 14)~strip
  return text

::method translateDb2RowLimit private
  use arg text
  upper = text~translate
  fetchFirst = upper~pos(" FETCH FIRST ")
  fetchNext = upper~pos(" FETCH NEXT ")
  fetchPos = fetchFirst
  if fetchPos = 0 then fetchPos = fetchNext
  if fetchPos = 0 then return text

  base = text~left(fetchPos - 1)~strip
  clause = text~substr(fetchPos + 7)~strip~space
  words = clause~makeArray(" ")
  if words~items < 4 then return .nil
  if words[1]~translate \= "FIRST" & words[1]~translate \= "NEXT" then return .nil
  if \datatype(words[2], "W") | words[2] < 0 then return .nil
  if words[3]~translate \= "ROW" & words[3]~translate \= "ROWS" then return .nil
  if words[4]~translate \= "ONLY" then return .nil
  if words~items > 4 then return .nil
  limit = words[2]

  upperBase = base~translate
  offsetPos = upperBase~lastPos(" OFFSET ")
  offset = 0
  if offsetPos > 0 then do
    offsetClause = base~substr(offsetPos + 8)~strip~space
    offsetWords = offsetClause~makeArray(" ")
    if offsetWords~items < 1 | offsetWords~items > 2 then return .nil
    if \datatype(offsetWords[1], "W") | offsetWords[1] < 0 then return .nil
    if offsetWords~items = 2 then if offsetWords[2]~translate \= "ROW" & offsetWords[2]~translate \= "ROWS" then return .nil
    offset = offsetWords[1]
    base = base~left(offsetPos - 1)~strip
  end
  return base || " LIMIT " || limit || " OFFSET " || offset

::method translateDb2TypeSpellings private
  use arg text
  upper = text~translate
  if \upper~startsWith("CREATE TABLE ") then return text
  -- Keep translation intentionally conservative.  These aliases preserve the
  -- representable value domain; DB2 range/precision limits are not claimed.
  text = self~replaceToken(text, " SMALLINT", " INTEGER")
  text = self~replaceToken(text, " BIGINT", " INTEGER")
  text = self~replaceToken(text, " INT", " INTEGER")
  text = self~replaceToken(text, " NUMERIC", " DECIMAL")
  text = self~replaceToken(text, " DEC ", " DECIMAL ")
  text = self~replaceToken(text, " TIMESTAMP", " DATETIME")
  text = self~replaceToken(text, " CLOB", " TEXT")
  return text

::method replaceToken private
  use arg text, wanted, replacement
  -- DDL only: do a caseless scan while preserving surrounding source text.
  upper = text~translate
  needle = wanted~translate
  start = 1
  do forever
    p = upper~pos(needle, start)
    if p = 0 then leave
    after = p + wanted~length
    if after <= text~length then do
      next = text~substr(after, 1)
      if next~verify("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_$", "M") = 1 then do
        start = p + wanted~length
        iterate
      end
    end
    text = text~left(p - 1) || replacement || text~substr(p + wanted~length)
    upper = text~translate
    start = p + replacement~length
  end
  return text

::method unquoteIdentifier private
  use arg value
  value = value~strip
  if value~length >= 2 then do
    if value~left(1) = '"' & value~right(1) = '"' then return value~substr(2, value~length - 2)
    if value~left(1) = "'" & value~right(1) = "'" then return value~substr(2, value~length - 2)
  end
  return value

::method singleValueResult private
  use arg name, value
  rs = .DatabaseResult~new(.DatabaseOperationType~SELECT)
  values = .table~new
  values[name] = value
  rs~rows~append(.DatabaseRow~new(values))
  rs~affectedRows = 1
  rs~rowsScanned = 1
  rs~accessPath = "DB2_SPECIAL_REGISTER"
  return rs

::method commandResult private
  use arg message
  rs = .DatabaseResult~new(.DatabaseOperationType~OPERATION)
  rs~message = message
  rs~accessPath = "DB2_PERSONALITY"
  return rs

::method failure private
  use arg errorCode, message
  return .DatabaseResult~new(.DatabaseOperationType~EXECUTE)~fail(errorCode, message)


::class NoSQLServerDB2Transaction public
::attribute personality
::attribute nativeTransaction
::attribute isolationLevel

::method init
  use arg personality, nativeTransaction, isolationLevel = ""
  self~personality = personality
  self~nativeTransaction = nativeTransaction
  self~isolationLevel = isolationLevel

::method execute
  use arg sqlText
  prepared = self~personality~prepareTransactionSQL(sqlText)
  if prepared~isA(.DatabaseResult) then return prepared
  return self~nativeTransaction~execute(prepared)

::method query
  use arg sqlText
  prepared = self~personality~prepareTransactionSQL(sqlText)
  if prepared~isA(.DatabaseResult) then return prepared
  return self~nativeTransaction~query(prepared)

::method commit
  return self~nativeTransaction~commit
::method rollback
  return self~nativeTransaction~rollback
::method savepoint
  use arg name
  return self~nativeTransaction~savepoint(name)
::method rollbackTo
  use arg savepoint
  return self~nativeTransaction~rollbackTo(savepoint)
::method state
  return self~nativeTransaction~state
::method token
  return self~nativeTransaction~token
::method lastMutationResults
  return self~nativeTransaction~lastMutationResults

::class NoSQLServerDB2CatalogOverlay public
::attribute baseEngine
::attribute catalogTables
::attribute db2Metadata

::method init
  use arg baseEngine, currentSchema, currentUser, db2Metadata = .nil
  self~baseEngine = baseEngine
  if db2Metadata == .nil then do; db2Metadata=.table~new; db2Metadata["constraints"]=.array~new; db2Metadata["indexes"]=.array~new; end
  self~db2Metadata = db2Metadata
  self~catalogTables = .table~new
  self~buildCatalog(currentSchema, currentUser)

::method buildCatalog private
  use arg currentSchema, currentUser
  tableRows = .array~new
  columnRows = .array~new
  indexRows = .array~new
  indexColumnRows = .array~new
  constraintRows = .array~new
  keyColumnRows = .array~new
  referenceRows = .array~new
  raw = .nil
  if self~baseEngine~hasMethod("READCATALOG") then raw = self~baseEngine~readCatalog
  names = .array~new
  if raw \== .nil then do
    candidate = raw["tables"]
    if candidate \== .nil then names = candidate
  end
  do tableName over names
    tableObject = self~baseEngine~table(tableName)
    if tableObject == .nil then iterate
    values = .table~new
    values["TABSCHEMA"] = currentSchema
    values["TABNAME"] = tableObject~definition~name~translate
    values["TYPE"] = "T"
    values["OWNER"] = currentUser
    values["OWNERTYPE"] = "U"
    values["CARD"] = tableObject~rowCount
    values["NPAGES"] = .nil
    values["TBSPACE"] = .nil
    tableRows~append(.DatabaseRow~new(values))

    colno = 0
    do col over tableObject~definition~columns
      cv = .table~new
      cv["TABSCHEMA"] = currentSchema
      cv["TABNAME"] = tableObject~definition~name~translate
      cv["COLNAME"] = col~name~translate
      cv["COLNO"] = colno
      cv["TYPENAME"] = self~db2TypeName(col~type)
      cv["LENGTH"] = self~db2TypeLength(col~type)
      cv["SCALE"] = 0
      if col~nullable then cv["NULLS"] = "Y"; else cv["NULLS"] = "N"
      cv["DEFAULT"] = .nil
      cv["IDENTITY"] = "N"
      cv["GENERATED"] = ""
      if col~primaryKey then cv["KEYSEQ"] = 1; else cv["KEYSEQ"] = .nil
      columnRows~append(.DatabaseRow~new(cv))
      colno += 1
    end

    if tableObject~definition~primaryKey~items > 0 then do
      constName = self~constraintName(tableObject~definition~name, "P", 1, "PK_" || tableObject~definition~name~translate)
      ignore = self~appendConstraintRows(constraintRows, keyColumnRows, indexRows, indexColumnRows, currentSchema, tableObject, constName, "P", tableObject~definition~primaryKey, "P")
    end
    uqNo = 0
    do uniqueColumns over tableObject~definition~uniqueConstraints
      uqNo += 1
      constName = self~constraintName(tableObject~definition~name, "U", uqNo, "UQ_" || tableObject~definition~name~translate || "_" || uqNo)
      ignore = self~appendConstraintRows(constraintRows, keyColumnRows, indexRows, indexColumnRows, currentSchema, tableObject, constName, "U", uniqueColumns, "U")
    end
    fkNo = 0
    do fk over tableObject~definition~foreignKeys
      fkNo += 1
      constName = self~constraintName(tableObject~definition~name, "F", fkNo, "FK_" || tableObject~definition~name~translate || "_" || fkNo)
      cv = .table~new
      cv["CONSTNAME"] = constName
      cv["TABSCHEMA"] = currentSchema
      cv["TABNAME"] = tableObject~definition~name~translate
      cv["TYPE"] = "F"
      cv["ENFORCED"] = "Y"
      constraintRows~append(.DatabaseRow~new(cv))
      kv = .table~new
      kv["CONSTNAME"] = constName
      kv["TABSCHEMA"] = currentSchema
      kv["TABNAME"] = tableObject~definition~name~translate
      kv["COLNAME"] = fk~column~translate
      kv["COLSEQ"] = 1
      keyColumnRows~append(.DatabaseRow~new(kv))
      rv = .table~new
      rv["CONSTNAME"] = constName
      rv["TABSCHEMA"] = currentSchema
      rv["TABNAME"] = tableObject~definition~name~translate
      rv["REFTABSCHEMA"] = currentSchema
      rv["REFTABNAME"] = fk~referencesTable~translate
      rv["DELETERULE"] = fk~onDelete
      rv["UPDATERULE"] = fk~onUpdate
      referenceRows~append(.DatabaseRow~new(rv))
    end

    if self~baseEngine~hasMethod("INDEXSNAPSHOT") then do col over tableObject~definition~columns
      snap = self~baseEngine~indexSnapshot(tableObject~definition~name, col~name)
      if snap \== .nil then do
        indName = self~indexName(tableObject~definition~name, col~name, "IDX_" || tableObject~definition~name~translate || "_" || col~name~translate)
        ignore = self~appendIndexRows(indexRows, indexColumnRows, currentSchema, tableObject~definition~name, indName, "D", .array~of(col~name))
      end
    end
  end
  self~catalogTables["SYSCAT.TABLES"] = .SQLMaterializedTable~new("SYSCAT.TABLES", .array~of("TABSCHEMA","TABNAME","TYPE","OWNER","OWNERTYPE","CARD","NPAGES","TBSPACE"), tableRows)
  self~catalogTables["SYSCAT.COLUMNS"] = .SQLMaterializedTable~new("SYSCAT.COLUMNS", .array~of("TABSCHEMA","TABNAME","COLNAME","COLNO","TYPENAME","LENGTH","SCALE","NULLS","DEFAULT","IDENTITY","GENERATED","KEYSEQ"), columnRows)
  self~catalogTables["SYSCAT.INDEXES"] = .SQLMaterializedTable~new("SYSCAT.INDEXES", .array~of("INDSCHEMA","INDNAME","OWNER","OWNERTYPE","TABSCHEMA","TABNAME","UNIQUERULE","COLCOUNT","INDEXTYPE"), indexRows)
  self~catalogTables["SYSCAT.INDEXCOLUSE"] = .SQLMaterializedTable~new("SYSCAT.INDEXCOLUSE", .array~of("INDSCHEMA","INDNAME","COLNAME","COLSEQ","COLORDER"), indexColumnRows)
  self~catalogTables["SYSCAT.TABCONST"] = .SQLMaterializedTable~new("SYSCAT.TABCONST", .array~of("CONSTNAME","TABSCHEMA","TABNAME","TYPE","ENFORCED"), constraintRows)
  self~catalogTables["SYSCAT.KEYCOLUSE"] = .SQLMaterializedTable~new("SYSCAT.KEYCOLUSE", .array~of("CONSTNAME","TABSCHEMA","TABNAME","COLNAME","COLSEQ"), keyColumnRows)
  self~catalogTables["SYSCAT.REFERENCES"] = .SQLMaterializedTable~new("SYSCAT.REFERENCES", .array~of("CONSTNAME","TABSCHEMA","TABNAME","REFTABSCHEMA","REFTABNAME","DELETERULE","UPDATERULE"), referenceRows)
  dummyRows = .array~new
  dv = .table~new; dv["IBMREQD"] = "Y"; dummyRows~append(.DatabaseRow~new(dv))
  self~catalogTables["SYSIBM.SYSDUMMY1"] = .SQLMaterializedTable~new("SYSIBM.SYSDUMMY1", .array~of("IBMREQD"), dummyRows)


::method constraintName private
  use arg tableName, constType, ordinal, fallback
  seen=0
  do e over self~db2Metadata["constraints"]
    if e["table"]~string~caselessEquals(tableName) & e["type"]~string=constType then do
      seen+=1
      if seen=ordinal then return e["name"]~string~translate
    end
  end
  return fallback

::method indexName private
  use arg tableName, columnName, fallback
  do e over self~db2Metadata["indexes"]
    if e["table"]~string~caselessEquals(tableName) & e["column"]~string~caselessEquals(columnName) then return e["name"]~string~translate
  end
  return fallback

::method appendConstraintRows private
  use arg constraintRows, keyColumnRows, indexRows, indexColumnRows, schemaName, tableObject, constName, constType, columns, uniqueRule
  cv = .table~new
  cv["CONSTNAME"] = constName
  cv["TABSCHEMA"] = schemaName
  cv["TABNAME"] = tableObject~definition~name~translate
  cv["TYPE"] = constType
  cv["ENFORCED"] = "Y"
  constraintRows~append(.DatabaseRow~new(cv))
  seq = 0
  do colName over columns
    seq += 1
    kv = .table~new
    kv["CONSTNAME"] = constName
    kv["TABSCHEMA"] = schemaName
    kv["TABNAME"] = tableObject~definition~name~translate
    kv["COLNAME"] = colName~translate
    kv["COLSEQ"] = seq
    keyColumnRows~append(.DatabaseRow~new(kv))
  end
  ignore = self~appendIndexRows(indexRows, indexColumnRows, schemaName, tableObject~definition~name, constName, uniqueRule, columns)
  return .true

::method appendIndexRows private
  use arg indexRows, indexColumnRows, schemaName, tableName, indName, uniqueRule, columns
  iv = .table~new
  iv["INDSCHEMA"] = schemaName
  iv["INDNAME"] = indName
  iv["OWNER"] = schemaName
  iv["OWNERTYPE"] = "U"
  iv["TABSCHEMA"] = schemaName
  iv["TABNAME"] = tableName~translate
  iv["UNIQUERULE"] = uniqueRule
  iv["COLCOUNT"] = columns~items
  iv["INDEXTYPE"] = "REG"
  indexRows~append(.DatabaseRow~new(iv))
  seq = 0
  do colName over columns
    seq += 1
    kv = .table~new
    kv["INDSCHEMA"] = schemaName
    kv["INDNAME"] = indName
    kv["COLNAME"] = colName~translate
    kv["COLSEQ"] = seq
    kv["COLORDER"] = "A"
    indexColumnRows~append(.DatabaseRow~new(kv))
  end
  return .true

::method db2TypeName private
  use arg sourceType
  t = sourceType~translate
  select
    when t = "DATETIME" then return "TIMESTAMP"
    when t = "TEXT" then return "CLOB"
    otherwise return t
  end

::method db2TypeLength private
  use arg sourceType
  t = sourceType~translate
  select
    when t = "INTEGER" then return 4
    when t = "BOOLEAN" then return 1
    when t = "DATE" then return 4
    when t = "DATETIME" then return 10
    when t = "DECIMAL" then return 16
    otherwise return 0
  end

::method table
  use arg name
  t = self~catalogTables[name~string~translate]
  if t \== .nil then return t
  return self~baseEngine~table(name)

::method tableRowCount
  use arg name
  t = self~table(name)
  if t == .nil then return .nil
  return t~rowCount

::method selectAll
  use arg name
  return self~selectWhere(name, .nil)

::method selectWhere
  use arg name, predicate
  t = self~catalogTables[name~string~translate]
  if t == .nil then return self~baseEngine~selectWhere(name, predicate)
  rs = .DatabaseResult~new(.DatabaseOperationType~SELECT)
  allRows = t~readRows
  found = .array~new
  do row over allRows
    if predicate == .nil then found~append(row)
    else if predicate~evaluate(row, t~definition) then found~append(row)
  end
  rs~rows = found
  rs~affectedRows = found~items
  rs~rowsScanned = allRows~items
  rs~accessPath = "DB2_CATALOG_SCAN"
  return rs

::method queryPatternLog
  return self~baseEngine~queryPatternLog
::method currentIndexCandidateCount
  use arg tableName, column, wanted
  if self~catalogTables[tableName~string~translate] \== .nil then return .nil
  return self~baseEngine~currentIndexCandidateCount(tableName, column, wanted)
::method joinMapSnapshot
  return self~baseEngine~joinMapSnapshot
::method tableMetadata
  use arg name
  t = self~catalogTables[name~string~translate]
  if t \== .nil then return t~definition
  return self~baseEngine~tableMetadata(name)
::method version
  return self~baseEngine~version
