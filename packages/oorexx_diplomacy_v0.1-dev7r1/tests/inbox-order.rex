/* P1 seat-order fairness acceptance, using Claude's unchanged measuring
   player. New journal format: seed/recipient list ordering, old replay
   formats still qualified by game.rex and press.rex. */
parse arg work
if work == '' then exit 2
failures = 0
checks = 0
board = .DiplomacyBoard~new('data/standard.source')
judge = .DiplomacyAdjudicator~new(board,'data/rules.conf')
initial = diplomacyInitialUnits(board,'data/initial-1901.source')
owned = judge~initialOwnership
config = .DiplomacyGameConfig~load('data/game.conf')
call check config~inboxOrder == 'SEEDED','new games default seeded'
path = work'/QUIET-25.log'
source = .DiplomacyMegaphoneSource~new('')
game = .DiplomacyGame~new(board,judge,config,initial,owned,source,.DiplomacyGameJournal~new(path),7)
call check game~run == 'FINISHED','quiet 25-year game completes'
call check game~pressCallCount = 1050 & game~callCount = 350,'all 1400 calls'
stats = source~stats
say 'Seeded inbox rank: call power mean first% last%'
do kind over .array~of('PRESS','ORDER')
  do power over .array~of('AUS','ENG','FRA','GER','ITA','RUS','TUR')
    key = kind'|'power'|'
    n = stats[key'RANKN']
    mean = stats[key'RANKSUM']/n
    first = stats[key'FIRST']/n
    last = stats[key'LAST']/n
    say kind power format(mean,,3) format(100*first,,2) format(100*last,,2)
    call check n = 300 | n = 600,'expected measured inbox count' kind power
    call check abs(mean-3.5) < 0.35,'mean near 3.5' kind power
    call check first > 0.08 & first < 0.25,'first rank not seat-fixed' kind power
    call check last > 0.08 & last < 0.25,'last rank not seat-fixed' kind power
  end
end
replay = .DiplomacyReplaySource~new(path)
call check replay~config~inboxOrder == 'SEEDED','journal v3 selects seeded policy'
newPath = work'/QUIET-25-replay.log'
game = .DiplomacyGame~new(board,judge,replay~config,initial,owned,replay,.DiplomacyGameJournal~new(newPath),replay~seed)
call check game~run == 'FINISHED','quiet replay completes'
call check diplomacySameJournal(path,newPath),'all inbox order events regenerated byte-identically'
input = .stream~new(path)
call check input~open('READ') == 'READY:','journal can be inspected'
call check input~linein == 'DIPLOG|3','journal v3 header'
seen = 0
do while input~lines > 0
  line = input~linein
  if line~left(12) == 'INBOX_ORDER|' then do
    parse var line . '|' year '|' phase '|' round '|' recipient '|' ids
    seen += 1
    call check ids~words = 6,'all messages logged exactly once for' recipient
  end
end
input~close
call check seen = 1050,'one inbox-order record per recipient per round'
-- Directed multi-message fixture with unequal volumes.
brokerJournal = .DiplomacyGameJournal~new(work'/INBOX-ORDER-DIRECTED.log')
broker = .DiplomacyPress~new(7,brokerJournal,'SEEDED')
lists = .directory~new
lists['AUS'] = .array~of('FRA','AUS','ENG')
lists['ENG'] = .array~of('ENG','AUS','FRA')
lists['FRA'] = .array~of('ENG','FRA','AUS')
responses = .directory~new
lf = '0A'x
responses['AUS'] = .array~of('OK','SEND TO: 1 3'||lf||'MESSAGE:'||lf||'aus-first'||lf||'END MESSAGE'||lf||'SEND TO: 1 3'||lf||'MESSAGE:'||lf||'aus-second'||lf||'END MESSAGE')
responses['ENG'] = .array~of('OK','SEND TO: 3'||lf||'MESSAGE:'||lf||'eng-first'||lf||'END MESSAGE')
responses['FRA'] = .array~of('OK','SEND TO: 1 3'||lf||'MESSAGE:'||lf||'fra-first'||lf||'END MESSAGE')
broker~finishRound(1901,'SPRING_MOVEMENT',1,responses,lists)
call check broker~inbox('FRA')~items = 3,'FRA receives all three messages'
call check broker~inbox('FRA')[1]~pos('eng-first') > 0,'recipient FRA sees ENG first'
call check broker~inbox('FRA')[2]~pos('aus-first') > 0,'first AUS message preserved'
call check broker~inbox('FRA')[3]~pos('aus-second') > 0,'second AUS message preserved'
call check broker~inbox('ENG')[1]~pos('aus-first') > 0,'different recipient ENG sees AUS first'
call check broker~inbox('ENG')[2]~pos('aus-second') > 0,'AUS order preserved for ENG'
call check broker~inbox('ENG')[3]~pos('fra-first') > 0,'FRA follows AUS for ENG'
call check broker~inbox('AUS')~items = 1,'no extra messages leak to AUS'
brokerJournal~close
say 'Inbox-order gate:' checks 'assertions;' failures 'failures'
exit (failures > 0)
check:
  use strict arg ok, label
  checks += 1
  if \ok then do
    failures += 1
    say 'FAIL:' label
  end
  return
::requires 'DiplomacyGame.cls'
::requires 'DiplomacyReplaySource.cls'
::requires 'DiplomacyMegaphoneSource.cls'
