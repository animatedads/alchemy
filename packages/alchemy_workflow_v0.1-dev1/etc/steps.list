# steps.list - the steps registered into the workflow, in this order inside each stage.
# Each line: file (relative to the package) | class
# Adding a step is a new file in src/steps and one line here; nothing else changes.
# Architecture: Tom Dyer. Written by: Claude (Opus 5.5), 2026-11-11.
src/steps/ManifestStep.cls    | ManifestStep
src/steps/HouseRulesStep.cls  | HouseRulesStep
src/steps/ModuleStampStep.cls | ModuleStampStep
src/steps/KitRunStep.cls      | KitRunStep
