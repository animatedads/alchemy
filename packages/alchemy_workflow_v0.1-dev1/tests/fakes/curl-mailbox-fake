#!/bin/sh
# curl stand-in for the workflow's mailbox tests (after oorexx_browser_ui_kit_v0.4's curl-mailbox-fake).
# Refuses a token on the command line; checks the bearer header arrives on stdin; answers by tool name;
# appends "TOOL<tab>body" to $MAILBOX_FAKE_LOG. MAILBOX_FAKE_CREATE names another answer for create.
# Architecture: Tom Dyer. Coding: Claude (Opus 5.5), 2026-11-19.
D=$(dirname "$0")/mailbox; O=; BODY=
for a in "$@"; do case "$a" in *Bearer*) echo "fake curl: token on the command line" >&2; exit 98 ;; esac; done
while [ $# -gt 0 ]; do
  case "$1" in
    -o) O=$2; shift ;;
    --data-binary) BODY=${2#@}; shift ;;
    -H|-w|-X|--max-time) shift ;;
    -*) ;;
    *) ;;
  esac
  shift
done
HDR=$(cat)
case "$HDR" in "Authorization: Bearer faketoken") ;; *) cp "$D/denied.json" "$O"; printf 200; exit 0 ;; esac
B=$(cat "$BODY")
case "$B" in
  *project.request.create*) T=create ;;
  *project.request.reply*) T=reply ;;
  *) echo "fake curl: unknown tool" >&2; exit 6 ;;
esac
[ -n "$MAILBOX_FAKE_LOG" ] && printf '%s\t%s\n' "$T" "$B" >> "$MAILBOX_FAKE_LOG"
[ "$T" = create ] && [ -n "$MAILBOX_FAKE_CREATE" ] && T=$MAILBOX_FAKE_CREATE
cp "$D/$T.json" "$O"; printf 200
