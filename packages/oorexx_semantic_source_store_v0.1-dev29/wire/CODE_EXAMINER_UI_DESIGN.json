  "reviewInvariant": "Source, design, findings, test evidence and disposition controls must all display and act on the same exact semantic object and revision identity.",
  "browserProhibitions": [
    "No direct database writes",
    "No source revision promotion",
    "No local inference of test result",
    "No local inference of work acceptance",
    "No browser-selected dependency revision unless explicitly submitted as a pin",
    "No hard-coded module or source-file inventory in HTML/JavaScript",
    "No manually edited browser transport configuration; bootstrap values come from the application service descriptor"
  ],
  "catalogInvariant": "Module, source-unit, deployment and branch navigation is populated from server-authoritative catalog data; adding source to the store requires no browser edit.",
  "contextInvariant": "Opening a semantic object returns design, findings, exact revision identity, revision history, scoped requirements, notes, resources, module/deployment state, branch state, semantic references, runtime surfaces, test evidence, work entries, exports and dependencies from server authority; missing sections fail closed.",
