#!/usr/bin/env bash
# Discover ALL registered providers, safely merge only supplied price observations.
# Absence of a feed is visible, not replaced with a fictional quotation.
set -euo pipefail
BASE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE=${CLOUD_ECONOMICS_STATE:-$BASE/state}
SOURCES=${CLOUD_ECONOMICS_SOURCES:-$STATE/sources}
mkdir -p "$STATE" "$SOURCES"
HEADER=$'id\tprovider\tregion\tsite\tsku\tpurchase\tmem\tcpu\tgpu\trate\tstartup\tnetwork\tfabric\trisk\tapproved\tcapacity\tfabric_ok\tts\texpiry\tcurrency\tsource\tjurisdiction\truntime'
tmp=$(mktemp "$STATE/.combined.XXXXXX")
stattmp=$(mktemp "$STATE/.providers.XXXXXX")
trap 'rm -f "$tmp" "$stattmp"' EXIT
printf '%s\n' "$HEADER" > "$tmp"
printf 'provider\tstatus\tobserved_epoch\tnote\n' > "$stattmp"
now=$(date +%s)
# Read-only cloud APIs have their own rate limits. A one-minute daemon tick
# must not refetch multi-page catalogues on every cycle by default.
needs_refresh() {
  local file=$1 epoch_col=$2 ttl=$3 fetched
  [[ "$ttl" =~ ^[0-9]+$ ]] || return 0
  [[ -s "$file" ]] || return 0
  fetched=$(awk -F '\t' -v c="$epoch_col" 'NR==2{print $c}' "$file")
  [[ "$fetched" =~ ^[0-9]+$ ]] || return 0
  (( now < fetched || now - fetched >= ttl ))
}
providers=( AWS AZURE GCP OCI IBM OVH SCALEWAY HETZNER OTC ALIBABA TENCENT HUAWEI COREWEAVE LAMBDA NVIDIA_DGX CLOUDFLARE FASTLY FLY VMWARE OPENSTACK OPENSHIFT COLAB HUGGINGFACE )
for provider in "${providers[@]}"; do
  file="$SOURCES/$provider.tsv"
  message='No active source configured'
  status=UNCONFIGURED
  if [[ "$provider" == AWS && "${CLOUD_ECONOMICS_AWS_ENABLE:-0}" == 1 ]] &&
     needs_refresh "$file" 18 "${CLOUD_ECONOMICS_AWS_MIN_POLL_SECONDS:-600}"; then
    observed=$(mktemp "$SOURCES/.aws.XXXXXX")
    evidence=$(mktemp "$SOURCES/.aws-evidence.XXXXXX")
    if CLOUD_ECONOMICS_AWS_EVIDENCE_FILE="$evidence" "$BASE/tools/aws-spot-readonly" > "$observed"; then
      mv -f "$observed" "$file"
      mv -f "$evidence" "$SOURCES/AWS.evidence.tsv"
    else
      rm -f "$observed" "$evidence"
      status=ERROR
      message='AWS Spot read-only history failed; previous snapshot is not current'
    fi
  fi
  if [[ "$provider" == AZURE && "${CLOUD_ECONOMICS_AZURE_ENABLE:-0}" == 1 ]] &&
     needs_refresh "$file" 18 "${CLOUD_ECONOMICS_AZURE_MIN_POLL_SECONDS:-1800}"; then
    observed=$(mktemp "$SOURCES/.azure.XXXXXX")
    if "$BASE/tools/azure-public-readonly" > "$observed"; then
      mv "$observed" "$file"
    else
      rm -f "$observed"
      status=ERROR
      message='Azure read-only Retail API failed; old feed not silently reused as current'
    fi
  fi
  if [[ "$provider" == GCP && "${CLOUD_ECONOMICS_GCP_ENABLE:-0}" == 1 ]] &&
     needs_refresh "$STATE/components/GCP.tsv" 10 "${CLOUD_ECONOMICS_GCP_MIN_POLL_SECONDS:-3600}"; then
    mkdir -p "$STATE/components"
    observed=$(mktemp "$STATE/components/.gcp.XXXXXX")
    if "$BASE/tools/gcp-catalog-readonly" > "$observed"; then
      mv -f "$observed" "$STATE/components/GCP.tsv"
      status=CATALOG_ONLY
      message='GCP Billing components observed; NOT full VM pricing or purchasable capacity'
      # Billing component time series uses SKU+region+unit, never the VM offer
      # ID namespace. A component cannot acquire a capacity slot.
      history="$STATE/components/history.tsv"
      [[ -f "$history" ]] || printf 'provider\tsku_id\tregion\tpurpose\tusage_unit\tunit_price_usd\tobserved_epoch\teffective_time\tevidence_digest\n' > "$history"
      awk -F '\t' 'NR==FNR {
        if (FNR>1) {k=$1 SUBSEP $2 SUBSEP $3 SUBSEP $5; price[k]=$6; ts[k]=$7}
        next
      } FNR>1 {
        k=$1 SUBSEP $2 SUBSEP $3 SUBSEP $7
        if (!(k in ts) || ($10>ts[k] && ($8!=price[k] || $10-ts[k]>=300)))
          print $1"\t"$2"\t"$3"\t"$4"\t"$7"\t"$8"\t"$10"\t"$9"\t"$12
      }' "$history" "$STATE/components/GCP.tsv" > "$STATE/components/.history-new"
      { head -1 "$history"; tail -n +2 "$history"; cat "$STATE/components/.history-new"; } |
        { IFS= read -r hdr; printf '%s\n' "$hdr"; tail -n 10000; } > "$STATE/components/.history-tmp"
      mv -f "$STATE/components/.history-tmp" "$history"
      rm -f "$STATE/components/.history-new"
    else
      rm -f "$observed"
      status=ERROR
      message='GCP public catalogue read failed; no inferred VM prices'
    fi
  fi
  if [[ "$provider" == GCP && "$status" == UNCONFIGURED &&
        "${CLOUD_ECONOMICS_GCP_ENABLE:-0}" == 1 &&
        -s "$STATE/components/GCP.tsv" ]]; then
    status=CATALOG_CACHED
    message='GCP Billing components cached; no new API read on this poll'
  fi
  if [[ -s "$file" && "$status" != ERROR ]]; then
    if [[ $(head -1 "$file") != "$HEADER" ]]; then
      status=INVALID_SCHEMA
      message='Normalized TSV schema mismatch'
    elif [[ $(wc -l < "$file") -le 1 ]]; then
      status=NO_OFFERS
      message='Provider returned no qualifying offers; no quote admitted'
    elif ! awk -F '\t' -v name="$provider" '
      NR>1 {
        if (NF!=23 || $2!=name || $1!~/^[A-Za-z0-9_.-]+$/ ||
            $10!~/^[0-9]+([.][0-9]+)?$/ ||
            $7!~/^[0-9]+([.][0-9]+)?$/ || $7<=0 ||
            $8!~/^[0-9]+([.][0-9]+)?$/ || $8<=0 ||
            $9!~/^[0-9]+$/ ||
            $11!~/^[0-9]+([.][0-9]+)?$/ ||
            $12!~/^[0-9]+([.][0-9]+)?$/ ||
            $13!~/^[0-9]+([.][0-9]+)?$/ ||
            $14!~/^[0-9]+([.][0-9]+)?$/ || $14>1 ||
            $6!~/^(ONDEMAND|SPOT)$/ ||
            $18!~/^[0-9]+$/ || $19!~/^[0-9]+$/ || $19<$18 ||
            $15!~/^[01]$/ || $16!~/^[01]$/ || $17!~/^[01]$/ ||
            $20!="USD" || seen[$1]++) bad=1
        if ($21 ~ /(UNVERIFIED|NO_CAPACITY_ATTESTATION|NOT_VM)/ &&
            ($15!="0" || $16!="0" || $17!="0")) bad=1
      } END {exit bad}' "$file"; then
      status=INVALID_DATA
      message='Malformed or cross-provider quote'
    elif ! awk -F '\t' 'NR==FNR {if (FNR>1) seen[$1]=1; next} FNR>1 && ($1 in seen) {bad=1} END {exit bad}' "$tmp" "$file"; then
      status=INVALID_DATA
      message='Quote ID collides with another registered provider'
    else
      # LIVE status is restricted to fresh quotes; approval and capacity are
      # separate hard gates in ooRexx and are never asserted here.
      if awk -F '\t' -v now="$now" 'NR>1 && ($18>now || $19<now || now-$18>3600) {bad=1} END{exit bad}' "$file"; then
        status=OBSERVED
        message='Read-only quotations; purchase authority NOT verified'
      else
        status=STALE
        message='Offer timestamps/expiration outside observation freshness window'
      fi
      # Keep stale rows for investigation, but the planner rejects expired rows.
      tail -n +2 "$file" >> "$tmp"
    fi
  fi
  printf '%s\t%s\t%s\t%s\n' "$provider" "$status" "$now" "$message" >> "$stattmp"
done
mv -f "$stattmp" "$STATE/providers.tsv"
mv -f "$tmp" "$STATE/offers.tsv"
# Record observed prices into a bounded training window; reject future samples.
[[ -f "$STATE/history.tsv" ]] || printf 'id\trate\tts\n' > "$STATE/history.tsv"
: > "$STATE/history.new"
awk -F '\t' -v now="$now" 'NR==FNR {
  if (FNR>1) {p[$1]=$2; t[$1]=$3}; next
}
FNR>1 && $1!="" && $18<=now && $18>=now-3600 && $19>=now {
  if (!($1 in t) || ($18>t[$1] && ($10!=p[$1] || $18-t[$1]>=300)))
    print $1"\t"$10"\t"$18
}' "$STATE/history.tsv" "$STATE/offers.tsv" >> "$STATE/history.new"
{
  printf 'id\trate\tts\n'
  tail -n +2 "$STATE/history.tsv"
  [[ ! -f "$STATE/history.new" ]] || cat "$STATE/history.new"
} | { IFS= read -r hdr; printf '%s\n' "$hdr"; tail -n 10000; } > "$STATE/history.tmp"
mv -f "$STATE/history.tmp" "$STATE/history.tsv"
rm -f "$STATE/history.new"
