@@ -0,0 +1,24 @@
+#!/usr/bin/env rexx
+c=.MediaMethodologyCatalogue~new
+.MediaMethodologyBuiltins~populate(c)
+call assertTrue c~methodology('AUDIO.SPECTRAL_INTEGRITY.WINDOWED_BUCKET_VIEWS')<>.nil,'WOLA method'
+call assertTrue c~methodology('QUAL.AUDIO.SPECTRAL_ORACLE_TEMPLATE_PROJECTION')<>.nil,'oracle method'
+call assertTrue c~methodology('QUAL.AUDIO.SPECTRAL_BLIND_CONTROL_TRIAL')<>.nil,'blind method'
+call assertTrue c~methodology('AUDIO.SPECTRAL_INTEGRITY.WINDOWED_BUCKET_VIEWS')~experimental,'WOLA is experimental'
+call assertTrue \c~methodology('AUDIO.SPECTRAL_INTEGRITY.WINDOWED_BUCKET_VIEWS')~reconstructive,'WOLA is measurement not reconstruction'
+call assertEq 'PRESERVE',c~methodology('QUAL.AUDIO.SPECTRAL_ORACLE_TEMPLATE_PROJECTION')~authorityEffect,'oracle authority'
+call assertEq 'PRESERVE',c~methodology('QUAL.AUDIO.SPECTRAL_BLIND_CONTROL_TRIAL')~authorityEffect,'blind authority'
+say 'PASS spectral-integrity v0.3 methodology contract'
+exit 0
+assertTrue: procedure
+  use arg value,label
+  if value then return
+  say 'FAIL' label
+  exit 1
+assertEq: procedure
+  use arg expected,actual,label
+  if expected==actual then return
+  say 'FAIL' label 'expected='expected 'actual='actual
+  exit 1
+::requires 'MediaMethodologies.cls'
+::requires 'MediaMethodologyBuiltins.cls'