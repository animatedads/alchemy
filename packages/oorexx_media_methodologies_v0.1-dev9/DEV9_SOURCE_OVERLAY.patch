+def import_blind_upstream(root):
+    source = Path(root) / "src" / "blind_trial.py"
+    if not source.is_file():
+        raise FileNotFoundError(f"missing upstream blind_trial.py: {source}")
+    src_dir = str(source.parent)
+    inserted = False
+    if src_dir not in sys.path:
+        sys.path.insert(0, src_dir)
+        inserted = True
+    try:
+        spec = importlib.util.spec_from_file_location("audio_spectral_integrity_blind_v03", source)
+        module = importlib.util.module_from_spec(spec)
+        assert spec.loader is not None
+        spec.loader.exec_module(module)
+    finally:
+        if inserted:
+            sys.path.remove(src_dir)
+    return module, source
+
