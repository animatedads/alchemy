+    ceiling = float(job.get("ceiling_hz", rate / 2))
+    offset = float(job.get("offset_hz", 0))
+    frame_samples = int(job.get("frame_samples", 4096))
+    hop_samples = int(job.get("hop_samples", frame_samples // 4))
+    odd, even = up.windowed_bucket_views(pcm, rate, slot, ceiling, offset, frame_samples, hop_samples)
+    odd_path, even_path = outdir / "windowed_odd.wav", outdir / "windowed_even.wav"
+    save_pcm24(odd_path, odd, rate); save_pcm24(even_path, even, rate)
+    source_error = None
+    if abs(ceiling - rate / 2) <= 1e-12:
+        source_error = float(np.max(np.abs((odd + even) - pcm)))
+    report = outdir / "windowed_views.json"
+    metrics = {"slot_hz": slot, "ceiling_hz": ceiling, "offset_hz": offset,
+               "frame_samples": frame_samples, "hop_samples": hop_samples,
+               "nyquist_source_reconstruction_max_abs_error": source_error,
+               "sample_rate": rate, "sample_count": int(pcm.shape[0]), "channels": int(pcm.shape[1])}
