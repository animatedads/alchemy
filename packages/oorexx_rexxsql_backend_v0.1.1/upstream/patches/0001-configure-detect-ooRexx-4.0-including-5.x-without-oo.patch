          extra_rexx_defines="-DLINUX"
+         # ooRexx 5 ships no oorexx-config: rexx.h declaring RexxReturnCode means the ooRexx 4.0+ API
+         for mh_orx_dir in $with_rexxincdir $REXXINCDIR /usr/local/include /usr/include $extra_incdirs; do
+            if test -r "$mh_orx_dir/rexx.h" && grep RexxReturnCode "$mh_orx_dir/rexx.h" >/dev/null 2>&1; then
