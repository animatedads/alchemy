{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "oorexx_legal_interrogation",
    "version": "0.1-dev6",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "INTENTION_SERVICE_ROOT": "${REPO_ROOT}/packages/oorexx_intention_service",
      "LEGAL_EFFECT_ROOT": "${REPO_ROOT}/packages/legal_effect_v0.14",
      "ALCHEMY_OBJECTS_ROOT": "${REPO_ROOT}/packages/alchemy_objects_v0.8",
      "CRYPTO_ROOT": "${REPO_ROOT}/packages/oorexx_crypto_v0.8.3"
    }
  },
  "tests": [
    {
      "name": "legal-interrogation-dev6-suite",
      "argv": [
        "bash",
        "run_tests.sh"
      ],
      "timeout_seconds": 180,
      "environment": {
        "require_dirs": [
          "INTENTION_SERVICE_ROOT",
          "LEGAL_EFFECT_ROOT",
          "ALCHEMY_OBJECTS_ROOT",
          "CRYPTO_ROOT"
        ],
        "report": [
          "INTENTION_SERVICE_ROOT",
          "LEGAL_EFFECT_ROOT",
          "ALCHEMY_OBJECTS_ROOT",
          "CRYPTO_ROOT"
        ]
      }
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/oorexx_legal_interrogation_v0.1-dev6"
    }
  }
}
