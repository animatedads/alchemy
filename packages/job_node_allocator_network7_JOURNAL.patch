@@ ::method append guarded
-  sequence+=1
+  nextSequence=sequence+1
   state=result~lifecycle
-  material="EVENT|"||sequence||
+  material="EVENT|"||nextSequence||
@@
-  stream~lineout(material); stream~lineout("COMMIT|"||sequence||"|"||digest); stream~close
+  stream~lineout(material); stream~lineout("COMMIT|"||nextSequence||"|"||digest); stream~close
+  sequence=nextSequence

@@ ::method restoreInto guarded
-    if line~left(6)="EVENT|" then do; pending=line; iterate; end
-    if line~left(7)<>"COMMIT|" | pending="" then iterate
+    if line~left(6)="EVENT|" then do
+      if pending<>"" then do; stream~close; return .JobNodeExecutionReconcileResult~new(.false,"LIFECYCLE_JOURNAL_UNCOMMITTED_GAP"); end
+      pending=line; iterate
+    end
+    if line~left(7)<>"COMMIT|" | pending="" then do
+      stream~close
+      return .JobNodeExecutionReconcileResult~new(.false,"LIFECYCLE_JOURNAL_UNEXPECTED_RECORD")
+    end

