{
  "schema": "alchemy.autobuild.integration/0.3",
  "package": {
    "name": "oorexx_slam_bostoncrab",
    "version": "0.17",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "ALCHEMY_REPO_ROOT": "${REPO_ROOT}",
      "RT_SRC": "${REPO_ROOT}/packages/oorexx_reasoned_thought_v0.1/src"
    },
    "prepend_path": [],
    "rexx_path": {
      "mode": "replace",
      "entries": [
        "${PACKAGE_ROOT}",
        "${PACKAGE_ROOT}/wordnet",
        "${REPO_ROOT}/packages/oorexx_reasoned_thought_v0.1/src"
      ],
      "require_entries": true
    },
    "require_dirs": [
      "RT_SRC"
    ],
    "report": [
      "ALCHEMY_REPO_ROOT",
      "RT_SRC"
    ]
  },
  "tests": [
    {
      "name": "manifest",
      "argv": [
        "sha256sum",
        "-c",
        "--quiet",
        "MANIFEST.sha256"
      ],
      "timeout_seconds": 60
    },
    {
      "name": "stories",
      "argv": [
        "sh",
        "tests/run_stories.sh"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "gloss-scramble",
      "argv": [
        "sh",
        "tests/run_scramble.sh"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "testimony-cases",
      "argv": [
        "sh",
        "testimony_cases/run.sh"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "qa-cases",
      "argv": [
        "sh",
        "qa_cases/run.sh"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "order-cases",
      "argv": [
        "sh",
        "orders/run.sh"
      ],
      "timeout_seconds": 600
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/oorexx_slam_bostoncrab_v0.17"
    }
  }
}
