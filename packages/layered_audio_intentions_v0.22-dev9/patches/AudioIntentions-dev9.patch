 ::constant UNAVAILABLE "UNAVAILABLE"
 
+/* Optional live authority/feasibility gates are deliberately external to Audio
+ * truth.  A gate may be a Directory or an object implementing
+ * allowIntention(candidate,target,context).  Directory precedence is:
+ * exact intention id, feature kind, then "*".  Missing entries allow.
+ *
+ * Gate values may be booleans / 0/1, or AudioIntentionGateDecision objects.
+ * Denial never deletes the candidate: the semantic surface remains observable
+ * but becomes UNAVAILABLE with explicit gate evidence. */
+::class AudioIntentionGateDecision public
+::attribute allowed get
+::attribute reason get
+::attribute evidence get
+::method init
+  expose allowed reason evidence
+  use strict arg allowedArg, reasonArg="", evidenceArg=.nil
+  allowed=allowedArg
+  reason=reasonArg~string
+  evidence=evidenceArg
+
@@
   if self~isRecording(target) then do
     self~discoverRecording(snapshot,target,context)
-    return snapshot
+    return self~applyContextGates(snapshot,context)
   end
   if self~isElement(target) then do
     self~discoverElement(snapshot,target,context)
-    return snapshot
+    return self~applyContextGates(snapshot,context)
   end
   if self~isView(target) then do
