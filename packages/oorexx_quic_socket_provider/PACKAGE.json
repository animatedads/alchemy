{
  "name": "oorexx_quic_socket_provider",
  "version": "0.1-dev5",
  "api": "quic.socket.provider/0.1",
  "socket_provider_compat": "0.1-dev14",
  "native_backend": "OpenSSL QUIC",
  "qualification": "qualification/run_environment_test.sh",
  "features": [
    "real OpenSSL QUIC client/server",
    "SocketProvider binding",
    "dynamic socket negotiation offer",
    "descriptor/readiness/event pump",
    "nonblocking tryAccept",
    "accepted peer SocketAddress identity",
    "real QUIC bidirectional child streams",
    "multiplexed stream acceptance",
    "SocketStreamAdapter compatibility for child streams",
    "nonblocking tryOpenStream with QUIC stream-count backpressure",
    "bidirectional/unidirectional local stream availability introspection",
    "structured nonblocking child-stream I/O results",
    "QUIC WANT_READ/WANT_WRITE retryable flow-control states",
    "explicit child-stream blocking-mode control"
  ]
}
