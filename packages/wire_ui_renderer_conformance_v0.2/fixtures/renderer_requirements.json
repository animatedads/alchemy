{
  "schema": "wire-ui-renderer-conformance/0.2",
  "protocol": "WIRE-UI/0.1",
  "renderers": [
    "web",
    "swing",
    "gtk-direct-linux",
    "android"
  ],
  "required_semantics": [
    "exact-definition",
    "exact-published-resource-ref",
    "revision-ordering",
    "event-time-renderedRevision",
    "stable-collection-identity",
    "bounded-range-request",
    "opaque-workspaceContext",
    "semantic-activation",
    "positive-list-observation",
    "deauthorisation-fail-closed"
  ],
  "forbidden_application_leaks": [
    "domNode",
    "jcomponent",
    "gtkWidget",
    "androidView",
    "composeNode",
    "hwnd",
    "rowOrdinal",
    "url",
    "uri",
    "href",
    "src",
    "path",
    "html",
    "copy",
    "description",
    "textContent"
  ]
}