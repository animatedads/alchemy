#!/usr/bin/env bash
set -euo pipefail

TABLE_FAMILY=inet
TABLE_NAME=alchemy_firewall
PROTECTED_SET=protected4
EXACT_SET=hostile_exact4
NET24_SET=hostile_net24

fail() { printf 'firewall-nft: %s\n' "$*" >&2; exit 64; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || fail "must run as root"; }
require_nft() { command -v nft >/dev/null 2>&1 || fail "nft not found"; }

valid_ipv4() {
  local ip=$1 IFS=. a b c d x
  read -r a b c d <<<"$ip" || return 1
  [[ -n ${a:-} && -n ${b:-} && -n ${c:-} && -n ${d:-} ]] || return 1
  [[ "$ip" != *..* ]] || return 1
  for x in "$a" "$b" "$c" "$d"; do
    [[ $x =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#$x >= 0 && 10#$x <= 255)) || return 1
  done
}

valid_net24() {
  local cidr=$1 ip=${cidr%/24}
  [[ $cidr == */24 ]] || return 1
  valid_ipv4 "$ip" || return 1
  [[ ${ip##*.} == 0 ]]
}

valid_minutes() {
  [[ $1 =~ ^[1-9][0-9]{0,5}$ ]]
}

init_table() {
  nft list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || nft add table "$TABLE_FAMILY" "$TABLE_NAME"
  nft list set "$TABLE_FAMILY" "$TABLE_NAME" "$PROTECTED_SET" >/dev/null 2>&1 || \
    nft 'add set inet alchemy_firewall protected4 { type ipv4_addr; flags interval; }'
  nft list set "$TABLE_FAMILY" "$TABLE_NAME" "$EXACT_SET" >/dev/null 2>&1 || \
    nft 'add set inet alchemy_firewall hostile_exact4 { type ipv4_addr; flags timeout; }'
  nft list set "$TABLE_FAMILY" "$TABLE_NAME" "$NET24_SET" >/dev/null 2>&1 || \
    nft 'add set inet alchemy_firewall hostile_net24 { type ipv4_addr; flags interval,timeout; }'

  nft list chain "$TABLE_FAMILY" "$TABLE_NAME" input >/dev/null 2>&1 || \
    nft 'add chain inet alchemy_firewall input { type filter hook input priority -50; policy accept; }'
  nft list chain "$TABLE_FAMILY" "$TABLE_NAME" forward >/dev/null 2>&1 || \
    nft 'add chain inet alchemy_firewall forward { type filter hook forward priority -50; policy accept; }'

  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" input | grep -Fq 'ip saddr @protected4 accept'; then
    nft add rule inet alchemy_firewall input ip saddr @protected4 accept
  fi
  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" input | grep -Fq 'ip saddr @hostile_exact4 drop'; then
    nft add rule inet alchemy_firewall input ip saddr @hostile_exact4 drop
  fi
  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" input | grep -Fq 'ip saddr @hostile_net24 drop'; then
    nft add rule inet alchemy_firewall input ip saddr @hostile_net24 drop
  fi
  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" forward | grep -Fq 'ip saddr @protected4 accept'; then
    nft add rule inet alchemy_firewall forward ip saddr @protected4 accept
  fi
  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" forward | grep -Fq 'ip saddr @hostile_exact4 drop'; then
    nft add rule inet alchemy_firewall forward ip saddr @hostile_exact4 drop
  fi
  if ! nft -a list chain "$TABLE_FAMILY" "$TABLE_NAME" forward | grep -Fq 'ip saddr @hostile_net24 drop'; then
    nft add rule inet alchemy_firewall forward ip saddr @hostile_net24 drop
  fi
}

require_root
require_nft
cmd=${1:-}
case "$cmd" in
  init)
    [[ $# -eq 1 ]] || fail "usage: firewall-nft init"
    init_table
    ;;
  protect)
    [[ $# -eq 2 ]] || fail "usage: firewall-nft protect IPV4|IPV4/24"
    init_table
    value=$2
    if [[ $value == */* ]]; then valid_net24 "$value" || fail "invalid protected /24: $value"; else valid_ipv4 "$value" || fail "invalid protected IPv4: $value"; fi
    nft add element inet alchemy_firewall protected4 "{ $value }" 2>/dev/null || true
    ;;
  block)
    [[ $# -eq 5 ]] || fail "usage: firewall-nft block IPV4 IPV4/24 EXACT_MINUTES NET24_MINUTES"
    init_table
    ip=$2; net=$3; exact_minutes=$4; net_minutes=$5
    valid_ipv4 "$ip" || fail "invalid IPv4: $ip"
    valid_net24 "$net" || fail "invalid /24: $net"
    valid_minutes "$exact_minutes" || fail "invalid exact timeout"
    valid_minutes "$net_minutes" || fail "invalid network timeout"
    expected_net="${ip%.*}.0/24"
    [[ $net == "$expected_net" ]] || fail "network does not contain source"
    if nft get element inet alchemy_firewall protected4 "{ $ip }" >/dev/null 2>&1; then fail "source is protected"; fi
    # Add or refresh.  Existing elements are replaced atomically enough for this
    # policy because the set itself remains installed throughout.
    nft delete element inet alchemy_firewall hostile_exact4 "{ $ip }" 2>/dev/null || true
    nft delete element inet alchemy_firewall hostile_net24 "{ $net }" 2>/dev/null || true
    nft add element inet alchemy_firewall hostile_exact4 "{ $ip timeout ${exact_minutes}m }"
    nft add element inet alchemy_firewall hostile_net24 "{ $net timeout ${net_minutes}m }"
    ;;
  status)
    [[ $# -eq 1 ]] || fail "usage: firewall-nft status"
    init_table
    nft list table inet alchemy_firewall
    ;;
  *) fail "unknown operation: ${cmd:-<empty>}" ;;
esac
