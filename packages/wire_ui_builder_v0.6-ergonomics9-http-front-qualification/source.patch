+pkg=cr~value
+if pkg~definitions~items<>15 then do; say "FAIL definition count" pkg~definitions~items; exit 1; end
+if w~artifact("ELEMENT","NN_TEMPORAL","1")==.nil then do; say "FAIL temporal element missing"; exit 1; end
+if w~artifact("ELEMENT","NN_OBSERVATIONS","1")==.nil then do; say "FAIL observation element missing"; exit 1; end
+say "PASS NotNotes Web Wire reference fixture"
+exit 0
