@@ -0,0 +1,25 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+const here=path.dirname(fileURLToPath(import.meta.url));
+const html=fs.readFileSync(path.join(here,'../web/notnotes/preview.html'),'utf8');
+const js=fs.readFileSync(path.join(here,'../web/notnotes/notnotes-wire-preview.js'),'utf8');
+const css=fs.readFileSync(path.join(here,'../web/notnotes/notnotes.css'),'utf8');
+const required=[
+ 'NN_SHELL','NN_NAV','NN_SEARCH','NN_REGISTER','NN_DETAIL','NN_TEMPORAL','NN_RELATIONS','NN_LIFECYCLE','NN_REPORTS','NN_ACTIVITY','NN_OBSERVATIONS','NN_COMPOSER','NN_CLARIFY'
+];
+for(const id of required){if(!html.includes(`data-wire-element="${id}"`))throw new Error(`missing web element ${id}`)}
+const actions=[
+ 'NOTNOTES.REFRESH_WINDOW','NOTNOTES.COMPLETE_DOCUMENT','NOTNOTES.DESIGN_FORMAT','NOTNOTES.ALTER_FORMAT',
+ 'NOTNOTES.OPEN_DOCUMENT','NOTNOTES.LINK_DOCUMENT','NOTNOTES.SAVE_DOCUMENT','NOTNOTES.SUBMIT','NOTNOTES.APPROVE',
+ 'NOTNOTES.REJECT','NOTNOTES.PRINT_DOCUMENT','NOTNOTES.RUN_REPORT','NOTNOTES.EXPORT_REPORT','NOTNOTES.PRINT_REPORT',
+ 'NOTNOTES.DISCOVER_INTENTIONS','NOTNOTES.SUBMIT_TEXT','NOTNOTES.END_SESSION','NOTNOTES.NAVIGATE','NOTNOTES.SEARCH',
+ 'NOTNOTES.FILTER','NOTNOTES.SORT'
+];
+for(const a of actions){if(!html.includes(a)&&!js.includes(a))throw new Error(`missing preview action ${a}`)}
+if(!js.includes("emit('NOTNOTES.DISCOVER_INTENTIONS'") || !js.includes("emit('NOTNOTES.SUBMIT_TEXT'")) throw new Error('intention discovery/submit sequence missing');
+if(/fetch\s*\(|XMLHttpRequest|localStorage|indexedDB/.test(js)) throw new Error('preview acquired application/network/storage authority');
+if(!html.includes('authoritative time semantics') || !html.includes('Instrumentation Mesh')) throw new Error('temporal/observation presentation missing');
+if(!js.includes('Intl.DateTimeFormat') || !js.includes('timeResolution')) throw new Error('temporal presentation mapping missing');
+if(!css.includes('@media(max-width:820px)')) throw new Error('narrow responsive projection missing');
+console.log('PASS NotNotes modern Web preview contract');
diff --git a/wire_ui_builder_v0.6/tests/test_notnotes_web_wire_fixture.rex b/wire_ui_builder_v0.6/tests/test_notnotes_web_wire_fixture.rex
