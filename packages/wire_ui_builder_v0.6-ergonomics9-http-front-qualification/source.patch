+/* Site semantic vocabulary: business meaning independent of renderer/profile. */
+::class WireUISemanticElement subclass AlchemyObject public
+::attribute elementId get
+::attribute version get
+::attribute semanticType get
+::attribute audiencePolicyRef get
+::attribute contentAddress get
+::method init
+  expose elementId version semanticType fields actions audiencePolicyRef metadata intentionRequirements contentAddress
+  use arg elementId, version, semanticType, fields=.nil, actions=.nil, audiencePolicyRef="PUBLIC", metadata=.nil, requestedIntentions=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned semantic interaction element"))
+  elementId=elementId~string~strip; version=version~string~strip; semanticType=semanticType~string~strip
+  audiencePolicyRef=audiencePolicyRef~string~strip
+  if elementId="" | version="" | semanticType="" then raise syntax 93.906 array("semantic element", elementId)
+  fields=.WireUIDesignUtil~copyArray(fields); actions=.WireUIDesignUtil~copyArray(actions); metadata=.WireUIDesignUtil~copyTable(metadata)
+  intentionRequirements=.array~new
+  if requestedIntentions<>.nil then do requirement over requestedIntentions
+    if requirement~isA(.WireUIIntentionRequirement) then r=requirement
+    else do
+      if \(requirement~isA(.Table) | requirement~isA(.Directory)) then raise syntax 93.948 array("intention requirement")
+      r=.WireUIIntentionRequirement~new(self~field(requirement,"bindingId",""),self~field(requirement,"purposeRef",""),self~field(requirement,"sphereRef",""),self~field(requirement,"action",""),self~field(requirement,"discoveryPolicy","DYNAMIC"),self~field(requirement,"readinessPolicy","READY_REQUIRED"),self~field(requirement,"refreshPoint","BEFORE_OFFER_AND_DISPATCH"),self~field(requirement,"metadata",.nil))
+    end
+    if \actions~hasItem(r~action) then raise syntax 93.906 array("intention action not declared by element",r~action)
+    intentionRequirements~append(r)
+  end
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("elementId","PUBLIC","stable site semantic identity")
+  self~registerStateVariable("version","PUBLIC","immutable semantic element version")
+  self~registerStateVariable("audiencePolicyRef","PUBLIC","declarative audience policy reference; never an authority grant")
+::method canonicalText
+  expose elementId version semanticType fields actions audiencePolicyRef metadata intentionRequirements
+  base=elementId"|"version"|"semanticType"|"audiencePolicyRef"|".WireUIDesignUtil~canonicalArray(fields)"|".WireUIDesignUtil~canonicalArray(actions)"|".WireUIDesignUtil~canonicalTable(metadata)
+  if intentionRequirements~items=0 then return base
+  intents=.array~new; do r over intentionRequirements; intents~append(r~asWire); end
+  return base"|INTENTIONS|".WireUIDesignUtil~canonicalArray(intents)
+::method ref
+  expose elementId version contentAddress
+  return .WireUIArtifactRef~new("ELEMENT",elementId,version,contentAddress)
+::method intentionRequirements
+  expose intentionRequirements
+  out=.array~new; do r over intentionRequirements; out~append(r); end; return out
+::method asWire
+  expose elementId version semanticType fields actions audiencePolicyRef metadata intentionRequirements contentAddress
+  intents=.array~new; do r over intentionRequirements; intents~append(r~asWire); end
+  d=.table~new; d["elementId"]=elementId; d["version"]=version; d["semanticType"]=semanticType; d["fields"]=.WireUIDesignUtil~copyArray(fields); d["actions"]=.WireUIDesignUtil~copyArray(actions); d["audiencePolicyRef"]=audiencePolicyRef; d["metadata"]=.WireUIDesignUtil~copyTable(metadata); d["intentionRequirements"]=intents; d["contentAddress"]=contentAddress
+  return d
+::method field private
+  use arg t,k,default=.nil
+  if t==.nil then return default
+  if t~hasIndex(k) then return t[k]
+  return default
