+  }
+
+  #enhanceFlowMap() {
+    const root=this.mount.querySelector?.('[data-wire-definition^="WUIB_FLOW_MAP@"]'); if(!root) return;
+    const items=[...(root.querySelectorAll?.('.wui-collection-item')??[])];
+    if(items[0]?.parentElement) items[0].parentElement.classList?.add?.('wui-builder-flow-filmstrip');
+    for(const item of items) {
+      if(!item?.ownerDocument || item.dataset?.wireFlowDecorated==='1') continue;
+      item.dataset.wireFlowDecorated='1'; item.classList?.add?.('wui-builder-flow-card');
+      const info=parseCollectionItemText(item.textContent??''); const d=item.ownerDocument;
+      const state=d.createElement('strong');state.className='wui-builder-flow-state';state.textContent=info.stateId??'STATE';
+      const thumb=d.createElement('span');thumb.className='wui-builder-flow-thumb';thumb.setAttribute('aria-label',`Layout thumbnail for ${info.stateId??'state'}`);
+      const cells=parseLayoutSignature(info.layoutSignature??'');
+      if(cells.length) for(const cell of cells){const block=d.createElement('span');block.className='wui-builder-flow-thumb-cell';block.style.gridColumn=`span ${cell.span}`;block.style.gridRow=`span ${cell.rowSpan}`;block.title=`${cell.region} · ${cell.span}/12`;block.dataset.region=cell.region;thumb.appendChild(block);}
+      else {const empty=d.createElement('span');empty.className='wui-builder-flow-thumb-empty';empty.textContent='No layout';thumb.appendChild(empty);}
+      const counts=d.createElement('span');counts.className='wui-builder-flow-counts';counts.textContent=`${info.activeCount??0} active · ${info.prefetchCount??0} prefetched`;
+      const next=d.createElement('span');next.className='wui-builder-flow-next';next.textContent=`→ ${info.nextStates??'END'}`;
+      const flowStateId=info.stateId??item.__wireActionDetail?.id??'';
+      if(item.dataset) item.dataset.wireFlowStateId=flowStateId;
+      this.#activateButton(thumb,()=>{this.selectedFlowStateId=flowStateId;this.#syncFlowSelection(root);item.click?.();});
+      item.addEventListener?.('click',()=>{this.selectedFlowStateId=flowStateId;this.#syncFlowSelection(root);});
+      item.replaceChildren(state,thumb,counts,next);
+    }
+    this.#syncFlowSelection(root);
+  }
+
+  #syncFlowSelection(root) {
+    for(const item of [...(root?.querySelectorAll?.('.wui-collection-item')??[])]) {
+      const flowStateId=item.dataset?.wireFlowStateId??item.__wireActionDetail?.id??'';
+      const selected=Boolean(this.selectedFlowStateId&&flowStateId===this.selectedFlowStateId);
+      if(selected)item.classList?.add?.('wui-builder-flow-selected');else item.classList?.remove?.('wui-builder-flow-selected');
+      item.setAttribute?.('aria-selected',selected?'true':'false');
+    }
+  }
+
+  #enhanceToolNav() {
+    const root=this.mount.querySelector?.('[data-wire-definition^="WUIB_TOOL_NAV@"]'); if(!root) return;
+    for(const item of [...(root.querySelectorAll?.('.wui-collection-item')??[])]) {
+      const label=String(item.textContent??'').trim().toUpperCase();
+      if(this.stateId && label===String(this.stateId).toUpperCase()) item.classList?.add?.('wui-builder-tool-active'); else item.classList?.remove?.('wui-builder-tool-active');
+    }
+  }
+
+  #instanceIdForRoot(root) {
+    for(const [instanceId,live] of this.renderer?.instances??[]) if(live?.root===root) return instanceId;
+    return null;
+  }
+}
