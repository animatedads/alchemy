@@ -0,0 +1,68 @@
+/* Journey authoring uses semantic element identities, not pages or DOM nodes. */
+::class WireUIJourneyDesign subclass AlchemyObject public
+::attribute journeyId get
+::attribute version get
+::attribute initialState get
+::attribute contentAddress get
+::method init
+  expose journeyId version initialState states transitions contentAddress sealed
+  use arg journeyId, version, initialState
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned semantic customer journey design"))
+  journeyId=journeyId~string~strip; version=version~string~strip; initialState=initialState~string~strip
+  states=.table~new; transitions=.table~new; sealed=.false; contentAddress=""
+  if journeyId="" | version="" | initialState="" then raise syntax 93.906 array("journey", journeyId)
+::method defineState
+  expose states sealed
+  use arg stateId, active=.nil, prefetch=.nil, onDemand=.nil
+  if sealed then return .WireUIDesignResult~failure("JOURNEY_SEALED")
+  s=.table~new; s["ACTIVE"]=.WireUIDesignUtil~copyArray(active); s["PREFETCH"]=.WireUIDesignUtil~copyArray(prefetch); s["ON_DEMAND"]=.WireUIDesignUtil~copyArray(onDemand)
+  states[stateId]=s
+  return .WireUIDesignResult~success(self)
+::method allowTransition
+  expose transitions sealed
+  use arg fromState,toState,trigger="",purpose=""
+  if sealed then return .WireUIDesignResult~failure("JOURNEY_SEALED")
+  t=.table~new; t["fromState"]=fromState; t["toState"]=toState; t["trigger"]=trigger; t["purpose"]=purpose
+  transitions[fromState"|"toState]=t
+  return .WireUIDesignResult~success(self)
+::method seal
+  expose states initialState sealed contentAddress
+  if \states~hasIndex(initialState) then return .WireUIDesignResult~failure("INITIAL_STATE_UNDEFINED",initialState)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  sealed=.true
+  return .WireUIDesignResult~success(self)
+::method isSealed
+  expose sealed
+  return sealed
+::method state
+  expose states
+  use arg stateId
+  if states~hasIndex(stateId) then return states[stateId]
+  return .nil
+::method stateIds
+  expose states
+  a=states~allIndexes; a~sort; return a
+::method transitions
+  expose transitions
+  a=.array~new; keys=transitions~allIndexes; keys~sort; do k over keys; a~append(transitions[k]); end; return a
+::method canonicalText
+  expose journeyId version initialState states transitions
+  text=journeyId"|"version"|"initialState"|"
+  keys=states~allIndexes; keys~sort
+  do k over keys
+    s=states[k]; text ||= "S:"k":".WireUIDesignUtil~canonicalArray(s["ACTIVE"])":".WireUIDesignUtil~canonicalArray(s["PREFETCH"])":".WireUIDesignUtil~canonicalArray(s["ON_DEMAND"] )"|"
+  end
+  tkeys=transitions~allIndexes; tkeys~sort
+  do k over tkeys; text ||= "T:"k":".WireUIDesignUtil~canonicalTable(transitions[k])"|"; end
+  return text
+::method ref
+  expose journeyId version contentAddress sealed
+  if \sealed then return .nil
+  return .WireUIArtifactRef~new("JOURNEY",journeyId,version,contentAddress)
+::method asWire
+  expose journeyId version initialState states transitions contentAddress sealed
+  d=.table~new; d["journeyId"]=journeyId; d["version"]=version; d["initialState"]=initialState; d["contentAddress"]=contentAddress; d["sealed"]=sealed
+  ss=.array~new; keys=states~allIndexes; keys~sort; do k over keys; r=.table~new; r["stateId"]=k; r["ACTIVE"]=.WireUIDesignUtil~copyArray(states[k]["ACTIVE"]); r["PREFETCH"]=.WireUIDesignUtil~copyArray(states[k]["PREFETCH"]); r["ON_DEMAND"]=.WireUIDesignUtil~copyArray(states[k]["ON_DEMAND"]); ss~append(r); end
+  d["states"]=ss; d["transitions"]=self~transitions
+  return d
+::requires "WireUIDesignSupport.cls"
