diff --git a/wire_ui_builder_v0.6/src/WireUICompiler.cls b/wire_ui_builder_v0.6/src/WireUICompiler.cls
new file mode 100644
index 0000000000000000000000000000000000000000..0d95473380b365e4485fe22e784030c16c00072b
--- /dev/null
+++ b/wire_ui_builder_v0.6/src/WireUICompiler.cls
@@ -0,0 +1,238 @@
+/* Compile exact release graph to profile-aware runtime-neutral Wire UI artifacts. */
+::class WireUICompiler subclass AlchemyObject public
+::method init
+  self~init:super(.WireUIDesignAlchemy~metadata("Wire UI design graph validator/compiler"))
+
+::method compile
+  use arg workspace, release
+  if \release~isA(.WireUISiteRelease) | \release~isSealed then return .WireUIDesignResult~failure("RELEASE_NOT_SEALED")
+  pkg=.WireUICompiledPackage~new(release~releaseId, release~version, release~ref)
+  refs=release~refs
+  pinned=.table~new
+  do r over refs; pinned[r~key]=r; end
+  /* Every exact release ref must exist with exactly the pinned content address. */
+  do r over refs
+    a=workspace~artifact(r~kind,r~artifactId,r~version)
+    if a==.nil then return .WireUIDesignResult~failure("PINNED_ARTIFACT_MISSING",r~key)
+    if r~contentAddress="" | a~ref~contentAddress \= r~contentAddress then return .WireUIDesignResult~failure("PINNED_CONTENT_MISMATCH",r~key)
+  end
+  /* Material and projection definitions are emitted independently; multiple versions coexist. */
+  do r over refs
+    a=workspace~artifact(r~kind,r~artifactId,r~version)
+    select
+      when r~kind="MATERIAL" then pkg~addMaterial(a~asWire)
+      when r~kind="PROJECTION" then do
+        er=a~elementRef; cr=a~componentRef
+        if \pinned~hasIndex(er~key) then return .WireUIDesignResult~failure("PROJECTION_ELEMENT_NOT_PINNED",a~projectionId)
+        if \pinned~hasIndex(cr~key) then return .WireUIDesignResult~failure("PROJECTION_COMPONENT_NOT_PINNED",a~projectionId)
+        component=workspace~artifact(cr~kind,cr~artifactId,cr~version)
+        d=.table~new
+        d["semanticElementRef"]=er~asWire
+        element=workspace~artifact(er~kind,er~artifactId,er~version)
+        ew=element~asWire
+        if ew["intentionRequirements"]~items>0 then d["intentionRequirements"]=ew["intentionRequirements"]
+        d["projectionRef"]=a~ref~asWire
+        d["definitionId"]=a~definitionId
+        d["definitionVersion"]=a~version
+        d["definitionKey"]=a~definitionId"@"a~version
+        d["profile"]=a~profile
+        d["primitive"]=component~primitive
+        d["componentRef"]=cr~asWire
+        d["styleRole"]=a~styleRole
+        d["materialRole"]=a~materialRole
+        aw=a~asWire; d["action"]=aw["action"]; d["bindings"]=aw["bindings"]
+        md=.WireUIDesignUtil~copyTable(aw["metadata"])
+        hints=self~compositionHints(workspace,refs,a)
+        if hints~items>0 then md["compositionHints"]=hints
+        d["metadata"]=md
+        d["contentAddress"]=.WireUIDesignUtil~token(.WireUIDesignUtil~canonicalTable(d))
+        pkg~addDefinition(d)
+      end
+      when r~kind="JOURNEY" then do
+        if \a~isSealed then return .WireUIDesignResult~failure("JOURNEY_NOT_SEALED",a~journeyId)
+        /* Compile each journey state against every profile represented in the pinned projections. */
+        profiles=.set~new
+        do rr over refs
+          if rr~kind="PROJECTION" then profiles~put(workspace~artifact(rr~kind,rr~artifactId,rr~version)~profile)
+        end
+        do profile over profiles
+          plan=.table~new; plan["journeyRef"]=a~ref~asWire; plan["profile"]=profile; plan["initialState"]=a~initialState
+          states=.array~new
+          do stateId over a~stateIds
+            source=a~state(stateId); row=.table~new; row["stateId"]=stateId
+            do tier over .array~of("ACTIVE","PREFETCH","ON_DEMAND")
+              row[tier || "_ELEMENTS"]=.WireUIDesignUtil~copyArray(source[tier])
+              defs=.array~new
+              do elementId over source[tier]
+                do rr over refs
+                  if rr~kind="PROJECTION" then do
+                    p=workspace~artifact(rr~kind,rr~artifactId,rr~version)
+                    if p~profile=profile then if p~elementRef~artifactId=elementId then defs~append(p~definitionId"@"p~version)
+                  end
+                end
+              end
+              row[tier]=defs
+            end
+            states~append(row)
+          end
+          plan["states"]=states; plan["transitions"]=a~transitions
+          pkg~addJourneyPlan(plan)
+        end
+      end
+      when r~kind="COMPOSITION" then do
+        jr=a~journeyRef
+        if \pinned~hasIndex(jr~key) then return .WireUIDesignResult~failure("COMPOSITION_JOURNEY_NOT_PINNED",a~compositionId)
+        journey=workspace~artifact(jr~kind,jr~artifactId,jr~version)
+        state=journey~state(a~stateId)
+        if state==.nil then return .WireUIDesignResult~failure("COMPOSITION_STATE_NOT_FOUND",a~compositionId"|"a~stateId)
+        active=.set~new; do elementId over state["ACTIVE"]; active~put(elementId); end
+        do placement over a~placements
+          if \active~hasIndex(placement["elementId"]) then return .WireUIDesignResult~failure("COMPOSITION_ELEMENT_NOT_ACTIVE",a~compositionId"|"placement["elementId"])
+          if placement["projectionId"]<>"" then do
+            found=.false
+            do rr over refs
+              if rr~kind<>"PROJECTION" then iterate
+              prj=workspace~artifact(rr~kind,rr~artifactId,rr~version)
+              if prj~projectionId=placement["projectionId"] then if prj~profile=a~profile then if prj~elementRef~artifactId=placement["elementId"] then found=.true
+            end
+            if \found then return .WireUIDesignResult~failure("COMPOSITION_PROJECTION_NOT_PINNED",a~compositionId"|"placement["projectionId"])
+          end
+        end
+        pkg~addComposition(a~asWire)
+      end
+      when r~kind="EXPERIMENT" then do
+        vars=a~variants
+        do v over vars
+          pr=v["projectionRef"]
+          if \pinned~hasIndex(pr~key) then return .WireUIDesignResult~failure("EXPERIMENT_VARIANT_NOT_PINNED",a~experimentId)
+          p=workspace~artifact(pr~kind,pr~artifactId,pr~version)
+          if p~elementRef~artifactId \= a~targetElementId then return .WireUIDesignResult~failure("EXPERIMENT_TARGET_MISMATCH",a~experimentId)
+        end
+        e=.table~new; e["experimentRef"]=a~ref~asWire; e["experimentId"]=a~experimentId; e["targetElementId"]=a~targetElementId; e["assignmentUnit"]=a~assignmentUnit; e["variants"]=vars
+        pkg~addExperiment(e)
+      end
+      otherwise nop
+    end
+  end
+  pkg~seal
+  return .WireUIDesignResult~success(pkg,"COMPILED")
+
+::method previewManifest
+  use arg workspace, compiledPackage, scenario
+  if scenario~releaseRef~contentAddress \= compiledPackage~releaseRef~contentAddress then return .WireUIDesignResult~failure("PREVIEW_RELEASE_MISMATCH")
+
+  selectedPlan=.nil
+  do p over compiledPackage~journeyPlans
+    if p["profile"]=scenario~profile then do; selectedPlan=p; leave; end
+  end
+  if selectedPlan==.nil then return .WireUIDesignResult~failure("PREVIEW_PROFILE_NOT_COMPILED",scenario~profile)
+  selectedState=.nil
+  do row over selectedPlan["states"]
+    if row["stateId"]=scenario~journeyState then do; selectedState=row; leave; end
+  end
+  if selectedState==.nil then return .WireUIDesignResult~failure("PREVIEW_JOURNEY_STATE_NOT_COMPILED",scenario~journeyState)
+
+  m=.table~new
+  m["scenarioRef"]=scenario~ref~asWire
+  m["releaseRef"]=compiledPackage~releaseRef~asWire
+  m["profile"]=scenario~profile
+  m["journeyState"]=scenario~journeyState
+  m["authenticated"]=scenario~authenticated
+  m["subjectId"]=scenario~subjectId
+  m["requestedExperimentAssignments"]=scenario~assignments
+  resolved=.table~new
+
+  do tier over .array~of("ACTIVE","PREFETCH","ON_DEMAND")
+    chosen=.array~new
+    do elementId over selectedState[tier || "_ELEMENTS"]
+      candidates=.array~new
+      do d over compiledPackage~definitions
+        if d["profile"] \= scenario~profile then iterate
+        if d["semanticElementRef"]["id"] = elementId then candidates~append(d)
+      end
+      if candidates~items=0 then iterate
+      picked=.nil
+      if candidates~items=1 then picked=candidates[1]
+      else do
+        matchingExperiment=.nil
+        matches=0
+        do e over compiledPackage~experiments
+          if e["targetElementId"]=elementId then do; matchingExperiment=e; matches+=1; end
+        end
+        if matches \= 1 then return .WireUIDesignResult~failure("PREVIEW_PROJECTION_AMBIGUOUS",scenario~profile"|"elementId)
+        variant=self~resolveVariant(matchingExperiment,scenario)
+        if variant==.nil then return .WireUIDesignResult~failure("PREVIEW_VARIANT_NOT_RESOLVED",matchingExperiment["experimentId"])
+        pr=variant["projectionRef"]
+        do d over candidates
+          rr=d["projectionRef"]
+          if rr["id"]=pr~artifactId then if rr["version"]=pr~version then if rr["contentAddress"]=pr~contentAddress then do; picked=d; leave; end
+        end
+        if picked==.nil then return .WireUIDesignResult~failure("PREVIEW_VARIANT_DEFINITION_MISSING",matchingExperiment["experimentId"])
+        resolved[matchingExperiment["experimentId"]]=variant["variantId"]
+      end
+      er=picked["semanticElementRef"]
+      element=workspace~artifact(er["kind"],er["id"],er["version"])
+      policy=element~audiencePolicyRef~translate
+      allowed=(policy="PUBLIC") | (policy="AUTHENTICATED" & scenario~authenticated)
+      if allowed then chosen~append(picked)
+    end
+    m[tier || "Definitions"]=chosen
+  end
+
+  m["resolvedExperiments"]=resolved
+  compositions=.array~new
+  do c over compiledPackage~compositions
+    if c["profile"]=scenario~profile then if c["stateId"]=scenario~journeyState then compositions~append(c)
+  end
+  m["compositions"]=compositions
+  m["previewContract"]=compiledPackage~previewContract
+  m["manifestContentAddress"]=.WireUIDesignUtil~token(.WireUIDesignUtil~canonicalTable(m))
+  return .WireUIDesignResult~success(m)
+
+::method compositionHints private
+  use arg workspace, refs, projection
+  out=.array~new
+  do rr over refs
+    if rr~kind<>"COMPOSITION" then iterate
+    c=workspace~artifact(rr~kind,rr~artifactId,rr~version)
+    if c~profile<>projection~profile then iterate
+    placements=c~placementsFor(projection~elementRef~artifactId,projection~projectionId)
+    do placement over placements
+      h=.table~new; h["compositionRef"]=c~ref~asWire; h["journeyRef"]=c~journeyRef~asWire
+      h["stateId"]=c~stateId; h["layoutModel"]=c~layoutModel; h["placement"]=placement
+      out~append(h)
+    end
+  end
+  return out
+
+::method resolveVariant private
+  use arg experiment, scenario
+  requested=scenario~assignments
+  expId=experiment["experimentId"]
+  if requested~hasIndex(expId) then do
+    wanted=requested[expId]
+    do v over experiment["variants"]; if v["variantId"]=wanted then return v; end
+    return .nil
+  end
+  total=0
+  do v over experiment["variants"]; total += v["weight"]; end
+  if total<=0 then return .nil
+  numeric digits 20
+  bucket=.WireUIDesignUtil~hashNumber(scenario~subjectId || "|" || experiment["experimentRef"]["contentAddress"]) // total
+  cursor=0
+  do v over experiment["variants"]
+    cursor += v["weight"]
+    if bucket < cursor then return v
+  end
+  return experiment["variants"][experiment["variants"]~items]
+::requires "WireUIDesignWorkspace.cls"
+::requires "WireUISiteRelease.cls"
+::requires "WireUICompiledPackage.cls"
+::requires "WireUIExperiment.cls"
+::requires "WireUIPreviewScenario.cls"
+::requires "WireUIJourneyDesign.cls"
+::requires "WireUIMaterialSet.cls"
+::requires "WireUIVisualComponent.cls"
+::requires "WireUISemanticElement.cls"
+
+::requires "WireUICompositionDesign.cls"
diff --git a/wire_ui_builder_v0.6/src/WireUICompositionDesign.cls b/wire_ui_builder_v0.6/src/WireUICompositionDesign.cls
new file mode 100644
index 0000000000000000000000000000000000000000..fce476b741d9cd4fd7385fcbb2fa34857746b19b
--- /dev/null
+++ b/wire_ui_builder_v0.6/src/WireUICompositionDesign.cls
@@ -0,0 +1,105 @@
+/*
+  Versioned semantic composition for one journey state and interaction profile.
+
+  Composition is deliberately element-centric. A placement normally names a
+  semantic element, so experiment variants can swap projections without
+  silently changing layout. An optional projectionId narrows a placement when
+  a variant genuinely needs a different arrangement.
+
+  Layout values are semantic renderer hints (GRID12/FLOW, region/order/span),
+  not arbitrary CSS and not DOM selectors.
+*/
+::class WireUICompositionDesign subclass AlchemyObject public
+::attribute compositionId get
+::attribute version get
+::attribute journeyRef get
+::attribute profile get
+::attribute stateId get
+::attribute layoutModel get
+::attribute contentAddress get
+::method init
+  expose compositionId version journeyRef profile stateId layoutModel placements metadata contentAddress
+  use arg compositionId, version, journeyRef, profile, stateId, layoutModel="GRID12", placementRows=.nil, metadata=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Versioned semantic layout composition"))
+  compositionId=compositionId~string~strip; version=version~string~strip
+  profile=profile~string~strip~translate; stateId=stateId~string~strip
+  layoutModel=layoutModel~string~strip~translate
+  if compositionId="" | version="" | profile="" | stateId="" then raise syntax 93.906 array("composition",compositionId)
+  if \journeyRef~isA(.WireUIArtifactRef) | journeyRef~kind<>"JOURNEY" then raise syntax 93.948 array("composition journeyRef")
+  if \(.set~of("GRID12","FLOW")~hasIndex(layoutModel)) then raise syntax 93.914 array("layoutModel",layoutModel)
+  placements=.array~new
+  if placementRows<>.nil then do row over placementRows
+    placements~append(self~normalisePlacement(row))
+  end
+  if placements~items=0 then raise syntax 93.906 array("composition placements",compositionId)
+  metadata=.WireUIDesignUtil~copyTable(metadata)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("compositionId","PUBLIC","stable semantic composition identity")
+  self~registerStateVariable("version","PUBLIC","immutable semantic composition version")
+  self~registerStateVariable("profile","PUBLIC","interaction profile composed")
+  self~registerStateVariable("stateId","PUBLIC","journey state composed")
+
+::method normalisePlacement private
+  use arg source
+  if source==.nil | \(source~isA(.Table) | source~isA(.Directory)) then raise syntax 93.948 array("composition placement")
+  d=.table~new
+  elementId=self~field(source,"elementId","")~string~strip
+  if elementId="" then raise syntax 93.906 array("placement elementId")
+  d["elementId"]=elementId
+  d["projectionId"]=self~field(source,"projectionId","")~string~strip
+  d["viewportClass"]=self~field(source,"viewportClass","DEFAULT")~string~strip~translate
+  if d["viewportClass"]="" then d["viewportClass"]="DEFAULT"
+  if \(.set~of("DEFAULT","SMALL","MEDIUM","LARGE")~hasIndex(d["viewportClass"])) then raise syntax 93.914 array("viewportClass",d["viewportClass"])
+  d["region"]=self~field(source,"region","main")~string~strip
+  if d["region"]="" then d["region"]="main"
+  d["order"]=self~whole(self~field(source,"order",0),0,"order")
+  d["span"]=self~whole(self~field(source,"span",12),1,"span")
+  if d["span"]>12 then raise syntax 93.914 array("span",d["span"])
+  d["rowSpan"]=self~whole(self~field(source,"rowSpan",1),1,"rowSpan")
+  d["align"]=self~field(source,"align","STRETCH")~string~strip~translate
+  if \(.set~of("START","CENTER","END","STRETCH")~hasIndex(d["align"])) then raise syntax 93.914 array("align",d["align"])
+  return d
+
+::method whole private
+  use arg value, minimum, label
+  n=value
+  if \n~datatype("N") then raise syntax 93.914 array(label,value)
+  if n<>n~trunc | n<minimum then raise syntax 93.914 array(label,value)
+  return n
+
+::method field private
+  use arg t,k,default=.nil
+  if t<>.nil then if t~hasIndex(k) then return t[k]
+  return default
+
+::method placements
+  expose placements
+  a=.array~new; do row over placements; a~append(.WireUIDesignUtil~copyTable(row)); end; return a
+
+::method placementsFor
+  expose placements
+  use arg elementId, projectionId=""
+  out=.array~new
+  do row over placements
+    if row["elementId"]<>elementId then iterate
+    if projectionId<>"" then if row["projectionId"]<>"" then if row["projectionId"]<>projectionId then iterate
+    out~append(.WireUIDesignUtil~copyTable(row))
+  end
+  return out
+
+::method canonicalText
+  expose compositionId version journeyRef profile stateId layoutModel placements metadata
+  return compositionId"|"version"|"journeyRef~canonicalText"|"profile"|"stateId"|"layoutModel"|".WireUIDesignUtil~canonicalArray(placements)"|".WireUIDesignUtil~canonicalTable(metadata)
+
+::method ref
+  expose compositionId version contentAddress
+  return .WireUIArtifactRef~new("COMPOSITION",compositionId,version,contentAddress)
+
+::method asWire
+  expose compositionId version journeyRef profile stateId layoutModel placements metadata contentAddress
+  d=.table~new; d["compositionId"]=compositionId; d["version"]=version; d["journeyRef"]=journeyRef~asWire
+  d["profile"]=profile; d["stateId"]=stateId; d["layoutModel"]=layoutModel
+  pp=.array~new; do row over placements; pp~append(.WireUIDesignUtil~copyTable(row)); end; d["placements"]=pp
+  d["metadata"]=.WireUIDesignUtil~copyTable(metadata); d["contentAddress"]=contentAddress
+  return d
+::requires "WireUIDesignSupport.cls"
diff --git a/wire_ui_builder_v0.6/src/WireUIDesignAssessment.cls b/wire_ui_builder_v0.6/src/WireUIDesignAssessment.cls
new file mode 100644
index 0000000000000000000000000000000000000000..972882947d4ec504fde812c0ff552735f7a6e0b9
--- /dev/null
+++ b/wire_ui_builder_v0.6/src/WireUIDesignAssessment.cls
@@ -0,0 +1,30 @@
+/* Evidence-backed assessment is deliberately separate from measured render facts. */
+::class WireUIDesignAssessment subclass AlchemyObject public
+::attribute assessmentId get
+::attribute version get
+::attribute classification get
+::attribute severity get
+::attribute confidence get
+::attribute finding get
+::attribute evidenceRef get
+::attribute contentAddress get
+::method init
+  expose assessmentId version classification severity confidence finding evidenceRef facts affectedRefs proposedVerbs contentAddress
+  use arg assessmentId, version, classification, severity, confidence, finding, evidenceRef, facts=.nil, affectedRefs=.nil, proposedVerbs=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Evidence-backed human/AI Wire UI design assessment"))
+  assessmentId=assessmentId~string~strip; version=version~string~strip; classification=classification~string~strip~translate; severity=severity~string~strip~translate; finding=finding~string~strip
+  if assessmentId="" | version="" | classification="" | severity="" | finding="" | confidence<0 | confidence>1 then raise syntax 93.906 array("design assessment",assessmentId)
+  if \evidenceRef~isA(.WireUIArtifactRef) then raise syntax 93.948 array("evidenceRef")
+  facts=.WireUIDesignUtil~copyTable(facts); affectedRefs=.WireUIDesignUtil~copyArray(affectedRefs); proposedVerbs=.WireUIDesignUtil~copyArray(proposedVerbs)
+  contentAddress=.WireUIDesignUtil~strongToken(self~canonicalText)
+::method canonicalText
+  expose assessmentId version classification severity confidence finding evidenceRef facts affectedRefs proposedVerbs
+  return assessmentId"|"version"|"classification"|"severity"|"confidence"|"finding"|"evidenceRef~canonicalText"|".WireUIDesignUtil~canonicalTable(facts)"|".WireUIDesignUtil~canonicalArray(affectedRefs)"|".WireUIDesignUtil~canonicalArray(proposedVerbs)
+::method ref
+  expose assessmentId version contentAddress
+  return .WireUIArtifactRef~new("DESIGN_ASSESSMENT",assessmentId,version,contentAddress)
+::method asWire
+  expose assessmentId version classification severity confidence finding evidenceRef facts affectedRefs proposedVerbs contentAddress
+  d=.table~new; d["assessmentId"]=assessmentId; d["version"]=version; d["classification"]=classification; d["severity"]=severity; d["confidence"]=confidence; d["finding"]=finding; d["evidenceRef"]=evidenceRef~asWire; d["facts"]=.WireUIDesignUtil~copyTable(facts)
