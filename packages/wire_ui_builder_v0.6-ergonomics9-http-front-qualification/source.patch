diff --git a/wire_ui_builder_v0.6/tests/test_resource_bridge.rex b/wire_ui_builder_v0.6/tests/test_resource_bridge.rex
new file mode 100644
index 0000000000000000000000000000000000000000..d6cac5ab504cb80b1a38b1de4fe37db5d65323c6
--- /dev/null
+++ b/wire_ui_builder_v0.6/tests/test_resource_bridge.rex
@@ -0,0 +1,40 @@
+/* Requires current RC executable-tree source on REXX_PATH. */
+root=.RcNode~new("app","Application")~assignUid("root")
+dlg=.RcNode~new("IDD_CUSTOMER","Dialog")~assignUid("root/r1")
+static1=.RcNode~new("IDC_STATIC","control",props("LTEXT"))~assignUid("root/r1/e1")
+static2=.RcNode~new("IDC_STATIC","control",props("LTEXT"))~assignUid("root/r1/e2")
+edit=.RcNode~new("IDC_NAME","control",props("EDITTEXT"))~assignUid("root/r1/e3")
+button=.RcNode~new("IDC_SAVE","Button")~assignUid("root/r1/e4")
+root~append(dlg); dlg~append(static1); dlg~append(static2); dlg~append(edit); dlg~append(button)
+handler=.RcCountingHandler~new
+root~registerHandler("saveCustomer",handler)
+button~bind("click","saveCustomer")
+
+importResult=.WireUIResourceBridge~importTree(root,"1")
+if importResult~elements~items<>6 then exit 1
+if importResult~triggerCount<>1 then exit 2
+if importResult~byResourceUid~items<>6 then exit 3
+if importResult~byResourceUid["root/r1/e1"]~elementId=importResult~byResourceUid["root/r1/e2"]~elementId then exit 4
+if importResult~byResourceUid["root/r1/e3"]~semanticType<>"TEXT_FIELD" then exit 5
+if importResult~byResourceUid["root/r1/e4"]~semanticType<>"ACTION_BUTTON" then exit 6
+wire=importResult~byResourceUid["root/r1/e4"]~asWire
+if wire["actions"]~items<>1 then exit 7
+if wire["actions"][1]<>"RESOURCE.EVENT.CLICK" then exit 8
+meta=wire["metadata"]
+if meta["resourceId"]<>"IDC_SAVE" then exit 9
+if meta["resourceUid"]<>"root/r1/e4" then exit 10
+if meta["resourceTriggerBindings"]~items<>1 then exit 11
+binding=meta["resourceTriggerBindings"][1]
+if binding["handlerNames"][1]<>"saveCustomer" then exit 12
+if meta["nativeHandlePolicy"]<>"NOT_IMPORTED" then exit 13
+say "PASS resource executable tree -> Wire semantic elements + trigger bindings"
+exit 0
+
+::routine props
+  use strict arg controlType
+  p=.directory~new
+  p["controlType"]=controlType
+  return p
+
+::requires "RcExecutableTree.cls"
+::requires "WireUIResourceBridge.cls"
diff --git a/wire_ui_builder_v0.6/tests/test_semantic_source_control.sh b/wire_ui_builder_v0.6/tests/test_semantic_source_control.sh
new file mode 100755
index 0000000000000000000000000000000000000000..50aec380267210a712c990837cc60e07ae04e27e
--- /dev/null
+++ b/wire_ui_builder_v0.6/tests/test_semantic_source_control.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+: "${SSC_ROOT:?set SSC_ROOT to oorexx_semantic_source_control_v0.2.2 or compatible}"
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+OUT="$TMP/scan.txt"
+"$SSC_ROOT/bin/osc" scan "$ROOT" --repo "$TMP/repo" --component WireUIBuilder >"$OUT"
+grep -q '^SCAN COMPLETE$' "$OUT"
+expected="$(find "$ROOT" -type f | wc -l | tr -d ' ')"
+actual="$(sed -n 's/^files= *\([0-9][0-9]*\).*/\1/p' "$OUT")"
+methods="$(sed -n 's/.*methods= *\([0-9][0-9]*\).*/\1/p' "$OUT")"
+attributes="$(sed -n 's/.*attributes= *\([0-9][0-9]*\).*/\1/p' "$OUT")"
+constants="$(sed -n 's/.*constants= *\([0-9][0-9]*\).*/\1/p' "$OUT")"
+[[ "$actual" == "$expected" ]]
+[[ "$methods" -ge 180 ]]
+[[ "$attributes" -ge 120 ]]
+[[ "$constants" -ge 2 ]]
+echo "PASS test_semantic_source_control releaseFiles=$actual methods=$methods attributes=$attributes constants=$constants"
