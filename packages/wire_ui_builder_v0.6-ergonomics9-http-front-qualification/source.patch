diff --git a/wire_ui_builder_v0.6/tools/capture_http_front_contract.sh b/wire_ui_builder_v0.6/tools/capture_http_front_contract.sh
new file mode 100755
index 0000000000000000000000000000000000000000..9fa1d1ac88d259e95a1c8c7db383712fe81db845
--- /dev/null
+++ b/wire_ui_builder_v0.6/tools/capture_http_front_contract.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+BASE=${1:?usage: capture_http_front_contract.sh BASE_URL OUTPUT_DIR [SITE_ROOT]}
+OUT=${2:?usage: capture_http_front_contract.sh BASE_URL OUTPUT_DIR [SITE_ROOT]}
+SITE_ROOT=${3:-}
+BASE=${BASE%/}
+mkdir -p "$OUT/bodies" "$OUT/headers"
+paths=(
+  /web/index.html
+  /web/builder.css
+  /web/builder-wire-ui.js
+  /web/composition-controller.js
+  /web/bootstrap-config.js
+  /web/session-readiness.js
+  /wire-ui/bootstrap
+)
+: > "$OUT/http.sha256"
+for path in "${paths[@]}"; do
+  safe=$(printf '%s' "$path" | sed 's#^/##;s#/#__#g')
+  curl --noproxy '*' -fsS -D "$OUT/headers/$safe.headers" "$BASE$path" -o "$OUT/bodies/$safe.body"
+  sha256sum "$OUT/bodies/$safe.body" | sed "s#  .*#  $path#" >> "$OUT/http.sha256"
+done
+python3 - "$OUT/bodies/wire-ui__bootstrap.body" "$OUT/bootstrap.normalized.json" <<'PY'
+import json,sys
+src,dst=sys.argv[1:]
+with open(src,'r',encoding='utf-8') as f: v=json.load(f)
+with open(dst,'w',encoding='utf-8') as f: json.dump(v,f,sort_keys=True,separators=(',',':')); f.write('\n')
+PY
+sha256sum "$OUT/bootstrap.normalized.json" > "$OUT/bootstrap.sha256"
+if [[ -n "$SITE_ROOT" ]]; then
+  (cd "$SITE_ROOT" && find web runtime -type f -print0 2>/dev/null | sort -z | xargs -0 sha256sum) > "$OUT/site-tree.sha256"
+fi
+printf 'Captured HTTP front contract from %s\n' "$BASE"
+cat "$OUT/http.sha256"
diff --git a/wire_ui_builder_v0.6/tools/compare_http_front_contract.sh b/wire_ui_builder_v0.6/tools/compare_http_front_contract.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6cceb5ed5bd77cc463fc1485dd85036d9fb6492d
--- /dev/null
+++ b/wire_ui_builder_v0.6/tools/compare_http_front_contract.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -euo pipefail
+A=${1:?usage: compare_http_front_contract.sh CAPTURE_A CAPTURE_B}
+B=${2:?usage: compare_http_front_contract.sh CAPTURE_A CAPTURE_B}
+rc=0
+for name in http.sha256 bootstrap.normalized.json site-tree.sha256; do
+  if [[ -f "$A/$name" || -f "$B/$name" ]]; then
+    if [[ ! -f "$A/$name" || ! -f "$B/$name" ]]; then
+      printf 'DIFF %s (missing on one side)\n' "$name" >&2; rc=1
+    elif ! diff -u "$A/$name" "$B/$name"; then
+      printf 'DIFF %s\n' "$name" >&2; rc=1
+    else
+      printf 'MATCH %s\n' "$name"
+    fi
+  fi
+done
+exit "$rc"
diff --git a/wire_ui_builder_v0.6/web/bootstrap-config.js b/wire_ui_builder_v0.6/web/bootstrap-config.js
new file mode 100644
index 0000000000000000000000000000000000000000..e8e1574f0133d5335d7cca74659ff32071857b22
--- /dev/null
+++ b/wire_ui_builder_v0.6/web/bootstrap-config.js
@@ -0,0 +1,15 @@
+export function parseBootstrapSeed(text) {
+  const value=JSON.parse(text||'{}');
+  if(!value||typeof value!=='object'||Array.isArray(value)) throw new TypeError('Wire UI Builder bootstrap seed must be an object');
+  return value;
+}
+export async function loadWireUIBootstrap(seed,fetchImpl=globalThis.fetch){
+  if(!seed||typeof seed!=='object'||Array.isArray(seed)) throw new TypeError('Wire UI Builder bootstrap seed must be an object');
+  if(!seed.bootstrapUrl) return Object.freeze({...seed});
+  if(typeof fetchImpl!=='function') throw new Error('fetch is required for Builder bootstrap URL');
+  const response=await fetchImpl(String(seed.bootstrapUrl),{method:'GET',credentials:'same-origin',cache:'no-store',headers:{accept:'application/json'}});
+  if(!response?.ok) throw new Error(`Wire UI Builder bootstrap request failed (${response?.status??'network'})`);
+  const value=await response.json();
+  if(!value||typeof value!=='object'||Array.isArray(value)) throw new Error('Wire UI Builder bootstrap response must be an object');
+  return Object.freeze({...value});
+}
diff --git a/wire_ui_builder_v0.6/web/builder-wire-ui.js b/wire_ui_builder_v0.6/web/builder-wire-ui.js
new file mode 100644
index 0000000000000000000000000000000000000000..2bc2059f4991050e8186df1a638ff95b9a14d699
--- /dev/null
+++ b/wire_ui_builder_v0.6/web/builder-wire-ui.js
@@ -0,0 +1,34 @@
+import {BuilderCompositionController} from './composition-controller.js';
+import {parseBootstrapSeed,loadWireUIBootstrap} from './bootstrap-config.js';
+import {BuilderSessionReadiness} from './session-readiness.js';
+const statusNode=document.getElementById('wire-ui-connection');
+const mount=document.getElementById('wire-ui-root');
+const configNode=document.getElementById('wire-ui-builder-config');
+function status(text,state=''){statusNode.textContent=text;statusNode.dataset.state=state;}
+function requireConfig(config){
+  for(const name of ['moduleUrl','gatewayUrl','outboundQueue']) if(!config?.[name]) throw new Error(`Wire UI Builder bootstrap requires ${name}`);
+  for(const name of ['applicationId','sessionId','accessPointId']) if(!config?.ownership?.[name]) throw new Error(`Wire UI Builder bootstrap requires ownership.${name}`);
+  return config;
+}
+async function boot(){
+  const readiness=new BuilderSessionReadiness({status,mount}); readiness.start();
+  const seed=parseBootstrapSeed(configNode?.textContent||'{}');
+  const config=requireConfig(await loadWireUIBootstrap(seed));
+  const api=await import(config.moduleUrl);
+  const {QueueFabricGatewayTransport,Comms,DefinitionRegistry,BrowserRenderer,WireUIRuntime,RenderProfileController,WireUIJourneyController,ObservationPlan,LocalStorageDefinitionCache,MaterialController}=api;
+  const transport=new QueueFabricGatewayTransport({url:config.gatewayUrl,outboundQueue:config.outboundQueue,ownership:config.ownership,putResultMode:'required'});
+  const comms=new Comms({transport,source:config.ownership.accessPointId,destination:config.outboundQueue});
+  const definitions=new DefinitionRegistry();
+  const material=new MaterialController({comms,document});
+  const renderer=new BrowserRenderer({definitions,mount,document});
+  const definitionCache=new LocalStorageDefinitionCache({storage:globalThis.localStorage});
+  const profile=new RenderProfileController({comms,definitions,definitionCache,renderer,siteId:config.siteId??'WIRE_UI_BUILDER_STUDIO'});
+  const runtime=new WireUIRuntime({comms,definitions,renderer,serverSemantic:true,renderProfile:profile,ownership:config.ownership});
+  const journey=new WireUIJourneyController({comms,runtime}); new ObservationPlan({comms});
+  const composition=new BuilderCompositionController({comms,runtime,renderer,definitions,mount,journeyController:journey,ownership:config.ownership}); composition.start();
+  comms.onState((event)=>{if(event.type==='connected')readiness.noteTransportConnected();else if(event.type==='closed')readiness.noteClosed();else if(event.type==='sequence-gap')readiness.noteSynchronising();else if(event.type==='inbound-handler-error')readiness.noteError();});
+  await comms.connect(profile.helloPayload({accessPointId:config.ownership.accessPointId}));
+  readiness.noteRenderedView();
+  globalThis.__wireUIBuilder=Object.freeze({comms,runtime,renderer,definitions,profile,material,journey,composition,readiness});
+}
+boot().catch((error)=>{console.error('Wire UI Builder bootstrap failed',error);status('Unable to connect','error');mount.replaceChildren();const panel=document.createElement('section');panel.className='builder-bootstrap-error';panel.textContent='The Builder could not establish this authoring session.';mount.appendChild(panel);});
