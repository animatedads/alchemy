+  previewContract=.table~new; previewContract["requiresRenderedCapture"]=.true; previewContract["captureBindsReleaseContentAddress"]=.true; previewContract["captureBindsScenarioContentAddress"]=.true; previewContract["semanticManifestAvailable"]=.true
