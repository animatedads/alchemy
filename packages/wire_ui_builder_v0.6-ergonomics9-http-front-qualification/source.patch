+need=.set~of("NOTNOTES.NAVIGATE","NOTNOTES.SEARCH","NOTNOTES.FILTER","NOTNOTES.SORT","NOTNOTES.SELECT_VIEW","NOTNOTES.SELECT_DOCUMENT","NOTNOTES.OPEN_DOCUMENT","NOTNOTES.REFRESH_WINDOW","NOTNOTES.PRINT_DOCUMENT","NOTNOTES.SET_FIELD","NOTNOTES.SAVE_DOCUMENT","NOTNOTES.SAVE","NOTNOTES.LINK_DOCUMENT","NOTNOTES.UNLINK_DOCUMENT","NOTNOTES.SUBMIT","NOTNOTES.APPROVE","NOTNOTES.REJECT","NOTNOTES.LIST_REPORTS","NOTNOTES.RUN_REPORT","NOTNOTES.DESIGN_REPORT","NOTNOTES.EXPORT_REPORT","NOTNOTES.PRINT_REPORT","NOTNOTES.DESIGN_FORMAT","NOTNOTES.ALTER_FORMAT","NOTNOTES.COMPLETE_DOCUMENT","NOTNOTES.ADD_SUBVIEW","NOTNOTES.ADD_CALCULATION","NOTNOTES.DISCOVER_INTENTIONS","NOTNOTES.SUBMIT_TEXT","NOTNOTES.END_SESSION","NOTNOTES.SELECT_CLARIFICATION")
