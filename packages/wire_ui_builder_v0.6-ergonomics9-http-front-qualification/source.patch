+const docs = [
+  {key:'TR-0041',type:'TPS Report',title:'TPS Report TPS-2026-041',status:'PENDING APPROVAL',owner:'A. Morgan',updated:'08 Oct',tps:'TPS-2026-041',department:'Operations',cost:'£12,400',startsAt:'2026-10-15T09:30:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'},
+  {key:'TR-0039',type:'TPS Report Review',title:'Quarterly TPS review',status:'DRAFT',owner:'B. Smith',updated:'08 Oct',tps:'TPS-2026-039',department:'Management',cost:'£4,850',startsAt:'2026-10-15T13:00:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'},
+  {key:'PR-1002',type:'Purchase Request',title:'GPU build server',status:'PENDING APPROVAL',owner:'C. Patel',updated:'07 Oct',tps:'—',department:'Engineering',cost:'£4,200',startsAt:'2026-10-16T10:00:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'},
+  {key:'SEC-2001',type:'Security Review',title:'GPU build server security review',status:'PENDING APPROVAL',owner:'D. Jones',updated:'07 Oct',tps:'—',department:'Security',cost:'—',startsAt:'2026-10-16T14:30:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'},
+  {key:'REL-3001',type:'Release Authorization',title:'AI coding pilot release',status:'APPROVED',owner:'E. Chan',updated:'06 Oct',tps:'—',department:'Release',cost:'—',startsAt:'2026-10-17T09:00:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'},
+  {key:'SUP-001',type:'Approval Document',title:'Acme Components supplier onboarding',status:'APPROVED',owner:'F. Green',updated:'05 Oct',tps:'—',department:'Procurement',cost:'—',startsAt:'2026-10-17T11:00:00+01:00',timezone:'Europe/London',timeResolution:'UNIQUE'}
+];
+let selected = docs[0];
+const rows = document.getElementById('documentRows');
+const search = document.getElementById('searchInput');
+const statusFilter = document.getElementById('statusFilter');
+const activity = document.getElementById('activityFeed');
+
+function badgeClass(status){return status==='APPROVED'?'approved':status==='REJECTED'?'rejected':status==='DRAFT'?'draft':'pending'}
+function emit(action, detail={}){
+  const record={type:'UI_ACTION',action,detail,wireRef:detail.key||null,renderedRevision:1842,at:new Date().toISOString()};
+  const item=document.createElement('div'); item.className='activity-item';
+  item.innerHTML=`<strong>${action}</strong><span>${detail.key||detail.value||'semantic action'}</span><time>${new Date().toLocaleTimeString()}</time>`;
+  activity.prepend(item); while(activity.children.length>6) activity.lastElementChild.remove();
+  window.dispatchEvent(new CustomEvent('wire-preview-action',{detail:record}));
+  return record;
+}
+function renderDetail(){
+  document.getElementById('detailTitle').textContent=selected.title;
+  const status=document.getElementById('detailStatus'); status.textContent=selected.status; status.className=`badge ${badgeClass(selected.status)}`;
+  const fields=document.getElementById('detailFields'); fields.innerHTML='';
+  [['Key',selected.key],['Type',selected.type],['TPS number',selected.tps],['Owner',selected.owner],['Department',selected.department],['Cost',selected.cost]].forEach(([k,v])=>{const dt=document.createElement('dt');dt.textContent=k;const dd=document.createElement('dd');dd.textContent=v;fields.append(dt,dd)});
+  const temporal=document.getElementById('temporalValue');
+  const resolution=document.getElementById('temporalResolution');
+  if(temporal){temporal.textContent=new Intl.DateTimeFormat('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:selected.timezone}).format(new Date(selected.startsAt))}
+  if(resolution){resolution.textContent=`${selected.timeResolution} · ${selected.timezone}`;resolution.className=`status-pill ${selected.timeResolution==='UNIQUE'?'good':'warn'}`}
+}
+function filteredDocs(){
+  const q=search.value.trim().toLowerCase(); const st=statusFilter.value;
+  return docs.filter(d=>(!st||d.status===st)&&(!q||Object.values(d).some(v=>String(v).toLowerCase().includes(q))));
+}
+function renderRows(){
+  const visible=filteredDocs(); rows.innerHTML=''; document.getElementById('resultCount').textContent=visible.length;
+  visible.forEach(d=>{const tr=document.createElement('tr'); if(d.key===selected.key) tr.className='selected'; tr.tabIndex=0; tr.dataset.key=d.key;
+    tr.innerHTML=`<td><input type="checkbox" aria-label="Select ${d.key}"></td><td><strong>${d.key}</strong></td><td>${d.type}</td><td>${d.title}</td><td><span class="badge ${badgeClass(d.status)}">${d.status}</span></td><td>${d.owner}</td><td>${d.updated}</td>`;
+    const open=()=>{selected=d; emit('NOTNOTES.OPEN_DOCUMENT',{key:d.key}); renderRows(); renderDetail()}; tr.addEventListener('click',open); tr.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();open()}}); rows.append(tr)});
+}
+function semanticButton(target){const action=target.closest('[data-action]'); if(!action)return; emit(action.dataset.action,{key:selected?.key})}
+document.addEventListener('click',semanticButton);
+document.querySelectorAll('.rail-item').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.rail-item').forEach(x=>x.classList.remove('active'));b.classList.add('active');emit('NOTNOTES.NAVIGATE',{value:b.dataset.state});document.getElementById('viewTitle').textContent=b.querySelector('b').textContent}));
+search.addEventListener('input',()=>{emit('NOTNOTES.SEARCH',{value:search.value});renderRows()});statusFilter.addEventListener('change',()=>{emit('NOTNOTES.FILTER',{value:statusFilter.value});renderRows()});document.getElementById('sortControl').addEventListener('change',e=>emit('NOTNOTES.SORT',{value:e.target.value}));document.getElementById('viewSelect').addEventListener('change',e=>emit('NOTNOTES.SELECT_VIEW',{value:e.target.value}));document.getElementById('clearSearch').addEventListener('click',()=>{search.value='';renderRows();search.focus()});
+document.querySelectorAll('[data-dialog]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.dialog)?.showModal()));
+document.querySelectorAll('[data-prompt]').forEach(b=>b.addEventListener('click',()=>{document.getElementById('composerInput').value=b.dataset.prompt;document.getElementById('composerInput').focus()}));
+function send(){const input=document.getElementById('composerInput');const text=input.value.trim();if(!text)return;emit('NOTNOTES.DISCOVER_INTENTIONS',{value:'fresh-each-turn'});emit('NOTNOTES.SUBMIT_TEXT',{value:text});input.value=''}
+document.getElementById('sendButton').addEventListener('click',send);document.getElementById('composerInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}});
+renderRows();renderDetail();emit('NOTNOTES.REFRESH_WINDOW',{value:'initial-projection'});
