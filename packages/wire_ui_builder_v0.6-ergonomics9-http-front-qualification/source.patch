+}
+
+export function parseCollectionItemText(text='') {
+  const out=Object.create(null);
+  for(const part of String(text).split(' · ')) {
+    const at=part.indexOf(':');
+    if(at<=0) continue;
+    out[part.slice(0,at).trim()]=part.slice(at+1).trim();
+  }
+  return out;
+}
+
+export function nextRegion(current, observed=[]) {
+  const values=[...new Set([...observed,'main','secondary','sidebar','footer'].map((v)=>String(v??'').trim()).filter(Boolean))];
+  if(!values.length) return 'main';
+  const at=values.indexOf(String(current??''));
+  return values[(at+1+values.length)%values.length];
+}
+
+export function nextAlignment(current='STRETCH') {
+  const values=['STRETCH','START','CENTER','END'];
+  const at=values.indexOf(String(current??'STRETCH').toUpperCase());
+  return values[(at+1+values.length)%values.length];
+}
+
+
+export function spanForPointerResize(startSpan,startX,currentX,containerWidth) {
+  const width=Number(containerWidth);
+  const from=Number(startX);
+  const to=Number(currentX);
+  const initial=Math.max(1,Math.min(12,Math.trunc(Number(startSpan)||12)));
+  if(!Number.isFinite(width)||width<=0||!Number.isFinite(from)||!Number.isFinite(to)) return initial;
+  const columns=Math.round(((to-from)/width)*12);
+  return Math.max(1,Math.min(12,initial+columns));
+}
+
+export function parseLayoutSignature(value='') {
+  const out=[];
+  for(const chunk of String(value??'').split('|')) {
