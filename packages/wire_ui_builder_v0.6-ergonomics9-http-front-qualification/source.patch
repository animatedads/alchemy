@@ -0,0 +1,157 @@
+/*
+  Windows/resource executable-tree -> Wire semantic authoring bridge.
+
+  Resource objects remain authoritative for resource identity and their named
+  event bindings.  This bridge projects those facts into ordinary Wire semantic
+  elements; it never exposes HWND/WM_* mechanics and never evaluates RC/JSON as
+  executable source.
+*/
+::class WireUIResourceImportResult public
+::attribute rootUid get
+::attribute elements get
+::attribute byResourceUid get
+::attribute triggerCount get
+::method init
+  expose rootUid elements byResourceUid triggerCount
+  use strict arg rootUid, elements, byResourceUid, triggerCount
+
+::class WireUIResourceBridge public
+::method importTree class
+  use strict arg tree, version="1"
+  if tree==.nil then raise syntax 93.948 array("resource tree")
+  if \tree~hasMethod("UID") then raise syntax 93.948 array("resource tree uid")
+  if \tree~hasMethod("CHILDREN") then raise syntax 93.948 array("resource tree children")
+  elements=.array~new
+  byUid=.directory~new
+  counter=.array~of(0)
+  self~walk(tree,version,elements,byUid,counter)
+  return .WireUIResourceImportResult~new(tree~uid,elements,byUid,counter[1])
+
+::method walk class private
+  use strict arg node, version, elements, byUid, counter
+  wire=self~elementFor(node,version)
+  elements~append(wire)
+  byUid[node~uid]=wire
+  wireData=wire~asWire
+  counter[1]=counter[1]+wireData["actions"]~items
+  do child over node~children
+    self~walk(child,version,elements,byUid,counter)
+  end
+
+::method elementFor class private
+  use strict arg node, version
+  resourceId=node~id~string
+  resourceUid=node~uid~string
+  nodeType=node~nodeType~string
+  metadata=.table~new
+  metadata["sourceKind"]="WINDOWS_RESOURCE_EXECUTABLE_TREE"
+  metadata["resourceId"]=resourceId
+  metadata["resourceUid"]=resourceUid
+  metadata["resourceNodeType"]=nodeType
+  metadata["resourceProperties"]=self~copyMap(node~properties)
+  metadata["resourceIdentityPolicy"]="PROVENANCE_ONLY"
+  metadata["wireIdentityPolicy"]="WIRE_ELEMENT_AUTHORITATIVE_AFTER_IMPORT"
+  metadata["nativeHandlePolicy"]="NOT_IMPORTED"
+
+  triggers=.array~new
+  actions=.array~new
+  if node~hasMethod("BINDINGS") then do
+    bindings=node~bindings
+    names=bindings~allIndexes
+    names~sort
+    do eventName over names
+      action=self~wireAction(eventName)
+      actions~append(action)
+      binding=.table~new
+      binding["eventName"]=eventName~string
+      binding["wireAction"]=action
+      handlers=.array~new
+      do handlerName over bindings[eventName]
+        handlers~append(handlerName~string)
+      end
+      binding["handlerNames"]=handlers
+      binding["dispatchAuthority"]="RESOURCE_EXECUTABLE_TREE"+      triggers~append(binding)
+    end
+  end
+  metadata["resourceTriggerBindings"]=triggers
+
+  fields=.array~new
+  if resourceId<>"" then fields~append("RESOURCE_ID")
+  if resourceUid<>"" then fields~append("RESOURCE_UID")
+  semanticType=self~semanticType(nodeType,node~properties)
+  elementId=self~elementId(resourceId,resourceUid)
+  return .WireUISemanticElement~new(elementId,version,semanticType,fields,actions,"PUBLIC",metadata)
+
+::method semanticType class private
+  use strict arg nodeType, properties
+  kind=nodeType~string~translate
+  if kind="APPLICATION" then return "APP_SHELL"
+  if kind="DIALOG" | kind="DIALOGEX" then return "DIALOG"
+  if kind="BUTTON" then return "ACTION_BUTTON"
+  if kind="MENU" | kind="MENUEX" | kind="POPUP" then return "MENU"
+  if kind="MENUITEM" then return "MENU_ITEM"
+  if kind="ACCELERATOR" | kind="ACCELERATORS" then return "COMMAND_KEY_BINDING"
+  if kind="STRINGTABLE" then return "RESOURCE_DATA"
+  if kind="CONTROL" then do
+    controlType=self~property(properties,"controlType","")~string~translate
+    select
+      when controlType="EDITTEXT" then return "TEXT_FIELD"
+      when controlType="LTEXT" | controlType="CTEXT" | controlType="RTEXT" then return "LABEL"
+      when controlType="PUSHBUTTON" | controlType="DEFPUSHBUTTON" then return "ACTION_BUTTON"
+      when controlType="CHECKBOX" | controlType="AUTOCHECKBOX" | controlType="STATE3" | controlType="AUTO3STATE" then return "CHECKBOX"
+      when controlType="RADIOBUTTON" | controlType="AUTORADIOBUTTON" then return "RADIO_OPTION"
+      when controlType="COMBOBOX" then return "SELECT_FIELD"
+      when controlType="LISTBOX" then return "LIST_BOX"
+      when controlType="GROUPBOX" then return "GROUP_BOX"
+      when controlType="ICON" then return "IMAGE"
+      when controlType="SCROLLBAR" then return "SCROLL_BAR"
+      otherwise return "RESOURCE_CONTROL"
+    end
+  end
+  return "RESOURCE_"||self~safeToken(kind)
+
+::method wireAction class private
+  use strict arg eventName
+  return "RESOURCE.EVENT."||self~safeToken(eventName~string~translate)
+
+::method elementId class private
+  use strict arg resourceId, resourceUid
+  base=self~safeToken(resourceId)
+  if base="" then base="RESOURCE"
+  return "RC."||base||"."||.WireUIDesignUtil~token(resourceUid)
+
+::method safeToken class private
+  use strict arg value
+  source=value~string~translate
+  out=""
+  allowed="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
+  do i=1 to source~length
+    ch=source~substr(i,1)
+    if pos(ch,allowed)>0 then out||=ch
+    else out||="_"
+  end
+  do while pos("__",out)>0
+    out=out~changeStr("__","_")
+  end
+  return out~strip("B","_")
+
+::method copyMap class private
+  use strict arg source
+  out=.table~new
+  if source==.nil then return out
+  if \source~hasMethod("ALLINDEXES") then return out
+  do key over source~allIndexes
+    out[key]=source[key]
+  end
+  return out
+
+::method property class private
+  use strict arg source, key, default
+  if source==.nil then return default
+  if \source~hasMethod("HASINDEX") then return default
+  if source~hasIndex(key) then return source[key]
+  return default
+
+::requires "WireUISemanticElement.cls"
+::requires "WireUIDesignSupport.cls"
