@@ -0,0 +1,58 @@
+/*
+  Stable design-time requirement for a runtime-discovered intention capability.
+
+  This object deliberately does NOT contain a discovered provider, proposal,
+  confidence score, resolved slot value, feasibility result, or READY decision.
+  Those are runtime evidence and must be refreshed by the Intention Service.
+*/
+::class WireUIIntentionRequirement subclass AlchemyObject public
+::attribute bindingId get
+::attribute purposeRef get
+::attribute sphereRef get
+::attribute action get
+::attribute discoveryPolicy get
+::attribute readinessPolicy get
+::attribute refreshPoint get
+::attribute contentAddress get
+
+::method init
+  expose bindingId purposeRef sphereRef action discoveryPolicy readinessPolicy refreshPoint metadata contentAddress
+  use arg bindingId, purposeRef, sphereRef="", action="", discoveryPolicy="DYNAMIC", readinessPolicy="READY_REQUIRED", refreshPoint="BEFORE_OFFER_AND_DISPATCH", metadata=.nil
+  self~init:super(.WireUIDesignAlchemy~metadata("Dynamic intention capability requirement"))
+  bindingId=bindingId~string~strip
+  purposeRef=purposeRef~string~strip
+  sphereRef=sphereRef~string~strip
+  action=action~string~strip~translate
+  discoveryPolicy=discoveryPolicy~string~strip~translate
+  readinessPolicy=readinessPolicy~string~strip~translate
+  refreshPoint=refreshPoint~string~strip~translate
+  if bindingId="" | purposeRef="" | action="" then raise syntax 93.906 array("intention requirement",bindingId)
+  if discoveryPolicy<>"DYNAMIC" then raise syntax 93.906 array("intention discovery policy",discoveryPolicy)
+  if readinessPolicy<>"READY_REQUIRED" then raise syntax 93.906 array("intention readiness policy",readinessPolicy)
+  if \(.set~of("BEFORE_OFFER","BEFORE_DISPATCH","BEFORE_OFFER_AND_DISPATCH")~hasIndex(refreshPoint)) then raise syntax 93.906 array("intention refresh point",refreshPoint)
+  metadata=.WireUIDesignUtil~copyTable(metadata)
+  contentAddress=.WireUIDesignUtil~token(self~canonicalText)
+  self~registerStateVariable("bindingId","PUBLIC","stable design-time intention binding identity")
+  self~registerStateVariable("purposeRef","PUBLIC","provider-neutral intention purpose reference")
+  self~registerStateVariable("sphereRef","PUBLIC","optional intention sphere/domain reference")
+  self~registerStateVariable("action","PUBLIC","Wire UI semantic action gated by runtime intention readiness")
+
+::method canonicalText
+  expose bindingId purposeRef sphereRef action discoveryPolicy readinessPolicy refreshPoint metadata
+  return bindingId"|"purposeRef"|"sphereRef"|"action"|"discoveryPolicy"|"readinessPolicy"|"refreshPoint"|".WireUIDesignUtil~canonicalTable(metadata)
+
+::method asWire
+  expose bindingId purposeRef sphereRef action discoveryPolicy readinessPolicy refreshPoint metadata contentAddress
+  d=.table~new
+  d["bindingId"]=bindingId
+  d["purposeRef"]=purposeRef
+  d["sphereRef"]=sphereRef
+  d["action"]=action
+  d["discoveryPolicy"]=discoveryPolicy
+  d["readinessPolicy"]=readinessPolicy
+  d["refreshPoint"]=refreshPoint
+  d["metadata"]=.WireUIDesignUtil~copyTable(metadata)
+  d["contentAddress"]=contentAddress
+  return d
+
+::requires "WireUIDesignSupport.cls"
