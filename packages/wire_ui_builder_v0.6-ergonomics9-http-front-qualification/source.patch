+  d["definitions"]=.WireUIDesignUtil~copyArray(definitions); d["journeyPlans"]=.WireUIDesignUtil~copyArray(journeyPlans); d["experiments"]=.WireUIDesignUtil~copyArray(experiments); d["materials"]=.WireUIDesignUtil~copyArray(materials); d["compositions"]=.WireUIDesignUtil~copyArray(compositions); d["previewContract"]=.WireUIDesignUtil~copyTable(previewContract)
