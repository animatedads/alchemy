+    resize.addEventListener?.('keydown',(event)=>{
+      if(event?.key!=='ArrowLeft'&&event?.key!=='ArrowRight'&&event?.key!=='Home'&&event?.key!=='End') return;
+      event.preventDefault?.(); event.stopPropagation?.();
+      const current=Number(resize.getAttribute?.('aria-valuenow')??info.span??12)||12;
+      const span=event.key==='Home'?1:event.key==='End'?12:Math.max(1,Math.min(12,current+(event.key==='ArrowLeft'?-1:1)));
+      resize.setAttribute?.('aria-valuenow',String(span)); sendSpan(span);
+    });
+    tools.append(
+      resize,
+      action('↻','Move to next region',()=>{if(id&&instanceId)void this.runtime?.sendSemanticAction?.('DESIGN.COMPOSITION.RELOCATE',{instanceId,detail:{id,region:nextRegion(info.region,regions)}});}),
+      action('⇔','Cycle alignment',()=>{if(id&&instanceId)void this.runtime?.sendSemanticAction?.('DESIGN.COMPOSITION.ALIGN',{instanceId,detail:{id,align:nextAlignment(info.align)}});}),
+      action('⋮⋮','Drag to reorder',()=>{})
+    );
+    item.replaceChildren(main,tools);
+  }
+
+  #enhanceArtifactLibrary() {
+    const root=this.mount.querySelector?.('[data-wire-definition^="WUIB_ARTIFACT_LIBRARY@"]'); if(!root) return;
+    for(const item of [...(root.querySelectorAll?.('.wui-collection-item')??[])]) {
+      if(!item?.ownerDocument || item.dataset?.wireLibraryDecorated==='1') continue;
+      item.dataset.wireLibraryDecorated='1'; item.classList?.add?.('wui-builder-library-item');
+      const info=parseCollectionItemText(item.textContent??''); const d=item.ownerDocument;
+      const kind=d.createElement('span');kind.className='wui-builder-library-kind';kind.textContent=info.kind??'ARTIFACT';
+      const name=d.createElement('strong');name.textContent=info.artifactId??info.id??'Untitled';
+      const rev=d.createElement('span');rev.className='wui-builder-library-rev';rev.textContent=`r${info.draftRevision??'?'} · v${info.publishVersion??'?'}`;
+      const artifactId=info.artifactId??info.id??item.__wireActionDetail?.id??'';
+      if(item.dataset) item.dataset.wireArtifactId=artifactId;
+      item.addEventListener?.('click',()=>{
+        this.selectedArtifactId=artifactId;
+        const canvas=this.mount.querySelector?.('[data-wire-definition^="WUIB_COMPOSITION_CANVAS@"]');
+        const placements=[...(canvas?.querySelectorAll?.('.wui-collection-item')??[])];
+        const matching=placements.find((placement)=>placement.dataset?.wireElementId===artifactId);
+        if(matching?.dataset?.wirePlacementId) this.selectedPlacementId=matching.dataset.wirePlacementId;
+        this.#syncArtifactSelection(root);
+        this.#syncSelection(placements);
+      });
+      item.replaceChildren(kind,name,rev);
+    }
+    this.#syncArtifactSelection(root);
+  }
+
+  #syncArtifactSelection(root) {
+    for(const item of [...(root?.querySelectorAll?.('.wui-collection-item')??[])]) {
+      const artifactId=item.dataset?.wireArtifactId??item.__wireActionDetail?.id??'';
+      const selected=Boolean(this.selectedArtifactId&&artifactId===this.selectedArtifactId);
+      if(selected)item.classList?.add?.('wui-builder-library-selected');else item.classList?.remove?.('wui-builder-library-selected');
