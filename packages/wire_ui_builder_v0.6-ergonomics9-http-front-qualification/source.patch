@@ -0,0 +1,62 @@
+app=.FakeNotNotesApp~new
+semantic=.FakeSemanticProvider~new
+obs=.FakeObservationProvider~new
+port=.NotNotesWebProjectionPort~new(app,semantic,obs)
+s=port~project("All Documents","","D-1",0,10)
+if \s~hasIndex("observations") then do; say "FAIL observations missing"; exit 1; end
+if s["observations"]["source"]<>"instrumentation.mesh/0.1" then do; say "FAIL observation source"; exit 1; end
+fields=s["detail"]["fields"]
+if \fields[1]~hasIndex("semantics") then do; say "FAIL field semantics missing"; exit 1; end
+if fields[1]["semantics"]["semanticType"]<>"DATETIME" then do; say "FAIL datetime semantics"; exit 1; end
+if fields[1]["semantics"]["resolution"]<>"UNIQUE" then do; say "FAIL temporal resolution"; exit 1; end
+say "PASS optional temporal/instrumentation projection seams"
+exit 0
+
+::class FakeNotNotesApp public
+::method init
+  expose doc
+  doc=.FakeDoc~new
+::method query; use arg q; return .array~of(doc)
+::method allDocuments; expose doc; return .array~of(doc)
+::method viewDocuments; use arg v; expose doc; return .array~of(doc)
+::method select; use arg key; expose doc; return doc
+::method selected; expose doc; return doc
+::method userFormatNames; return .array~of("Meeting")
+::method reportDefinitionNames; return .array~new
+::method dependencyState; use arg d; return .directory~new
+
+::class FakeDoc public
+::attribute DocKey get
+::attribute documentId get
+::attribute formName get
+::attribute Title get
+::attribute ApprovalStatus get
+::attribute Risk get
+::attribute DependsOn get
+::attribute revision get
+::attribute Workflow get
+::method init
+  expose DocKey documentId formName Title ApprovalStatus Risk DependsOn revision Workflow
+  DocKey="D-1"; documentId="urn:notnotes:d-1"; formName="Meeting"; Title="Planning"; ApprovalStatus="DRAFT"; Risk="LOW"; DependsOn=""; revision=1; Workflow="DRAFT"
+::method fieldNames; return .array~of("StartsAt")
+::method field; use arg name; return "2026-10-15T09:30:00+01:00"
+
+::class FakeSemanticProvider public
+::method fieldSemantics
+  use arg document,name
+  d=.directory~new
+  d["semanticType"]="DATETIME"
+  d["timezone"]="Europe/London"
+  d["resolution"]="UNIQUE"
+  d["evidence"]="single-time-service.v1-draft"
+  return d
+
+::class FakeObservationProvider public
+::method snapshot
+  d=.directory~new
+  d["source"]="instrumentation.mesh/0.1"
+  d["freshness"]="CURRENT"
+  d["status"]="AVAILABLE"
+  return d
+
+::requires "NotNotesWebProjectionPort.cls"
diff --git a/wire_ui_builder_v0.6/tests/test_notnotes_web_preview.mjs b/wire_ui_builder_v0.6/tests/test_notnotes_web_preview.mjs
