{
  "schema": "alchemy.autobuild.integration/0.2",
  "package": {
    "name": "oorexx_social_media",
    "version": "0.1-dev7",
    "kind": "oorexx"
  },
  "working_directory": ".",
  "environment": {
    "set": {
      "REXX_PATH": "${PACKAGE_ROOT}/src"
    },
    "prepend_path": []
  },
  "tests": [
    {
      "name": "all-social-unit-tests",
      "argv": [
        "bash",
        "tests/run_all.sh"
      ],
      "timeout_seconds": 180
    }
  ],
  "publish": {
    "tree": {
      "source": ".",
      "path": "packages/oorexx_social_media_v0.1-dev7"
    }
  }
}
