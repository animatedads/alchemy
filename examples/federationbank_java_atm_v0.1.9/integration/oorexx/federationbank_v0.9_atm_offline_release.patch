+::method beginRelease
+  use arg authorityId, terminalId, customerId, releaseIdempotencyKey
+  rec = self~authority(authorityId)
+  if rec == .nil then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_UNKNOWN", authorityId)
+  if rec["terminalId"] <> terminalId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_TERMINAL_MISMATCH")
+  if rec["customerId"] <> customerId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_CUSTOMER_MISMATCH")
+  status = rec["status"]~string
+  existingKey = ""
+  if rec~hasIndex("releaseIdempotencyKey") then existingKey = rec["releaseIdempotencyKey"]~string
+  if status = "CONSUMED" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ALREADY_CONSUMED", authorityId)
+  if status = "RELEASED" then do
+    if existingKey = releaseIdempotencyKey~string then return .FederationBankResult~success(rec,"ATM_OFFLINE_AUTHORITY_RELEASE_REPLAY")
+    return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ALREADY_RELEASED", authorityId)
+  end
+  if status = "RELEASE_PENDING" then do
+    if existingKey = releaseIdempotencyKey~string then return .FederationBankResult~success(rec,"ATM_OFFLINE_AUTHORITY_RELEASE_RESUME")
+    return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_RELEASE_IN_PROGRESS", authorityId)
+  end
+  if status <> "ACTIVE" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_NOT_ACTIVE", status)
+  next = rec~copy
+  next["status"] = "RELEASE_PENDING"
+  next["releaseIdempotencyKey"] = releaseIdempotencyKey~string
+  next["releaseRequestedAt"] = .DateTime~new~utcIsoDate
+  return self~publish(next)
+::method markReleased
+  use arg authorityId, releaseIdempotencyKey
+  rec = self~authority(authorityId)
+  if rec == .nil then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_UNKNOWN", authorityId)
+  status = rec["status"]~string
+  existingKey = ""
+  if rec~hasIndex("releaseIdempotencyKey") then existingKey = rec["releaseIdempotencyKey"]~string
+  if status = "RELEASED" then do
+    if existingKey = releaseIdempotencyKey~string then return .FederationBankResult~success(rec,"already released")
+    return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ALREADY_RELEASED", authorityId)
+  end
+  if status <> "RELEASE_PENDING" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_RELEASE_STATE_INVALID", status)
+  if existingKey <> releaseIdempotencyKey~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_RELEASE_IDEMPOTENCY_MISMATCH", authorityId)
+  next = rec~copy
+  next["status"] = "RELEASED"
+  next["releasedAt"] = .DateTime~new~utcIsoDate
+  return self~publish(next)
