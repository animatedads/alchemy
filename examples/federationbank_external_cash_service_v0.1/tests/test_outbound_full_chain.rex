v=.FederationBankExternalCashMemoryVaultPort~new("IOM-DOUGLAS","VAULT-1","GBP",100000); s=.FBExtServiceTest~service(v); sh=.FBExtServiceTest~shipment("OUT1","OUTBOUND",30000); ignore=.FBExtServiceTest~submit(s,sh); r=.FBExtServiceTest~dispatch(s,sh); .FBExtServiceTest~assertEq("IN_TRANSIT",r~code); .FBExtServiceTest~assertEq(70000,v~expectedMinor); r=.FBExtServiceTest~receive(s,sh); .FBExtServiceTest~assertEq("COMPLETED",r~code); .FBExtServiceTest~assertEq(1,v~releaseCount); say "PASS: outbound external cash leaves branch custody before carrier/cash-centre completion"
::requires "TestSupport.cls"
