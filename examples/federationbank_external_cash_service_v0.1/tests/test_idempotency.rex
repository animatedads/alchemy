v=.FederationBankExternalCashMemoryVaultPort~new("IOM-DOUGLAS","VAULT-1","GBP",100000); s=.FBExtServiceTest~service(v); sh=.FBExtServiceTest~shipment("OUT2","OUTBOUND",10000); ignore=.FBExtServiceTest~submit(s,sh,"C1"); r=.FBExtServiceTest~submit(s,sh,"C1"); .FBExtServiceTest~assertEq("IDEMPOTENT_REPLAY",r~code); ignore=.FBExtServiceTest~dispatch(s,sh,"C2"); r=.FBExtServiceTest~dispatch(s,sh,"C2"); .FBExtServiceTest~assertEq("IDEMPOTENT_REPLAY",r~code); .FBExtServiceTest~assertEq(1,v~releaseCount); say "PASS: external cash commands are semantically idempotent"
::requires "TestSupport.cls"
