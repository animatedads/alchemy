root="/tmp/fbextcash-queue-"||random(10000,99999); address system "rm -rf '"root"'"
codec=.FederationBankExternalCashServicePersistenceSupport~newCodec; m=.ObjectQueueManager~new(root,codec,"queue-admin"); v=.FederationBankExternalCashMemoryVaultPort~new("IOM-DOUGLAS","VAULT-1","GBP",100000); s=.FBExtServiceTest~service(v); w=.FederationBankExternalCashQueueWorker~new(s,m,"FB.EXT.CMD","FB.EXT.EVT","fb-external-cash-service","queue-admin","PERMANENT"); .FBExtServiceTest~assertTrue(w~install~ok); ignore=m~grant("FB.EXT.CMD","client",.QueueAccess~PUT,"queue-admin")
sh=.FBExtServiceTest~shipment("Q1","OUTBOUND",12000); p=.directory~new; p["shipment"]=sh; p["approval"]=.FBExtServiceTest~approval(sh); env=.FederationBankExternalCashServiceEnvelope~new("QCMD","FBEXTCASH.SHIPMENT.SUBMIT","STAFF-A","CASH",p,"CORR:Q1"); o=.table~new; o["persistent"]=.true; .FBExtServiceTest~assertTrue(m~put("FB.EXT.CMD",env,o,"client")~ok)
codec2=.FederationBankExternalCashServicePersistenceSupport~newCodec; m2=.ObjectQueueManager~new(root,codec2,"queue-admin"); v2=.FederationBankExternalCashMemoryVaultPort~new("IOM-DOUGLAS","VAULT-1","GBP",100000); s2=.FBExtServiceTest~service(v2); w2=.FederationBankExternalCashQueueWorker~new(s2,m2,"FB.EXT.CMD","FB.EXT.EVT","fb-external-cash-service","queue-admin","PERMANENT"); .FBExtServiceTest~assertTrue(w2~install~ok); r=w2~processOne; .FBExtServiceTest~assertTrue(r~ok); .FBExtServiceTest~assertEq("AUTHORISED",r~value~code); say "PASS: permanent Queue Fabric recovers typed External Cash shipment command"
::requires "FederationBankExternalCashServiceQueue.cls"
::requires "TestSupport.cls"
