v=.FederationBankExternalCashMemoryVaultPort~new("IOM-DOUGLAS","VAULT-1","GBP",100000); s=.FBExtServiceTest~service(v); sh=.FBExtServiceTest~shipment("IN2","INBOUND",20000); ignore=.FBExtServiceTest~submit(s,sh); ignore=.FBExtServiceTest~dispatch(s,sh); r=.FBExtServiceTest~receive(s,sh,19000); .FBExtServiceTest~assertEq("RECONCILIATION_REQUIRED",r~code); .FBExtServiceTest~assertEq(100000,v~expectedMinor); .FBExtServiceTest~assertEq(1,s~branchOutstandingCount("IOM-DOUGLAS","GBP")); say "PASS: manifest/count mismatch becomes explicit reconciliation work"
