bs=.FBExtBranchAdapterTest~branchService; sh=.FBExtBranchAdapterTest~shipment("FULL1","OUTBOUND",20000); au=.FBExtBranchAdapterTest~authority(sh); reg=.FBExtBranchAdapterTest~registryFor(bs,sh,au); port=.FederationBankExternalBranchCashVaultPort~new(bs,reg); svc=.FederationBankExternalCashService~new(.FederationBankExternalCashFixturePolicy~new,port); p=.directory~new; p["shipment"]=sh; p["approval"]=.FederationBankExternalCashApproval~new("APR:FULL",sh~semanticIdentity,"STAFF-B","STAFF-AUTH:B"); r=svc~handle(.FederationBankExternalCashServiceEnvelope~new("SUB","FBEXTCASH.SHIPMENT.SUBMIT","STAFF-A","CASH",p)); .FBExtBranchAdapterTest~assertEq("AUTHORISED",r~code); p=.directory~new; p["shipmentId"]=sh~shipmentId; r=svc~handle(.FederationBankExternalCashServiceEnvelope~new("DSP","FBEXTCASH.SHIPMENT.DISPATCH","STAFF-A","CASH",p)); .FBExtBranchAdapterTest~assertEq("IN_TRANSIT",r~code); .FBExtBranchAdapterTest~assertEq(80000,bs~state~vault("VAULT-1")~expectedMinor); rec=.FBExtBranchAdapterTest~receipt(sh); p["receipt"]=rec; r=svc~handle(.FederationBankExternalCashServiceEnvelope~new("RCV","FBEXTCASH.SHIPMENT.RECEIVE","CARRIER","CASH",p)); .FBExtBranchAdapterTest~assertEq("COMPLETED",r~code); say "PASS: External Cash service completes against real Branch Cash vault authority"
::requires "TestSupport.cls"
