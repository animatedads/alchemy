::constant RULES_V1_SIGNATURE_BASE64 "vTV+IEl58BpTq5jdLMV90wC+bsNu07kIPsptBcKLosqGp5d9GAYuYr+/CABOwvWSyXOAaOFD0kr2L/4CtkkuAg=="
