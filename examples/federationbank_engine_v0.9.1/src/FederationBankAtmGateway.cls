::method response private
  use arg req, ok, code, detail="", data=.nil
  if data==.nil then data=.directory~new
  d=.directory~new
  d["schema"]=.FederationBankAtmBuild~RESPONSE_SCHEMA
  d["commandId"]=req["commandId"]
  d["operation"]=req["operation"]
