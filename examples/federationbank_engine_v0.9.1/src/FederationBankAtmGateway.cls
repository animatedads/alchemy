/* Durable session facts contain no PIN/card secret.  A retained publication
 * lets a restarted gateway validate a recovery upload from an ATM journal. */
::class FederationBankAtmSessionAuthority public
::method init
  expose topics sessions credentials sessionSeconds
  use arg topicFabric, sessionSecondsArg = 600
  topics = topicFabric
  sessionSeconds = sessionSecondsArg + 0
  sessions = .directory~new
  credentials = .directory~new
  credentials["4111111111111111"] = .array~of("1234","CUST-001","Existing Customer")
  credentials["5555555555554444"] = .array~of("4321","CUST-002","Existing Australian Customer")
  self~rebuild
::method rebuild
  expose topics sessions
  if topics == .nil then return 0
  count = 0
  do publication over topics~retainedPublications
    if publication~topicName <> .FederationBankServiceTopology~ATM_SESSION_TOPIC then iterate
    p = publication~payload
    if p == .nil | \p~isA(.Directory) then iterate
    if p["schema"] <> "federationbank.atm.session/0.8" then iterate
    sessions[p["sessionId"]] = p
    count += 1
  end
  return count
::method publish private
  expose topics sessions
  use arg record
  sessions[record["sessionId"]] = record
  if topics == .nil then return .FederationBankResult~success(record)
  options=.table~new
  token=record["sessionId"]~string~changestr("/","_")~changestr(" ","_")
  options["subtopic"]="session/"||token
  options["retain"]=.true
  options["persistent"]=.true
  options["correlationId"]=record["sessionId"]
  r=topics~publish(.FederationBankServiceTopology~ATM_SESSION_TOPIC,record,options,.FederationBankServiceTopology~ATM_GATEWAY)
  if \r~ok then return .FederationBankResult~failure("ATM_SESSION_PERSIST_FAILED",r~code||":"||r~detail,r)
  return .FederationBankResult~success(record)
::method logon
  expose credentials sessionSeconds
  use arg cardId, credential, commandId, terminalId = ""
  card=cardId~string
  if \credentials~hasIndex(card) then return .FederationBankResult~failure("AUTHENTICATION_FAILED","card/PIN not accepted")
  c=credentials[card]
  if c[1] <> credential~string then return .FederationBankResult~failure("AUTHENTICATION_FAILED","card/PIN not accepted")
  now=.DateTime~new
  expires=now + .TimeSpan~new(0,0,sessionSeconds % 60,sessionSeconds // 60,0)
  rec=.directory~new
  rec["schema"]="federationbank.atm.session/0.8"
  rec["sessionId"]="SESSION-"||commandId~string
  rec["customerId"]=c[2]
  rec["customerDisplayName"]=c[3]
  rec["terminalId"]=terminalId~string
  rec["issuedAt"]=now~utcIsoDate
  rec["expiresAt"]=expires~utcIsoDate
  rec["status"]="ACTIVE"
  return self~publish(rec)
::method resolve
  expose sessions
  use arg sessionId, allowExpired = .false, terminalId = ""
  sid=sessionId~string
  if sid="" | \sessions~hasIndex(sid) then return .FederationBankResult~failure("SESSION_INVALID","logon required")
  rec=sessions[sid]
  if rec["status"] <> "ACTIVE" then return .FederationBankResult~failure("SESSION_INVALID","session is not active")
  if terminalId~string <> "" & rec["terminalId"]~string <> "" & rec["terminalId"]~string <> terminalId~string then return .FederationBankResult~failure("SESSION_TERMINAL_MISMATCH","customer session belongs to another terminal")
  if \allowExpired then do
    iso=rec["expiresAt"]~string; if iso~right(1)="Z" then iso=iso~left(iso~length-1)
    if .DateTime~new > .DateTime~fromIsoDate(iso) then return .FederationBankResult~failure("SESSION_EXPIRED","customer session expired")
  end
  return .FederationBankResult~success(rec)
::method resolveRecovery
  expose sessions
  use arg sessionId, terminalId = ""
  sid=sessionId~string
  if sid="" | \sessions~hasIndex(sid) then return .FederationBankResult~failure("SESSION_INVALID","recovery session not found")
  rec=sessions[sid]
  /* Physical-cash recovery is deliberately independent of an interactive
     session lifetime.  Only retained sessions which were once authenticated
     may be used, and terminal binding is still enforced.  Future explicit
     REVOKED/COMPROMISED states are not recovery-capable. */
  if rec["status"] <> "ACTIVE" & rec["status"] <> "LOGGED_OFF" then return .FederationBankResult~failure("SESSION_RECOVERY_NOT_ALLOWED",rec["status"])
  if terminalId~string <> "" & rec["terminalId"]~string <> "" & rec["terminalId"]~string <> terminalId~string then return .FederationBankResult~failure("SESSION_TERMINAL_MISMATCH","customer session belongs to another terminal")
  return .FederationBankResult~success(rec)
::method logoff
  use arg sessionId
  r=self~resolve(sessionId,.true)
  if \r~ok then return r
  rec=r~value~copy
  rec["status"]="LOGGED_OFF"
  rec["loggedOffAt"]=.DateTime~new~utcIsoDate
  return self~publish(rec)

/* Bank-issued offline authorities are durable retained facts.  They contain no
 * customer credential material.  v0.9 deliberately issues single-use
 * authority envelopes: either a Ledger-backed RESERVED_ALLOWANCE or a bounded
 * DELEGATED_STAND_IN risk authority. */
::class FederationBankAtmOfflineAuthorityService public
::constant DEFAULT_RECONCILIATION_WINDOW_SECONDS 86400
::constant DEFAULT_TERMINAL_CLOCK_SKEW_SECONDS 120
::method init
  expose topics authorities
  use arg topicFabric
  topics = topicFabric
  authorities = .directory~new
  self~rebuild
::method rebuild
  expose topics authorities
  authorities = .directory~new
  if topics == .nil then return 0
  count = 0
  do publication over topics~retainedPublications
    if publication~topicName <> .FederationBankServiceTopology~ATM_OFFLINE_AUTHORITY_TOPIC then iterate
    p = publication~payload
    if p == .nil | \p~isA(.Directory) then iterate
    if p["schema"] <> "federationbank.atm.offline-authority/0.9" then iterate
    authorities[p["offlineAuthorityId"]] = p
    count += 1
  end
  return count
::method publish private
  expose topics authorities
  use arg record
  authorities[record["offlineAuthorityId"]] = record
  if topics == .nil then return .FederationBankResult~success(record)
  options = .table~new
  token = record["offlineAuthorityId"]~string~changestr("/","_")~changestr(" ","_")
  options["subtopic"] = "authority/" || token
  options["retain"] = .true
  options["persistent"] = .true
  options["correlationId"] = record["offlineAuthorityId"]
  r = topics~publish(.FederationBankServiceTopology~ATM_OFFLINE_AUTHORITY_TOPIC, record, options, .FederationBankServiceTopology~ATM_GATEWAY)
  if \r~ok then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_PERSIST_FAILED", r~code || ":" || r~detail, r)
  return .FederationBankResult~success(record)
::method issue
  use arg authorityId, modeArg, terminalId, customerId, accountId, currencyArg, maxMinorArg, holdIdArg, rulesetId, rulesVersion, requestedAt, ttlSecondsArg = 600, decision = .nil, sessionIdArg = "", issuedTerminalSequenceArg = 0, reconciliationWindowSecondsArg = 86400, terminalClockSkewSecondsArg = 120
  mode = modeArg~string~upper; currency = currencyArg~string~upper; maxMinor = maxMinorArg + 0; ttlSeconds = ttlSecondsArg + 0
  reconciliationWindowSeconds = reconciliationWindowSecondsArg + 0; terminalClockSkewSeconds = terminalClockSkewSecondsArg + 0
  if authorityId~string = "" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ID_REQUIRED")
  if mode <> "RESERVED_ALLOWANCE" & mode <> "DELEGATED_STAND_IN" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_MODE_INVALID", mode)
  if maxMinor <= 0 then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_AMOUNT_INVALID", maxMinor)
  if mode = "RESERVED_ALLOWANCE" & holdIdArg~string = "" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_HOLD_REQUIRED")
  if reconciliationWindowSeconds <= 0 then return .FederationBankResult~failure("ATM_OFFLINE_RECONCILIATION_WINDOW_INVALID", reconciliationWindowSeconds)
  if terminalClockSkewSeconds < 0 then return .FederationBankResult~failure("ATM_OFFLINE_CLOCK_SKEW_INVALID", terminalClockSkewSeconds)
  issued = requestedAt
  if issued == .nil then issued = .DateTime~new
  expires = issued + .TimeSpan~new(0,0,ttlSeconds % 60,ttlSeconds // 60,0)
  rec = .directory~new
  rec["schema"] = "federationbank.atm.offline-authority/0.9"
  rec["offlineAuthorityId"] = authorityId~string
  rec["authorityMode"] = mode
  rec["terminalId"] = terminalId~string
  rec["customerId"] = customerId~string
  rec["accountId"] = accountId~string
  rec["currency"] = currency
  rec["maxAmountMinor"] = maxMinor
  rec["holdId"] = holdIdArg~string
  rec["rulesetId"] = rulesetId~string
  rec["rulesVersion"] = rulesVersion~string
  rec["sessionId"] = sessionIdArg~string
  rec["issuedTerminalSequence"] = issuedTerminalSequenceArg + 0
  rec["reconciliationWindowSeconds"] = reconciliationWindowSeconds
  rec["terminalClockSkewSeconds"] = terminalClockSkewSeconds
  rec["issuedAt"] = issued~utcIsoDate
  rec["expiresAt"] = expires~utcIsoDate
  rec["status"] = "ACTIVE"
  rec["singleUse"] = "true"
  if decision <> .nil & decision~isA(.Directory) then do k over .array~of("securityPolicyId","securityPolicyVersion","securityDisposition","corporatePolicyId","corporatePolicyVersion","corporatePolicyRuleId","legalProfileId","legalGenerationId","legalGenerationVersion","regulatoryProfileId")
    if decision~hasIndex(k) then rec[k] = decision[k]
  end
  return self~publish(rec)
::method authority
  expose authorities
  use arg authorityId
  if \authorities~hasIndex(authorityId~string) then return .nil
  return authorities[authorityId~string]
::method timeSpanSeconds private
  use arg secondsArg
  total = secondsArg + 0
  days = total % 86400
  rest = total // 86400
  hours = rest % 3600
  rest = rest // 3600
  minutes = rest % 60
  seconds = rest // 60
  return .TimeSpan~new(days,hours,minutes,seconds,0)
::method parseIso private
  use arg isoArg
  iso = isoArg~string
  if iso~right(1) = "Z" then iso = iso~left(iso~length - 1)
  return .DateTime~fromIsoDate(iso)
::method validateAdvice
  expose authorities
  use arg authorityId, terminalId, customerId, accountId, currencyArg, amountMinorArg, rulesetId, rulesVersion, adviceIdempotencyKey, physicalTransactionId, dispensedAtArg = "", presentedSessionId = "", adviceTerminalSequenceArg = 0, receivedAtArg = .nil
  id = authorityId~string
  if id = "" | \authorities~hasIndex(id) then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_UNKNOWN", id)
  rec = authorities[id]
  if rec["status"] = "CONSUMED" then do
    if rec["settlementIdempotencyKey"]~string = adviceIdempotencyKey~string & rec["physicalTransactionId"]~string = physicalTransactionId~string then return .FederationBankResult~new(.true,"ATM_OFFLINE_AUTHORITY_REPLAY","same physical cash advice replay",rec)
    return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ALREADY_CONSUMED", id)
  end
  if rec["status"] <> "ACTIVE" then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_NOT_ACTIVE", rec["status"])
  if rec["terminalId"] <> terminalId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_TERMINAL_MISMATCH")
  if rec["customerId"] <> customerId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_CUSTOMER_MISMATCH")
  if rec["accountId"] <> accountId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ACCOUNT_MISMATCH")
  if rec["currency"] <> currencyArg~string~upper then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_CURRENCY_MISMATCH")
  if rec["rulesetId"] <> rulesetId~string | rec["rulesVersion"] <> rulesVersion~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_RULESET_MISMATCH")
  if amountMinorArg + 0 <= 0 | amountMinorArg + 0 > rec["maxAmountMinor"] + 0 then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_AMOUNT_EXCEEDED", rec["maxAmountMinor"])
  if physicalTransactionId~string = "" then return .FederationBankResult~failure("ATM_OFFLINE_PHYSICAL_ID_REQUIRED")
  if rec~hasIndex("sessionId") & rec["sessionId"]~string <> "" then if rec["sessionId"]~string <> presentedSessionId~string then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_SESSION_MISMATCH")
  if rec~hasIndex("issuedTerminalSequence") & rec["issuedTerminalSequence"] + 0 > 0 then if adviceTerminalSequenceArg + 0 <= rec["issuedTerminalSequence"] + 0 then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_SEQUENCE_INVALID", adviceTerminalSequenceArg)

  signal on syntax name badEvidenceTime
  expires = self~parseIso(rec["expiresAt"])
  if receivedAtArg == .nil then receivedAt = .DateTime~new
  else receivedAt = receivedAtArg
  if receivedAt <= expires then do
    signal off syntax
    return .FederationBankResult~new(.true,"ATM_OFFLINE_AUTHORITY_CURRENT","authority is still current at reconciliation",rec)
  end

  /* Expiry prevents a new dispense.  It must not erase a physical cash fact
     which happened while the bank-issued authority was valid.  Delayed
     reconciliation is accepted only inside a bank-bounded evidence window. */
  if dispensedAtArg~string = "" then do
    signal off syntax
    return .FederationBankResult~failure("ATM_OFFLINE_PHYSICAL_TIME_REQUIRED", id)
  end
  issued = self~parseIso(rec["issuedAt"])
  dispensed = self~parseIso(dispensedAtArg)
  if rec~hasIndex("terminalClockSkewSeconds") then skewSeconds = rec["terminalClockSkewSeconds"] + 0
  else skewSeconds = self~DEFAULT_TERMINAL_CLOCK_SKEW_SECONDS
  if rec~hasIndex("reconciliationWindowSeconds") then windowSeconds = rec["reconciliationWindowSeconds"] + 0
  else windowSeconds = self~DEFAULT_RECONCILIATION_WINDOW_SECONDS
  skew = self~timeSpanSeconds(skewSeconds)
  earliest = issued - skew
  latest = expires + skew
  if dispensed < earliest | dispensed > latest then do
    signal off syntax
    return .FederationBankResult~failure("ATM_OFFLINE_DISPENSE_OUTSIDE_AUTHORITY", dispensedAtArg)
  end
  deadline = expires + self~timeSpanSeconds(windowSeconds)
  if receivedAt > deadline then do
    signal off syntax
    return .FederationBankResult~failure("ATM_OFFLINE_RECONCILIATION_WINDOW_EXPIRED", rec["expiresAt"])
  end
  signal off syntax
  return .FederationBankResult~new(.true,"ATM_OFFLINE_DELAYED_EVIDENCE_ACCEPTED","physical cash evidence occurred within bank-issued authority",rec)
badEvidenceTime:
  signal off syntax
  return .FederationBankResult~failure("ATM_OFFLINE_EVIDENCE_TIME_INVALID", id)
::method markConsumed
  use arg authorityId, adviceIdempotencyKey, physicalTransactionId, amountMinor, dispensedAt = "", evidenceDisposition = ""
  rec = self~authority(authorityId)
  if rec == .nil then return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_UNKNOWN", authorityId)
  if rec["status"] = "CONSUMED" then do
    if rec["settlementIdempotencyKey"]~string = adviceIdempotencyKey~string then return .FederationBankResult~success(rec, "already consumed")
    return .FederationBankResult~failure("ATM_OFFLINE_AUTHORITY_ALREADY_CONSUMED", authorityId)
  end
  next = rec~copy
  next["status"] = "CONSUMED"
  next["settlementIdempotencyKey"] = adviceIdempotencyKey~string
  next["physicalTransactionId"] = physicalTransactionId~string
  next["consumedMinor"] = amountMinor + 0
  if dispensedAt~string <> "" then next["dispensedAt"] = dispensedAt~string
  if evidenceDisposition~string <> "" then next["evidenceDisposition"] = evidenceDisposition~string
  next["consumedAt"] = .DateTime~new~utcIsoDate
  return self~publish(next)

::class FederationBankAtmGateway public
::method init
  expose topology runtime ledgerEngine sessions signer terminalState offlineAuthorities
  use arg topologyArg, runtimeArg, ledgerEngineArg, sessionAuthorityArg = .nil, signerArg = .nil, offlineAuthorityArg = .nil
  topology=topologyArg; runtime=runtimeArg; ledgerEngine=ledgerEngineArg
  if sessionAuthorityArg==.nil then sessions=.FederationBankAtmSessionAuthority~new(topology~topics)
  else sessions=sessionAuthorityArg
  if signerArg==.nil then signer=.FederationBankAtmRuleSigner~new
  else signer=signerArg
  if offlineAuthorityArg==.nil then offlineAuthorities=.FederationBankAtmOfflineAuthorityService~new(topology~topics)
  else offlineAuthorities=offlineAuthorityArg
  terminalState=.directory~new
::method signer
  expose signer
  return signer
::method sessions
  expose sessions
  return sessions
::method offlineAuthorities
  expose offlineAuthorities
  return offlineAuthorities
::method rules
  rules=.directory~new
  rules["schema"]=.FederationBankAtmBuild~RULES_SCHEMA
  rules["rulesetId"]=.FederationBankAtmBuild~RULESET_ID
  rules["version"]=.FederationBankAtmBuild~RULES_VERSION
  rules["issuedAt"]="2026-08-25T00:00:00Z"
  rules["validFrom"]="2026-08-25T00:00:00Z"
  rules["validUntil"]="2030-01-01T00:00:00Z"
  target=.directory~new; target["terminalId"]="*"; target["region"]="IOM"; rules["target"]=target
  online=.directory~new; online["balance"]=.JSON~true; online["withdrawal"]=.JSON~true; online["deposit"]=.JSON~true; rules["online"]=online
  offline=.directory~new; offline["balanceMode"]="CACHED_MARKED_STALE"; offline["withdrawalMode"]="DENY"; offline["depositMode"]="CAPTURE_AND_QUEUE"; rules["offline"]=offline
  limits=.directory~new; limits["maxWithdrawalMinor"]=50000; limits["maxDepositMinor"]=100000; limits["sessionTimeoutSeconds"]=600; rules["limits"]=limits
