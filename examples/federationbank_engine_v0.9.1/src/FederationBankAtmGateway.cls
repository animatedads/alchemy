::method failure private
  use arg req, resultOrCode, detail=""
  if resultOrCode~isA(.FederationBankResult) then return self~response(req,.false,resultOrCode~code,resultOrCode~detail)
  return self~response(req,.false,resultOrCode,detail)
::method data private
  use arg req
  if req~hasIndex("data") & req["data"]<>.nil & req["data"]~isA(.Directory) then return req["data"]
  return .directory~new
::method validateRequest private
  use arg req, message=.nil
  if req==.nil | \req~isA(.Directory) then return .FederationBankResult~failure("ATM_REQUEST_INVALID","JSON object required")
  do k over .array~of("schema","commandId","idempotencyKey","operation","terminalId","terminalSequence","sessionId","requestedAt","rulesetId","rulesVersion","data")
    if \req~hasIndex(k) then return .FederationBankResult~failure("ATM_REQUEST_FIELD_REQUIRED",k)
  end
  if req["schema"]<>.FederationBankAtmBuild~REQUEST_SCHEMA then return .FederationBankResult~failure("ATM_REQUEST_SCHEMA_INVALID",req["schema"])
  if req["commandId"]~string="" | req["idempotencyKey"]~string="" then return .FederationBankResult~failure("ATM_COMMAND_ID_REQUIRED")
  if req["terminalId"]~string="" then return .FederationBankResult~failure("ATM_TERMINAL_ID_REQUIRED")
  if message<>.nil then do
    if message~bodyType<>"TEXT" then return .FederationBankResult~failure("ATM_JMS_TEXT_REQUIRED")
    if message~headers~hasIndex("JMSCORRELATIONID") then if message~headers["JMSCORRELATIONID"]~string<>req["commandId"]~string then return .FederationBankResult~failure("ATM_CORRELATION_MISMATCH")
    props=message~properties
    if props~hasIndex("FB_ATM_SCHEMA") then if props["FB_ATM_SCHEMA"]~string<>req["schema"]~string then return .FederationBankResult~failure("ATM_JMS_SCHEMA_MISMATCH")
    if props~hasIndex("FB_ATM_OPERATION") then if props["FB_ATM_OPERATION"]~string<>req["operation"]~string then return .FederationBankResult~failure("ATM_JMS_OPERATION_MISMATCH")
    if props~hasIndex("FB_ATM_TERMINAL_ID") then if props["FB_ATM_TERMINAL_ID"]~string<>req["terminalId"]~string then return .FederationBankResult~failure("ATM_JMS_TERMINAL_MISMATCH")
    if props~hasIndex("FB_ATM_RULES_VERSION") then if props["FB_ATM_RULES_VERSION"]~string<>req["rulesVersion"]~string then return .FederationBankResult~failure("ATM_JMS_RULES_VERSION_MISMATCH")
  end
  return .FederationBankResult~success(req)
