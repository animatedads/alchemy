    if p["status"]<>"OPEN" then iterate
    a=.directory~new
    a["accountId"]=p["accountId"]
    a["displayName"]=p["productCode"]~string~changestr("_"," ")~lower
    a["productCode"]=p["productCode"]
    a["currency"]=p["currency"]
    a["status"]=p["status"]
    rows~append(a)
  end
  return rows
::method bankCommand private
  use arg req, operation, customerId, accountId, currency, amount, details=.nil
  iso=req["requestedAt"]~string; if iso~right(1)="Z" then iso=iso~left(iso~length-1)
  if details==.nil then details=.directory~new
  return .FederationBankCommand~new(req["commandId"],operation,req["idempotencyKey"],customerId,accountId,"",currency,amount,"ATM",req["terminalId"],.DateTime~fromIsoDate(iso),"","","","","","","","","RETAIL","STANDARD",details)
::method pumpPayment private
  expose runtime
  use arg command
  q=runtime~submitTransfer(command)
  if \q~ok then return .FederationBankResult~failure("ATM_BACKEND_SUBMIT_FAILED",q~code||":"||q~detail,q)
  a=runtime~processPaymentsOne
  if a~ok then do
    p=runtime~processLedgerOne
    c=runtime~processPaymentsCompletionOne
  end
  got=runtime~getPaymentsResult
  if \got~ok then return .FederationBankResult~failure("ATM_BACKEND_RESULT_MISSING",got~code||":"||got~detail,got)
  payload=got~value~payload
  if payload["ok"]~string~translate="TRUE" | payload["ok"]=.true | payload["ok"]~string="1" then return .FederationBankResult~success(payload,payload["code"],payload["detail"])
  return .FederationBankResult~failure(payload["code"],payload["detail"],payload)
::method pumpPaymentDecision private
  expose runtime
  use arg command
  q = runtime~submitTransfer(command)
  if \q~ok then return .FederationBankResult~failure("ATM_BACKEND_SUBMIT_FAILED", q~code || ":" || q~detail, q)
  a = runtime~processPaymentsOne
  if \a~ok then do
    got = runtime~getPaymentsResult
    if got~ok then do
      payload = got~value~payload
      return .FederationBankResult~failure(payload["code"], payload["detail"], payload)
    end
    return a
  end
  got = runtime~getPaymentsResult
  if \got~ok then return .FederationBankResult~failure("ATM_BACKEND_RESULT_MISSING", got~code || ":" || got~detail, got)
  payload = got~value~payload
  if payload["ok"]~string~translate = "TRUE" | payload["ok"] = .true | payload["ok"]~string = "1" then return .FederationBankResult~success(payload, payload["code"], payload["detail"])
  return .FederationBankResult~failure(payload["code"], payload["detail"], payload)

::method handleRequest
  expose sessions ledgerEngine terminalState offlineAuthorities
  use arg req
  checked=self~validateRequest(req)
  if \checked~ok then return self~response(req,.false,checked~code,checked~detail)
  op=req["operation"]~string~upper; d=self~data(req)
  select
    when op="TERMINAL_SIGN_ON" then do
      terminalState[req["terminalId"]]="ACTIVE"
      out=.directory~new; out["protocolVersion"]="0.1"; out["terminalStatus"]="ACTIVE"
      return self~response(req,.true,"TERMINAL_ACCEPTED","",out)
    end
    when op="GET_RULES" then return self~response(req,.true,"RULES_CURRENT","current signed ATM rules",self~signedRulesData)
    when op="LOGON" then do
      r=sessions~logon(d["cardId"],d["credential"],req["commandId"],req["terminalId"])
      if \r~ok then return self~failure(req,r)
      rec=r~value; out=.directory~new
      do k over .array~of("sessionId","customerId","customerDisplayName") ; out[k]=rec[k]; end
      out["sessionExpiresAt"]=rec["expiresAt"]
      return self~response(req,.true,"LOGON_ACCEPTED","",out)
    end
    when op="LOGOFF" then do
      r=sessions~logoff(req["sessionId"]); if \r~ok then return self~failure(req,r)
      return self~response(req,.true,"LOGOFF_ACCEPTED")
    end
    when op="LIST_ACCOUNTS" then do
      s=self~sessionFor(req); if \s~ok then return self~failure(req,s)
      out=.directory~new; out["accounts"]=self~accountList(s~value["customerId"])
      return self~response(req,.true,"ACCOUNTS_RETURNED","",out)
    end
    when op="GET_BALANCE" then do
      s=self~sessionFor(req); if \s~ok then return self~failure(req,s)
      r=ledgerEngine~queryBalance(s~value["customerId"],d["accountId"]); if \r~ok then return self~failure(req,r)
      return self~response(req,.true,"BALANCE_RETURNED","",r~value)
    end
    when op="GET_OFFLINE_ALLOWANCE" then do
      s=self~sessionFor(req); if \s~ok then return self~failure(req,s)
      mode=d["authorityMode"]~string~upper
      if mode<>"RESERVED_ALLOWANCE" & mode<>"DELEGATED_STAND_IN" then return self~response(req,.false,"OFFLINE_AUTHORITY_MODE_INVALID",mode)
      detail=.directory~new
      detail["terminalId"]=req["terminalId"]; detail["atmNetworkId"]=.FederationBankAtmBuild~NETWORK_ID; detail["rulesetId"]=req["rulesetId"]; detail["rulesVersion"]=req["rulesVersion"]; detail["authorityMode"]=mode
      c=self~bankCommand(req,"ATM_OFFLINE_AUTHORITY_ISSUE",s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],detail)
      decision=self~pumpPaymentDecision(c); if \decision~ok then return self~failure(req,decision)
      holdId=""
      if mode="RESERVED_ALLOWANCE" then do
        holdReq=req~copy; holdReq["commandId"]=req["commandId"]||"-HOLD"; holdReq["idempotencyKey"]=req["idempotencyKey"]||"-HOLD"
        holdId="ATM-OFFLINE-HOLD-"||req["idempotencyKey"]
        hd=.directory~new; hd["holdId"]=holdId
        hc=self~bankCommand(holdReq,"PLACE_HOLD",s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],hd)
        hr=self~pumpPayment(hc); if \hr~ok then return self~failure(req,hr)
      end
      authorityId="OFFAUTH-"||req["idempotencyKey"]
      issued=offlineAuthorities~issue(authorityId,mode,req["terminalId"],s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],holdId,req["rulesetId"],req["rulesVersion"],.DateTime~new,600,decision~value,req["sessionId"],req["terminalSequence"])
      if \issued~ok then return self~failure(req,issued)
      out=issued~value~copy
      if mode="RESERVED_ALLOWANCE" then code="OFFLINE_RESERVED_ALLOWANCE_ISSUED"
      else code="OFFLINE_STANDIN_AUTHORITY_ISSUED"
      return self~response(req,.true,code,"",out)
    end
    when op="WITHDRAW_AUTHORISE" then do
      s=self~sessionFor(req); if \s~ok then return self~failure(req,s)
      holdId="ATM-HOLD-"||req["idempotencyKey"]; authId="WDAUTH-"||req["idempotencyKey"]
      detail=.directory~new; detail["holdId"]=holdId
      c=self~bankCommand(req,"PLACE_HOLD",s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],detail)
      r=self~pumpPayment(c); if \r~ok then return self~failure(req,r)
      out=.directory~new; out["authorizationId"]=authId; out["holdId"]=holdId; out["amountMinor"]=d["amountMinor"]; out["currency"]=d["currency"]; out["expiresAt"]=(.DateTime~new+.TimeSpan~new(0,0,3,0,0))~utcIsoDate
      return self~response(req,.true,"WITHDRAW_AUTHORISED","",out)
    end
    when op="WITHDRAW_CANCEL" then do
      s=self~sessionFor(req,.true); if \s~ok then return self~failure(req,s)
      detail=.directory~new; detail["holdId"]=d["holdId"]
      c=self~bankCommand(req,"RELEASE_HOLD",s~value["customerId"],"","",0,detail)
      /* recover owner/currency from Ledger hold without trusting client. */
      hs=ledgerEngine~queryHold(d["holdId"]); if \hs~ok then return self~failure(req,hs)
      c=self~bankCommand(req,"RELEASE_HOLD",hs~value["customerId"],hs~value["accountId"],hs~value["currency"],0,detail)
      r=self~pumpPayment(c); if \r~ok then return self~failure(req,r)
      out=.directory~new; out["holdId"]=d["holdId"]
      return self~response(req,.true,"WITHDRAW_CANCELLED","",out)
    end
    when op="WITHDRAW_COMMIT" then do
      hs=ledgerEngine~queryHold(d["holdId"]); if \hs~ok then return self~failure(req,hs)
      expected="WDAUTH-"||d["holdId"]~string~substr(10)
      if d["authorizationId"]~string<>expected then return self~response(req,.false,"WITHDRAW_AUTHORIZATION_INVALID","hold/auth mismatch")
      detail=.directory~new
      detail["terminalId"]=req["terminalId"]; detail["atmNetworkId"]=.FederationBankAtmBuild~NETWORK_ID; detail["rulesetId"]=req["rulesetId"]; detail["rulesVersion"]=req["rulesVersion"]
      detail["physicalTransactionId"]=d["physicalTransactionId"]; detail["terminalSequence"]=req["terminalSequence"]; detail["authorizationId"]=d["authorizationId"]; detail["holdId"]=d["holdId"]; detail["dispensedMinor"]=d["dispensedMinor"]
      c=self~bankCommand(req,"WITHDRAW_COMMIT",hs~value["customerId"],hs~value["accountId"],hs~value["currency"],hs~value["amountMinor"],detail)
      r=self~pumpPayment(c); if \r~ok then return self~failure(req,r)
      out=.directory~new; out["bankTransactionId"]=req["idempotencyKey"]; out["amountMinor"]=hs~value["amountMinor"]; out["accountId"]=hs~value["accountId"]
      if r~value~hasIndex("bookBalanceMinor") then out["bookBalanceMinor"]=r~value["bookBalanceMinor"]
      return self~response(req,.true,"WITHDRAW_COMMITTED","",out)
    end
    when op="WITHDRAW_EXCEPTION" then return self~response(req,.true,"WITHDRAW_EXCEPTION_RECORDED","reconciliation evidence accepted")
    when op="DEPOSIT_COMMIT" then do
      s=self~sessionFor(req,.true); if \s~ok then return self~failure(req,s)
      detail=.directory~new
      detail["terminalId"]=req["terminalId"]; detail["atmNetworkId"]=.FederationBankAtmBuild~NETWORK_ID; detail["rulesetId"]=req["rulesetId"]; detail["rulesVersion"]=req["rulesVersion"]
      detail["physicalTransactionId"]=d["physicalTransactionId"]; detail["terminalSequence"]=req["terminalSequence"]
      c=self~bankCommand(req,"DEPOSIT_COMMIT",s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],detail)
      r=self~pumpPayment(c); if \r~ok then return self~failure(req,r)
      out=.directory~new; out["bankTransactionId"]=req["idempotencyKey"]; out["amountMinor"]=d["amountMinor"]; out["accountId"]=d["accountId"]
      if r~value~hasIndex("bookBalanceMinor") then out["bookBalanceMinor"]=r~value["bookBalanceMinor"]
      return self~response(req,.true,"DEPOSIT_COMMITTED","",out)
    end
    when op="GET_TRANSACTION_STATUS" then do
      r=ledgerEngine~queryTransactionStatus(d["idempotencyKey"])
      if \r~ok then return self~failure(req,r)
      return self~response(req,.true,r~code,"",r~value)
    end
    when op="OFFLINE_WITHDRAWAL_ADVICE" then do
      authority=offlineAuthorities~authority(d["offlineAuthorityId"])
      if authority==.nil then return self~response(req,.false,"ATM_OFFLINE_AUTHORITY_UNKNOWN",d["offlineAuthorityId"])
      /* Already-created physical-cash evidence is recovery work, not an
         interactive customer operation.  Resolve the retained authenticated
         session with terminal binding even if the customer has since logged
         off or the interactive timeout elapsed. */
      s=sessions~resolveRecovery(req["sessionId"],req["terminalId"]); if \s~ok then return self~failure(req,s)
      dispensedAt=""; if d~hasIndex("dispensedAt") then dispensedAt=d["dispensedAt"]
      adviceReceivedAt=.DateTime~new
      validated=offlineAuthorities~validateAdvice(d["offlineAuthorityId"],req["terminalId"],s~value["customerId"],d["accountId"],d["currency"],d["amountMinor"],req["rulesetId"],req["rulesVersion"],req["idempotencyKey"],d["physicalTransactionId"],dispensedAt,req["sessionId"],req["terminalSequence"],adviceReceivedAt)
      if \validated~ok then return self~failure(req,validated)
      authority=validated~value; mode=authority["authorityMode"]; evidenceDisposition=validated~code
      detail=.directory~new
      detail["terminalId"]=req["terminalId"]; detail["atmNetworkId"]=.FederationBankAtmBuild~NETWORK_ID; detail["rulesetId"]=req["rulesetId"]; detail["rulesVersion"]=req["rulesVersion"]; detail["terminalSequence"]=req["terminalSequence"]
      detail["physicalTransactionId"]=d["physicalTransactionId"]; detail["dispensedMinor"]=d["amountMinor"]; detail["offlineAuthorityId"]=authority["offlineAuthorityId"]; detail["authorityMode"]=mode
      detail["dispensedAt"]=dispensedAt; detail["adviceReceivedAt"]=adviceReceivedAt~utcIsoDate
      detail["authorityIssuedAt"]=authority["issuedAt"]; detail["authorityExpiresAt"]=authority["expiresAt"]; detail["offlineEvidenceDisposition"]=evidenceDisposition; detail["recoverySessionId"]=req["sessionId"]
      if authority~hasIndex("issuedTerminalSequence") then detail["authorityIssuedTerminalSequence"]=authority["issuedTerminalSequence"]
      if authority~hasIndex("reconciliationWindowSeconds") then detail["reconciliationWindowSeconds"]=authority["reconciliationWindowSeconds"]
      if authority~hasIndex("terminalClockSkewSeconds") then detail["terminalClockSkewSeconds"]=authority["terminalClockSkewSeconds"]
      if mode="RESERVED_ALLOWANCE" then do
        detail["authorizationId"]=authority["offlineAuthorityId"]; detail["holdId"]=authority["holdId"]
        c=self~bankCommand(req,"WITHDRAW_COMMIT",s~value["customerId"],authority["accountId"],authority["currency"],d["amountMinor"],detail)
      end
      else c=self~bankCommand(req,"OFFLINE_WITHDRAWAL_ADVICE",s~value["customerId"],authority["accountId"],authority["currency"],d["amountMinor"],detail)
      r=self~pumpPayment(c); if \r~ok then return self~failure(req,r)
      marked=offlineAuthorities~markConsumed(authority["offlineAuthorityId"],req["idempotencyKey"],d["physicalTransactionId"],d["amountMinor"],dispensedAt,evidenceDisposition)
      if \marked~ok then return self~response(req,.false,"OFFLINE_AUTHORITY_FINALIZE_FAILED",marked~code||":"||marked~detail,r~value)
      out=r~value~copy; out["offlineAuthorityId"]=authority["offlineAuthorityId"]; out["authorityMode"]=mode
      return self~response(req,.true,"OFFLINE_WITHDRAWAL_SETTLED","",out)
    end
    otherwise return self~response(req,.false,"OPERATION_UNSUPPORTED",op)
  end
::method plainWireValue private
  use arg value
  if value == .nil then return .nil
  /* ooRexx json.cls intentionally returns JSON string literals as the
     String subclass .JsonString.  Durable Queue Fabric payloads must not
     accidentally retain parser wrapper objects, so canonicalise only that
     wrapper while preserving booleans, numbers and all other scalar types. */
  if value~isA(.JsonString) then return value~string
  if value~isA(.Directory) then do
    out=.directory~new
    do key over value~allIndexes
      out[key~string]=self~plainWireValue(value[key])
    end
    return out
  end
  if value~isA(.Array) then do
    out=.array~new
    do item over value
      out~append(self~plainWireValue(item))
    end
    return out
  end
  return value

::method processBridgeMessage
  use arg message
  blank=.directory~new; blank["commandId"]=""; blank["operation"]=""; blank["terminalId"]=""
  if message==.nil | \message~isA(.JMSBridgeMessage) then return .JMSBridgeResult~failure("ATM_JMS_MESSAGE_REQUIRED")
  if message~bodyType<>"TEXT" then return .JMSBridgeResult~failure("ATM_JMS_TEXT_REQUIRED")
  signal on syntax name badJson
  req=self~plainWireValue(.JSON~fromJSON(message~body))
  signal off syntax
  checked=self~validateRequest(req,message)
  if checked~ok then response=self~handleRequest(req)
  else response=self~response(req,.false,checked~code,checked~detail)
  props=.directory~new
  props["FB_ATM_SCHEMA"]=.FederationBankAtmBuild~RESPONSE_SCHEMA
  props["FB_ATM_OPERATION"]=req["operation"]
  props["FB_ATM_TERMINAL_ID"]=req["terminalId"]
  props["FB_ATM_RULES_VERSION"]=req["rulesVersion"]
  headers=.directory~new; headers["JMSCORRELATIONID"]=req["commandId"]
  out=.JMSBridgeMessage~new("","TEXT",.JSON~toJSON(response),headers,props,"FEDERATIONBANK","")
  return .JMSBridgeResult~success(out,"ATM_RESPONSE_READY",req["commandId"])
badJson:
  signal off syntax
  return .JMSBridgeResult~failure("ATM_JSON_INVALID",condition("D"))

