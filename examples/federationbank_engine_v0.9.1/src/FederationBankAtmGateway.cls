/* FederationBank v0.9.1 ATM channel gateway.
 * Exact adapter for the FederationBank ATM request/response 0.1 wire protocol.
 * The gateway is a channel boundary: it authenticates terminal/customer
 * sessions, verifies protocol metadata, signs bank-owned ATM rules, and
 * translates state-changing ATM operations into the existing Queue Fabric
 * Payments -> Ledger authority path.  It never posts directly to Ledger.
 */

::class FederationBankAtmBuild public
::constant REQUEST_SCHEMA "federationbank.atm.request/0.1"
::constant RESPONSE_SCHEMA "federationbank.atm.response/0.1"
::constant RULES_SCHEMA "federationbank.atm.rules/0.1"
::constant RULESET_ID "FB-ATM-IOM-DEMO"
::constant RULES_VERSION 1
::constant KEY_ID "FB-ATM-RULE-KEY-1"
::constant NETWORK_ID "FEDERATIONBANK-DEMO"

::class FederationBankAtmBase64 public
::method encodeHex class
  use arg hex
  h = hex~string~space(0)~lower
  if h~length // 2 <> 0 then raise syntax 88.900 array("BASE64_HEX_LENGTH_INVALID")
  alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  out = ""
  pos = 1
  do while pos <= h~length
    remain = h~length - pos + 1
    b1 = x2d(h~substr(pos,2)); pos += 2
    if remain >= 4 then do; b2=x2d(h~substr(pos,2)); pos+=2; end
    else b2=0
    if remain >= 6 then do; b3=x2d(h~substr(pos,2)); pos+=2; end
    else b3=0
    n = b1 * 65536 + b2 * 256 + b3
    i1 = n % 262144
    rest = n // 262144
    i2 = rest % 4096
    rest = rest // 4096
    i3 = rest % 64
    i4 = rest // 64
    out ||= alphabet~substr(i1+1,1) || alphabet~substr(i2+1,1)
    if remain >= 4 then out ||= alphabet~substr(i3+1,1)
    else out ||= "="
    if remain >= 6 then out ||= alphabet~substr(i4+1,1)
    else out ||= "="
  end
  return out

