#!/usr/bin/env python3
"""Tiny mysql --batch --raw compatible read client for the toybench.
Only the surface needed by database_core's read/query probes is implemented.
Actual SQL resultsets travel over the MySQL wire protocol to msqlshim.
"""
import re, socket, struct, sys

FLAGS=1|4|512|8192|32768|131072|524288

def recvn(s,n):
    out=b''
    while len(out)<n:
        p=s.recv(n-len(out))
        if not p: raise EOFError('socket closed')
        out+=p
    return out

def readpkt(s):
    h=recvn(s,4); n=int.from_bytes(h[:3],'little'); return h[3],recvn(s,n)

def sendpkt(s,seq,p):
    s.sendall(len(p).to_bytes(3,'little')+bytes([seq])+p)

def lenenc(data,pos=0):
    b=data[pos]
    if b<0xfb: return b,pos+1
    if b==0xfb: return None,pos+1
    if b==0xfc: return int.from_bytes(data[pos+1:pos+3],'little'),pos+3
    if b==0xfd: return int.from_bytes(data[pos+1:pos+4],'little'),pos+4
    if b==0xfe: return int.from_bytes(data[pos+1:pos+9],'little'),pos+9
    raise ValueError('bad lenenc')

def lstr(data,pos):
    n,pos=lenenc(data,pos)
    if n is None: return None,pos
    return data[pos:pos+n],pos+n

def colname(packet):
    pos=0; vals=[]
    for _ in range(6):
        v,pos=lstr(packet,pos); vals.append(v)
    return (vals[4] or b'').decode(errors='replace')

def connect(host,port,user,database):
    s=socket.create_connection((host,port),timeout=10); s.settimeout(120)
    _,g=readpkt(s)
    if not g or g[0]!=10: raise RuntimeError('bad MySQL greeting')
    resp=struct.pack('<I',FLAGS)+struct.pack('<I',16*1024*1024)+bytes([45])+b'\0'*23+user.encode()+b'\0'+b'\0'+b'mysql_native_password\0'
    sendpkt(s,1,resp); _,p=readpkt(s)
    if not p or p[0]!=0: raise RuntimeError('handshake rejected')
    if database:
        sendpkt(s,0,b'\x02'+database.encode()); _,p=readpkt(s)
        if not p or p[0]!=0: raise RuntimeError('database selection failed')
    return s

def query(s,sql):
    sendpkt(s,0,b'\x03'+sql.encode()); _,p=readpkt(s)
    if not p: raise RuntimeError('empty response')
    if p[0]==0xff:
        code=int.from_bytes(p[1:3],'little')
        msg=p[9:].decode(errors='replace') if len(p)>=9 else p[3:].decode(errors='replace')
        raise RuntimeError(f'ERROR {code}: {msg}')
    if p[0]==0x00: return [],[]
    ncols,_=lenenc(p)
    cols=[]
    for _ in range(ncols): _,cp=readpkt(s); cols.append(colname(cp))
    readpkt(s)
    rows=[]
    while True:
        _,rp=readpkt(s)
        if rp and rp[0]==0xfe and len(rp)<9: break
        pos=0; row=[]
        for _ in range(ncols):
            v,pos=lstr(rp,pos)
            row.append(None if v is None else v.decode(errors='replace'))
        rows.append(row)
    return cols,rows

def split_sql(text):
    out=[]; buf=[]; quote=None; i=0
    while i<len(text):
        ch=text[i]
        if quote:
            buf.append(ch)
            if ch==quote:
                if i+1<len(text) and text[i+1]==quote:
                    buf.append(text[i+1]); i+=1
                else: quote=None
        else:
            if ch in "'\"": quote=ch; buf.append(ch)
            elif ch==';':
                s=''.join(buf).strip(); buf=[]
                if s: out.append(s)
            else: buf.append(ch)
        i+=1
    s=''.join(buf).strip()
    if s: out.append(s)
    return out

def emit(cols,rows):
    if not cols: return
    print('\t'.join(cols))
    for r in rows:
        print('\t'.join('NULL' if v is None else v for v in r))

def main(argv):
    host='127.0.0.1'; port=3306; user=''; database=''
    i=1; positional=[]
    while i<len(argv):
        a=argv[i]
        if a in ('--batch','--raw'): i+=1; continue
        if a=='--host': host=argv[i+1]; i+=2; continue
        if a.startswith('--host='): host=a.split('=',1)[1]; i+=1; continue
        if a=='--port': port=int(argv[i+1]); i+=2; continue
        if a.startswith('--port='): port=int(a.split('=',1)[1]); i+=1; continue
        if a=='--user': user=argv[i+1]; i+=2; continue
        if a.startswith('--user='): user=a.split('=',1)[1]; i+=1; continue
        if a.startswith('-'): i+=1; continue
        positional.append(a); i+=1
    if positional: database=positional[-1]
    script=sys.stdin.read()
    s=connect(host,port,user or 'toy',database)
    try:
        for stmt in split_sql(script):
            upper=stmt.strip().upper()
            if upper.startswith('START TRANSACTION') or upper=='COMMIT' or upper=='ROLLBACK' or upper.startswith('SET TRANSACTION'):
                # database_core wraps read probes in a transaction. msqlshim does
                # not expose SQL transaction-control syntax, so this read-only
                # CLI bridge leaves those wrappers local rather than fabricating
                # a server-side transaction claim.
                continue
            m=re.fullmatch(r"SELECT\s+'(__OOREXX_RESULT_(?:BEGIN|END)_\d+__)'\s+AS\s+__oorexx_frame",stmt,re.I)
            if m:
                emit(['__oorexx_frame'],[[m.group(1)]])
                continue
            m=re.fullmatch(r"SELECT\s+VERSION\(\)\s+AS\s+__oorexx_server_version",stmt,re.I)
            if m:
                _,rows=query(s,'SELECT VERSION()')
                emit(['__oorexx_server_version'],rows)
                continue
            cols,rows=query(s,stmt)
            emit(cols,rows)
    finally:
        s.close()
    return 0

if __name__=='__main__':
    try: raise SystemExit(main(sys.argv))
    except Exception as e:
        print(str(e),file=sys.stderr)
        raise SystemExit(1)
