bc=.FBBranchDayEvidenceTest~branchCashService; till=.FBBranchDayEvidenceTest~openTill; tills=.directory~new; tills[till~tillId]=till; ex=.FBBranchDayEvidenceTest~externalService; sh=.FBBranchDayEvidenceTest~externalShipment("EX1","OUTBOUND",7000); r=.FBBranchDayEvidenceTest~externalComplete(ex,sh); .FBBranchDayEvidenceTest~assertEq("COMPLETED",r~code); a=.FederationBankBranchDayEvidenceAssembler~new(bc,tills,.nil,ex); d=.FederationBankBranchDay~new("DAY-2","IOM-DOUGLAS",.DateTime~new~utcIsoDate~left(10)); open=a~openingEvidence(d~branchId,d~businessDate,"GBP"); apr=.FederationBankBranchDayApproval~new("APR-O",d~openActionIdentity(open~endpoints,open~positions,"MGR-A"),"MGR-B","STAFF-AUTH:B"); ignore=d~open(open~endpoints,open~positions,"MGR-A",apr,.FederationBankBranchDayFixturePolicy~new); close=a~closingEvidence(d,"GBP")~value; .FBBranchDayEvidenceTest~assertEq(7000,close~totals[1]~externalCashOutMinor); say "PASS: Branch Day control totals derive external shipments from External Cash service"
::requires "TestSupport.cls"
