bc=.FBBranchDayEvidenceTest~branchCashService; till=.FBBranchDayEvidenceTest~openTill; tills=.directory~new; tills[till~tillId]=till; st=.FBBranchDayEvidenceTest~tellerCashState; st~putWork(.FBBranchDayEvidenceTest~cashWork("R1","DEPOSIT",1000,"RECONCILIATION_REQUIRED")); a=.FederationBankBranchDayEvidenceAssembler~new(bc,tills,.FBBranchDayEvidenceTest~tellerCashService(st)); p=a~positionEvidence("IOM-DOUGLAS","GBP",.DateTime~new~utcIsoDate~left(10)); .FBBranchDayEvidenceTest~assertEq(1,p~outstandingReconciliationCount); d=.FederationBankBranchDay~new("DAY-X","IOM-DOUGLAS",.DateTime~new~utcIsoDate~left(10)); es=a~endpointEvidence(d~branchId,"GBP"); r=d~open(es,.array~of(p),"MGR-A",.FederationBankBranchDayApproval~new("A",d~openActionIdentity(es,.array~of(p),"MGR-A"),"MGR-B","AUTH"),.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertEq("OUTSTANDING_RECONCILIATION",r~code); say "PASS: unresolved Teller Cash work blocks Branch Day certification"
::requires "TestSupport.cls"
