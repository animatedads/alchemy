bc=.FBBranchDayEvidenceTest~branchCashService; till=.FBBranchDayEvidenceTest~openTill; tills=.directory~new; tills[till~tillId]=till; st=.FBBranchDayEvidenceTest~tellerCashState; st~putWork(.FBBranchDayEvidenceTest~cashWork("D2","DEPOSIT",10000)); st~putWork(.FBBranchDayEvidenceTest~cashWork("W2","WITHDRAWAL",5000)); tc=.FBBranchDayEvidenceTest~tellerCashService(st); a=.FederationBankBranchDayEvidenceAssembler~new(bc,tills,tc); date=.DateTime~new~utcIsoDate~left(10); d=.FederationBankBranchDay~new("DAY-E2E","IOM-DOUGLAS",date)
open=a~openingEvidence(d~branchId,date,"GBP"); ap=.FederationBankBranchDayApproval~new("APR-O",d~openActionIdentity(open~endpoints,open~positions,"MGR-A"),"MGR-B","AUTH:B"); r=d~open(open~endpoints,open~positions,"MGR-A",ap,.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok)
ctx=.FederationBankTillCustodyContext~new("TILL-04","IOM-DOUGLAS","TELLER-04","SESSION-X","WS-1","CUSTODY:TILL-04"); act=.FederationBankTillAction~new("ACT-D","CASH_IN",10000,"GBP","TELLER-04"); ignore=till~applyCash(act,.FBBranchDayEvidenceTest~tillBundle(10000),ctx,.nil,.FederationBankTillPolicy~new); act=.FederationBankTillAction~new("ACT-W","CASH_OUT",5000,"GBP","TELLER-04"); ignore=till~applyCash(act,.FBBranchDayEvidenceTest~tillBundle(5000),ctx,.nil,.FederationBankTillPolicy~new)
ignore=d~beginClose("MGR-A",.FederationBankBranchDayApproval~new("APR-B",d~beginCloseActionIdentity("MGR-A"),"MGR-B","AUTH:B"),.FederationBankBranchDayFixturePolicy~new)
r=till~close(ctx,.FBBranchDayEvidenceTest~tillBundle(25000),.FederationBankTillApproval~new("APR-TC","CLOSE","SUP-1","CLOSE"),.FederationBankTillPolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok,"till close")
v=bc~state~vault("VAULT-1"); ctrl=.FederationBankBranchCashControl~new("IOM-DOUGLAS","VAULT-1","STAFF-A","STAFF-B","CTRL:CLOSE"); r=v~close(ctrl,.FBBranchDayEvidenceTest~bcBundle(80000),.FederationBankBranchCashFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok,"vault close")
cr=a~closingEvidence(d,"GBP"); .FBBranchDayEvidenceTest~assertTrue(cr~ok); ce=cr~value; cap=.FederationBankBranchDayApproval~new("APR-C",d~closeActionIdentity(ce~endpoints,ce~positions,ce~totals,"MGR-A"),"MGR-B","AUTH:B"); r=d~close(ce~endpoints,ce~positions,ce~totals,"MGR-A",cap,.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok,r~code); .FBBranchDayEvidenceTest~assertEq("CLOSED",d~state); say "PASS: Branch Day closes from authoritative vault/till evidence and Teller Cash control totals"
