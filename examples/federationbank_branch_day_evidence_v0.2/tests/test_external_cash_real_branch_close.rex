bc=.FBBranchDayEvidenceTest~branchCashService; till=.FBBranchDayEvidenceTest~openTill; tills=.directory~new; tills[till~tillId]=till; reg=.FederationBankExternalBranchCashControlRegistry~new; port=.FederationBankExternalBranchCashVaultPort~new(bc,reg); ex=.FederationBankExternalCashService~new(.FederationBankExternalCashFixturePolicy~new,port); assembler=.FederationBankBranchDayEvidenceAssembler~new(bc,tills,.nil,ex); date=.DateTime~new~utcIsoDate~left(10); day=.FederationBankBranchDay~new("DAY-EXT","IOM-DOUGLAS",date)
open=assembler~openingEvidence(day~branchId,date,"GBP"); ap=.FederationBankBranchDayApproval~new("APR-O",day~openActionIdentity(open~endpoints,open~positions,"MGR-A"),"MGR-B","AUTH:B"); r=day~open(open~endpoints,open~positions,"MGR-A",ap,.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok)
d=.directory~new; d["7000"]=1; eb=.FederationBankExternalCashBundle~new("GBP",d); sh=.FederationBankExternalCashShipment~new("EXT-REAL","IOM-DOUGLAS","OUTBOUND","VAULT-1","CENTRE","CARRIER","MAN:EXT-REAL","SEAL:EXT-REAL",eb,"STAFF-A","STAFF-AUTH:A"); p=.directory~new; p["shipment"]=sh; p["approval"]=.FederationBankExternalCashApproval~new("APR:EXT",sh~semanticIdentity,"STAFF-B","STAFF-AUTH:B"); r=ex~handle(.FederationBankExternalCashServiceEnvelope~new("SUB-EXT","FBEXTCASH.SHIPMENT.SUBMIT","STAFF-A","CASH",p)); .FBBranchDayEvidenceTest~assertEq("AUTHORISED",r~code); au=r~value~authority; v=bc~state~vault("VAULT-1"); bi=.FederationBankBranchCashExternalInstruction~new(sh~shipmentId,sh~branchId,sh~direction,sh~vaultId,sh~bundle~totalMinor,sh~bundle~currency,au~semanticIdentity,sh~manifestRef,sh~sealId,sh~requestedByStaffId); reg~put(sh~shipmentId,.FederationBankBranchCashExternalControl~new("ECTRL:EXT",bi~semanticIdentity,v~primaryStaffId,v~checkerStaffId,au~semanticIdentity)); p=.directory~new; p["shipmentId"]=sh~shipmentId; r=ex~handle(.FederationBankExternalCashServiceEnvelope~new("DSP-EXT","FBEXTCASH.SHIPMENT.DISPATCH","STAFF-A","CASH",p)); .FBBranchDayEvidenceTest~assertEq("IN_TRANSIT",r~code); rec=.FederationBankExternalCashReceipt~new("REC:EXT",sh~semanticIdentity,"CASH_CENTRE","CARRIER",sh~sealId,sh~bundle,"CENTRE-CUSTODY:EXT"); p["receipt"]=rec; r=ex~handle(.FederationBankExternalCashServiceEnvelope~new("RCV-EXT","FBEXTCASH.SHIPMENT.RECEIVE","CARRIER","CASH",p)); .FBBranchDayEvidenceTest~assertEq("COMPLETED",r~code); .FBBranchDayEvidenceTest~assertEq(73000,v~expectedMinor)
ignore=day~beginClose("MGR-A",.FederationBankBranchDayApproval~new("APR-B",day~beginCloseActionIdentity("MGR-A"),"MGR-B","AUTH:B"),.FederationBankBranchDayFixturePolicy~new); ctx=.FederationBankTillCustodyContext~new("TILL-04","IOM-DOUGLAS","TELLER-04","S","W","C"); ignore=till~close(ctx,.FBBranchDayEvidenceTest~tillBundle(20000),.FederationBankTillApproval~new("APR-T","C","SUP","C"),.FederationBankTillPolicy~new); ctrl=.FederationBankBranchCashControl~new("IOM-DOUGLAS","VAULT-1","STAFF-A","STAFF-B","CTRL:CLOSE"); r=v~close(ctrl,.FBBranchDayEvidenceTest~bcBundle(73000),.FederationBankBranchCashFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok)
cr=assembler~closingEvidence(day,"GBP"); .FBBranchDayEvidenceTest~assertTrue(cr~ok); ce=cr~value; .FBBranchDayEvidenceTest~assertEq(7000,ce~totals[1]~externalCashOutMinor); .FBBranchDayEvidenceTest~assertEq(93000,ce~positions[1]~expectedMinor); cap=.FederationBankBranchDayApproval~new("APR-C",day~closeActionIdentity(ce~endpoints,ce~positions,ce~totals,"MGR-A"),"MGR-B","AUTH:B"); r=day~close(ce~endpoints,ce~positions,ce~totals,"MGR-A",cap,.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok,r~code); say "PASS: real external shipment changes Branch Cash vault and reconciles Branch Day control totals"
