bc=.FBBranchDayEvidenceTest~branchCashService; till=.FBBranchDayEvidenceTest~openTill; tills=.directory~new; tills[till~tillId]=till; st=.FBBranchDayEvidenceTest~tellerCashState; st~putWork(.FBBranchDayEvidenceTest~cashWork("D1","DEPOSIT",10000)); st~putWork(.FBBranchDayEvidenceTest~cashWork("W1","WITHDRAWAL",5000)); tc=.FBBranchDayEvidenceTest~tellerCashService(st); a=.FederationBankBranchDayEvidenceAssembler~new(bc,tills,tc); d=.FederationBankBranchDay~new("DAY-1","IOM-DOUGLAS",.DateTime~new~utcIsoDate~left(10)); open=a~openingEvidence(d~branchId,d~businessDate,"GBP"); apr=.FederationBankBranchDayApproval~new("APR-O",d~openActionIdentity(open~endpoints,open~positions,"MGR-A"),"MGR-B","STAFF-AUTH:B"); r=d~open(open~endpoints,open~positions,"MGR-A",apr,.FederationBankBranchDayFixturePolicy~new); .FBBranchDayEvidenceTest~assertTrue(r~ok); ignore=d~beginClose("MGR-A",.FederationBankBranchDayApproval~new("APR-B",d~beginCloseActionIdentity("MGR-A"),"MGR-B","STAFF-AUTH:B"),.FederationBankBranchDayFixturePolicy~new); close=a~closingEvidence(d,"GBP")~value; t=close~totals[1]; .FBBranchDayEvidenceTest~assertEq(10000,t~customerCashInMinor); .FBBranchDayEvidenceTest~assertEq(5000,t~customerCashOutMinor); say "PASS: Branch Day control totals derive customer cash from Teller Cash service work"
::requires "TestSupport.cls"
