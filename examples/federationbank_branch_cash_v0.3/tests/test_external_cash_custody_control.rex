v=.FBBranchCashTestSupport~openVault("VAULT-1",100000); i=.FederationBankBranchCashExternalInstruction~new("EXT-X","IOM-DOUGLAS","OUTBOUND","VAULT-1",10000,"GBP","EXTAUTH:X","MAN:X","SEAL:X","STAFF-A"); c=.FederationBankBranchCashExternalControl~new("ECTRL:X",i~semanticIdentity,"OTHER-A","OTHER-B",i~externalAuthorityRef); r=v~applyExternalCash(i,.FBBranchCashTestSupport~bundle(10000),c,.FederationBankBranchCashFixturePolicy~new); .FBBranchCashTestSupport~assertEq(r~code,"VAULT_CUSTODY_CONTROL_MISMATCH"); .FBBranchCashTestSupport~assertEq(v~expectedMinor,100000); say "PASS: external authority cannot bypass current vault dual custody"
::requires "TestSupport.cls"
