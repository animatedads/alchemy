v=.FBBranchCashTestSupport~openVault("VAULT-1",100000); i=.FederationBankBranchCashExternalInstruction~new("EXT-OUT","IOM-DOUGLAS","OUTBOUND","VAULT-1",30000,"GBP","EXTAUTH:2","MAN:2","SEAL:2","STAFF-A"); c=.FederationBankBranchCashExternalControl~new("ECTRL:2",i~semanticIdentity,v~primaryStaffId,v~checkerStaffId,i~externalAuthorityRef); r=v~applyExternalCash(i,.FBBranchCashTestSupport~bundle(30000),c,.FederationBankBranchCashFixturePolicy~new); .FBBranchCashTestSupport~assertTrue(r~ok); .FBBranchCashTestSupport~assertEq(v~expectedMinor,70000); r=v~applyExternalCash(i,.FBBranchCashTestSupport~bundle(30000),c,.FederationBankBranchCashFixturePolicy~new); .FBBranchCashTestSupport~assertTrue(r~ok); .FBBranchCashTestSupport~assertEq(v~expectedMinor,70000); say "PASS: external outbound cash is exact and idempotent"
::requires "TestSupport.cls"
