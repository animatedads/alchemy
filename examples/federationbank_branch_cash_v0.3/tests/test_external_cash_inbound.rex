v=.FBBranchCashTestSupport~openVault("VAULT-1",100000); i=.FederationBankBranchCashExternalInstruction~new("EXT-IN","IOM-DOUGLAS","INBOUND","VAULT-1",25000,"GBP","EXTAUTH:1","MAN:1","SEAL:1","STAFF-A"); c=.FederationBankBranchCashExternalControl~new("ECTRL:1",i~semanticIdentity,v~primaryStaffId,v~checkerStaffId,i~externalAuthorityRef); r=v~applyExternalCash(i,.FBBranchCashTestSupport~bundle(25000),c,.FederationBankBranchCashFixturePolicy~new); .FBBranchCashTestSupport~assertTrue(r~ok,"external inbound"); .FBBranchCashTestSupport~assertEq(v~expectedMinor,125000); say "PASS: external inbound cash changes vault physical custody under exact authority"
::requires "TestSupport.cls"
