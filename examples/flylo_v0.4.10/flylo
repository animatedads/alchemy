function send(res, status, headers, body) {
  res.writeHead(status, {
    'x-content-type-options': 'nosniff',
    'cache-control': 'no-store',
    ...headers
  });
  res.end(body);
}

function sendJson(res, status, value) {
  return send(res, status, { 'content-type': 'application/json; charset=utf-8' }, JSON.stringify(value) + '\n');
}

function resolveStaticPath(pathname) {
  let decoded;
  try { decoded = decodeURIComponent(pathname); }
  catch { return null; }
  const relative = decoded === '/' ? 'index.html' : decoded.replace(/^\/+/, '');
  const normalized = path.normalize(relative);
  if (normalized.startsWith('..') || path.isAbsolute(normalized)) return null;
  const candidate = path.join(WEB_ROOT, normalized);
  const rel = path.relative(WEB_ROOT, candidate);
  if (rel.startsWith('..') || path.isAbsolute(rel)) return null;
  return candidate;
}

function credentialEnvironmentName() {
  return process.env.AI_GROK_CREDENTIAL_ENV || 'XAI_API_KEY';
}

function assistantConfigured() {
  const envName = credentialEnvironmentName();
  return typeof process.env[envName] === 'string' && process.env[envName].trim().length > 0;
}

function parseWholeEnvironment(name, fallback, minimum, maximum, issues) {
  const raw = process.env[name];
  if (raw === undefined || String(raw).trim() === '') return fallback;
  const value = Number(String(raw).trim());
  if (!Number.isInteger(value) || value < minimum || value > maximum) {
    issues.push(`${name}_INVALID`);
    return fallback;
  }
  return value;
}

function assistantConfiguration() {
  const issues = [];
  const model = String(process.env.FLYLO_GROK_MODEL || 'grok-4.3').trim();
  if (!model) issues.push('FLYLO_GROK_MODEL_REQUIRED');
  parseWholeEnvironment('FLYLO_GROK_MAX_OUTPUT', 700, 1, 8192, issues);
  parseWholeEnvironment('AI_GROK_MAX_OUTPUT', 8192, 1, 65536, issues);
  parseWholeEnvironment('AI_GROK_TIMEOUT', 60, 1, 300, issues);
  parseWholeEnvironment('FLYLO_GROK_REQUEST_TIMEOUT_MS', 70000, 1000, 310000, issues);
  const endpoint = String(process.env.AI_GROK_ENDPOINT || 'https://api.x.ai/v1/chat/completions').trim();
  const allowHttp = process.env.AI_GROK_ALLOW_HTTP_TEST === '1';
  if (!(endpoint.startsWith('https://') || (allowHttp && endpoint.startsWith('http://')))) issues.push('AI_GROK_ENDPOINT_INVALID');
  const allowlist = String(process.env.AI_GROK_MODELS || 'grok-4.3,grok-4.6,grok-4.5,grok-4')
    .split(',').map(v => v.trim()).filter(Boolean);
  if (model && !allowlist.includes(model)) issues.push('FLYLO_GROK_MODEL_NOT_ALLOWLISTED');
  return { issues, model, endpoint };
}

function assistantReady() {
  return assistantConfigured() && assistantRuntimeProbe.ok && assistantConfiguration().issues.length === 0;
}

function assistantStatus() {
  const config = assistantConfiguration();
  return {
    provider: 'grok-xai',
    transport: 'realtime',
    batch: false,
    configured: assistantConfigured(),
    ready: assistantReady(),
    runtimeReady: Boolean(assistantRuntimeProbe.ok),
    runtimeCode: assistantRuntimeProbe.code,
    model: config.model,
