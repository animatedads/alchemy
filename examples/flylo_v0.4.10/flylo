}

function flyloReferenceDate() {
  const configured = String(process.env.FLYLO_TODAY || '').trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(configured)) return configured;
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit'
  }).formatToParts(new Date());
  const values = Object.fromEntries(parts.filter(p => p.type !== 'literal').map(p => [p.type, p.value]));
  return `${values.year}-${values.month}-${values.day}`;
}

function assistantSessionId(raw) {
  const supplied = typeof raw === 'string' ? raw.trim() : '';
  if (supplied && /^[A-Za-z0-9._-]{1,80}$/.test(supplied)) return supplied;
  return crypto.randomUUID();
}

function assistantSession(id) {
  const existing = assistantSessions.get(id);
  if (existing) {
    existing.updatedAt = Date.now();
    return existing;
  }
  if (assistantSessions.size >= ASSISTANT_SESSION_LIMIT) {
    let oldestKey = null;
    let oldest = Infinity;
    for (const [key, value] of assistantSessions) {
      if (value.updatedAt < oldest) { oldest = value.updatedAt; oldestKey = key; }
    }
    if (oldestKey) assistantSessions.delete(oldestKey);
  }
  const created = { frame: null, updatedAt: Date.now() };
  assistantSessions.set(id, created);
  return created;
}

function readJsonBody(req) {
  return new Promise((resolve, reject) => {
    let size = 0;
    const chunks = [];
    req.on('data', chunk => {
      size += chunk.length;
      if (size > ASSISTANT_BODY_LIMIT) {
        reject(Object.assign(new Error('request too large'), { code: 'BODY_TOO_LARGE' }));
        req.destroy();
        return;
      }
      chunks.push(chunk);
    });
    req.on('end', () => {
      try {
        const text = Buffer.concat(chunks).toString('utf8');
        resolve(text ? JSON.parse(text) : {});
      } catch (error) {
        reject(Object.assign(error, { code: 'JSON_INVALID' }));
      }
    });
    req.on('error', reject);
  });
}

function textBound(value, max) {
  const text = typeof value === 'string' ? value : '';
  return text.length <= max ? text : text.slice(0, max);
}

function safeBrowserContext(value) {
  const input = value && typeof value === 'object' && !Array.isArray(value) ? value : {};
  const safe = {};
  const search = input.search && typeof input.search === 'object' ? input.search : null;
  if (search) {
    safe.search = {
      origin: textBound(search.origin, 16),
      destination: textBound(search.destination, 16),
      date: textBound(search.date, 20),
      passengers: Number.isInteger(search.passengers) ? search.passengers : undefined
    };
  }
  const sale = input.sale && typeof input.sale === 'object' ? input.sale : null;
  if (sale) {
    safe.sale = {
      state: textBound(sale.state, 32),
      flightNo: textBound(sale.flightNo, 24),
      origin: textBound(sale.origin, 16),
      destination: textBound(sale.destination, 16),
      date: textBound(sale.date, 20),
      totalMinor: Number.isInteger(sale.totalMinor) ? sale.totalMinor : undefined,
      currency: textBound(sale.currency, 8),
      bookingStatus: textBound(sale.bookingStatus, 32),
      bookingRef: textBound(sale.bookingRef, 32),
      selectedExtras: Array.isArray(sale.selectedExtras) ? sale.selectedExtras.slice(0, 8).map(v => textBound(v, 40)) : []
    };
  }
  return safe;
}

function safeConversation(history) {
  if (!Array.isArray(history)) return '';
  return history.slice(-8).map(item => {
    if (!item || typeof item !== 'object') return null;
    const role = item.role === 'assistant' ? 'ASSISTANT' : item.role === 'user' ? 'CUSTOMER' : null;
    if (!role) return null;
    const content = textBound(item.content, 2000).replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, ' ');
    return `${role}: ${content}`;
  }).filter(Boolean).join('\n');
}

