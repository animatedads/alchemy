function probeRexxRuntime() {
  if (!fs.existsSync(RUNTIME_PROBE)) return { ok: false, code: 'RUNTIME_PROBE_MISSING' };
  const result = spawnSync(assistantRexxCommand(), [RUNTIME_PROBE], {
    cwd: ROOT, env: rexxEnvironment(), encoding: 'utf8', timeout: 5000, shell: false
  });
  if (result.error) return { ok: false, code: result.error.code === 'ENOENT' ? 'REXX_UNAVAILABLE' : 'RUNTIME_PROBE_ERROR' };
  if (result.status !== 0 || !String(result.stdout || '').includes('FLYLO_RUNTIME_PROBE_OK')) {
    return { ok: false, code: `RUNTIME_PROBE_FAILED_${result.status ?? 'UNKNOWN'}` };
  }
  return { ok: true, code: 'OK' };
}

