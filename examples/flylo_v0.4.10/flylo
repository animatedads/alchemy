  return {
    schema: 'flylo.assistant.frame/0.2', intent: 'UNKNOWN', serviceRequest: 'NONE', informationRequest: 'NONE',
    slots: {
      origin: '', destination: '', outboundDay: 0, outboundMonth: 0, outboundYear: 0, outboundDate: '',
      passengers: 0, tripType: '', returnDay: 0, returnMonth: 0, returnYear: 0, returnDate: '',
      bookingRef: '', familyName: '', documentCountry: '', travellerAge: 0,
      companionChildMentioned: false, tobaccoForCompanion: false
    }
  };
}

function safeContinuityFallback(question, partialFrame) {
  const text = String(question || '').trim();
  const lower = text.toLowerCase();
  const frame = partialFrame && typeof partialFrame === 'object' ? JSON.parse(JSON.stringify(partialFrame)) : emptyAssistantFrame();
  frame.slots = frame.slots && typeof frame.slots === 'object' ? frame.slots : emptyAssistantFrame().slots;
  let missing = [];
  let reply = 'I am having trouble with the live chat language layer, but I can still keep the conversation moving. Tell me whether you want to search for a flight or get help with an existing booking.';

  if (/\b(my booking|my reservation|booked|booking)\b/.test(lower)) {
    frame.intent = 'MANAGE_BOOKING';
    frame.serviceRequest = frame.serviceRequest === 'ADD_CHECKED_BAG' ? frame.serviceRequest : 'BOOKING_LOOKUP';
    missing = [];
    if (!frame.slots.bookingRef) missing.push('bookingRef');
    if (!frame.slots.familyName) missing.push('familyName');
    reply = 'I can still help with your existing booking. Please give me the FlyLo booking reference and the booking surname so I can retrieve the right booking.';
  } else if (/\b(fly|flight|travel|go|ticket|tickets|book)\b/.test(lower)) {
    frame.intent = 'BOOK_JOURNEY';
    if (/\b(new york|newark|nyc)\b/.test(lower)) frame.slots.destination = 'EWR';
    const partyMatch = lower.match(/\b(\d{1,6})\s+(?:ticket|tickets|passenger|passengers|seat|seats)\b/);
    if (partyMatch) frame.slots.passengers = Number.parseInt(partyMatch[1], 10);
    missing = [];
    if (!frame.slots.origin) missing.push('origin');
    if (!frame.slots.destination) missing.push('destination');
    if (!frame.slots.outboundDate) missing.push('outboundDate');
    if (!Number.isInteger(frame.slots.passengers) || frame.slots.passengers < 1) missing.push('passengers');
    if (!frame.slots.tripType) missing.push('tripType');
    const destination = frame.slots.destination === 'EWR' ? ' to New York' : '';
    const party = Number.isInteger(frame.slots.passengers) && frame.slots.passengers > 0 ? ` for ${frame.slots.passengers} passengers` : '';
    const asks = [];
    if (!frame.slots.origin) asks.push('where you are leaving from');
    if (!frame.slots.outboundDate) asks.push('your travel date');
    if (!Number.isInteger(frame.slots.passengers) || frame.slots.passengers < 1) asks.push('number of passengers');
    if (!frame.slots.tripType) asks.push('whether it is one-way or return');
    reply = `I can still collect the flight-search details${destination}${party}. Tell me ${asks.join(', ').replace(/, ([^,]*)$/, ', and $1')}.`;
  }

  return { text: reply, frame, missing };
}

function normalizeAssistantBooleans(result) {
  const truth = value => value === true || value === 1 || value === '1' || value === 'true';
  const slots = result && result.frame && result.frame.slots;
  if (slots && typeof slots === 'object') {
    for (const key of ['companionChildMentioned', 'tobaccoForCompanion']) {
      if (Object.prototype.hasOwnProperty.call(slots, key)) slots[key] = truth(slots[key]);
    }
  }
  const evidence = result && result.authorityEvidence;
  if (evidence && typeof evidence === 'object') {
    const booleanKeys = new Set([
      'governmentAdmissionAuthority','airlineDocumentCheckOnly','visaWaiverProgram','needsDocumentStatus',
      'checkedBaggageDoesNotChangeCustomsAllowance','dutyFreeShopDoesNotOverrideImportRules','mustDeclareExcess',
      'ageClarificationNeeded','companionAllowanceEligible','ordinaryCigarettesCheckedBaggagePermitted',
      'ordinaryCigarettesCarryOnPermitted','lighterRuleSeparate','customsRulesSeparate','customsRulesRemainSeparate',
      'transactionRequired','quietTransactionForbidden','quietTransactionPermitted'
    ]);
    const visit = value => {
      if (!value || typeof value !== 'object') return;
      if (Array.isArray(value)) { for (const item of value) visit(item); return; }
      for (const [key, child] of Object.entries(value)) {
        if (booleanKeys.has(key)) value[key] = truth(child);
        else visit(child);
      }
    };
    visit(evidence);
  }
  if (result && result.action && result.action.product) {
    for (const key of ['transactionRequired','quietTransactionForbidden','quietTransactionPermitted']) {
      if (Object.prototype.hasOwnProperty.call(result.action.product, key)) result.action.product[key] = truth(result.action.product[key]);
    }
  }
  return result;
}


class FlyLoPublicRuntimeBridge {
  constructor(dataRoot) {
    this.dataRoot = dataRoot;
    this.child = null;
    this.pending = new Map();
    this.sequence = 0;
    this.ready = false;
    this.readyInfo = null;
    this.lastError = null;
  }

  start() {
    if (this.child) return Promise.resolve(this.readyInfo);
    return new Promise((resolve, reject) => {
      const runtimeEnv = {
        ...rexxEnvironment(),
        FLYLO_DURABLE_ROOT: path.join(this.dataRoot, 'queue'),
        FLYLO_ACCOUNTING_STORE: path.join(this.dataRoot, 'accounting', 'flylo-stat.jsonl')
      };
      const child = spawn(rexxCommand(), [PUBLIC_RUNTIME], {
        cwd: ROOT, env: runtimeEnv, stdio: ['pipe', 'pipe', 'pipe'], shell: false
      });
      this.child = child;
      const timer = setTimeout(() => {
        if (this.ready) return;
        child.kill('SIGTERM');
        reject(new Error('FLYLO_PUBLIC_RUNTIME_START_TIMEOUT'));
      }, 10000);
      timer.unref();

      const lines = readline.createInterface({ input: child.stdout, crlfDelay: Infinity });
      lines.on('line', line => {
        let message;
        try { message = JSON.parse(line); }
        catch {
          this.lastError = `invalid runtime output: ${line.slice(0, 240)}`;
          return;
        }
        if (message.event === 'FLYLO_PUBLIC_RUNTIME_READY') {
          this.ready = Boolean(message.ok);
          this.readyInfo = message;
          clearTimeout(timer);
          if (this.ready) resolve(message);
          else reject(new Error(message.code || 'FLYLO_PUBLIC_RUNTIME_NOT_READY'));
          return;
        }
        const id = String(message.id || '');
        const pending = this.pending.get(id);
        if (!pending) return;
        this.pending.delete(id);
        clearTimeout(pending.timer);
        pending.resolve(message);
      });
      child.stderr.on('data', chunk => {
        const text = chunk.toString('utf8').trim();
        if (text) process.stderr.write(`FLYLO_PUBLIC_RUNTIME_DIAGNOSTIC ${text}\n`);
      });
      child.on('error', error => {
        this.lastError = error.message;
        clearTimeout(timer);
        if (!this.ready) reject(error);
        this.failPending(error);
      });
      child.on('exit', code => {
        this.ready = false;
        this.lastError = `runtime exited ${code}`;
        clearTimeout(timer);
        this.child = null;
        this.failPending(new Error(this.lastError));
      });
    });
  }

  failPending(error) {
    for (const pending of this.pending.values()) {
      clearTimeout(pending.timer);
      pending.reject(error);
    }
    this.pending.clear();
  }

  request(payload, timeoutMs = 12000) {
    if (!this.child || !this.ready) return Promise.reject(new Error('FLYLO_PUBLIC_RUNTIME_UNAVAILABLE'));
    const id = `R${++this.sequence}`;
    const request = { ...payload, id };
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(id);
        reject(new Error('FLYLO_PUBLIC_RUNTIME_REQUEST_TIMEOUT'));
      }, timeoutMs);
      timer.unref();
      this.pending.set(id, { resolve, reject, timer });
      this.child.stdin.write(JSON.stringify(request) + '\n', error => {
        if (!error) return;
        const pending = this.pending.get(id);
        if (!pending) return;
        this.pending.delete(id);
        clearTimeout(timer);
        reject(error);
      });
    });
  }

  status() {
    return {
      ready: this.ready,
      wireUiServer: this.readyInfo?.wireUiServer || '0.17',
      engine: this.readyInfo?.engine || 'QUEUE_FABRIC_DURABLE_FIXTURE',
      accounting: this.readyInfo?.accounting || 'ACCOUNTING_CORE_0.7',
      storage: this.readyInfo?.storage || 'DURABLE',
      lastError: this.lastError
    };
  }

  stop() {
    if (!this.child) return;
    this.child.stdin.end();
    this.child.kill('SIGTERM');
  }
}

function publicActionFailure(reply, action) {
  const internalCode = String(reply?.code || 'FLYLO_ACTION_FAILED');
  const detail = String(reply?.detail || '');
  if (action === 'BOOKING.LOOKUP' && (internalCode === 'BOOKING_NOT_FOUND' || internalCode === 'BOOKING_NAME_MISMATCH')) {
    return { status: 404, body: { ok: false, code: 'BOOKING_LOOKUP_NOT_MATCHED', message: 'We could not match that booking reference and surname. Check the confirmation and try again.' } };
  }
  if (internalCode.startsWith('RUNTIME_CONDITION_') || internalCode.startsWith('BOOT_CONDITION_')) {
    process.stderr.write(`FLYLO_PUBLIC_RUNTIME_DIAGNOSTIC action=${action} code=${internalCode} stage=${String(reply?.stage || '')} detail=${detail}\n`);
    return { status: 500, body: { ok: false, code: 'FLYLO_ACTION_INTERNAL_FAILURE', message: 'FlyLo hit an internal service error while handling that request. The booking was not changed.' } };
  }
  const friendly = internalCode === 'NO_ITINERARY_AVAILABLE'
    ? 'FlyLo could not find an itinerary with enough availability for that search.'
    : (detail || internalCode);
  return { status: 409, body: { ok: false, code: internalCode, message: friendly } };
}

async function handlePublicAction(req, res) {
  let body;
  try { body = await readJsonBody(req); }
  catch (error) { return sendJson(res, 400, { ok: false, code: error.code || 'JSON_INVALID', message: 'The FlyLo action request could not be read.' }); }
  if (!publicRuntimeBridge?.ready) return sendJson(res, 503, { ok: false, code: 'FLYLO_PUBLIC_RUNTIME_UNAVAILABLE', message: 'FlyLo booking services are not ready.' });
  const action = typeof body.action === 'string' ? body.action : '';
  if (!action) return sendJson(res, 400, { ok: false, code: 'FLYLO_ACTION_REQUIRED', message: 'A semantic action is required.' });
  try {
    const reply = await publicRuntimeBridge.request({ op: 'ACTION', action, detail: body.detail && typeof body.detail === 'object' ? body.detail : {} });
    if (!reply.ok) {
      const failure = publicActionFailure(reply, action);
      return sendJson(res, failure.status, failure.body);
    }
    return sendJson(res, 200, { ok: true, code: reply.code, result: reply.result });
  } catch (error) {
    process.stderr.write(`FLYLO_PUBLIC_RUNTIME_DIAGNOSTIC action=${action} bridge=${error.message}\n`);
    return sendJson(res, 502, { ok: false, code: 'FLYLO_PUBLIC_RUNTIME_FAILED', message: 'FlyLo could not reach its booking runtime. The booking was not changed.' });
  }
}

async function handleWorkspaceMutation(req, res, op) {
  let body;
  try { body = await readJsonBody(req); }
  catch (error) { return sendJson(res, 400, { ok: false, code: error.code || 'JSON_INVALID', message: 'The FlyLo workspace request could not be read.' }); }
  if (!publicRuntimeBridge?.ready) return sendJson(res, 503, { ok: false, code: 'FLYLO_PUBLIC_RUNTIME_UNAVAILABLE', message: 'FlyLo booking services are not ready.' });
  try {
    const reply = await publicRuntimeBridge.request({ op, ...body });
    if (!reply.ok) return sendJson(res, 409, { ok: false, code: reply.code, stage: reply.stage, message: String(reply.detail || reply.code) });
    return sendJson(res, 200, { ok: true, code: reply.code, result: reply.result });
  } catch (error) {
    return sendJson(res, 502, { ok: false, code: 'FLYLO_WORKSPACE_RUNTIME_FAILED', message: error.message });
  }
}

function runAssistant(payload) {
  return new Promise((resolve, reject) => {
    const child = spawn(assistantRexxCommand(), [CHAT_BRIDGE], {
      cwd: ROOT,
      env: rexxEnvironment(),
      stdio: ['pipe', 'pipe', 'pipe'],
      shell: false
    });
    let stdout = '';
    let stderr = '';
    let finished = false;
    const limit = 256 * 1024;
    const timer = setTimeout(() => {
      if (finished) return;
      child.kill('SIGTERM');
      reject(Object.assign(new Error('assistant timeout'), { code: 'ASSISTANT_TIMEOUT' }));
    }, Number(process.env.FLYLO_GROK_REQUEST_TIMEOUT_MS || 70000));
    timer.unref();

    function append(which, chunk) {
      if (which === 'out') stdout += chunk.toString('utf8');
      else stderr += chunk.toString('utf8');
      if (stdout.length + stderr.length > limit) child.kill('SIGTERM');
    }
    child.stdout.on('data', chunk => append('out', chunk));
    child.stderr.on('data', chunk => append('err', chunk));
    child.on('error', error => {
      if (finished) return;
      finished = true;
      clearTimeout(timer);
      reject(Object.assign(error, { code: error.code === 'ENOENT' ? 'REXX_UNAVAILABLE' : 'ASSISTANT_PROCESS_ERROR' }));
    });
    child.on('close', code => {
      if (finished) return;
      finished = true;
      clearTimeout(timer);
      const lines = stdout.trim().split(/\r?\n/).filter(Boolean);
      const last = lines[lines.length - 1] || '';
      try {
        const result = JSON.parse(last);
        result.processExitCode = code;
        resolve(result);
      } catch {
        reject(Object.assign(new Error(`assistant bridge returned invalid output${stderr ? ': ' + stderr.slice(-240) : ''}`), { code: 'ASSISTANT_BRIDGE_INVALID' }));
      }
    });
    child.stdin.end(JSON.stringify(payload) + '\n');
  });
}

async function handleAssistant(req, res) {
  if (!assistantConfigured()) {
    return sendJson(res, 503, {
      ok: false,
      code: 'FLYLO_ASSISTANT_NOT_CONFIGURED',
      message: `Grok is ready to assist once ${credentialEnvironmentName()} is available to ./flylo.`,
      assistant: assistantStatus()
    });
  }
  if (!assistantRuntimeProbe.ok) {
    return sendJson(res, 503, {
      ok: false, code: 'FLYLO_ASSISTANT_REXX_RUNTIME_INCOMPATIBLE',
      message: 'FlyLo could not initialise its ooRexx structured-assistant runtime. Check the server console; the website itself can remain running.',
      assistant: assistantStatus()
    });
  }
  const configuration = assistantConfiguration();
  if (configuration.issues.length) {
    return sendJson(res, 503, {
      ok: false, code: 'FLYLO_ASSISTANT_CONFIGURATION_INVALID',
      message: 'FlyLo found an invalid Grok assistant configuration. Check /healthz or the server console.',
      assistant: assistantStatus()
    });
  }

  let body;
  try { body = await readJsonBody(req); }
  catch (error) {
    const status = error.code === 'BODY_TOO_LARGE' ? 413 : 400;
    return sendJson(res, status, { ok: false, code: error.code || 'FLYLO_ASSISTANT_REQUEST_INVALID', message: 'The assistant request could not be read.' });
  }

  const question = textBound(body.question, 4000).trim();
  if (!question) return sendJson(res, 400, { ok: false, code: 'FLYLO_ASSISTANT_QUESTION_REQUIRED', message: 'Please type a question for FlyLo.' });

  const sessionId = assistantSessionId(body.sessionId);
  const session = assistantSession(sessionId);
  const context = safeBrowserContext(body.context);
  const payload = {
    question,
    referenceDate: flyloReferenceDate(),
    turnId: `FLYLO-${Date.now()}-${crypto.randomUUID().replace(/-/g, '').slice(0, 12)}`,
    currentFrame: session.frame,
    browserContext: context,
    conversationEvidence: safeConversation(body.history)
  };

  try {
    const result = normalizeAssistantBooleans(await runAssistant(payload));
    if (result.ok) {
      session.frame = result.frame || session.frame;
      session.updatedAt = Date.now();
      return sendJson(res, 200, {
        ok: true,
        sessionId,
        text: result.text,
        model: result.model || assistantStatus().model,
        finishReason: result.finishReason || 'stop',
        frame: result.frame || null,
        missing: result.missing || [],
        structuredUtterance: result.structuredUtterance && typeof result.structuredUtterance === 'object'
          ? { ...result.structuredUtterance, sealed: Boolean(result.structuredUtterance.sealed) }
          : null,
        authorityEvidence: result.authorityEvidence || null,
        action: result.action || null
      });
    }
    if (String(result.code || '').startsWith('FLYLO_ASSISTANT_INTERNAL_')) {
      assistantDiagnostics.internalFailures += 1;
      assistantDiagnostics.lastInternalCode = result.code;
      assistantDiagnostics.lastStage = result.diagnostic && result.diagnostic.stage || null;
      const diagnostic = result.diagnostic || {};
      process.stderr.write(`FLYLO_ASSISTANT_DIAGNOSTIC code=${result.code} stage=${diagnostic.stage || 'unknown'} condition=${diagnostic.conditionCode || 'unknown'} position=${diagnostic.position || 0}\n`);
      const continuity = safeContinuityFallback(question, result.partialFrame || session.frame);
      session.frame = continuity.frame;
      session.updatedAt = Date.now();
      return sendJson(res, 200, {
        ok: true, degraded: true, sessionId, text: continuity.text, model: null, finishReason: 'deterministic-continuity',
        frame: continuity.frame, missing: continuity.missing, structuredUtterance: null, authorityEvidence: null, action: null,
        assistantCode: result.code
      });
    }
    let status = 502;
    let message = 'I could not reach Grok just now. Your FlyLo booking and journey systems have not been changed.';
    if (result.code === 'AI_PROVIDER_RATE_LIMITED') { status = 429; message = 'Grok is busy just now. Please try the question again shortly.'; }
    if (result.code === 'AI_PROVIDER_CREDENTIAL_UNAVAILABLE' || result.code === 'AI_PROVIDER_AUTH_REJECTED') { status = 503; message = "FlyLo's Grok assistant credentials need attention on the server."; }
    if (String(result.code || '').includes('UNRESOLVED') || String(result.code || '').includes('INVALID')) { status = 422; message = result.detail || 'I could not interpret that safely. Please rephrase the travel detail.'; }
    return sendJson(res, status, { ok: false, code: result.code || 'FLYLO_ASSISTANT_FAILED', message });
  } catch (error) {
    const code = error.code || 'FLYLO_ASSISTANT_RUNTIME_FAILED';
    const status = code === 'REXX_UNAVAILABLE' ? 503 : code === 'ASSISTANT_TIMEOUT' ? 504 : 502;
    return sendJson(res, status, {
      ok: false,
      code,
      message: code === 'REXX_UNAVAILABLE' ? 'FlyLo needs ooRexx available to run the Grok assistant.' : 'The FlyLo assistant is temporarily unavailable.'
    });
  }
}

function handle(req, res) {
  const requestUrl = new URL(req.url || '/', 'http://flylo.invalid');
  if (req.method === 'GET' && requestUrl.pathname === '/healthz') {
    return sendJson(res, 200, {
      ok: true,
      service: 'flylo-website',
      version: fs.readFileSync(path.join(ROOT, 'VERSION.txt'), 'utf8').trim(),
      runtime: publicRuntimeBridge ? publicRuntimeBridge.status() : { ready: false },
      assistant: assistantStatus()
    });
  }

  if (req.method === 'POST' && requestUrl.pathname === '/api/assistant') {
    void handleAssistant(req, res);
    return;
  }
  if (req.method === 'POST' && requestUrl.pathname === '/api/action') {
    void handlePublicAction(req, res);
    return;
  }
  if (req.method === 'POST' && requestUrl.pathname === '/api/workspace/select') {
    void handleWorkspaceMutation(req, res, 'WORKSPACE.SELECT');
    return;
  }
  if (req.method === 'POST' && requestUrl.pathname === '/api/workspace/sort') {
    void handleWorkspaceMutation(req, res, 'WORKSPACE.SORT');
    return;
  }
  if (req.method === 'POST' && requestUrl.pathname === '/api/workspace/context') {
    void handleWorkspaceMutation(req, res, 'WORKSPACE.CONTEXT');
    return;
  }

  if (req.method !== 'GET' && req.method !== 'HEAD') {
    return send(res, 405, { 'content-type': 'text/plain; charset=utf-8', allow: 'GET, HEAD, POST' }, 'Method not allowed\n');
  }

  const filename = resolveStaticPath(requestUrl.pathname);
  if (!filename) return send(res, 400, { 'content-type': 'text/plain; charset=utf-8' }, 'Bad request\n');

  fs.stat(filename, (statError, stat) => {
    if (statError || !stat.isFile()) {
      return send(res, 404, { 'content-type': 'text/plain; charset=utf-8' }, 'Not found\n');
    }
    const type = MIME[path.extname(filename).toLowerCase()] || 'application/octet-stream';
    res.writeHead(200, {
      'content-type': type,
      'content-length': stat.size,
      'x-content-type-options': 'nosniff',
      'cache-control': 'no-store'
    });
    if (req.method === 'HEAD') return res.end();
    const stream = fs.createReadStream(filename);
    stream.on('error', () => {
      if (!res.headersSent) send(res, 500, { 'content-type': 'text/plain; charset=utf-8' }, 'Server error\n');
      else res.destroy();
    });
    stream.pipe(res);
  });
}

function displayHost(host) {
  if (host === '0.0.0.0' || host === '::') return '127.0.0.1';
  return host.includes(':') ? `[${host}]` : host;
}

let options;
try { options = parseArgs(process.argv.slice(2)); }
catch (error) {
  process.stderr.write(`FlyLo launcher error: ${error.message}\n`);
  process.exit(2);
}

if (!fs.existsSync(path.join(WEB_ROOT, 'index.html'))) {
  process.stderr.write(`FlyLo launcher error: web/index.html not found under ${ROOT}\n`);
  process.exit(2);
}
if (!fs.existsSync(CHAT_BRIDGE)) {
  process.stderr.write(`FlyLo launcher error: tools/flylo_assistant_turn.rex not found under ${ROOT}\n`);
  process.exit(2);
}
if (!fs.existsSync(PUBLIC_RUNTIME)) {
  process.stderr.write(`FlyLo launcher error: tools/flylo_public_runtime.rex not found under ${ROOT}\n`);
  process.exit(2);
}
if (!fs.existsSync(RUNTIME_PROBE)) {
  process.stderr.write(`FlyLo launcher error: tools/flylo_runtime_probe.rex not found under ${ROOT}\n`);
  process.exit(2);
}
assistantRuntimeProbe = probeRexxRuntime();
if (!assistantRuntimeProbe.ok) process.stderr.write(`FLYLO_ASSISTANT_PREFLIGHT ${assistantRuntimeProbe.code}\n`);
const configAtStart = assistantConfiguration();
if (configAtStart.issues.length) process.stderr.write(`FLYLO_ASSISTANT_CONFIG ${configAtStart.issues.join(',')}\n`);

const server = http.createServer(handle);
server.on('error', (error) => {
  if (error && error.code === 'EADDRINUSE') {
    process.stderr.write(`FlyLo launcher error: ${options.host}:${options.port} is already in use\n`);
  } else {
    process.stderr.write(`FlyLo launcher error: ${error.message}\n`);
  }
  process.exit(1);
});

async function startFlyLo() {
  const dataRoot = ensureFlyLoDataDirectory();
  publicRuntimeBridge = new FlyLoPublicRuntimeBridge(dataRoot);
  try {
    await publicRuntimeBridge.start();
  } catch (error) {
    process.stderr.write(`FlyLo launcher error: public booking runtime failed: ${error.message}\n`);
    process.exit(2);
    return;
  }
  server.listen(options.port, options.host, () => {
    const address = server.address();
    const port = typeof address === 'object' && address ? address.port : options.port;
    const url = `http://${displayHost(options.host)}:${port}/`;
    process.stdout.write(`FLYLO_READY ${url}\n`);
    process.stdout.write(`FLYLO_RUNTIME wire-ui-0.17 queue-fabric-durable accounting-core-0.7\n`);
    process.stdout.write(`FLYLO_ASSISTANT ${assistantReady() ? 'grok-realtime' : assistantConfigured() ? 'configuration-error' : 'not-configured'}\n`);
    process.stdout.write('Press Ctrl-C to stop FlyLo.\n');
  });
}

void startFlyLo();

let stopping = false;
function stop(signal) {
  if (stopping) return;
  stopping = true;
  process.stdout.write(`FLYLO_STOP ${signal}\n`);
  if (publicRuntimeBridge) publicRuntimeBridge.stop();
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(1), 3000).unref();
}
process.on('SIGINT', () => stop('SIGINT'));
process.on('SIGTERM', () => stop('SIGTERM'));
