function usage(exitCode = 0) {
  const out = exitCode === 0 ? process.stdout : process.stderr;
  out.write(`FlyLo development website launcher\n\nUsage:\n  ./flylo [--host HOST] [--port PORT]\n\nDefaults:\n  host: FLYLO_HOST or 127.0.0.1\n  port: FLYLO_PORT or 4173\n\nAssistant:\n  XAI_API_KEY enables the real-time Grok assistant.\n  FLYLO_GROK_MODEL defaults to grok-4.3.\n  Structured-language interpretation + Structured Utterance v0.3 are mandatory.\n  No Grok Batch path is used.\n\nWebsite runtime:\n  Public booking/manage-booking actions are server-backed through Wire UI Server v0.17\n  and durable Queue Fabric-backed FlyLo engines. No browser demo action fallback is used.\n\nExamples:\n  ./flylo\n  ./flylo --port 8080\n  ./flylo --host 0.0.0.0 --port 4173\n`);
  process.exit(exitCode);
}

function parseArgs(argv) {
  const options = {
    host: process.env.FLYLO_HOST || '127.0.0.1',
    port: Number(process.env.FLYLO_PORT || 4173)
  };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h') usage(0);
    if (arg === '--host') {
      if (++i >= argv.length) usage(2);
      options.host = argv[i];
      continue;
    }
    if (arg === '--port') {
      if (++i >= argv.length) usage(2);
      options.port = Number(argv[i]);
      continue;
    }
    process.stderr.write(`Unknown option: ${arg}\n`);
    usage(2);
  }
  if (!options.host) throw new Error('FLYLO_HOST_REQUIRED');
  if (!Number.isInteger(options.port) || options.port < 0 || options.port > 65535) {
    throw new Error('FLYLO_PORT_INVALID');
  }
  return options;
}

function flyloDataDirectory() {
  const configured = String(process.env.FLYLO_DATA_DIR || '').trim();
  return configured ? path.resolve(configured) : path.join(os.homedir(), '.flylo');
